# Mirai Shigoto — environment variables template.
#
# Copy to `.env` (gitignored) for local dev, or set in Vercel project
# settings for preview/production. Only PUBLIC_* keys are baked into
# client-side bundles; non-prefixed keys stay server-only.

# ─── Analytics (public; embedded in client HTML) ───────────────────────────

# Cloudflare Web Analytics beacon token. The CF beacon <script> is only
# emitted when this is set — production deploys configure it via the Vercel
# environment-variable UI. Leave blank for previews/forks so they don't
# pollute the production beacon.
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX format). The gtag.js
# snippet is only emitted when this is set. Same policy as the CF beacon:
# blank in previews/forks; production deploys configure via Vercel env.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional X (Twitter) Ads pixel ID. When unset the pixel snippet is
# skipped entirely.
PUBLIC_X_PIXEL_ID=

# Optional Meta (Facebook/Instagram) Pixel ID. When unset the pixel
# snippet is skipped entirely. The pixel is consent-gated: even when
# this env is set, fbq('init') + PageView only fire after the user
# accepts the cookie banner (or has previously accepted). Configured
# in Vercel project env for both preview and production deploys.
PUBLIC_META_PIXEL_ID=

# Google Ads conversion-tracking ID (AW-XXXXXXXXX format). Shares the
# gtag.js library with PUBLIC_GA4_MEASUREMENT_ID, so the AW- config only
# fires when GA4 is also set (the gtag bootstrap is gated on GA4). When
# unset, no gtag('config','AW-…') call is made; other trackers are
# unaffected. Configure in Vercel project env. No trailing whitespace —
# a stray \n invalidates the ID.
PUBLIC_GOOGLE_ADS_ID=

# ─── Edge Function secrets (server only) ───────────────────────────────────

# GA4 Measurement Protocol API secret. Used by middleware.ts to fire
# server-side page_view hits that bypass browser tracking protection /
# ad-blockers. Generate at:
#   GA4 → Admin → Data Streams → click your stream → scroll to
#   "Measurement Protocol API secrets" → Create
# Mark this env as Sensitive in Vercel (server-only — no PUBLIC_ prefix).
# When unset, middleware passes through silently and only client-side
# gtag.js hits are recorded.
GA4_MP_API_SECRET=

# Vercel Cron authentication for api/cron/measurement-sentinel. When
# set, Vercel sends `Authorization: Bearer <CRON_SECRET>` on cron
# invocations and the sentinel rejects other callers with 401. When
# unset the sentinel fails open (still runs; endpoint stays read-only).
# Any long random string. Set in Vercel Production env, mark Sensitive.
CRON_SECRET=

# Vercel AI Gateway key for the scoring runner
# (`bun scripts/run-scoring.ts --provider ai-gateway`). One key reaches every
# vendor's models; create with `vercel ai-gateway api-keys create`. Local
# batch runs only — the site and its Vercel functions never read this.
AI_GATEWAY_API_KEY=

# Sentinel phase 2 (#334): GA4 Data API reconciliation via Vercel OIDC
# federation. Non-secret identifiers; production-only. No Google key
# exists anywhere — the chain is OIDC → STS → 300s impersonation.
# Values + GCP replay commands: docs/INCIDENT_RUNBOOK.md §6.7.
GCP_WIF_AUDIENCE=
GCP_SA_EMAIL=

# Google Analytics admin setup (analytics/setup-ga4.mjs). GA4_PROPERTY_ID
# is also read by sentinel phase 2 in production.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
