# Mirai Shigoto — environment variables template.
#
# Copy to `.env` (gitignored) for local dev, or set in Vercel project
# settings for preview/production. Only PUBLIC_* keys are baked into
# client-side bundles; non-prefixed keys stay server-only.

# ─── Analytics (public; embedded in client HTML) ───────────────────────────

# Cloudflare Web Analytics beacon token. The CF beacon <script> is only
# emitted when this is set — production deploys configure it via the Vercel
# environment-variable UI. Leave blank for previews/forks so they don't
# pollute the production beacon.
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX format). The gtag.js
# snippet is only emitted when this is set. Same policy as the CF beacon:
# blank in previews/forks; production deploys configure via Vercel env.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional X (Twitter) Ads pixel ID. When unset the pixel snippet is
# skipped entirely.
PUBLIC_X_PIXEL_ID=

# ─── Edge Function secrets (server only) ───────────────────────────────────

# GA4 Measurement Protocol API secret. Used by middleware.ts to fire
# server-side page_view hits that bypass browser tracking protection /
# ad-blockers. Generate at:
#   GA4 → Admin → Data Streams → click your stream → scroll to
#   "Measurement Protocol API secrets" → Create
# Mark this env as Sensitive in Vercel (server-only — no PUBLIC_ prefix).
# When unset, middleware passes through silently and only client-side
# gtag.js hits are recorded.
GA4_MP_API_SECRET=

# Resend transactional-email API key — auto-injected by the Resend Vercel
# integration in production. Required for api/feedback.js + api/subscribe.js
# to actually deliver mail; without it those endpoints return 202 + a
# log-only fallback.
RESEND_API_KEY=

# Operator inbox for feedback submissions. When unset, feedback is logged
# but not emailed.
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Resend audience IDs for newsletter subscribe (one per language).
RESEND_AUDIENCE_ID_JA=
RESEND_AUDIENCE_ID_EN=

# Google Analytics admin setup (analytics/setup-ga4.mjs).
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
