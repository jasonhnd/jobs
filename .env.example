# Mirai Shigoto — environment variables template.
#
# Copy to `.env` (gitignored) for local dev, or set in Vercel project
# settings for preview/production. Only PUBLIC_* keys are baked into
# client-side bundles; non-prefixed keys stay server-only.

# ─── Analytics (public; embedded in client HTML) ───────────────────────────

# Cloudflare Web Analytics beacon token. Leave unset to use the production
# beacon embedded in BaseLayout (defaults match mirai-shigoto.com).
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX format). Leave unset to
# use the production property.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional X (Twitter) Ads pixel ID. When unset the pixel snippet is
# skipped entirely.
PUBLIC_X_PIXEL_ID=

# ─── Edge Function secrets (server only) ───────────────────────────────────

# Resend transactional-email API key — auto-injected by the Resend Vercel
# integration in production. Required for api/feedback.js + api/subscribe.js
# to actually deliver mail; without it those endpoints return 202 + a
# log-only fallback.
RESEND_API_KEY=

# Operator inbox for feedback submissions. When unset, feedback is logged
# but not emailed.
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Resend audience IDs for newsletter subscribe (one per language).
RESEND_AUDIENCE_ID_JA=
RESEND_AUDIENCE_ID_EN=

# Google Analytics admin setup (analytics/setup-ga4.mjs).
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
