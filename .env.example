# Mirai Shigoto — environment variables template.
#
# Copy to `.env` (gitignored) for local dev, or set in Vercel project
# settings for preview/production. Only PUBLIC_* keys are baked into
# client-side bundles; non-prefixed keys stay server-only.

# ─── Analytics (public; embedded in client HTML) ───────────────────────────

# Cloudflare Web Analytics beacon token. The CF beacon <script> is only
# emitted when this is set — production deploys configure it via the Vercel
# environment-variable UI. Leave blank for previews/forks so they don't
# pollute the production beacon.
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX format). The gtag.js
# snippet is only emitted when this is set. Same policy as the CF beacon:
# blank in previews/forks; production deploys configure via Vercel env.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional X (Twitter) Ads pixel ID. When unset the pixel snippet is
# skipped entirely.
PUBLIC_X_PIXEL_ID=

# Optional Meta (Facebook/Instagram) Pixel ID. When unset the pixel
# snippet is skipped entirely. The pixel is consent-gated: even when
# this env is set, fbq('init') + PageView only fire after the user
# accepts the cookie banner (or has previously accepted). Configured
# in Vercel project env for both preview and production deploys.
PUBLIC_META_PIXEL_ID=

# Google Ads conversion-tracking ID (AW-XXXXXXXXX format). Shares the
# gtag.js library with PUBLIC_GA4_MEASUREMENT_ID, so the AW- config only
# fires when GA4 is also set (the gtag bootstrap is gated on GA4). When
# unset, no gtag('config','AW-…') call is made; other trackers are
# unaffected. Configure in Vercel project env. No trailing whitespace —
# a stray \n invalidates the ID.
PUBLIC_GOOGLE_ADS_ID=

# ─── Edge Function secrets (server only) ───────────────────────────────────

# GA4 Measurement Protocol API secret. Used by middleware.ts to fire
# server-side page_view hits that bypass browser tracking protection /
# ad-blockers. Generate at:
#   GA4 → Admin → Data Streams → click your stream → scroll to
#   "Measurement Protocol API secrets" → Create
# Mark this env as Sensitive in Vercel (server-only — no PUBLIC_ prefix).
# When unset, middleware passes through silently and only client-side
# gtag.js hits are recorded.
GA4_MP_API_SECRET=

# Production feedback release requirements (all except FROM are required):
#   PUBLIC_TURNSTILE_SITE_KEY — renders the browser challenge widget
#   TURNSTILE_SECRET_KEY     — verifies its token in the Edge Function
#   UPSTASH_REDIS_REST_URL   — locates the per-IP rate-limit store
#   UPSTASH_REDIS_REST_TOKEN — authorizes rate-limit store requests
#   RESEND_API_KEY           — authorizes the Resend delivery request
#   FEEDBACK_TO_EMAIL        — operator inbox that receives the message
#   FEEDBACK_FROM_EMAIL      — optional sender override; see default below
# Missing required security, rate-limit, or delivery values fail closed in
# production as documented in the sections below.

# Resend transactional-email API key — auto-injected by the Resend Vercel
# integration when it is configured. Required in production by
# api/feedback.js, and also used by api/subscribe.js.
RESEND_API_KEY=

# Operator inbox for feedback submissions. Production requires both this and
# RESEND_API_KEY: if either is missing, api/feedback.js records only a
# PII-safe redacted diagnostic and returns HTTP 503
# `feedback_delivery_failed` / `config_missing`. Preview/development retains
# the explicit HTTP 202 `{ ok: true, delivered: false, warn: "config_missing" }`
# non-delivery response for local testing; the UI treats it as a failure.
FEEDBACK_TO_EMAIL=

# Optional sender override. When blank, api/feedback.js uses
# `onboarding@resend.dev`; production operators may set a verified sender.
FEEDBACK_FROM_EMAIL=

# Resend audience IDs for the shared footer newsletter signup (one per language).
RESEND_AUDIENCE_ID_JA=
RESEND_AUDIENCE_ID_EN=

# Google Analytics admin setup (analytics/setup-ga4.mjs).
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Rate limiting (Upstash Redis REST) ────────────────────────────────────
#
# Per-IP rate limit for api/feedback.js + api/subscribe.js. Production requires
# a valid HTTPS URL plus TOKEN; missing or malformed configuration fails closed
# and the endpoints return HTTP 429. Preview/development skips the quota when
# either value is missing, while the honeypot + body cap + origin gate remain.
# Set both to enable: 10 POSTs/5min for feedback, 5 POSTs/5min for subscribe.
#
# Provisioning: https://upstash.com → free-tier Redis DB → REST tab → copy
# `UPSTASH_REDIS_REST_URL` + `UPSTASH_REDIS_REST_TOKEN` here AND into
# Vercel project env (Sensitive).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional upstream-outage override (it does not make missing production
# credentials acceptable). Production defaults to fail-closed; set `0`,
# `false`, or `no` to fail open. Preview/development defaults to fail-open;
# set `1`, `true`, or `yes` to fail closed.
FAIL_CLOSED_ON_RATELIMIT_ERROR=

# ─── Cloudflare Turnstile (invisible CAPTCHA) ──────────────────────────────
#
# PUBLIC_TURNSTILE_SITE_KEY is baked into the footer and renders the browser
# widget that supplies `cf-turnstile-response`. TURNSTILE_SECRET_KEY stays
# server-only and verifies that token. Both must be set for a usable production
# form. With a configured secret, a missing widget/token returns HTTP 403.
#
# In production, a missing TURNSTILE_SECRET_KEY fails closed: the feedback
# endpoint returns HTTP 403 `turnstile_failed` with reason
# `production_misconfigured`. In preview/development, a missing secret skips
# verification so local forms can be exercised without Cloudflare credentials.
#
# Provisioning: https://dash.cloudflare.com/?to=/:account/turnstile →
# Add Site → copy site key (public) + secret key (server-only).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Cloudflare-outage override. Production defaults to fail-closed; set
# `0`, `false`, or `no` to fail open. Preview/development defaults to fail-open;
# set `1`, `true`, or `yes` to fail closed. Missing production credentials
# always fail closed regardless of this outage override.
FAIL_CLOSED_ON_TURNSTILE_ERROR=
