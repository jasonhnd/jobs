{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "rm -rf dist-astro node_modules/.astro && bun run build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "installCommand": "bun install --frozen-lockfile",
  "bunVersion": "1.4.x",
  "outputDirectory": "dist-astro",
  "crons": [
    {
      "path": "/api/cron/measurement-sentinel",
      "schedule": "17 22 * * *"
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://*.googletagmanager.com https://www.google-analytics.com https://va.vercel-scripts.com https://static.ads-twitter.com https://connect.facebook.net 'sha256-+5bdLHzj8GiTPeItmNhH70xQPa7yclrHL56ESG2Vqjs=' 'sha256-1rv/mZufcZoaPwpsbw987HwE/M+WuYKzHXuF3BCvzOo=' 'sha256-38OCDMBi/9eHN7h9wJ7am7Es1NbQmBTeBLM+9/L8Prc=' 'sha256-685wL/dHCdikCfQrWJc8/3h3zn+7ugScWhAVQZcHVr8=' 'sha256-7UQoTOXlNTB2PmxDEORz5ZFhL+9pc57Rc1pDvEkEp8E=' 'sha256-80on6q+4N8b4tdPifTn79iWlzXfYoRuhIjokIq9QGw4=' 'sha256-8pJ3laaECnNFCT3EG1ABP5Ie2vlMu5JHFMeCxeofC0w=' 'sha256-FVDsBMyIkFkMuh4pcxmfkeKhemFWJy8Wf0rRwb26HrQ=' 'sha256-HoGE2p4ezyPr243yXx4oYFy03DXE/DQybGi+wrOTh/0=' 'sha256-L4QbaDe3zN+KRmmJzQvuDGTdSssRmLG9ZapL7Ibsc0k=' 'sha256-NTyQhvHtVVVCiEA6DDpN8V3Vo2MJX4NDFxJ6ZO2+QjA=' 'sha256-P6fbFPD1fIoekwHZUeK7OWCuG0WnQ7hQzcplwlHgeK4=' 'sha256-UoO7Y/sJrjo2L/d+JjLhS40cLwmEiZtcgOPRajhQf0A=' 'sha256-a/ELOLuHCmf4ijQU2+KIkI8osS2lscWKvTwTtIuIDpc=' 'sha256-eTdOqQIqhAhWcMk9A4G/vtp6OMnP4KrAeNqOFWToqvE=' 'sha256-mEjXucpUExIz3nx3AizABlBEO3RXLDXVXIkrpe7XvPk=' 'sha256-nteMg/XPiAM10FHVDeo3XNBvVT7qg8ELII75+qi17vc=' 'sha256-rFmFVhlarDQFXs/CHiq7yV070fgclMlEekefNZPS6xg=' 'sha256-rMk6BYbivudkhnerx/Rk2lI++sOY2uBxHPARDHh/Tpk=' 'sha256-rtTYLg1aJvZmwCs10Oh7gxsU9JzW4fzO/kfUuQU6RE8=' 'sha256-uu95dQjw9YgQydNAPcGN6ka1mx7BDuoTJ87I20UTTGU=' 'sha256-vLf/TS2H7w0qx7j66lohFNPTEgHM/GtEUYO0CGsSbk0=' 'sha256-x4JMRHHxuJFMff+ZyUM1lgOELW03/4yhCe6wetFlMH0=' 'sha256-xD6hZa6sAXFt/YW5BTXyUDDy/VTct3vVyIb47bVSYwA='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com https://*.google-analytics.com https://analytics.google.com https://www.google.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://vitals.vercel-insights.com https://analytics.twitter.com https://t.co https://www.facebook.com https://connect.facebook.net; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "pre.mirai-shigoto.com" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data.treemap.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }
      ]
    },
    {
      "source": "/data.treemap.meta.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }
      ]
    },
    {
      "source": "/data.top10.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }
      ]
    },
    {
      "source": "/data.search.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }
      ]
    },
    {
      "source": "/data.detail/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }
      ]
    },
    {
      "source": "/data.labels/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" }
      ]
    },
    {
      "source": "/data.sectors.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/image-sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" }
      ]
    },
    {
      "source": "/llms(-full)?\\.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [],
  "redirects": [
    {
      "source": "/me/start",
      "destination": "/shindan",
      "permanent": true
    },
    {
      "source": "/data.json",
      "destination": "/data.treemap.json",
      "permanent": true
    },
    {
      "source": "/occ/404-:slug*",
      "destination": "/occupations/404",
      "permanent": true
    },
    {
      "source": "/occ/404",
      "destination": "/occupations/404",
      "permanent": true
    },
    {
      "source": "/occ/:id(\\d+)-:slug*",
      "destination": "/:id",
      "permanent": true
    },
    {
      "source": "/occ/:id(\\d+)",
      "destination": "/:id",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/ja/about/methodology",
      "destination": "/methodology",
      "permanent": true
    },
    {
      "source": "/ja/about/data-sources",
      "destination": "/methodology",
      "permanent": true
    },
    {
      "source": "/ja/about/glossary",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ja/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ja/404.html",
      "destination": "/occupations/404",
      "permanent": true
    },
    {
      "source": "/ja/404",
      "destination": "/occupations/404",
      "permanent": true
    },
    {
      "source": "/ja",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ja/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/models/opus-4-7",
      "destination": "/models/opus-4-7@2026-04-25",
      "permanent": true
    },
    {
      "source": "/models/opus-4-8",
      "destination": "/models/opus-4-8@2026-05-30",
      "permanent": true
    },
    {
      "source": "/models/fable-5",
      "destination": "/models/fable-5@2026-06-13",
      "permanent": true
    },
    {
      "source": "/models/gpt-5.6-sol",
      "destination": "/models/gpt-5.6-sol@2026-07-12",
      "permanent": true
    },
    {
      "source": "/models/opus-5",
      "destination": "/models/opus-5@2026-07-26",
      "permanent": true
    },
    {
      "source": "/models/grok-4.6",
      "destination": "/models/grok-4.6@2026-09-07",
      "permanent": true
    },
    {
      "source": "/models/grok-4.7",
      "destination": "/models/grok-4.7@2026-09-22",
      "permanent": true
    },
    {
      "source": "/models/fable-5-1",
      "destination": "/models/fable-5-1@2026-09-09",
      "permanent": true
    },
    {
      "source": "/models/gpt-6-astra",
      "destination": "/models/gpt-6-astra@2026-09-10",
      "permanent": true
    },
    {
      "source": "/models/grok-4.5",
      "destination": "/models/grok-4.5@2026-09-10",
      "permanent": true
    },
    {
      "source": "/models/opus-5-5",
      "destination": "/models/opus-5-5@2026-09-23",
      "permanent": true
    },
    {
      "source": "/models/gpt-6-sol",
      "destination": "/models/gpt-6-sol@2026-09-23",
      "permanent": true
    },
    {
      "source": "/models/gpt-6.1-sol",
      "destination": "/models/gpt-6.1-sol@2026-10-01",
      "permanent": true
    }
  ]
}
