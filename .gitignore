# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
# dist/ IS tracked: (1) it's the Astro publicDir (per astro.config.mjs); the
# committed JSON projections plus 4 SEO statics (og.png, robots.txt, llms.txt,
# llms-full.txt) all flow into dist-astro/ at build time. (2) Vercel rebuilds
# data fresh via `npm run build:data` on every deploy, but the SEO statics
# need a tracked home so they survive a clean checkout.
# Future cleanup (separate PR): split SEO statics into public/ and gitignore
# dist/ generated JSON.
dist.next/
dist.prev/
build/
.cache/

# Astro / TS migration output dirs
# Astro build output (Vercel deploy target — built fresh in CI, not committed).
dist-astro/
# Atomic-stage dirs from earlier Python build attempts (left over when swap
# failed on Dropbox lock). Local-only.
dist-py.next/
dist-ts/
# Astro internal cache (auto-generated types, content collection metadata)
.astro/

# Environment files
.env
.env.*
!.env.example

# Pipeline raw outputs (kept locally, not pushed).
# IMPORTANT: leading slash anchors to repo root — without it, `pages/` would
# also match `src/pages/` and silently strip Astro pages from git.
/html/
/pages/
/raw/
*.log

# Local-only dev artifacts (don't ship to public repo)
.claude/
_audit/
.vercel

# Credentials — never commit these (defensive patterns; real credentials should
# live OUTSIDE the repo, e.g. ~/.config/mirai-shigoto/)
*-sa.json
*service-account*.json
*credentials*.json
gcp-*.json

# Personal monitoring/dashboards cheatsheet — local-only operator reference,
# contains direct dashboard URLs and account-specific paths. Not source code.
analytics/dashboards.md

# Local-only preview / scratch HTML files. Names starting with `_` are draft.
_*.html

# docs/ — all design / planning markdown is local-only, not synced to GitHub.
docs/
