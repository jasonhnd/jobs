{
  "name": "mirai-shigoto",
  "version": "1.3.0",
  "private": true,
  "description": "Static site + Vercel Edge Functions for mirai-shigoto.com (TypeScript ETL + Astro).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:data && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:consistency": "tsx src/data/test-consistency.ts",
    "build:data": "tsx src/data/build.ts",
    "import:ipd": "tsx src/data/import-ipd.ts",
    "audit": "npm audit --audit-level=moderate && (cd analytics && npm audit --audit-level=moderate)",
    "test:seo": "bash scripts/seo-check.sh https://mirai-shigoto.com/"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@vercel/og": "^0.6.5",
    "astro": "^5.1.0",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
