---
/**
 * BaseLayout.astro — common <head> + body shell + footer.
 *
 * 2026-05-23 PR #6 retry: previous deploy served stale dist-astro/ with
 * mismatched CSP hashes. Touching a frontmatter comment to bust Vercel
 * build cache. This comment is in .astro frontmatter only — does NOT
 * affect rendered HTML, inline script bodies, or CSP hashes.
 *
 * Captures the boilerplate every static page needs:
 *   - Theme inline script (no flash)
 *   - DNS prefetch / preconnect for analytics + fonts
 *   - Google Fonts (Noto Serif JP + Plus Jakarta Sans)
 *   - Open Graph + Twitter Card defaults
 *   - Cloudflare Web Analytics
 *   - Google tag (gtag.js) — deferred to window.load
 *   - Vercel Web Analytics + Speed Insights
 *   - Inline favicon (treemap-tile SVG)
 *
 * Page-specific content goes through props + slots:
 *   - title, description, keywords, canonical (props)
 *   - og.* defaults to title/description; override via props
 *   - noindex flag (for 404 etc.)
 *   - jsonLd slot — page-specific JSON-LD <script>
 *   - head slot — page-specific <link>/<meta>/<style>
 *   - default slot — page body content
 *   - bodyEnd slot — page-specific scripts after content
 *
 * CSP hardening (audit CODE-012, 2026-05-17): every inline <script> on this
 * layout is now STATIC (no per-request / per-page interpolation). Env-derived
 * values (GA4 measurement ID, X pixel ID) are emitted as <meta> tags and read
 * back at runtime; the inline script body is byte-identical across every
 * build of every page, so a single SHA-256 hash in vercel.json's
 * script-src directive covers all 821+ rendered pages. The build step
 * `scripts/compute-csp-hashes.cjs` collects those hashes after Astro
 * finishes rendering and rewrites vercel.json so script-src no longer needs
 * `'unsafe-inline'`. See also: `_IdPageScript.astro`, `_JobtagAnchor.astro`,
 * `Footer.astro`, `MobileNav.astro` — same static-script + data-attribute
 * pattern.
 */
import TopNav from '../components/TopNav.astro';
import MobileNav from '../components/MobileNav.astro';
import { siteConfig } from '@/site/config';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Optional class applied to <body> for page-specific styling hooks. */
  bodyClass?: string;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
  noindex = false,
  bodyClass,
} = Astro.props;

const robotsContent = noindex ? 'noindex, follow' : 'index, follow';

const X_PIXEL_ID = import.meta.env.PUBLIC_X_PIXEL_ID;

// Analytics ids — environment-overridable so preview/staging can point at
// a separate property without editing the layout. Audit's #7.2: the
// previous code defaulted unset env vars to the PRODUCTION CF/GA4 IDs,
// so a fork or unconfigured preview branch would silently pump traffic
// into the live mirai-shigoto.com beacons. Now: env required for the
// beacon to render. Production deploys pass PUBLIC_CF_BEACON_TOKEN /
// PUBLIC_GA4_MEASUREMENT_ID via Vercel's environment-variable UI.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const GA4_MEASUREMENT_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;
---
<!doctype html>
<html lang={siteConfig.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme: read saved choice before paint (no flash). Falls back to system preference via CSS @media. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    {/* RA-011 (2026-05-18): hreflang declaration. Site is JA-only as
        of v1.4.0, but declaring x-default + ja makes the intent explicit
        for search engines and avoids the "missing hreflang" warning. */}
    <link rel="alternate" hreflang="ja" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Warm up TCP/TLS to analytics origins while HTML parses. -->
    <link rel="dns-prefetch" href="//static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    <link rel="dns-prefetch" href="//static.ads-twitter.com" />
    <link rel="dns-prefetch" href="//connect.facebook.net" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="jsonLd" />

    <!-- Cloudflare Web Analytics — only emitted when PUBLIC_CF_BEACON_TOKEN is configured.
         No inline <script> body; the data-cf-beacon attribute is parsed by the
         remote beacon.min.js itself. CSP-safe: only an external <script src> is
         emitted here. -->
    {CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
      ></script>
    )}

    <!-- ── CODE-012 CSP hardening (2026-05-17) ────────────────────────────────────
         Analytics config values are emitted as <meta> tags so the inline gtag /
         X-pixel reader scripts can stay 100% static (no per-build interpolation).
         Static-body inline scripts hash deterministically across every page; one
         CSP `'sha256-…'` entry covers every render. Env values are still env-gated
         (the <meta> is only rendered when the corresponding env var is set), so
         previews / forks without env still skip the tracker bootstrap entirely. -->
    {GA4_MEASUREMENT_ID && <meta name="ga4-measurement-id" content={GA4_MEASUREMENT_ID} />}
    {X_PIXEL_ID && <meta name="x-pixel-id" content={X_PIXEL_ID} />}
    {META_PIXEL_ID && <meta name="meta-pixel-id" content={META_PIXEL_ID} />}

    <!-- Google tag (gtag.js) bootstrap — STATIC script body (no `define:vars`,
         no template interpolation). Reads its config from the
         <meta name="ga4-measurement-id"> tag above. The `function gtag()` MUST
         remain a top-level declaration (NOT wrapped in IIFE) so gtag.js's library
         can swap `window.gtag` in place — see 2026-05-11 GA4 outage diagnosis. -->
    {GA4_MEASUREMENT_ID && (
      <script is:inline>
        (function () {
          var meta = document.querySelector('meta[name="ga4-measurement-id"]');
          if (!meta) return;
          var id = meta.getAttribute('content');
          if (!id) return;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() { window.dataLayer.push(arguments); };
          // RA-013 (2026-05-18): GA4 consent mode v2 — default 'denied' until
          // the user accepts via the cookie banner (see bottom of <body>).
          // Banner JS calls window.gtag('consent', 'update', {...granted})
          // when the user clicks 同意. If user has previously accepted, the
          // localStorage check below pre-flips before page_view fires.
          var prior = (function () {
            try { return localStorage.getItem('cookieConsent'); } catch (e) { return null; }
          })();
          var rejected = prior === 'rejected';
          var status = rejected ? 'denied' : 'granted';
          window.gtag('consent', 'default', {
            ad_storage: status,
            analytics_storage: status,
            ad_user_data: status,
            ad_personalization: status,
            functionality_storage: 'granted',
            personalization_storage: status,
            security_storage: 'granted'
          });
          window.gtag('js', new Date());
          window.gtag('config', id);
          window.addEventListener('load', function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
            document.head.appendChild(s);
          });
        })();
      </script>
    )}

    <!-- Vercel Web Analytics + Speed Insights -->
    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <!-- X (Twitter) Ads Pixel — STATIC script body, reads its pixel ID from the
         <meta name="x-pixel-id"> tag above. Defer to window.load, mirrors gtag pattern. -->
    {X_PIXEL_ID && (
      <script is:inline>
        (function () {
          var meta = document.querySelector('meta[name="x-pixel-id"]');
          if (!meta) return;
          var X_PIXEL_ID = meta.getAttribute('content');
          if (!X_PIXEL_ID) return;
          window.addEventListener('load', function () {
            !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);
            },s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='https://static.ads-twitter.com/uwt.js',
            a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a))}(window,document,'script');
            twq('config', X_PIXEL_ID);
            twq('event', 'tw-pageview');
          });
        })();
      </script>
    )}

    <!-- Meta (Facebook/Instagram) Pixel — STATIC script body, reads its pixel ID
         from the <meta name="meta-pixel-id"> tag above. Unlike GA4's gtag, the
         Meta Pixel has no native consent-mode gating, so we LAZY-init: define
         window.__metaPixelInit() but only invoke it once the user accepts the
         cookie banner. Returning visitors with prior accept run it on load.
         The cookie banner's Accept handler (bottom of <body>) calls
         window.__metaPixelInit() on click. RA-? (2026-05-18). -->
    {META_PIXEL_ID && (
      <script is:inline>
        (function () {
          var meta = document.querySelector('meta[name="meta-pixel-id"]');
          if (!meta) return;
          var id = meta.getAttribute('content');
          if (!id) return;
          window.__metaPixelInit = function () {
            // Guard against re-entry on a fast Accept-click that races the
            // window.load auto-init: both paths call __metaPixelInit, but
            // __metaPixelStarted only flips after fbevents.js finishes
            // loading. Without an "initializing" flag, the second call would
            // re-fire `init` + `track('PageView')` and double-bill the event.
            if (window.__metaPixelStarted || window.__metaPixelInitializing) return;
            window.__metaPixelInitializing = true;
            /* Install the standard Meta Pixel stub. It sets fbq as a function
               that queues calls into n.queue until the real fbevents.js loads
               and overrides n.callMethod. We KEEP the stub's queueing semantics
               so init/track calls below are buffered correctly, but we DO NOT
               flip __metaPixelStarted here — that flag only flips after the
               script's onload fires, proving fbevents.js actually loaded. If
               the script fails (CSP / ad blocker / network), the flag stays
               false so a subsequent consent toggle can retry. */
            if (!window.fbq) {
              var n = window.fbq = function () {
                n.callMethod
                  ? n.callMethod.apply(n, arguments)
                  : n.queue.push(arguments);
              };
              if (!window._fbq) window._fbq = n;
              n.push = n;
              n.loaded = !0;
              n.version = '2.0';
              n.queue = [];
            }
            /* Queue init + PageView. These execute against the queue now and
               replay once fbevents.js binds. */
            window.fbq('init', id);
            window.fbq('track', 'PageView');
            /* Inject fbevents.js with explicit load/error handlers. */
            var t = document.createElement('script');
            t.async = true;
            t.src = 'https://connect.facebook.net/en_US/fbevents.js';
            t.onload = function () {
              /* Real fbevents.js has bound; queued calls have flushed. Only
                 now is it safe to mark the pixel as started. */
              if (typeof window.fbq === 'function') {
                window.__metaPixelStarted = true;
              }
            };
            t.onerror = function () {
              // Clear the initializing flag so a subsequent consent grant
              // (or page reload) can retry the load.
              window.__metaPixelInitializing = false;
              console.warn('[meta-pixel] fbevents.js load failed; init will retry on next consent grant');
            };
            var s = document.getElementsByTagName('script')[0];
            if (s && s.parentNode) {
              s.parentNode.insertBefore(t, s);
            } else {
              document.head.appendChild(t);
            }
          };
          var prior = (function () {
            try { return localStorage.getItem('cookieConsent'); } catch (e) { return null; }
          })();
          // Mirror GA default-granted policy (PR #5, 2026-05-23): init Meta
          // Pixel unless the user explicitly clicked 拒否する. Default
          // (no banner interaction yet) and 'accepted' both load the pixel.
          if (prior !== 'rejected') {
            window.addEventListener('load', window.__metaPixelInit);
          }
        })();
      </script>
    )}

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect x='8' y='8' width='22' height='22' fill='%23ffd84d' rx='3'/><rect x='34' y='8' width='22' height='22' fill='%23ff8a3d' rx='3'/><rect x='8' y='34' width='22' height='22' fill='%2380c0ff' rx='3'/><rect x='34' y='34' width='22' height='22' fill='%2300b04b' rx='3'/></svg>"
    />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">本文へスキップ</a>
    <script is:inline>
      /* RA-002b (2026-05-18): JS fallback to toggle .is-focused on skip-link.
         Some browsers (and CDP-driven testing harnesses) don't apply :focus
         pseudo-class for programmatic .focus() calls or rapid Tab presses.
         The class toggle guarantees the visible state. */
      (function () {
        var links = document.querySelectorAll('a.skip-link');
        links.forEach(function (s) {
          s.addEventListener('focus', function () { s.classList.add('is-focused'); });
          s.addEventListener('blur',  function () { s.classList.remove('is-focused'); });
        });
      })();
    </script>
    {/* `<header>` as a direct child of `<body>` carries the implicit
        "banner" landmark role. AT users navigating by landmark previously
        found no page-level banner because MobileNav/TopNav each emitted
        their own inner header without a wrapping landmark above them. */}
    <header>
      <MobileNav />
      <TopNav />
    </header>
    <main id="main-content">
      <slot />
    </main>
    <slot name="bodyEnd" />

    {/* RA-013 (2026-05-18): Cookie consent banner. Hidden by default; shown
        when localStorage.cookieConsent is unset. Fires gtag consent 'update'
        on accept; rejects merely remembers the choice (default is denied). */}
    <div id="cookieBanner" class="cookie-banner" role="region" aria-label="Cookie 同意" aria-live="polite" hidden>
      <div class="cb-inner">
        <p class="cb-text">
          本サイトはアクセス解析のために Cookie を使用します。同意いただける場合は「同意する」を、不要な場合は「拒否する」を選択してください。詳細は <a href="/privacy">プライバシーポリシー</a>。
        </p>
        <div class="cb-actions">
          <button type="button" id="cookieReject" class="cb-btn cb-btn-reject">拒否する</button>
          <button type="button" id="cookieAccept" class="cb-btn cb-btn-accept">同意する</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'cookieConsent';
        // 1 year, matches the GA `_ga` cookie lifetime so the consent
        // signal doesn't expire before the user's analytics session.
        var COOKIE_MAX_AGE = 60 * 60 * 24 * 365;
        function writeCookie(val) {
          try {
            document.cookie =
              KEY + '=' + encodeURIComponent(val) +
              '; Max-Age=' + COOKIE_MAX_AGE +
              '; Path=/; SameSite=Lax; Secure';
          } catch (e) {}
        }
        var banner = document.getElementById('cookieBanner');
        if (!banner) return;
        var prior;
        try { prior = localStorage.getItem(KEY); } catch (e) { prior = null; }
        // P0-2 (2026-05-24): mirror localStorage → cookie so the Vercel
        // Edge middleware (which has no DOM and cannot read localStorage)
        // can honour an explicit 'rejected' choice. Only writes when the
        // cookie is absent so a fresher cookie wins over a stale local
        // value. Existing 'accepted' users also get the cookie set so
        // future server-side hits respect the GRANTED state explicitly.
        if (prior && document.cookie.indexOf(KEY + '=') === -1) {
          writeCookie(prior);
        }
        if (!prior) banner.hidden = false;
        function save(val) {
          try { localStorage.setItem(KEY, val); } catch (e) {}
          writeCookie(val);
          banner.hidden = true;
        }
        document.getElementById('cookieAccept')?.addEventListener('click', function () {
          save('accepted');
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              ad_storage: 'granted',
              analytics_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              personalization_storage: 'granted'
            });
          }
          if (typeof window.__metaPixelInit === 'function') {
            window.__metaPixelInit();
          }
        });
        document.getElementById('cookieReject')?.addEventListener('click', function () {
          save('rejected');
          // Actively revoke GA consent on the SAME page session.
          // Previously default was 'denied' so this was implicit. After
          // PR #5 (2026-05-23) default is 'granted', so without an
          // explicit gtag update the page would keep firing /g/collect
          // until next navigation. Meta Pixel cannot be revoked mid-
          // session (no fbq consent API in current init); next page
          // load gates on prior === 'rejected' and skips fbevents.js.
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              ad_storage: 'denied',
              analytics_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              personalization_storage: 'denied'
            });
          }
        });
      })();
    </script>
  </body>
</html>
