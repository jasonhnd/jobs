---
/**
 * BaseLayout.astro — common <head> + body shell + footer.
 *
 * Captures the boilerplate every static page needs:
 *   - Theme inline script (no flash)
 *   - DNS prefetch / preconnect for analytics + fonts
 *   - Google Fonts (Noto Serif JP + Plus Jakarta Sans)
 *   - Open Graph + Twitter Card defaults
 *   - Cloudflare Web Analytics
 *   - Google tag (gtag.js) — deferred to window.load
 *   - Vercel Web Analytics + Speed Insights
 *   - Inline favicon (treemap-tile SVG)
 *
 * Page-specific content goes through props + slots:
 *   - title, description, keywords, canonical (props)
 *   - og.* defaults to title/description; override via props
 *   - noindex flag (for 404 etc.)
 *   - jsonLd slot — page-specific JSON-LD <script>
 *   - head slot — page-specific <link>/<meta>/<style>
 *   - default slot — page body content
 *   - bodyEnd slot — page-specific scripts after content
 *
 * CSP hardening (audit CODE-012, 2026-05-17): every inline <script> on this
 * layout is now STATIC (no per-request / per-page interpolation). Env-derived
 * values (GA4 measurement ID, X pixel ID) are emitted as <meta> tags and read
 * back at runtime; the inline script body is byte-identical across every
 * build of every page, so a single SHA-256 hash in vercel.json's
 * script-src directive covers all 821+ rendered pages. The build step
 * `scripts/compute-csp-hashes.cjs` collects those hashes after Astro
 * finishes rendering and rewrites vercel.json so script-src no longer needs
 * `'unsafe-inline'`. See also: `_IdPageScript.astro`, `_JobtagAnchor.astro`,
 * `Footer.astro`, `MobileNav.astro` — same static-script + data-attribute
 * pattern.
 */
import TopNav from '../components/TopNav.astro';
import MobileNav from '../components/MobileNav.astro';
import { siteConfig } from '@/site/config';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Optional class applied to <body> for page-specific styling hooks. */
  bodyClass?: string;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
  noindex = false,
  bodyClass,
} = Astro.props;

const robotsContent = noindex ? 'noindex, follow' : 'index, follow';

const X_PIXEL_ID = import.meta.env.PUBLIC_X_PIXEL_ID;

// Analytics ids — environment-overridable so preview/staging can point at
// a separate property without editing the layout. Audit's #7.2: the
// previous code defaulted unset env vars to the PRODUCTION CF/GA4 IDs,
// so a fork or unconfigured preview branch would silently pump traffic
// into the live mirai-shigoto.com beacons. Now: env required for the
// beacon to render. Production deploys pass PUBLIC_CF_BEACON_TOKEN /
// PUBLIC_GA4_MEASUREMENT_ID via Vercel's environment-variable UI.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const GA4_MEASUREMENT_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
---
<!doctype html>
<html lang={siteConfig.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme: read saved choice before paint (no flash). Falls back to system preference via CSS @media. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />

    <!-- Warm up TCP/TLS to analytics origins while HTML parses. -->
    <link rel="dns-prefetch" href="//static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    <link rel="dns-prefetch" href="//static.ads-twitter.com" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="jsonLd" />

    <!-- Cloudflare Web Analytics — only emitted when PUBLIC_CF_BEACON_TOKEN is configured.
         No inline <script> body; the data-cf-beacon attribute is parsed by the
         remote beacon.min.js itself. CSP-safe: only an external <script src> is
         emitted here. -->
    {CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
      ></script>
    )}

    <!-- ── CODE-012 CSP hardening (2026-05-17) ────────────────────────────────────
         Analytics config values are emitted as <meta> tags so the inline gtag /
         X-pixel reader scripts can stay 100% static (no per-build interpolation).
         Static-body inline scripts hash deterministically across every page; one
         CSP `'sha256-…'` entry covers every render. Env values are still env-gated
         (the <meta> is only rendered when the corresponding env var is set), so
         previews / forks without env still skip the tracker bootstrap entirely. -->
    {GA4_MEASUREMENT_ID && <meta name="ga4-measurement-id" content={GA4_MEASUREMENT_ID} />}
    {X_PIXEL_ID && <meta name="x-pixel-id" content={X_PIXEL_ID} />}

    <!-- Google tag (gtag.js) bootstrap — STATIC script body (no `define:vars`,
         no template interpolation). Reads its config from the
         <meta name="ga4-measurement-id"> tag above. The `function gtag()` MUST
         remain a top-level declaration (NOT wrapped in IIFE) so gtag.js's library
         can swap `window.gtag` in place — see 2026-05-11 GA4 outage diagnosis. -->
    {GA4_MEASUREMENT_ID && (
      <script is:inline>
        (function () {
          var meta = document.querySelector('meta[name="ga4-measurement-id"]');
          if (!meta) return;
          var id = meta.getAttribute('content');
          if (!id) return;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() { window.dataLayer.push(arguments); };
          window.gtag('consent', 'default', {
            ad_storage: 'granted',
            analytics_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            functionality_storage: 'granted',
            personalization_storage: 'granted',
            security_storage: 'granted'
          });
          window.gtag('js', new Date());
          window.gtag('config', id);
          window.addEventListener('load', function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
            document.head.appendChild(s);
          });
        })();
      </script>
    )}

    <!-- Vercel Web Analytics + Speed Insights -->
    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <!-- X (Twitter) Ads Pixel — STATIC script body, reads its pixel ID from the
         <meta name="x-pixel-id"> tag above. Defer to window.load, mirrors gtag pattern. -->
    {X_PIXEL_ID && (
      <script is:inline>
        (function () {
          var meta = document.querySelector('meta[name="x-pixel-id"]');
          if (!meta) return;
          var X_PIXEL_ID = meta.getAttribute('content');
          if (!X_PIXEL_ID) return;
          window.addEventListener('load', function () {
            !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);
            },s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='https://static.ads-twitter.com/uwt.js',
            a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a))}(window,document,'script');
            twq('config', X_PIXEL_ID);
            twq('event', 'tw-pageview');
          });
        })();
      </script>
    )}

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect x='8' y='8' width='22' height='22' fill='%23ffd84d' rx='3'/><rect x='34' y='8' width='22' height='22' fill='%23ff8a3d' rx='3'/><rect x='8' y='34' width='22' height='22' fill='%2380c0ff' rx='3'/><rect x='34' y='34' width='22' height='22' fill='%2300b04b' rx='3'/></svg>"
    />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <MobileNav />
    <TopNav />
    <slot />
    <slot name="bodyEnd" />
  </body>
</html>
