---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import EditionNav from '@/components/EditionNav.astro';
import { CANONICAL_HUB_CSS } from '@/lib/canonical/hub';
import { siteConfig } from '@/site/config';
import { stringifyJsonLd } from '@/lib/json-for-script';
const canonical = `${siteConfig.origin}/pro`;
const jsonLd = stringifyJsonLd({ '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: 'Pro | 未来の仕事', description: 'Pro', inLanguage: 'ja', isPartOf: { '@id': `${siteConfig.origin}/#website` }, breadcrumb: { '@id': `${canonical}#breadcrumb` } },
  { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: '未来の仕事', item: `${siteConfig.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Pro', item: canonical },
  ] },
] });
---
<BaseLayout title="Pro | 未来の仕事" description="Pro" canonical={canonical}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={CANONICAL_HUB_CSS} />
  <div id="wrapper">
    <EditionNav ordinaryPath="/" />
    <header id="content"><h1>Pro</h1></header>
    <p><a href="/pro/rankings">職業ランキング</a></p>
    <p><a href="/map">職業マップ</a></p>
    <Footer />
  </div>
</BaseLayout>
