---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { OCCUPATION_COUNT } from '@/site/config';
import { ENTRY_PATHS_CONFIGS } from '@/views/genre-configs';
import { loadAllDetails, buildGenreResult, buildGenreIndexSpotlight } from '@/views/genre-hub';
import { renderGenreIndexJsonLd, renderGenreHubIndexCards, renderGenreIndexSpotlight, GENRE_HUB_CSS } from '@/templates/Hub';

const details = loadAllDetails();
const n = ENTRY_PATHS_CONFIGS.length;
const cards = ENTRY_PATHS_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return {
    slug: cfg.slug, short_ja: cfg.short_ja, description_ja: cfg.description_ja,
    count: r.items.length, top: r.items[0]?.name_ja ?? '',
    countLabel: `TOP ${r.items.length} 職業`,
  };
});

const canonical = 'https://mirai-shigoto.com/entry-paths';
const title = `入職経路から職業を探す｜新卒/中途/バイト出身/独立 ${n} hub | 未来の仕事`;
const seoDesc = '入職経路 (新卒採用・中途採用・バイト出身・独立開業) で職業 TOP 30 を一覧。自分のキャリア起点に合う仕事を探せます。';
const jsonLd = renderGenreIndexJsonLd(canonical, '入職経路から探す', seoDesc);
const cardsHtml = renderGenreHubIndexCards(cards, 'entry-paths');
const spotlightHtml = renderGenreIndexSpotlight(buildGenreIndexSpotlight(details, ENTRY_PATHS_CONFIGS, 12));
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=entry-paths" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>入職経路から探す</span></nav>
    <header id="content">
      <h1><span class="accent">入職経路から職業を探す</span></h1>
      <p class="sub">入職経路 <strong>{n} 軸</strong> で {OCCUPATION_COUNT.SCORED} 職業を分類</p>
      <p class="intro">新卒一括採用・中途転職・バイトからの正社員化・独立開業など、入職経路の典型パターン別に職業を一覧。自分のキャリア起点に合う仕事を探せます。</p>
    </header>
    <section><h2>入職経路 {n} 分類</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Fragment set:html={spotlightHtml} />
    <Footer />
  </div>
</BaseLayout>
