---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { EMPLOYMENT_CONFIGS } from '../../../views/genre-configs';
import { loadAllDetails, buildGenreResult } from '../../../views/genre-hub';
import { renderGenreIndexJsonLd, renderGenreHubIndexCards, GENRE_HUB_CSS } from '../../../templates/Hub';

const details = loadAllDetails();
const cards = EMPLOYMENT_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return {
    slug: cfg.slug, short_ja: cfg.short_ja, description_ja: cfg.description_ja,
    count: r.items.length, top: r.items[0]?.name_ja ?? '',
    countLabel: `TOP ${r.items.length} 職業`,
  };
});

const canonical = 'https://mirai-shigoto.com/ja/employment-types';
const title = '雇用形態から職業を探す｜正社員/フリーランス/パート/公務員 4 hub | 未来の仕事';
const seoDesc = '雇用形態 (正社員・フリーランス・パート派遣・公務員) で職業 TOP 30 を一覧。安定 vs 自由のトレードオフから自分に合う雇用を探せます。';
const jsonLd = renderGenreIndexJsonLd(canonical, '雇用形態から探す', seoDesc);
const cardsHtml = renderGenreHubIndexCards(cards, 'employment-types');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=employment-types" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>雇用形態から探す</span></nav>
    <header id="content">
      <h1><span class="accent">雇用形態から職業を探す</span></h1>
      <p class="sub">雇用形態 <strong>4 軸</strong> で 552 職業を分類</p>
      <p class="intro">正社員・フリーランス・パート派遣・公務員などの雇用形態別に、それぞれの比率が高い職業を一覧。安定性 vs 自由度のトレードオフから選択できます。</p>
    </header>
    <section><h2>雇用形態 4 分類</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
