---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { EDUCATION_CONFIGS } from '../../../data/lib/genre-configs';
import { loadAllDetails, buildGenreResult, escapeHtml, renderGenreIndexJsonLd, GENRE_HUB_CSS } from '../../../data/lib/genre-hub';

const details = loadAllDetails();
const cards = EDUCATION_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return { cfg, count: r.items.length, top: r.items[0]?.name_ja ?? '' };
});

const canonical = 'https://mirai-shigoto.com/ja/education';
const title = '学歴から職業を探す｜6 学歴別 hub | 未来の仕事';
const seoDesc = '学歴別 (高卒未満/高卒/専門/大卒/院卒/生涯学習) で職業 TOP 30 を一覧。学歴ハードルから自分に合う職業を探せます。';
const jsonLd = renderGenreIndexJsonLd(canonical, '学歴から探す', seoDesc);
const cardsHtml = cards.map((c) =>
  `<li><a href="/ja/education/${c.cfg.slug}">` +
  `<span class="gci-name">${escapeHtml(c.cfg.short_ja)}</span>` +
  `<span class="gci-desc">${escapeHtml(c.cfg.description_ja.slice(0, 90))}…</span>` +
  (c.top ? `<span class="iri-preview">🥇 ${escapeHtml(c.top)}</span>` : '') +
  `<span class="gci-count">TOP ${c.count} 職業</span>` +
  `</a></li>`
).join('');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=education" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>学歴から探す</span></nav>
    <header id="content">
      <h1><span class="accent">学歴から職業を探す</span></h1>
      <p class="sub">学歴 <strong>6 段階</strong> 別に 552 職業を分類</p>
      <p class="intro">高卒未満から大学院卒まで、学歴別に向く職業を一覧。各 hub で TOP 30 職業を AI 影響度・年収と共に確認できます。</p>
    </header>
    <section><h2>学歴 6 分類</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
