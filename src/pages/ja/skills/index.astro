---
/**
 * src/pages/ja/skills/index.astro — スキル別 hub の index page。
 *
 * 10 個の主要スキルを card grid で表示。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { buildSkillsBundle } from '../../../views/skills-hub';
import { renderHubJsonLd, renderSkillsHubCards } from '../../../templates/SkillHub';
import { loadGraph } from '@/graph';
import { makeSkillRankingLoaderFromGraph, makeTreemapSummaryFromGraph } from '@/views/skill';

const graph = await loadGraph();
const { hub } = buildSkillsBundle({
  skillRanking: makeSkillRankingLoaderFromGraph(graph),
  treemap: makeTreemapSummaryFromGraph(graph),
});
const canonical = 'https://mirai-shigoto.com/ja/skills';
const title = 'スキルから職業を探す｜10 のスキル別に 556 職業を整理 | 未来の仕事';
const seoDesc =
  '批判的思考・問題解決・対人感受性・プログラミング等、IPD 39 スキル軸から選んだ 10 の主要スキル別に職業 TOP 30 を AI 影響度・年収と共に一覧。';
const keywords = 'スキル別 職業, 適職, スキル 仕事, 仕事 適性, 556 職業';

const cardsHtml = renderSkillsHubCards(hub.cards);
const jsonLd = renderHubJsonLd();
---
<BaseLayout
  title={title}
  description={seoDesc}
  canonical={canonical}
  keywords={keywords}
  ogImage="https://mirai-shigoto.com/api/og?page=skills"
  ogTitle={title}
  ogDescription={seoDesc}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={`
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}
body{background:var(--bg);color:var(--fg);font-family:var(--font-sans);line-height:1.65}
a{color:var(--accent-deep);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
a:hover{color:var(--accent)}
#wrapper{max-width:980px;margin:0 auto;padding:32px 20px 80px}
.crumb{font-size:.85rem;color:var(--fg2);margin-bottom:24px}
.crumb a{color:var(--fg2)}
.crumb span[aria-hidden]{margin:0 8px;color:var(--fg3)}
header{margin-bottom:32px;border-bottom:1px solid var(--border);padding-bottom:24px}
h1{font-family:var(--font-serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:600;line-height:1.25;color:var(--fg);margin-bottom:12px}
h1 .accent{color:var(--accent-deep)}
.sub{color:var(--fg2);font-size:.95rem}
.sub strong{color:var(--accent-deep);font-weight:600}
.intro{margin:24px 0;color:var(--fg);font-size:1.05rem;max-width:64ch}
section{margin:48px 0}
h2{font-family:var(--font-serif);font-size:1.35rem;font-weight:600;color:var(--fg);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.skill-cards{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;padding:0;margin:0;grid-auto-rows:1fr}
.skill-cards li{display:flex}
.skill-cards li a{display:flex;flex-direction:column;padding:22px 22px 18px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;text-decoration:none;color:var(--fg);transition:border-color 150ms,transform 150ms;min-height:180px;height:100%;width:100%}
.skill-cards li a:hover{border-color:var(--accent);transform:translateY(-1px)}
.sci-name{display:block;font-family:var(--font-serif);font-size:1.2rem;font-weight:600;color:var(--accent-deep);margin-bottom:10px}
.sci-desc,.skill-card-desc{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;flex:1;font-size:.86rem;color:var(--fg2);line-height:1.6;margin-bottom:10px}
.sci-preview{display:block;font-size:.78rem;color:var(--accent-deep);margin-bottom:6px;font-weight:500}
.sci-count{font-size:.78rem;color:var(--fg3);font-variant-numeric:tabular-nums}
@media (max-width:600px){#wrapper{padding:20px 16px 60px}h1{font-size:1.5rem}}
`} />

  <div id="wrapper">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">未来の仕事</a>
      <span aria-hidden="true">›</span>
      <span>スキルから探す</span>
    </nav>

    <header id="content">
      <h1><span class="accent">スキルから職業を探す</span></h1>
      <p class="sub">IPD 39 スキル軸から <strong>10 の主要スキル</strong> を hub 化、556 職業を整理</p>
      <p class="intro">
        身につけたいスキル・得意なスキルから、それが活きる職業を探せます。
        各スキルの説明と、IPD スコアが高い職業 TOP 30 を AI 影響度・年収と共に一覧。
      </p>
    </header>

    <section aria-label="スキル一覧">
      <h2>主要スキル 10 選</h2>
      <ul class="skill-cards" set:html={cardsHtml} />
    </section>

    <Footer />
  </div>
</BaseLayout>
