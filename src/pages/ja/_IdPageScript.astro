---
/**
 * src/pages/ja/_IdPageScript.astro — page-local Astro component
 * carrying the per-occupation client-side script.
 *
 * Currently a single responsibility: fire the GA4 `result_view`
 * event with occupation_id + ai_risk_score + risk_tier on page
 * load. Wraps a single `<script slot="bodyEnd" is:inline>` tag.
 *
 * History: the v1 [id] page also carried theme-toggle and
 * follow/share handlers, but the theme toggle is forced
 * `display:none` by _id-css.ts and the share buttons live in
 * the canonical <Footer /> component (the v2 design's
 * `.follow-share-section-DELETED-v2` div was dead UI long
 * before this cleanup). Both handlers have been removed; if a
 * future page-level button needs JS, add it here.
 *
 * Astro `_`-prefix → not routed; component-only.
 */

interface Props {
  readonly occId: number;
  readonly riskScoreJs: number | null;
  readonly riskTierJs: 'high' | 'mid' | 'low';
}

const { occId, riskScoreJs, riskTierJs } = Astro.props;
---
<script slot="bodyEnd" is:inline define:vars={{ occId, riskScoreJs, riskTierJs }}>
    // Per-occupation page-view signal for the GA4 conversion funnel.
    try { if (typeof gtag === 'function') gtag('event', 'result_view', { occupation_id: occId, ai_risk_score: riskScoreJs, risk_tier: riskTierJs, language: 'ja' }); } catch (e) {}
  </script>
