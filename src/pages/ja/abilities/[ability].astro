---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { ABILITIES_CONFIGS } from '../../../data/lib/genre-configs';
import {
  loadAllDetails,
  buildGenreResult,
  renderRankItem,
  renderHighlights,
  renderSectorChart,
  renderFaqHtml,
  renderGenreJsonLd,
  escapeHtml,
  GENRE_HUB_CSS,
} from '../../../data/lib/genre-hub';
import { buildLinkRegistry, inlineLinkText } from '../../../data/lib/inline-links';
import { renderRelatedHubsBlock, RELATED_CROSS_HUB_CSS } from '../../../data/lib/hub-hub-graph';

export async function getStaticPaths() {
  // Step 4 (partial): the abilities-hub detail records are derived directly
  // from the knowledge graph rather than loading public/data.detail/*.json.
  // genre-hub.buildGenreResult still operates on the legacy DetailFileMin
  // shape — the adapter at src/views/hub.ts produces that shape from graph.
  const { loadGraph } = await import('@/graph');
  const { loadGraphAdaptedDetails } = await import('@/views/hub');
  const { buildGenreResult: _build } = await import('../../../data/lib/genre-hub');
  const { ABILITIES_CONFIGS: _cfgs } = await import('../../../data/lib/genre-configs');
  const graph = await loadGraph();
  const details = loadGraphAdaptedDetails(graph);
  return _cfgs.map((cfg) => {
    const result = _build(details, cfg);
    return { params: { ability: cfg.slug }, props: { result } };
  });
}

const { result } = Astro.props;
const cfg = result.config;
const canonical = `https://mirai-shigoto.com/ja/abilities/${cfg.slug}`;
const title = `${cfg.title_ja}｜TOP ${result.items.length}・AI 影響度付き【2026 年版】 | 未来の仕事`;
const seoDesc = `${cfg.short_ja}スコアが高い職業 TOP ${result.items.length}。${cfg.description_ja.slice(0, 80)}…`;

const statsHtml = result.stats.length > 0
  ? `<dl class="stats">${result.stats.map(([l, v]) => `<div><dt>${escapeHtml(l)}</dt><dd>${escapeHtml(v)}</dd></div>`).join('')}</dl>`
  : '';
const highlightsHtml = renderHighlights(result.highlights);
const sectorChartHtml = renderSectorChart(result.sectorBreakdown, `セクター内訳（TOP${result.items.length}）`);
const rankItems = result.items.map((o) => renderRankItem(o, cfg.short_ja)).join('');
const faqHtml = renderFaqHtml(result.faqItems);
const jsonLd = renderGenreJsonLd(canonical, cfg, result.items, seoDesc, result.faqItems, 'abilities', '能力から探す');

function listOfStrings(items: ReadonlyArray<string>, cls: string): string {
  const lis = items.map((s) => '<li>' + escapeHtml(s) + '</li>').join('');
  return '<ul class="' + cls + '">' + lis + '</ul>';
}
const charsHtml = cfg.characteristics_ja ? listOfStrings(cfg.characteristics_ja, 'characteristics') : '';
const developHtml = cfg.how_to_develop_ja ? listOfStrings(cfg.how_to_develop_ja, 'how-to-develop') : '';

const _linkRegistry = buildLinkRegistry();
const introHtml = inlineLinkText(cfg.description_ja, _linkRegistry, { maxLinks: 5 });
const crossHubHtml = renderRelatedHubsBlock('abilities', cfg.slug, 6);

const relatedHtml = '<ul class="related-genre">' + ABILITIES_CONFIGS
  .filter((m) => m.slug !== cfg.slug)
  .map((m) => `<li><a href="/ja/abilities/${m.slug}"><span class="rg-name">${escapeHtml(m.short_ja)}</span><span class="rg-desc">${escapeHtml(m.description_ja.slice(0, 60))}…</span></a></li>`)
  .join('') + '</ul>';
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage={`https://mirai-shigoto.com/api/og?ability=${cfg.slug}`} ogTitle={title.slice(0, 120)} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/ja/abilities" rel="up">能力から探す</a><span aria-hidden="true">›</span><span>{cfg.short_ja}</span></nav>
    <header id="content">
      <h1><span class="accent">{cfg.title_ja}</span></h1>
      <p class="sub">IPD <strong>{cfg.short_ja}</strong> スコアが高い職業 TOP {result.items.length}（全 552 職業中）</p>
      <p class="intro" set:html={introHtml}></p>
    </header>
    {(charsHtml || developHtml) && (
      <section class="genre-detail" aria-label={`${cfg.short_ja}とは`}>
        <h2>{cfg.short_ja}とは</h2>
        <p set:html={introHtml}></p>
        <div class="genre-detail-grid">
          {charsHtml && <div><h3>こんな特徴がある人</h3><Fragment set:html={charsHtml} /></div>}
          {developHtml && <div><h3>鍛え方のヒント</h3><Fragment set:html={developHtml} /></div>}
        </div>
      </section>
    )}
    <Fragment set:html={statsHtml} />
    <Fragment set:html={highlightsHtml} />
    <Fragment set:html={sectorChartHtml} />
    <section aria-label={`TOP ${result.items.length} 職業`}>
      <h2>{cfg.short_ja} TOP {result.items.length}（IPD スコア降順）</h2>
      <ol class="rank-list" set:html={rankItems} />
    </section>
    <Fragment set:html={faqHtml} />
    <Fragment set:html={crossHubHtml} />
    <section aria-label="他の能力"><h2>他の能力</h2><Fragment set:html={relatedHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
