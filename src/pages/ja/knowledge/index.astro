---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { KNOWLEDGE_CONFIGS } from '../../../views/genre-configs';
import { loadAllDetails, buildGenreResult } from '../../../views/genre-hub';
import { renderGenreIndexJsonLd, renderGenreHubIndexCards, GENRE_HUB_CSS } from '../../../templates/Hub';

const details = loadAllDetails();
const n = KNOWLEDGE_CONFIGS.length;
const cards = KNOWLEDGE_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return {
    slug: cfg.slug, short_ja: cfg.short_ja, description_ja: cfg.description_ja,
    count: r.items.length, top: r.items[0]?.name_ja ?? '',
    countLabel: `TOP ${r.items.length} 職業`,
  };
});

const canonical = 'https://mirai-shigoto.com/ja/knowledge';
const title = `知識から職業を探す｜IPD 知識領域別 ${n} hub | 未来の仕事`;
const seoDesc = 'IPD 33 知識領域から、各知識を活かす職業 TOP 30 を一覧。生産・顧客サービス・機械・医学・数学等。';
const jsonLd = renderGenreIndexJsonLd(canonical, '知識から探す', seoDesc);
const cardsHtml = renderGenreHubIndexCards(cards, 'knowledge');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=knowledge" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>知識から探す</span></nav>
    <header id="content">
      <h1><span class="accent">知識から職業を探す</span></h1>
      <p class="sub">IPD <strong>33 知識領域</strong> から主要 {n} を hub 化、556 職業を整理</p>
      <p class="intro">専門知識領域から、それを活かす職業を探せます。生産・顧客サービス・機械・医学・数学などの代表的知識領域別に、TOP 30 職業を一覧。</p>
    </header>
    <section><h2>主要 {n} 知識領域</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
