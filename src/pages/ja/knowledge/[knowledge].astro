---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { KNOWLEDGE_CONFIGS } from '../../../views/genre-configs';
import {
  loadAllDetails, buildGenreResult, renderRankItem, renderHighlights,
  renderSectorChart, renderFaqHtml, renderGenreJsonLd, escapeHtml, GENRE_HUB_CSS,
} from '../../../views/genre-hub';
import { buildLinkRegistry, inlineLinkText } from '../../../views/inline-links';
import { renderRelatedHubsBlock, RELATED_CROSS_HUB_CSS } from '../../../views/hub-hub-graph';

export async function getStaticPaths() {
  // Step 4 (partial): detail records derived directly from the knowledge graph.
  const { loadGraph } = await import('@/graph');
  const { loadGraphAdaptedDetails } = await import('@/views/hub');
  const { buildGenreResult: _b } = await import('../../../views/genre-hub');
  const { KNOWLEDGE_CONFIGS: _c } = await import('../../../views/genre-configs');
  const graph = await loadGraph();
  const details = loadGraphAdaptedDetails(graph);
  return _c.map((cfg) => ({ params: { knowledge: cfg.slug }, props: { result: _b(details, cfg) } }));
}

const { result } = Astro.props;
const cfg = result.config;
const canonical = `https://mirai-shigoto.com/ja/knowledge/${cfg.slug}`;
const title = `${cfg.title_ja}｜TOP ${result.items.length}・AI 影響度付き【2026 年版】 | 未来の仕事`;
const seoDesc = `${cfg.short_ja}スコアが高い職業 TOP ${result.items.length}。${cfg.description_ja.slice(0, 80)}…`;

const statsHtml = result.stats.length > 0
  ? `<dl class="stats">${result.stats.map(([l, v]) => `<div><dt>${escapeHtml(l)}</dt><dd>${escapeHtml(v)}</dd></div>`).join('')}</dl>` : '';
const highlightsHtml = renderHighlights(result.highlights);
const sectorChartHtml = renderSectorChart(result.sectorBreakdown, `セクター内訳（TOP${result.items.length}）`);
const rankItems = result.items.map((o) => renderRankItem(o, cfg.short_ja)).join('');
const faqHtml = renderFaqHtml(result.faqItems);
const jsonLd = renderGenreJsonLd(canonical, cfg, result.items, seoDesc, result.faqItems, 'knowledge', '知識から探す');

const _linkRegistry = buildLinkRegistry();
const introHtml = inlineLinkText(cfg.description_ja, _linkRegistry, { maxLinks: 5 });
const crossHubHtml = renderRelatedHubsBlock('knowledge', cfg.slug, 6);

const relatedHtml = '<ul class="related-genre">' + KNOWLEDGE_CONFIGS
  .filter((m) => m.slug !== cfg.slug)
  .map((m) => `<li><a href="/ja/knowledge/${m.slug}"><span class="rg-name">${escapeHtml(m.short_ja)}</span><span class="rg-desc">${escapeHtml(m.description_ja.slice(0, 60))}…</span></a></li>`)
  .join('') + '</ul>';
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage={`https://mirai-shigoto.com/api/og?knowledge=${cfg.slug}`} ogTitle={title.slice(0, 120)} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/ja/knowledge" rel="up">知識から探す</a><span aria-hidden="true">›</span><span>{cfg.short_ja}</span></nav>
    <header id="content">
      <h1><span class="accent">{cfg.title_ja}</span></h1>
      <p class="sub">IPD <strong>{cfg.short_ja}</strong> スコアが高い職業 TOP {result.items.length}（全 552 職業中）</p>
      <p class="intro" set:html={introHtml}></p>
    </header>
    <Fragment set:html={statsHtml} />
    <Fragment set:html={highlightsHtml} />
    <Fragment set:html={sectorChartHtml} />
    <section><h2>{cfg.short_ja} TOP {result.items.length}</h2><ol class="rank-list" set:html={rankItems} /></section>
    <Fragment set:html={faqHtml} />
    <Fragment set:html={crossHubHtml} />
    <section aria-label="他の知識"><h2>他の知識領域</h2><Fragment set:html={relatedHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
