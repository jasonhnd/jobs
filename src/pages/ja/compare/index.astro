---
/**
 * src/pages/ja/compare/index.astro — 職業比較 hub の index page。
 *
 * 12 個の比較ペアを card grid で表示。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { buildCompareBundle } from '../../../views/compare-hub';
import { renderHubJsonLd, renderCompareHubCards } from '../../../templates/Compare';

const { hub } = buildCompareBundle();
const canonical = 'https://mirai-shigoto.com/ja/compare';
const title = '職業を比較する｜20 ペアの side-by-side 比較・AI 影響度付き | 未来の仕事';
const seoDesc =
  '看護師 vs 訪問介護員、SE vs プログラマー、医療事務 vs 一般事務など、迷いやすい職業ペアを side-by-side で比較。AI 影響度・年収・労働条件・必要スキルを並べて意思決定の助けに。';
const keywords = '職業 比較, 違い, 仕事 選び方, vs, 552 職業';

const cardsHtml = renderCompareHubCards(hub.cards);
const jsonLd = renderHubJsonLd();
---
<BaseLayout
  title={title}
  description={seoDesc}
  canonical={canonical}
  keywords={keywords}
  ogImage="https://mirai-shigoto.com/api/og?page=compare"
  ogTitle={title}
  ogDescription={seoDesc}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={`
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}
body{background:var(--bg);color:var(--fg);font-family:var(--font-sans);line-height:1.65}
a{color:var(--accent-deep);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
a:hover{color:var(--accent)}
#wrapper{max-width:980px;margin:0 auto;padding:32px 20px 80px}
.crumb{font-size:.85rem;color:var(--fg2);margin-bottom:24px}
.crumb a{color:var(--fg2)}
.crumb span[aria-hidden]{margin:0 8px;color:var(--fg3)}
header{margin-bottom:32px;border-bottom:1px solid var(--border);padding-bottom:24px}
h1{font-family:var(--font-serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:600;line-height:1.25;color:var(--fg);margin-bottom:12px}
h1 .accent{color:var(--accent-deep)}
.sub{color:var(--fg2);font-size:.95rem}
.sub strong{color:var(--accent-deep);font-weight:600}
.intro{margin:24px 0;color:var(--fg);font-size:1.05rem;max-width:64ch}
section{margin:48px 0}
h2{font-family:var(--font-serif);font-size:1.35rem;font-weight:600;color:var(--fg);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.compare-cards{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px;padding:0;margin:0;grid-auto-rows:1fr}
.compare-cards li a{display:flex;flex-direction:column;padding:20px 22px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;text-decoration:none;color:var(--fg);transition:border-color 150ms,transform 150ms;height:100%}
.compare-cards li a:hover{border-color:var(--accent);transform:translateY(-1px)}
.cci-title{display:block;font-family:var(--font-serif);font-size:1.1rem;font-weight:600;color:var(--accent-deep);margin-bottom:10px;line-height:1.35}
.cci-pair{display:flex;flex-wrap:nowrap;align-items:center;gap:6px;margin-bottom:10px;font-size:.85rem;overflow:hidden}
.cci-name{font-weight:500;color:var(--fg);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cci-vs{color:var(--fg3);font-size:.78rem;font-weight:600}
.cci-desc{display:-webkit-box;font-size:.82rem;color:var(--fg2);line-height:1.6;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;flex:1}
.risk-pill{display:inline-block;padding:2px 8px;border-radius:12px;font-size:.7rem;font-weight:600;font-variant-numeric:tabular-nums}
.risk-pill.low{background:#E0EAE2;color:#48705F}
.risk-pill.mid{background:#F4E5C7;color:#8A6A2A}
.risk-pill.high{background:#F5D5C7;color:#A24A28}
@media (max-width:600px){#wrapper{padding:20px 16px 60px}h1{font-size:1.5rem}}

/* RA-017 (2026-05-18): interactive 2-occupation comparison tool */
.interactive-compare{background:var(--bg2);padding:24px;border-radius:12px;border:1px solid var(--border);margin-bottom:48px}
.interactive-compare h2{margin-bottom:8px;border-bottom:none;padding-bottom:0;font-size:1.2rem}
.interactive-compare > p{color:var(--fg2);font-size:.9rem;margin-bottom:20px}
#customCompareForm{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:end;margin-bottom:16px}
@media (max-width:600px){#customCompareForm{grid-template-columns:1fr}}
.cc-input{display:flex;flex-direction:column;gap:4px}
.cc-input label{font-size:.78rem;color:var(--fg2);font-weight:600}
.cc-input input{padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:.95rem;font-family:inherit;background:var(--bg);color:var(--fg);min-height:42px}
.cc-input input:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}
.cc-vs{font-family:var(--font-serif);font-weight:700;font-size:1.1rem;color:var(--accent);padding-bottom:10px;align-self:end}
@media (max-width:600px){.cc-vs{display:flex;justify-content:center;padding:0;align-self:stretch;font-size:.78rem;color:var(--fg2)}}
.cc-submit{grid-column:1/-1;padding:12px 24px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:.95rem;font-weight:600;cursor:pointer;min-height:44px;font-family:inherit}
.cc-submit:hover{filter:brightness(1.05)}
.cc-submit:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.cc-loading,.cc-error{padding:16px;text-align:center;color:var(--fg2);font-size:.9rem}
.cc-error{color:#c0411e}
.cc-result{margin-top:18px;overflow-x:auto}
.cc-table{width:100%;border-collapse:collapse;background:var(--bg)}
.cc-table th,.cc-table td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line)}
.cc-table thead th{font-family:var(--font-serif);font-size:1.05rem;color:var(--accent-deep);font-weight:600;border-bottom:2px solid var(--border)}
.cc-table thead th a{color:inherit;text-decoration:none}
.cc-table thead th a:hover{text-decoration:underline}
.cc-table .cc-vs-col{text-align:center;color:var(--fg3);font-size:.78rem;font-weight:400}
.cc-table tbody td:first-child{color:var(--fg2);font-size:.85rem;font-weight:500;width:120px}
.cc-table tbody td{color:var(--fg);font-size:.92rem;font-variant-numeric:tabular-nums}
`} />

  <div id="wrapper">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">未来の仕事</a>
      <span aria-hidden="true">›</span>
      <span>職業を比較する</span>
    </nav>

    <header id="content">
      <h1><span class="accent">職業を比較する</span></h1>
      <p class="sub">迷いやすい職業ペアを <strong>{hub.cards.length} 組</strong> 用意 · side-by-side 比較</p>
      <p class="intro">
        看護師 vs 訪問介護員、SE vs プログラマー、医療事務 vs 一般事務など、
        違いがわかりにくい職業ペアを並べて比較。AI 影響度・年収・労働条件・必要スキルを一覧で確認し、
        自分に合うキャリア選択の助けに。
      </p>
    </header>

    {/* RA-017 (2026-05-18): interactive 2-occupation comparison tool.
        Client-side fetch /data.search.json (~100 KB) for the dropdown,
        then /data.detail/<id>.json for the two selected jobs. URL state
        is mirrored to ?a=&b= so comparisons are bookmarkable. */}
    <section class="interactive-compare" aria-label="自由 2 職業比較">
      <h2>2 つの職業を選んで比較</h2>
      <p>552 職業から自由に 2 つ選び、AI 影響度・年収・労働時間などを並べて確認できます。</p>
      <form id="customCompareForm" role="search">
        <div class="cc-input">
          <label for="ccA">職業 A</label>
          <input type="text" id="ccA" name="a" list="ccOccList" autocomplete="off" placeholder="例: 看護師" />
        </div>
        <div class="cc-vs" aria-hidden="true">VS</div>
        <div class="cc-input">
          <label for="ccB">職業 B</label>
          <input type="text" id="ccB" name="b" list="ccOccList" autocomplete="off" placeholder="例: 訪問介護員" />
        </div>
        <datalist id="ccOccList"></datalist>
        <button type="submit" class="cc-submit">比較する</button>
      </form>
      <div id="customCompareResult" aria-live="polite"></div>
    </section>

    <section aria-label="比較ペア一覧">
      <h2>{hub.cards.length} 組の比較</h2>
      <ul class="compare-cards" set:html={cardsHtml} />
    </section>

    <Footer />
  </div>

  <script is:inline slot="bodyEnd">
    (function () {
      var formA = document.getElementById('ccA');
      var formB = document.getElementById('ccB');
      var form = document.getElementById('customCompareForm');
      var datalist = document.getElementById('ccOccList');
      var result = document.getElementById('customCompareResult');
      if (!form || !result) return;

      var occs = null;
      var nameToId = new Map();

      function padId(n) { return String(n).padStart(4, '0'); }

      function escapeHtml(s) {
        var div = document.createElement('div');
        div.textContent = s || '';
        return div.innerHTML;
      }

      function fmt(v, suffix) {
        if (v === null || v === undefined || v === '') return '—';
        return (typeof v === 'number' ? v.toLocaleString('en-US') : v) + (suffix || '');
      }

      function render(a, b) {
        var rows = [
          ['AI 影響度', (a.ai_risk && a.ai_risk.score != null ? a.ai_risk.score : '—') + ' / 10',
                       (b.ai_risk && b.ai_risk.score != null ? b.ai_risk.score : '—') + ' / 10'],
          ['年収（平均）', fmt(a.stats && a.stats.salary_man_yen && Math.round(a.stats.salary_man_yen), ' 万円'),
                          fmt(b.stats && b.stats.salary_man_yen && Math.round(b.stats.salary_man_yen), ' 万円')],
          ['就業者数', fmt(a.stats && a.stats.workers, ' 人'),
                      fmt(b.stats && b.stats.workers, ' 人')],
          ['月労働時間', fmt(a.stats && a.stats.monthly_hours && Math.round(a.stats.monthly_hours), ' 時間'),
                       fmt(b.stats && b.stats.monthly_hours && Math.round(b.stats.monthly_hours), ' 時間')],
          ['平均年齢', fmt(a.stats && a.stats.average_age, ' 歳'),
                      fmt(b.stats && b.stats.average_age, ' 歳')],
          ['求人倍率', fmt(a.stats && a.stats.recruit_ratio, ''),
                      fmt(b.stats && b.stats.recruit_ratio, '')]
        ];
        var html = '<div class="cc-result"><table class="cc-table"><thead><tr>' +
          '<th scope="col"></th>' +
          '<th scope="col"><a href="/ja/' + a.id + '">' + escapeHtml(a.title.ja) + '</a></th>' +
          '<th scope="col" class="cc-vs-col">vs</th>' +
          '<th scope="col"><a href="/ja/' + b.id + '">' + escapeHtml(b.title.ja) + '</a></th>' +
          '</tr></thead><tbody>';
        rows.forEach(function (r) {
          html += '<tr><td>' + escapeHtml(r[0]) + '</td>' +
                  '<td>' + escapeHtml(r[1]) + '</td>' +
                  '<td class="cc-vs-col" aria-hidden="true"></td>' +
                  '<td>' + escapeHtml(r[2]) + '</td></tr>';
        });
        html += '</tbody></table></div>';
        return html;
      }

      function compare(aId, bId) {
        result.innerHTML = '<p class="cc-loading">読み込み中…</p>';
        Promise.all([
          fetch('/data.detail/' + padId(aId) + '.json').then(function (r) { return r.json(); }),
          fetch('/data.detail/' + padId(bId) + '.json').then(function (r) { return r.json(); })
        ]).then(function (pair) {
          result.innerHTML = render(pair[0], pair[1]);
        }).catch(function () {
          result.innerHTML = '<p class="cc-error">データ取得に失敗しました</p>';
        });
      }

      fetch('/data.search.json').then(function (r) { return r.json(); }).then(function (data) {
        occs = data.documents || [];
        occs.forEach(function (o) {
          var opt = document.createElement('option');
          opt.value = o.title_ja;
          datalist.appendChild(opt);
          nameToId.set(o.title_ja, o.id);
        });
        var params = new URLSearchParams(location.search);
        var ap = params.get('a'), bp = params.get('b');
        if (ap && bp) {
          var aId = parseInt(ap, 10), bId = parseInt(bp, 10);
          var aRec = occs.find(function (o) { return o.id === aId; });
          var bRec = occs.find(function (o) { return o.id === bId; });
          if (aRec && bRec) {
            formA.value = aRec.title_ja;
            formB.value = bRec.title_ja;
            compare(aId, bId);
          }
        }
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var aId = nameToId.get(formA.value);
        var bId = nameToId.get(formB.value);
        if (!aId || !bId) {
          result.innerHTML = '<p class="cc-error">候補リストから職業を選択してください</p>';
          return;
        }
        if (aId === bId) {
          result.innerHTML = '<p class="cc-error">異なる 2 つの職業を選択してください</p>';
          return;
        }
        var url = new URL(location.href);
        url.searchParams.set('a', aId);
        url.searchParams.set('b', bId);
        history.replaceState(null, '', url);
        compare(aId, bId);
      });
    })();
  </script>
</BaseLayout>
