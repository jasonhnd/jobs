---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { WORK_STYLES_CONFIGS } from '../../../views/genre-configs';
import { loadAllDetails, buildGenreResult, escapeHtml, renderGenreIndexJsonLd, GENRE_HUB_CSS } from '../../../views/genre-hub';

const details = loadAllDetails();
const cards = WORK_STYLES_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return { cfg, count: r.items.length, top: r.items[0]?.name_ja ?? '' };
});

const canonical = 'https://mirai-shigoto.com/ja/work-styles';
const title = '働き方から職業を探す｜業務形態 7 軸別 hub | 未来の仕事';
const seoDesc = '屋内/屋外・移動・シフト・チームなど、働き方の特性で職業を分類。自分のライフスタイルに合う仕事を探せます。';
const jsonLd = renderGenreIndexJsonLd(canonical, '働き方から探す', seoDesc);
const cardsHtml = cards.map((c) =>
  `<li><a href="/ja/work-styles/${c.cfg.slug}">` +
  `<span class="gci-name">${escapeHtml(c.cfg.short_ja)}</span>` +
  `<span class="gci-desc">${escapeHtml(c.cfg.description_ja.slice(0, 90))}…</span>` +
  (c.top ? `<span class="iri-preview">1位 ${escapeHtml(c.top)}</span>` : '') +
  `<span class="gci-count">TOP ${c.count} 職業</span>` +
  `</a></li>`
).join('');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=work-styles" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>働き方から探す</span></nav>
    <header id="content">
      <h1><span class="accent">働き方から職業を探す</span></h1>
      <p class="sub">業務形態 <strong>7 軸</strong> で 552 職業を分類</p>
      <p class="intro">屋外/屋内・移動の多さ・シフト勤務・チーム作業・座り仕事など、働き方の特性で職業を整理しました。ライフスタイルとの相性で職業を選びたい人向け。</p>
    </header>
    <section><h2>働き方 7 軸</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
