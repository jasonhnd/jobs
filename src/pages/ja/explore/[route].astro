---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { EXPLORE_ROUTES, type ExploreRoute } from '../../../views/explore-routes';
import {
  GENRE_HUB_CSS, renderExploreGenreCards, renderExploreOtherRoutes,
  renderExploreSlugJsonLd,
} from '../../../templates/Hub';

export async function getStaticPaths() {
  return EXPLORE_ROUTES.map((route) => ({ params: { route: route.slug }, props: { route } }));
}

interface Props { route: ExploreRoute; }
const { route } = Astro.props as Props;

const canonical = `https://mirai-shigoto.com/ja/explore/${route.slug}`;
const title = `${route.title_ja} | 未来の仕事`;
const seoDesc = route.description_ja;
const genreCardsHtml = renderExploreGenreCards(route.genres);
const jsonLd = renderExploreSlugJsonLd(route.slug, route.title_ja, seoDesc);
const otherRoutesHtml = renderExploreOtherRoutes(
  EXPLORE_ROUTES.filter((r) => r.slug !== route.slug),
);
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage={`https://mirai-shigoto.com/api/og?route=${route.slug}`} ogTitle={title.slice(0, 120)} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/ja/explore" rel="up">探す方法</a><span aria-hidden="true">›</span><span>{route.short_ja}</span></nav>
    <header id="content">
      <h1><span class="accent">{route.title_ja}</span></h1>
      <p class="sub">{route.short_ja} の入口</p>
      <p class="intro">{route.intro_ja}</p>
    </header>
    <section><h2>{route.short_ja} に含まれる入口</h2><ul class="genre-cards" set:html={genreCardsHtml} /></section>
    <section><h2>他の探し方</h2><Fragment set:html={otherRoutesHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
