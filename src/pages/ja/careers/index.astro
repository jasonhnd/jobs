---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { CAREER_PERSONAS } from '../../../views/careers-meta';
import { loadAllDetails, escapeHtml, renderGenreIndexJsonLd, GENRE_HUB_CSS } from '../../../data/lib/genre-hub';

const details = loadAllDetails();
const cards = CAREER_PERSONAS.map((p) => {
  const matched = details.map((d) => ({ d, score: p.recommend(d) })).filter((x) => x.score !== null);
  matched.sort((a, b) => (b.score as number) - (a.score as number));
  const top = matched[0]?.d?.title?.ja ?? '';
  return { p, count: Math.min(30, matched.length), top };
});

const canonical = 'https://mirai-shigoto.com/ja/careers';
const title = 'キャリア段階から職業を探す｜10 persona 別おすすめ | 未来の仕事';
const seoDesc = '新卒・20-50代転職・シニア・主婦復職・キャリアチェンジ等、10 persona 別におすすめ職業 TOP 30 を一覧。年代・状況別の現実的な選択肢。';
const jsonLd = renderGenreIndexJsonLd(canonical, 'キャリア段階から探す', seoDesc);
const cardsHtml = cards.map((c) =>
  `<li><a href="/ja/careers/${c.p.slug}">` +
  `<span class="gci-name">${escapeHtml(c.p.short_ja)}</span>` +
  `<span class="gci-desc">${escapeHtml(c.p.description_ja.slice(0, 100))}…</span>` +
  (c.top ? `<span class="iri-preview">1位 ${escapeHtml(c.top)}</span>` : '') +
  `<span class="gci-count">推薦 TOP ${c.count} 職業</span>` +
  `</a></li>`
).join('');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=careers" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>キャリア段階から探す</span></nav>
    <header id="content">
      <h1><span class="accent">キャリア段階から職業を探す</span></h1>
      <p class="sub"><strong>{CAREER_PERSONAS.length} persona</strong> 別におすすめ職業を整理</p>
      <p class="intro">年代・キャリア段階・ライフ状況別に、その時期に現実的な職業選択肢を一覧。新卒から シニアまで、自分の今のステージに合うキャリア候補を確認できます。</p>
    </header>
    <section><h2>{CAREER_PERSONAS.length} 個の persona</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
