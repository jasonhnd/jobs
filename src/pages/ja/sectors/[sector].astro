---
/**
 * src/pages/ja/sectors/[sector].astro — per-sector hub page (16 routes).
 *
 * Step 2 migration: data flows through src/views/sector.sectorDetailView()
 * which queries the knowledge graph. The legacy data.detail/*.json files
 * are still produced by build:data and read by other surfaces (OG endpoint,
 * etc.), but this page no longer touches them.
 *
 * Inline CSS preserved verbatim from the v1.x design.
 *
 * Rendering helpers (sector-meta.ts, inline-links.ts, hub-hub-graph.ts) still
 * live under src/data/lib/. They'll be migrated to src/views/ + src/templates/
 * in later steps; for now they remain pure-data callees the view + page both
 * delegate to.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { loadGraph } from '@/graph';
import { sectorDetailView, type SectorOccupationSummary } from '@/views/sector';
import { getSectorEssay, computeSectorPatterns, computeSiteBaseline, type SectorOcc } from '../../../data/lib/sector-meta';
import { buildLinkRegistry, inlineLinkText } from '../../../data/lib/inline-links';
import { renderRelatedHubsBlock, RELATED_CROSS_HUB_CSS } from '../../../data/lib/hub-hub-graph';
import { escapeHtml as esc } from '@/lib/safe-html';
import { fmtInt } from '@/lib/num';
import { riskClass as riskBandFromScore } from '@/lib/risk';
import { buildSectorFaqs } from '@/data/lib/sector-faqs';
import { renderSectorJsonLd } from '@/templates/SectorJsonLd';
import { renderOccFaq } from '@/templates/OccFaq';
import {
  renderSectorOccupationTopList,
  renderSectorOccupationFullList,
  renderRelatedSectorsList,
} from '@/templates/SectorListings';
import { renderSectorPatterns } from '@/templates/SectorPatterns';
import { SECTOR_PAGE_CSS } from './_sector-css';

const SITE = 'https://mirai-shigoto.com';
const TOP_N = 5;
const DATE_PUBLISHED = '2026-05-05';
const DATE_MODIFIED = '2026-05-09';

// fmtInt + riskBandFromScore (alias of riskClass) imported from @/lib/num + @/lib/risk above.
// FAQ Q/A pairs come from buildSectorFaqs (see src/data/lib/sector-faqs).

/** Convert the view's camelCase summary into the snake_case shape that
 *  sector-meta.ts helpers expect. */
function toSectorOcc(o: SectorOccupationSummary): SectorOcc {
  return {
    id: o.id as unknown as number,
    title_ja: o.titleJa,
    ai_risk: o.aiRisk,
    workers: o.workers,
    salary: o.salary,
    monthly_hours: o.monthlyHours,
    average_age: o.averageAge,
    recruit_ratio: o.recruitRatio,
  };
}

export async function getStaticPaths() {
  const graph = await loadGraph();
  const sectorIds = [...graph.sectors.keys()];
  return sectorIds.map((sectorId) => ({
    params: { sector: sectorId as unknown as string },
    props: {
      view: sectorDetailView(graph, sectorId),
    },
  }));
}

interface Props {
  view: ReturnType<typeof sectorDetailView>;
}

const { view } = Astro.props as Props;
const sector = view.sector;
const occs = view.occupations;
const allOccs = view.allOccupations;
const relatedSectors = view.relatedSectors;

// ── Phase 2: AI 時代エッセイ + データから見えるパターン ──
const sectorEssay = getSectorEssay(sector.id as unknown as string);
const allSectorOccs: SectorOcc[] = allOccs.map(toSectorOcc);
const baseline = computeSiteBaseline(allSectorOccs);
const sectorOccsForPattern: SectorOcc[] = occs.map(toSectorOcc);
const patterns = computeSectorPatterns(sectorOccsForPattern, baseline, sector.nameJa);

const sid = sector.id as unknown as string;
const nameLoc = sector.nameJa;
const descIntro = sector.descriptionJa ?? '';
const canonical = `${SITE}/ja/sectors/${sid}`;
const n = occs.length;

const workforceTotal = occs.reduce((s, o) => s + (o.workers || 0), 0);
const risks = occs.map((o) => o.aiRisk).filter((x): x is number => x !== null && x !== undefined);
const meanRisk: number | null = risks.length ? risks.reduce((a, b) => a + b, 0) / risks.length : null;

// Sort occupations matching legacy: -workers desc tiebreak by id asc, take top 3 titles.
const sortedByWorkers = [...occs].sort((a, b) => {
  const wb = b.workers || 0;
  const wa = a.workers || 0;
  if (wb !== wa) return wb - wa;
  return (a.id as unknown as number) - (b.id as unknown as number);
});
const sampleTitles: string[] = [];
for (const o of sortedByWorkers.slice(0, 3)) {
  if (o.titleJa) sampleTitles.push(o.titleJa);
}
const samplesStr = sampleTitles.join(' / ');

const title = `${nameLoc}の職業一覧 — ${n}職業｜AI 影響度ランキング・年収・就業者数 | 未来の仕事`;
const ogTitle = `${nameLoc}の職業一覧 — ${n}職業｜AI 影響度ランキング`;
const seoDesc =
  `${nameLoc} 業界の${n}職業をAI影響度・年収・就業者数で一覧。` +
  `代表職業：${samplesStr}。Claude Opus 4.7 による独自分析（非公式）。`;

const crumbRoot = '未来の仕事';
const crumbSectors = 'セクター';
const skipLabel = '本文へスキップ';
const h1Main = `${nameLoc}の職業`;
const subText =
  `<strong>${n} 職業</strong>` +
  (meanRisk !== null ? ` · 平均 AI 影響 <strong>${meanRisk.toFixed(1)}/10</strong>` : '') +
  ` · 就業者数 計 <strong>${fmtInt(workforceTotal)}</strong> 人`;

const hHigh = `${nameLoc} の AI 影響 が高い職業 TOP 5`;
const hLow = `${nameLoc} の AI 影響 が低い職業 TOP 5`;
const hPop = `${nameLoc} の 就業者数 TOP 5`;
const hFull = `${nameLoc} の全 ${n} 職業（AI 影響度 高い順）`;
const hRelated = '他のセクター';

// Sort by ai_risk desc, then top high / top low / top workers (matching legacy).
const occsWithRisk = occs.filter((o) => o.aiRisk !== null && o.aiRisk !== undefined);
const sortedByRiskDesc = [...occsWithRisk].sort((a, b) => (b.aiRisk as number) - (a.aiRisk as number));
const topHigh = sortedByRiskDesc.slice(0, TOP_N);
const topLow = [...sortedByRiskDesc].reverse().slice(0, TOP_N);
const topWorkers = occs
  .filter((o) => o.workers)
  .sort((a, b) => (b.workers as number) - (a.workers as number))
  .slice(0, TOP_N);

// Full list: sort by -ai_risk (-1 if null) then id asc — matches legacy.
const fullSorted = [...occs].sort((a, b) => {
  const ar = -(a.aiRisk ?? -1);
  const br = -(b.aiRisk ?? -1);
  if (ar !== br) return ar - br;
  return (a.id as unknown as number) - (b.id as unknown as number);
});

const keywordsList: string[] = [nameLoc];
for (const t of sampleTitles) keywordsList.push(t);
keywordsList.push(`${nameLoc} 仕事`, `${nameLoc} 職業`, `${nameLoc} AI 影響`);
const keywordsStr = keywordsList.join(', ');

// Build FAQs — single source of truth in src/data/lib/sector-faqs.
const faqs = buildSectorFaqs({
  nameJa: nameLoc,
  occupationCount: n,
  workforceTotal,
  meanRisk,
  topWorkers: topWorkers.map((o) => ({ titleJa: o.titleJa, aiRisk: o.aiRisk })),
  topHigh: topHigh.map((o) => ({ titleJa: o.titleJa, aiRisk: o.aiRisk })),
  topLow: topLow.map((o) => ({ titleJa: o.titleJa, aiRisk: o.aiRisk })),
});

// JSON-LD — single source of truth in src/templates/SectorJsonLd.
const jsonLd = renderSectorJsonLd({
  canonical,
  nameJa: nameLoc,
  sectorId: sid,
  siteOrigin: SITE,
  occupationCount: n,
  occupations: fullSorted.map((o) => ({
    id: o.id as unknown as number,
    titleJa: o.titleJa,
  })),
  faqs,
  breadcrumbRoot: crumbRoot,
  breadcrumbSectors: crumbSectors,
  datePublished: DATE_PUBLISHED,
  dateModified: DATE_MODIFIED,
});

const ogImage = `${SITE}/api/og?sector=${sid}`;

// List sections (top / full / related-sectors / FAQ) come from shared
// templates under src/templates/SectorListings + src/templates/OccFaq.
function toListOcc(o: SectorOccupationSummary) {
  return {
    id: o.id as unknown as number,
    titleJa: o.titleJa,
    aiRisk: o.aiRisk,
    workers: o.workers,
  };
}

const topHighHtml = renderSectorOccupationTopList(topHigh.map(toListOcc));
const topLowHtml = renderSectorOccupationTopList(topLow.map(toListOcc));
const topWorkersHtml = renderSectorOccupationTopList(topWorkers.map(toListOcc));
const fullListHtml = renderSectorOccupationFullList(fullSorted.map(toListOcc));
const relatedHtml = renderRelatedSectorsList(
  relatedSectors.map((s) => ({
    id: s.id as unknown as string,
    nameJa: s.ja,
    occupationCount: s.occupationCount,
  })),
);
const faqHtml = renderOccFaq(faqs);

// Phase D: inline-link occupation names mentioned in the intro and AI era essay.
const _linkRegistry = buildLinkRegistry();
const crossHubHtml = renderRelatedHubsBlock('sectors', sid, 6);
const introInlined = descIntro
  ? inlineLinkText(descIntro, _linkRegistry, { maxLinks: 3 })
  : '';
const introSection = introInlined ? `<p class="intro">${introInlined}</p>` : '';

// ── AI 時代の特性 essay block ──
const aiEraEssayInlined = sectorEssay
  ? inlineLinkText(sectorEssay.ai_era_essay_ja, _linkRegistry, { maxLinks: 5 })
  : '';
const aiEraEssayHtml = sectorEssay
  ? `<section class="ai-era-essay" aria-label="AI 時代の特性">
       <h2>AI 時代の${esc(sector.nameJa)}の特性</h2>
       <p>${aiEraEssayInlined}</p>
     </section>`
  : '';

// ── データから見えるパターン (auto-derived 観察) ──
const patternsHtml = renderSectorPatterns({
  aiLowCount: patterns.ai_low_count,
  aiMidCount: patterns.ai_mid_count,
  aiHighCount: patterns.ai_high_count,
  aiLowPct: patterns.ai_low_pct,
  aiMidPct: patterns.ai_mid_pct,
  aiHighPct: patterns.ai_high_pct,
  observations: patterns.observations,
});
---
<BaseLayout
  title={title}
  description={seoDesc}
  canonical={canonical}
  keywords={keywordsStr}
  ogTitle={ogTitle}
  ogDescription={seoDesc}
  ogImage={ogImage}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />

  <style slot="head" set:html={SECTOR_PAGE_CSS} />

  <a class="skip-link" href="#content">{skipLabel}</a>

  <div id="wrapper">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">{crumbRoot}</a>
      <span aria-hidden="true">›</span>
      <a href="/ja/sectors" rel="up">{crumbSectors}</a>
      <span aria-hidden="true">›</span>
      <span>{nameLoc}</span>
    </nav>

    <header id="content">
      <h1>
        <span class="accent">{h1Main}</span>
      </h1>
      <p class="sub" set:html={subText} />
      <Fragment set:html={introSection} />
    </header>

    <section aria-label="セクター概要">
      <dl class="stats">
        <div><dt>職業数</dt><dd>{n}</dd></div>
        <div><dt>平均 AI 影響</dt><dd>{meanRisk === null ? '—' : `${meanRisk.toFixed(1)} / 10`}</dd></div>
        <div><dt>就業者数 合計</dt><dd>{fmtInt(workforceTotal)}</dd></div>
      </dl>
    </section>

    <Fragment set:html={aiEraEssayHtml} />

    <Fragment set:html={patternsHtml} />

    <section aria-label={hHigh}>
      <h2>{hHigh}</h2>
      <Fragment set:html={topHighHtml} />
    </section>

    <section aria-label={hLow}>
      <h2>{hLow}</h2>
      <Fragment set:html={topLowHtml} />
    </section>

    <section aria-label={hPop}>
      <h2>{hPop}</h2>
      <Fragment set:html={topWorkersHtml} />
    </section>

    <section aria-label={hFull}>
      <h2>{hFull}</h2>
      <Fragment set:html={fullListHtml} />
    </section>

    <Fragment set:html={faqHtml} />

    <Fragment set:html={crossHubHtml} />

    <section aria-label={hRelated}>
      <h2>{hRelated}</h2>
      <Fragment set:html={relatedHtml} />
    </section>

    <Footer />
  </div>
</BaseLayout>
