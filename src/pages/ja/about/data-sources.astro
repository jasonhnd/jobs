---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { GENRE_HUB_CSS } from '../../../templates/Hub';

const canonical = 'https://mirai-shigoto.com/ja/about/data-sources';
const title = 'データソース一覧 | 未来の仕事';
const seoDesc = '本サイトが使用するデータの出典: 厚労省 jobtag、JILPT IPD v7.00、賃金構造基本統計調査、労働力調査、ハローワーク求人統計。';

const SITE = 'https://mirai-shigoto.com';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'TechArticle', '@id': `${canonical}#article`, url: canonical, name: title, headline: 'データソース一覧', description: seoDesc, inLanguage: 'ja' },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: '未来の仕事', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '方法論・信頼性', item: `${SITE}/ja/about` },
      { '@type': 'ListItem', position: 3, name: 'データソース', item: canonical },
    ] },
  ],
}, null, 2);
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=data-sources" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={`
.source-section{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:24px;margin:24px 0}
.source-section h2{font-size:1.15rem;color:var(--accent);margin:0 0 14px;padding:0;border:none}
.source-section dl{margin:14px 0}
.source-section dt{font-family:var(--font-serif);color:var(--accent-deep);font-weight:600;margin-top:14px;font-size:.95rem}
.source-section dd{margin:4px 0 0;font-size:.92rem;line-height:1.7;color:var(--fg)}
.source-section a{color:var(--accent-deep)}
`} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/ja/about" rel="up">方法論・信頼性</a><span aria-hidden="true">›</span><span>データソース</span></nav>
    <header id="content">
      <h1><span class="accent">データソース一覧</span></h1>
      <p class="sub">本サイト使用 <strong>全データの出典</strong></p>
      <p class="intro">本サイトの数値データはすべて公的統計および公認データベースに由来します。各ソースの正式名・公開元・利用条件を以下に明示します。</p>
    </header>

    <section class="source-section">
      <h2>1. 職業情報データベース (IPD v7.00)</h2>
      <dl>
        <dt>正式名</dt>
        <dd>『職業情報データベース 解説系/数値系ダウンロードデータ ver.7.00』</dd>
        <dt>公開元</dt>
        <dd>独立行政法人 労働政策研究・研修機構 (JILPT)</dd>
        <dt>分発元</dt>
        <dd>厚生労働省 職業情報提供サイト (job tag) <a href="https://shigoto.mhlw.go.jp/User/" rel="external noopener noreferrer" target="_blank">https://shigoto.mhlw.go.jp/User/</a></dd>
        <dt>含まれる情報</dt>
        <dd>556 職業 × 数百項目: タスク、スキル、知識、能力、興味、価値観、業務特性、学歴分布、雇用形態、関連資格、関連団体等。</dd>
        <dt>本サイトでの利用</dt>
        <dd>すべての職業ページの基礎データ。spoke ページの description、関連資格、scoring 入力等。</dd>
        <dt>利用条件</dt>
        <dd>job tag 利用規約 第 9 条「職業解説 / 職業の数値情報については 編集・加工、再集計等の二次利用が可能」。本サイトは合法的二次利用です。</dd>
      </dl>
    </section>

    <section class="source-section">
      <h2>2. 労働市場統計</h2>
      <dl>
        <dt>賃金構造基本統計調査</dt>
        <dd>厚生労働省。年収・月労働時間・平均年齢のソース。</dd>
        <dt>労働力調査</dt>
        <dd>総務省統計局。就業者数のソース。</dd>
        <dt>ハローワーク求人統計</dt>
        <dd>厚生労働省。求人賃金 (月)・有効求人倍率のソース。</dd>
        <dt>本サイトでの利用</dt>
        <dd>jobtag 経由で取得した時点のスナップショット (2026-04-25 時点) を冷凍保存。新規 IPD 職業 (581-584) は対応データなし。</dd>
      </dl>
    </section>

    <section class="source-section">
      <h2>3. AI 影響度評価</h2>
      <dl>
        <dt>評価モデル</dt>
        <dd>Claude Opus 4.7 (Anthropic)</dd>
        <dt>評価日</dt>
        <dd>2026-04-25 (552 職業を一括評価)</dd>
        <dt>評価方式</dt>
        <dd>各職業に対して single-pass 評価。タスクリスト + IPD profile を入力に、0-10 整数 + 日本語 rationale を出力。</dd>
        <dt>校正</dt>
        <dd>各整数スコアの anchor occupations を固定 (詳細は <a href="/ja/about/methodology">方法論ページ</a>)。</dd>
        <dt>注意</dt>
        <dd>本サイト運営者の独立分析であり、Anthropic、厚労省、JILPT、jobtag による評価ではありません。</dd>
      </dl>
    </section>

    <section class="source-section">
      <h2>4. 表記・引用ルール</h2>
      <p>jobtag 利用規約に従い、本サイト全ページのフッターおよび about ページで以下を明示しています:</p>
      <p><em>「『職業情報データベース 解説系ダウンロードデータ ver.7.00』職業情報提供サイト (job tag) より 2026 年 4 月 25 日にダウンロード」</em></p>
      <p><em>「(https://shigoto.mhlw.go.jp/User/download) を加工して作成」</em></p>
      <p>AI 影響度スコアは「Claude Opus 4.7 による独自分析 (非公式)」と全 spoke ページで明示しています。</p>
    </section>

    <section class="source-section">
      <h2>5. 更新頻度</h2>
      <dl>
        <dt>IPD データ</dt>
        <dd>JILPT が新版を公開した時点で更新 (年 1-2 回程度)。</dd>
        <dt>労働市場統計</dt>
        <dd>jobtag 側の更新時に再爬取。年 1 回が標準。</dd>
        <dt>AI 影響度スコア</dt>
        <dd>新モデル登場時または IPD 大幅更新時に再評価 (半年〜1 年に 1 回)。</dd>
      </dl>
    </section>

    <Footer />
  </div>
</BaseLayout>
