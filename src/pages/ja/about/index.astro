---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { GENRE_HUB_CSS } from '../../../templates/Hub';

const canonical = 'https://mirai-shigoto.com/ja/about';
const title = '方法論・用語・データソース | 未来の仕事';
const seoDesc = '本サイトの AI 影響度評価方法論、用語集、データソースを公開。Claude Opus 4.7 による評価ロジック、IPD v7.00 出典、評価の限界を確認できます。';

const SITE = 'https://mirai-shigoto.com';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: '方法論・信頼性', description: seoDesc, isPartOf: { '@id': `${SITE}/#website` }, inLanguage: 'ja' },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: '未来の仕事', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '方法論・信頼性', item: canonical },
    ] },
  ],
}, null, 2);
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=about-trust" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>方法論・信頼性</span></nav>
    <header id="content">
      <h1><span class="accent">方法論・用語・データソース</span></h1>
      <p class="sub">独自分析の <strong>裏側</strong> を公開</p>
      <p class="intro">本サイトの AI 影響度評価がどう作られているか、用語の定義、データの出典、評価の限界。透明性を重視した独立サイトとして全公開しています。</p>
    </header>
    <section>
      <h2>3 つのドキュメント</h2>
      <ul class="genre-cards">
        <li><a href="/ja/about/methodology"><span class="gci-name">AI 影響度評価の方法論</span><span class="gci-desc">Claude Opus 4.7 によるタスクレベル評価ロジック、ルーブリック、評価フレームワーク。</span></a></li>
        <li><a href="/ja/about/glossary"><span class="gci-name">用語集</span><span class="gci-desc">AI 影響度・risk band・demand band 等、本サイト独自用語の定義。</span></a></li>
        <li><a href="/ja/about/data-sources"><span class="gci-name">データソース一覧</span><span class="gci-desc">厚労省 jobtag、JILPT IPD、賃金構造基本統計調査等、引用元の詳細。</span></a></li>
      </ul>
    </section>
    <Footer />
  </div>
</BaseLayout>
