---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { LIFE_BALANCE_CONFIGS } from '../../../data/lib/genre-configs';
import { loadAllDetails, buildGenreResult, escapeHtml, renderGenreIndexJsonLd, GENRE_HUB_CSS } from '../../../data/lib/genre-hub';

const details = loadAllDetails();
const cards = LIFE_BALANCE_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return { cfg, count: r.items.length, top: r.items[0]?.name_ja ?? '' };
});

const canonical = 'https://mirai-shigoto.com/ja/life-balance';
const title = 'ライフ整合から職業を探す｜育児・介護・健康・趣味と両立 5 hub | 未来の仕事';
const seoDesc = '育児・介護・健康・精神負担・趣味との両立しやすい職業を一覧。ライフステージ別に向く職業を AI 影響度・年収と共に確認。';
const jsonLd = renderGenreIndexJsonLd(canonical, 'ライフ整合から探す', seoDesc);
const cardsHtml = cards.map((c) =>
  `<li><a href="/ja/life-balance/${c.cfg.slug}">` +
  `<span class="gci-name">${escapeHtml(c.cfg.short_ja)}</span>` +
  `<span class="gci-desc">${escapeHtml(c.cfg.description_ja.slice(0, 90))}…</span>` +
  (c.top ? `<span class="iri-preview">🥇 ${escapeHtml(c.top)}</span>` : '') +
  `<span class="gci-count">TOP ${c.count} 職業</span>` +
  `</a></li>`
).join('');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=life-balance" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>ライフ整合から探す</span></nav>
    <header id="content">
      <h1><span class="accent">ライフ整合から職業を探す</span></h1>
      <p class="sub">ライフ条件 <strong>5 軸</strong> で 552 職業を整理</p>
      <p class="intro">育児・介護・健康・精神負担・趣味との両立など、ライフステージ別に向く職業を一覧。労働時間・AI 影響度を組み合わせて、長く続けやすい仕事を探せます。</p>
    </header>
    <section><h2>ライフ整合 5 軸</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
