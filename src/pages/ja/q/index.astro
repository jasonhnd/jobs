---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { QA_ITEMS } from '../../../views/qa-meta';
import { renderGenreIndexJsonLd, renderQGroupsHtml, GENRE_HUB_CSS } from '../../../templates/Hub';

const canonical = 'https://mirai-shigoto.com/ja/q';
// 2026-05-17 H4 fix: was hard-coded 36 — drifted to 49 as QA_ITEMS
// grew. Title/desc now derive count from QA_ITEMS so they never
// drift again. Also keeps the OG card / sitemap aligned via the
// same source.
const qaCount = QA_ITEMS.length;
const title = `よくある質問 (Q&A)｜${qaCount} 個の質問に回答 | 未来の仕事`;
const seoDesc = `AI 時代のキャリアに関する ${qaCount} の質問に回答。「AI でなくならない仕事は？」「30 代の転職はどう選ぶ？」等、具体的な状況別に解説。`;
const jsonLd = renderGenreIndexJsonLd(canonical, '質問で探す', seoDesc);

// Group by sub-genre
const groups = [
  ['AI 不安に答える', QA_ITEMS.slice(0, 8)],
  ['業種別の未来', QA_ITEMS.slice(8, 14)],
  ['キャリア相談', QA_ITEMS.slice(14, 23)],
  ['ライフ条件', QA_ITEMS.slice(23, 29)],
  ['適性・興味', QA_ITEMS.slice(29, 36)],
] as const;
const groupsHtml = renderQGroupsHtml(groups);
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=qa" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <a class="skip-link" href="#content">本文へスキップ</a>
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>質問で探す</span></nav>
    <header id="content">
      <h1><span class="accent">よくある質問 (Q&A)</span></h1>
      <p class="sub"><strong>{QA_ITEMS.length} 個</strong> の質問に独自分析で回答</p>
      <p class="intro">AI 時代のキャリア選択に関するよくある質問を 5 ジャンル ({groups.length} 分類) に整理し、各質問に対して直答 + 根拠 + 例で回答しています。</p>
    </header>
    <Fragment set:html={groupsHtml} />
    <Footer />
  </div>
</BaseLayout>
