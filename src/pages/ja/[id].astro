---
/**
 * [id].astro — per-occupation detail page (JA only).
 *
 * Renders one HTML page per occupation, generated statically via
 * getStaticPaths() reading public/data.detail/<id>.json. Page sections:
 *   - JSON-LD (WebPage + Occupation + BreadcrumbList + FAQPage)
 *   - Risk card + AI rationale long-form (if present)
 *   - Stats dl
 *   - "what is", "how to become", "working conditions" sections
 *   - 5-axis profile radar (data.profile5.json)
 *   - Top-N skills/knowledge/abilities
 *   - FAQ (auto-generated from data)
 *   - Transfer paths (data.transfer_paths.json) or legacy related fallback
 *   - Orgs/certs side-by-side
 *   - Provenance footnote + sources list + share/follow block
 *
 * The inline CSS is preserved verbatim from the v1.x design — a future
 * refactor can extract it into shared classes once we can see what's truly
 * common across detail / sector / ranking pages.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import IdPageScript from './_IdPageScript.astro';
import { buildIdPageBindings } from './_id-bindings';
import { ID_PAGE_CSS } from './_id-css';
import type { Rec } from '@/data/lib/adapt-detail';
import { type SpokeNeighbor } from '../../data/lib/spoke-spoke-graph';

// Schema.org dates appear inside the JSON-LD payload + RSS-style metadata.
// Page-internal versioning, not derived state.
const DATE_PUBLISHED = '2026-04-25';
const DATE_MODIFIED = '2026-04-30';

// ─── getStaticPaths ──────────────────────────────────────────────────────────

export async function getStaticPaths() {
  // Step 11: page-level data prep moved to the view layer
  // (src/views/occupation-page-data). Loads the graph, adapts every
  // detail file, builds the name lookup + ranking-hits-by-occ +
  // same-risk-neighbor serializations. The pickRelatedOccupations
  // helper preserves the legacy "close-risk quota + id-distance
  // fill" algorithm byte-for-byte.
  const { buildOccupationPageData, pickRelatedOccupations } = await import(
    '@/views/occupation-page-data'
  );

  const { allRecs, nameLookup, rankingHitsArr, sameRiskArr } = await buildOccupationPageData();

  // URL params are NOT zero-padded — legacy URLs are /ja/1, /ja/162, /ja/584
  // (no leading zeros). Astro emits dist-astro/ja/{id}.html matching that.
  return allRecs.map((rec) => ({
    params: { id: String(rec.id) },
    props: {
      rec,
      related: pickRelatedOccupations(rec, allRecs),
      nameLookup,
      rankingHitsArr,
      sameRiskArr,
    },
  }));
}

// ─── Page render ─────────────────────────────────────────────────────────────
//
// All Rec → SafeHtml render adapters + page-binding derivations live in
// ./_id-bindings (buildIdPageBindings) and ./_id-renderers. The page
// frontmatter below just unpacks the props, awaits the spoke-graph view,
// calls buildIdPageBindings once, and destructures the result.

interface PageProps {
  rec: Rec;
  related: Rec[];
  nameLookup: Record<number, string>;
  rankingHitsArr: Array<[number, Array<{ slug: string; rank: number }>]>;
  sameRiskArr: Array<[number, SpokeNeighbor[]]>;
}

const { rec, related, nameLookup, rankingHitsArr, sameRiskArr } = Astro.props as PageProps;

// Spoke-graph derived views (same-risk neighbors + related-hubs).
// Single source of truth in src/views/occupation-page-data.
const { buildOccupationSpokeViews } = await import('@/views/occupation-page-data');
const { sameRiskHtml, relatedHubsHtml } = await buildOccupationSpokeViews(
  rec,
  rankingHitsArr,
  sameRiskArr,
);

// All page-render derivations (display strings, SEO meta, section HTML,
// JSON-LD, share-text payload) are bundled into one pass in
// ./_id-bindings. The bindings call orchestrates ~80 lines of
// const declarations under one entry point.
const bindings = buildIdPageBindings({
  rec,
  related,
  nameLookup,
  datePublished: DATE_PUBLISHED,
  dateModified: DATE_MODIFIED,
});
const {
  id, canonical, nameJa, risk, mhlwUrl, rationale, oneLineText,
  title, seoDesc, ogTitle, ogDesc, keywords,
  ctxH2, howH2, condH2, ctxHtml,
  metaRowHtml, aiRiskDetailHtml, profileHtml, topnHtml, faqHtml,
  transferHtml, orgsCertsHtml, provenanceHtml, howSection, condSection,
  legacyRelatedHtml,
  riskClass, riskNumDisp, recruitDisp, hourlyDisp,
  workersCell, ageCell, hoursCell, salaryCell,
  shareTextForPost, copyToastText, jsonLd,
} = bindings;

---
<BaseLayout
  title={title}
  description={seoDesc}
  keywords={keywords}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDesc}
  ogImage={`https://mirai-shigoto.com/api/og?id=${id}`}
  ogType="article"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={ID_PAGE_CSS} />

  <a class="skip-link" href="#content">本文へ</a>

  <div id="wrapper">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">日本の職業 AI 影響マップ</a>
      <span aria-hidden="true">›</span>
      <span>{nameJa}</span>
    </nav>

    <header id="content">
      <h1>
        <span class="accent">{nameJa}</span>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="ライト・ダークモード切替" title="ライト / ダーク切替">
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-1-13h2v3h-2V2Zm0 19h2v3h-2v-3ZM2 11h3v2H2v-2Zm17 0h3v2h-3v-2ZM5.6 4.2 7.7 6.3 6.3 7.7 4.2 5.6l1.4-1.4Zm12.7 12.7 2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4ZM5.6 19.8l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1ZM18.3 7.7l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1Z"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
        </button>
      </h1>
      <Fragment set:html={metaRowHtml} />
    </header>

    <div class={`risk-card ${riskClass}`}>
      <div>
        <div class="risk-label">AI 影響</div>
        <div class="risk-num">{riskNumDisp}<small> / 10</small></div>
      </div>
      <div class="risk-rationale">{rationale}</div>
    </div>

    <div class="one-line">{oneLineText}</div>

    <Fragment set:html={aiRiskDetailHtml} />

    <dl class="stats" aria-label="主な職業統計">
      <div><dt>就業者数</dt><dd>{workersCell}</dd></div>
      <div><dt>年収（平均）</dt><dd>{salaryCell}</dd></div>
      <div><dt>平均年齢</dt><dd>{ageCell}</dd></div>
      <div><dt>月労働時間</dt><dd>{hoursCell}</dd></div>
      <div><dt>求人倍率</dt><dd>{recruitDisp}</dd></div>
      <div><dt>時給</dt><dd>{hourlyDisp}</dd></div>
    </dl>

    <section class="context">
      <h2>{ctxH2}</h2>
      <Fragment set:html={ctxHtml} />
    </section>

    <Fragment set:html={howSection} />

    <Fragment set:html={condSection} />

    <Fragment set:html={profileHtml} />

    <Fragment set:html={topnHtml} />

    <Fragment set:html={faqHtml} />

    <Fragment set:html={transferHtml} />

    <Fragment set:html={sameRiskHtml} />

    <Fragment set:html={legacyRelatedHtml} />

    <Fragment set:html={orgsCertsHtml} />

    <Fragment set:html={relatedHubsHtml} />

    {/* v2: page-level <section class="sources"> and .follow-share-section
        were removed; the canonical <Footer /> below carries 出典 + share
        buttons + per-page jobtag outbound click is preserved via the hidden
        anchor below to keep the GA4 `jobtag_outbound_click` funnel intact. */}
    <a
      href={mhlwUrl}
      rel="external noopener noreferrer"
      target="_blank"
      data-jobtag-id={String(id)}
      data-ai-risk={String(risk ?? 0)}
      onclick={`if(window.gtag)gtag('event','jobtag_outbound_click',{occupation_id:${id},ai_risk_score:${risk ?? 0},language:'ja'});`}
      style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
      aria-hidden="true"
      tabindex="-1"
    >厚生労働省 job tag — {nameJa}（公式）</a>

    <div class="follow-share-section-DELETED-v2" hidden>
      <div class="follow-block">
        <a class="follow-cta"
           id="x-follow-cta"
           href="https://x.com/miraishigotocom"
           target="_blank"
           rel="noopener noreferrer">
          <span class="follow-text">
            <strong>X でフォローする</strong>
            <small>毎日の職業分析を受け取る</small>
          </span>
        </a>
      </div>

      <div class="share-divider"><span>このページをシェア</span></div>

      <div class="share-row" role="group" aria-label="このページをシェア">
        <a class="share-btn" id="share-x" data-platform="x" href="#" aria-label="X で共有">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"/></svg>
        </a>
        <a class="share-btn" id="share-line" data-platform="line" href="#" aria-label="LINE で共有">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755Zm-3.855 3.016c0 .27-.174.51-.432.596a.616.616 0 0 1-.199.031.61.61 0 0 1-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595a.658.658 0 0 1 .194-.033c.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771Zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771Zm-2.466.629H4.917a.629.629 0 0 1-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
        </a>
        <a class="share-btn" id="share-hatena" data-platform="hatena" href="#" aria-label="はてなブックマークで共有">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.47 0C22.42 0 24 1.58 24 3.53v16.94c0 1.95-1.58 3.53-3.53 3.53H3.53C1.58 24 0 22.42 0 20.47V3.53C0 1.58 1.58 0 3.53 0h16.94Zm-3.7 14.47a1.41 1.41 0 1 0 0 2.82 1.41 1.41 0 0 0 0-2.82Zm-5.92 2.69c1.59 0 2.92-.18 3.71-.83.84-.65 1.27-1.55 1.27-2.69 0-.97-.32-1.75-.97-2.34-.65-.59-1.5-.92-2.55-1 .92-.25 1.62-.59 2.04-1.07.43-.45.65-1.07.65-1.84 0-.61-.13-1.16-.4-1.61-.27-.45-.65-.83-1.18-1.07-.45-.22-1-.4-1.61-.5-.61-.07-1.55-.13-2.79-.13H6.74v13.07h4.11Zm-.86-2.5h-.94v-3.13h.97c1.16 0 1.95.13 2.34.4.4.27.59.72.59 1.34 0 .54-.18.97-.54 1.21-.36.27-1.16.18-2.42.18Zm0-5.45h-.94V6.5h.4c1.21 0 2 .07 2.39.27.4.18.61.61.61 1.27 0 .59-.22 1.05-.65 1.27-.4.18-1.18.27-2.39.27ZM22.59 16.94v-7.5h-2.13v7.5h2.13Z"/></svg>
        </a>
        <a class="share-btn" id="share-linkedin" data-platform="linkedin" href="#" aria-label="LinkedIn で共有">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0H5C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5ZM8 19H5V8h3v11ZM6.5 6.73a1.76 1.76 0 1 1 0-3.53 1.76 1.76 0 0 1 0 3.53ZM20 19h-3v-5.6c0-3.37-4-3.11-4 0V19h-3V8h3v1.77c1.4-2.59 7-2.78 7 2.47V19Z"/></svg>
        </a>
        <a class="share-btn" id="share-facebook" data-platform="facebook" href="#" aria-label="Facebook で共有">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99C18.34 21.13 22 16.99 22 12Z"/></svg>
        </a>
        <button class="share-btn" id="share-copy" type="button" data-platform="copy" aria-label="URL をコピー">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1ZM8 13h8v-2H8v2Zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4a5 5 0 0 0 0-10Z"/></svg>
        </button>
        <button class="share-btn" id="share-native" type="button" data-platform="native" aria-label="共有" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 8 6h3v8h2V6h3l-4-4Zm-7 7v11c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2h-3v2h3v11H7V9h3V7H7c-1.1 0-2 .9-2 2Z"/></svg>
        </button>
        <span class="share-toast" id="share-toast" aria-live="polite"></span>
      </div>
    </div>

    <nav class="map-back-link" aria-label="職業マップへ戻る">
      <a href="/map">← 職業マップへ</a>
    </nav>

    <Footer />
  </div>

  <IdPageScript
    occId={id}
    canonicalJs={canonical}
    shareTextJs={shareTextForPost}
    copyToastJs={copyToastText}
    riskScoreJs={risk}
    riskTierJs={risk !== null && risk >= 7 ? 'high' : risk !== null && risk >= 5 ? 'mid' : 'low'}
  />
</BaseLayout>
