// Lazy getters so render-time code (after getStaticPaths) can grab the same
// auxiliary data without re-reading per page.
let _profile5: Record<string, Record<string, number | null>> | null = null;
function getProfile5(): Record<string, Record<string, number | null>> {
  if (_profile5 === null) {
    _profile5 = (readJsonSafe<Profile5File>(paths().profile5) ?? {}).profiles ?? {};
  }
  return _profile5;
}
let _transferPaths: Record<string, TransferPathEntry> | null = null;
function getTransferPaths(): Record<string, TransferPathEntry> {
  if (_transferPaths === null) {
    _transferPaths = (readJsonSafe<TransferPathsFile>(paths().transfer) ?? {}).paths ?? {};
  }
  return _transferPaths;
}

