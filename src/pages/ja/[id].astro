---
/**
 * [id].astro — per-occupation detail page (JA only).
 *
 * Migrated from scripts/build_occupations.py (PR 27, Track C).
 *
 * Renders one HTML page per occupation, generated statically via
 * getStaticPaths() reading dist/data.detail/<id>.json. Mirrors the layout
 * produced by the legacy Python `render_html()` function:
 *   - JSON-LD (WebPage + Occupation + BreadcrumbList + FAQPage)
 *   - Risk card + AI rationale long-form (if present)
 *   - Stats dl
 *   - "what is", "how to become", "working conditions" sections
 *   - 5-axis profile radar (data.profile5.json)
 *   - Top-N skills/knowledge/abilities
 *   - FAQ (auto-generated from data)
 *   - Transfer paths (data.transfer_paths.json) or legacy related fallback
 *   - Orgs/certs side-by-side
 *   - Provenance footnote + sources list + share/follow block
 *
 * The inline CSS is preserved verbatim from the Python CSS_BLOCK so we
 * keep visual parity with ja/<id>.html until later refactors extract it
 * into shared classes (Track D follow-up).
 */
import { readFileSync, readdirSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

// ─── Build-time data sources ────────────────────────────────────────────────
// NOTE: Astro hoists getStaticPaths into its own module scope, so anything it
// references must be either inline-defined inside it or imported at the top.
// We expose DATA_DETAIL etc. through a single helper module so getStaticPaths
// and the body share the same data. To keep this PR self-contained, we keep
// constants and helpers at module scope but do all I/O inside the bodies of
// getStaticPaths and the page render — Astro's static analysis allows that.

const DATE_PUBLISHED = '2026-04-25';
const DATE_MODIFIED = '2026-04-30';
const RELATED_COUNT = 5;

function readJsonSafe(p: string): any {
  try {
    return JSON.parse(readFileSync(p, 'utf8'));
  } catch {
    return null;
  }
}

function paths(): { detail: string; profile5: string; transfer: string } {
  const repo = path.resolve(process.cwd());
  return {
    detail: path.join(repo, 'public', 'data.detail'),
    profile5: path.join(repo, 'public', 'data.profile5.json'),
    transfer: path.join(repo, 'public', 'data.transfer_paths.json'),
  };
}

// Lazy getters so render-time code (after getStaticPaths) can grab the same
// auxiliary data without re-reading per page.
let _profile5: Record<string, any> | null = null;
function getProfile5(): Record<string, any> {
  if (_profile5 === null) {
    _profile5 = (readJsonSafe(paths().profile5) ?? {}).profiles ?? {};
  }
  return _profile5;
}
let _transferPaths: Record<string, any> | null = null;
function getTransferPaths(): Record<string, any> {
  if (_transferPaths === null) {
    _transferPaths = (readJsonSafe(paths().transfer) ?? {}).paths ?? {};
  }
  return _transferPaths;
}

// ─── Types & shape adapter (mirrors _load_legacy_shape_corpus) ──────────────

type Rec = {
  id: number;
  name_ja: string;
  desc_ja: string | null;
  what_it_is_ja: string | null;
  how_to_become_ja: string | null;
  working_conditions_ja: string | null;
  salary: number | null;
  workers: number | null;
  hours: number | null;
  age: number | null;
  recruit_wage: number | null;
  recruit_ratio: number | null;
  hourly_wage: number | null;
  ai_risk: number | null;
  ai_rationale_ja: string | null;
  url: string;
  aliases_ja: string[];
  classifications: any;
  sector: any;
  risk_band: string | null;
  workforce_band: string | null;
  demand_band: string | null;
  ai_model: string | null;
  ai_scored_at: string | null;
  skills_top10: any[];
  knowledge_top5: any[];
  abilities_top5: any[];
  tasks_count: number | null;
  tasks_lead_ja: string | null;
  related_orgs: any[];
  related_certs_ja: string[];
  data_source_versions: any;
  ai_rationale_long_ja: string | null;
  ai_displaceable_tasks_ja: string[];
  ai_resilient_tasks_ja: string[];
  ai_horizon_5y_ja: string | null;
};

function adapt(d: any): Rec {
  const stats = d.stats ?? {};
  const ai = d.ai_risk ?? {};
  const title = d.title ?? {};
  const desc = d.description ?? {};
  return {
    id: d.id,
    name_ja: title.ja ?? '',
    desc_ja: desc.summary_ja ?? null,
    what_it_is_ja: desc.what_it_is_ja ?? null,
    how_to_become_ja: desc.how_to_become_ja ?? null,
    working_conditions_ja: desc.working_conditions_ja ?? null,
    salary: stats.salary_man_yen ?? null,
    workers: stats.workers ?? null,
    hours: stats.monthly_hours ?? null,
    age: stats.average_age ?? null,
    recruit_wage: stats.recruit_wage_man_yen ?? null,
    recruit_ratio: stats.recruit_ratio ?? null,
    hourly_wage: null,
    ai_risk: ai.score ?? null,
    ai_rationale_ja: ai.rationale_ja ?? null,
    url: d.url ?? `https://shigoto.mhlw.go.jp/User/Occupation/Detail/${d.id}`,
    aliases_ja: title.aliases_ja ?? [],
    classifications: d.classifications ?? {},
    sector: d.sector ?? null,
    risk_band: d.risk_band ?? null,
    workforce_band: d.workforce_band ?? null,
    demand_band: d.demand_band ?? null,
    ai_model: ai.model ?? null,
    ai_scored_at: ai.scored_at ?? null,
    skills_top10: d.skills_top10 ?? [],
    knowledge_top5: d.knowledge_top5 ?? [],
    abilities_top5: d.abilities_top5 ?? [],
    tasks_count: d.tasks_count ?? null,
    tasks_lead_ja: d.tasks_lead_ja ?? null,
    related_orgs: d.related_orgs ?? [],
    related_certs_ja: d.related_certs_ja ?? [],
    data_source_versions: d.data_source_versions ?? {},
    ai_rationale_long_ja: ai.rationale_long_ja ?? null,
    ai_displaceable_tasks_ja: ai.displaceable_tasks_ja ?? [],
    ai_resilient_tasks_ja: ai.resilient_tasks_ja ?? [],
    ai_horizon_5y_ja: ai.horizon_5y_ja ?? null,
  };
}

// ─── getStaticPaths ──────────────────────────────────────────────────────────

export async function getStaticPaths() {
  // Inline all imports/constants because Astro hoists getStaticPaths into
  // its own module scope — top-of-file consts are not visible here.
  const fs = await import('node:fs');
  const np = await import('node:path');
  const repo = np.resolve(process.cwd());
  const detailDir = np.join(repo, 'public', 'data.detail');
  const RELATED = 5;

  function adaptLocal(d: any): any {
    const stats = d.stats ?? {};
    const ai = d.ai_risk ?? {};
    const title = d.title ?? {};
    const desc = d.description ?? {};
    return {
      id: d.id,
      name_ja: title.ja ?? '',
      desc_ja: desc.summary_ja ?? null,
      what_it_is_ja: desc.what_it_is_ja ?? null,
      how_to_become_ja: desc.how_to_become_ja ?? null,
      working_conditions_ja: desc.working_conditions_ja ?? null,
      salary: stats.salary_man_yen ?? null,
      workers: stats.workers ?? null,
      hours: stats.monthly_hours ?? null,
      age: stats.average_age ?? null,
      recruit_wage: stats.recruit_wage_man_yen ?? null,
      recruit_ratio: stats.recruit_ratio ?? null,
      hourly_wage: null,
      ai_risk: ai.score ?? null,
      ai_rationale_ja: ai.rationale_ja ?? null,
      url: d.url ?? `https://shigoto.mhlw.go.jp/User/Occupation/Detail/${d.id}`,
      aliases_ja: title.aliases_ja ?? [],
      classifications: d.classifications ?? {},
      sector: d.sector ?? null,
      risk_band: d.risk_band ?? null,
      workforce_band: d.workforce_band ?? null,
      demand_band: d.demand_band ?? null,
      ai_model: ai.model ?? null,
      ai_scored_at: ai.scored_at ?? null,
      skills_top10: d.skills_top10 ?? [],
      knowledge_top5: d.knowledge_top5 ?? [],
      abilities_top5: d.abilities_top5 ?? [],
      tasks_count: d.tasks_count ?? null,
      tasks_lead_ja: d.tasks_lead_ja ?? null,
      related_orgs: d.related_orgs ?? [],
      related_certs_ja: d.related_certs_ja ?? [],
      data_source_versions: d.data_source_versions ?? {},
      ai_rationale_long_ja: ai.rationale_long_ja ?? null,
      ai_displaceable_tasks_ja: ai.displaceable_tasks_ja ?? [],
      ai_resilient_tasks_ja: ai.resilient_tasks_ja ?? [],
      ai_horizon_5y_ja: ai.horizon_5y_ja ?? null,
    };
  }

  const files = fs.readdirSync(detailDir).filter((f: string) => f.endsWith('.json'));
  const all: any[] = files
    .map((f: string) => adaptLocal(JSON.parse(fs.readFileSync(np.join(detailDir, f), 'utf8'))))
    .sort((a: any, b: any) => a.id - b.id);

  // Build name lookup (matches NAME_LOOKUP in Python).
  const nameLookup: Record<number, string> = {};
  for (const r of all) nameLookup[r.id] = r.name_ja;

  function pickRelated(rec: any, count = RELATED): any[] {
    const rid = rec.id;
    const risk = rec.ai_risk;
    const chosen: any[] = [];
    const chosenIds = new Set<number>();
    if (risk !== null) {
      const same = all.filter(
        (r: any) => r.id !== rid && r.ai_risk !== null && Math.abs(r.ai_risk - risk) <= 1,
      );
      same.sort((a: any, b: any) => {
        const da = Math.abs((a.ai_risk ?? 0) - risk);
        const db = Math.abs((b.ai_risk ?? 0) - risk);
        if (da !== db) return da - db;
        const na = Math.abs(a.id - rid);
        const nb = Math.abs(b.id - rid);
        if (na !== nb) return na - nb;
        return a.id - b.id;
      });
      for (const r of same) {
        if (chosen.length >= 3) break;
        chosen.push(r);
        chosenIds.add(r.id);
      }
    }
    const neighbors = all
      .filter((r: any) => r.id !== rid && !chosenIds.has(r.id))
      .sort((a: any, b: any) => {
        const na = Math.abs(a.id - rid);
        const nb = Math.abs(b.id - rid);
        if (na !== nb) return na - nb;
        return a.id - b.id;
      });
    for (const r of neighbors) {
      if (chosen.length >= count) break;
      chosen.push(r);
      chosenIds.add(r.id);
    }
    return chosen.slice(0, count);
  }

  // URL params are NOT zero-padded — legacy URLs are /ja/1, /ja/162, /ja/584
  // (no leading zeros). Astro emits dist-astro/ja/{id}.html matching that.
  // The data filename in dist/data.detail/{padded}.json IS zero-padded; that
  // padding is handled inside the JSON load step, not in URLs.
  return all.map((rec) => ({
    params: { id: String(rec.id) },
    props: { rec, related: pickRelated(rec), nameLookup },
  }));
}

// ─── Helpers (mirror Python helpers) ─────────────────────────────────────────

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#x27;');
}

function fmtInt(n: number | null | undefined): string {
  if (n === null || n === undefined) return '—';
  return Math.trunc(n).toLocaleString('en-US');
}

const NOUN_FINAL_ENDINGS = [
  '職業', '仕事', '技術者', '職人', '担当者', '専門職', '技能職',
  'オペレーター', 'エンジニア', 'デザイナー', 'プログラマー',
  '従事者', '作業員', '者', '士', '員', '家', '師', '工',
];

function endsWithAny(s: string, suffixes: string[]): boolean {
  return suffixes.some((suf) => s.endsWith(suf));
}

function makeDefinition(rec: Rec): string {
  const name = (rec.name_ja || '').trim();
  const summary = (rec.desc_ja || '').trim();
  if (!summary) {
    const sectorJa = rec.sector?.ja || '';
    if (sectorJa) return `${name}とは、${sectorJa}業界に属する職業です。`;
    return `${name}とは、日本の職業の一つです。`;
  }
  let first = summary.split('。')[0].trim();
  if (!first) first = summary.replace(/[。.]+$/, '').trim();
  if (first.startsWith(`${name}とは`) || first.startsWith(`${name}は`)) {
    if (!first.endsWith('です') && !first.endsWith('ます') && !first.endsWith('である')) {
      return endsWithAny(first, NOUN_FINAL_ENDINGS) ? `${first}です。` : `${first}職業です。`;
    }
    return `${first}。`;
  }
  if (endsWithAny(first, NOUN_FINAL_ENDINGS)) return `${name}とは、${first}です。`;
  return `${name}とは、${first}職業です。`;
}

function formatParagraphs(text: string | null): string {
  if (!text) return '';
  const normalized = text.replace(/\n　/g, '\n\n').replace(/\r\n/g, '\n');
  const chunks = normalized.split(/\n\s*\n+/).map((c) => c.trim()).filter(Boolean);
  if (!chunks.length) return `<p>${escapeHtml(text.trim())}</p>`;
  return chunks.map((c) => `<p>${escapeHtml(c)}</p>`).join('\n        ');
}

function jaUrl(id: number): string {
  return `https://mirai-shigoto.com/ja/${id}`;
}

function bandLabel(field: string, band: string | null): string | null {
  if (!band) return null;
  const labels: Record<string, Record<string, string>> = {
    risk_band: { low: 'AI 影響 低', mid: 'AI 影響 中', high: 'AI 影響 高' },
    workforce_band: { small: '規模 小', mid: '規模 中', medium: '規模 中', large: '規模 大' },
    demand_band: { cool: '需要 安定', warm: '需要 旺盛', hot: '需要 過熱' },
  };
  return labels[field]?.[band] ?? null;
}

function bandClass(field: string, band: string | null): string {
  if (!band) return '';
  if (field === 'risk_band') return `band-${band}`;
  if (field === 'workforce_band') {
    return ({ small: 'band-low', mid: 'band-mid', medium: 'band-mid', large: 'band-high' } as Record<string, string>)[band] ?? '';
  }
  if (field === 'demand_band') {
    return ({ cool: 'band-low', warm: 'band-mid', hot: 'band-high' } as Record<string, string>)[band] ?? '';
  }
  return '';
}

function renderMetaRow(rec: Rec): string {
  const parts: string[] = [];
  const sectorName = rec.sector?.ja || '';
  if (sectorName) {
    const href = `/ja/sectors/${rec.sector?.id}`;
    parts.push(`<a class="sector-chip" href="${escapeHtml(href)}">${escapeHtml(sectorName)}</a>`);
  }
  for (const f of ['risk_band', 'workforce_band', 'demand_band'] as const) {
    const b = rec[f];
    const label = bandLabel(f, b);
    if (label) parts.push(`<span class="band ${bandClass(f, b)}">${escapeHtml(label)}</span>`);
  }
  if (!parts.length) return '';
  return `<div class="meta-row">${parts.join('')}</div>`;
}

function renderProfileRadar(rec: Rec): string {
  const profile = getProfile5()[String(rec.id)];
  if (!profile) return '';
  const axes = ['creative', 'social', 'judgment', 'physical', 'routine'];
  const values = axes.map((a) => profile[a] ?? 0);
  if (!values.some((v) => v)) return '';
  const labels = ['創造性', '対人', '判断', '身体', '定型'];
  const cx = 170, cy = 170, r = 130;
  const pts: string[] = [];
  for (let i = 0; i < values.length; i++) {
    const ang = (-90 + i * 72) * Math.PI / 180;
    const scale = (values[i] || 0) / 100;
    const x = cx + Math.cos(ang) * r * scale;
    const y = cy + Math.sin(ang) * r * scale;
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  let gridLayers = '';
  for (const level of [0.25, 0.5, 0.75, 1.0]) {
    const layer: string[] = [];
    for (let i = 0; i < 5; i++) {
      const ang = (-90 + i * 72) * Math.PI / 180;
      const x = cx + Math.cos(ang) * r * level;
      const y = cy + Math.sin(ang) * r * level;
      layer.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    }
    gridLayers += `<polygon points="${layer.join(' ')}" fill="none" stroke="rgba(36,30,24,0.10)" stroke-width="1"/>`;
  }
  let labelHtml = '';
  for (let i = 0; i < labels.length; i++) {
    const ang = (-90 + i * 72) * Math.PI / 180;
    const lx = cx + Math.cos(ang) * (r + 22);
    const ly = cy + Math.sin(ang) * (r + 22);
    labelHtml += `<text x="${lx.toFixed(1)}" y="${ly.toFixed(1)}" text-anchor="middle" dominant-baseline="middle" font-size="13" font-family="Plus Jakarta Sans, sans-serif" font-weight="600" fill="#7A6F5E" letter-spacing="0.04em">${escapeHtml(labels[i])}</text>`;
  }
  const legend = labels
    .map((lab, i) => `<dt>${escapeHtml(lab)}</dt><dd>${Math.trunc(values[i])}</dd>`)
    .join('');
  const h2 = '5 次元プロファイル';
  return `<section class="profile" aria-label="${escapeHtml(h2)}"><h2>${escapeHtml(h2)}</h2><div class="radar-wrap"><svg class="radar-svg" viewBox="0 0 340 340" role="img" aria-label="${escapeHtml(h2)}">${gridLayers}<polygon points="${pts.join(' ')}" fill="rgba(217,107,61,0.18)" stroke="#D96B3D" stroke-width="2.5" stroke-linejoin="round"/>${labelHtml}</svg><dl class="radar-legend">${legend}</dl></div></section>`;
}

function renderTopn(rec: Rec): string {
  const skills = rec.skills_top10 ?? [];
  const knowledge = rec.knowledge_top5 ?? [];
  const abilities = rec.abilities_top5 ?? [];
  if (!(skills.length || knowledge.length || abilities.length)) return '';
  function block(title: string, items: any[]): string {
    if (!items.length) return '';
    const lis = items
      .map((it) => {
        const lab = it.label_ja || '';
        const score = (it.score ?? 0).toFixed(1);
        return `<li><span class="topn-name">${escapeHtml(lab)}</span><span class="topn-score">${score}</span></li>`;
      })
      .join('');
    return `<div class="topn-block"><h3>${escapeHtml(title)}</h3><ol>${lis}</ol></div>`;
  }
  const h2 = '必要なスキル・知識・能力';
  const body = block('スキル Top 10', skills) + block('知識 Top 5', knowledge) + block('能力 Top 5', abilities);
  return `<section class="topn" aria-label="${escapeHtml(h2)}"><h2>${escapeHtml(h2)}</h2><div class="topn-grid">${body}</div></section>`;
}

function buildOccFaqs(rec: Rec): [string, string][] {
  const name = rec.name_ja || '';
  const salary = rec.salary;
  const workers = rec.workers;
  const recruit = rec.recruit_ratio;
  const risk = rec.ai_risk;
  const rationale = (rec.ai_rationale_ja || '').trim().replace(/。$/, '').trim();
  const how = (rec.how_to_become_ja || '').trim();
  const skills = rec.skills_top10 ?? [];
  const faqs: [string, string][] = [];

  if (salary) {
    const monthly = salary / 12;
    const compare = salary > 500
      ? '日本全体の平均年収（約460万円）を上回る水準'
      : salary < 420
        ? '日本全体の平均年収（約460万円）を下回る水準'
        : '日本全体の平均年収（約460万円）と同程度';
    faqs.push([
      `${name}の年収はいくらですか？`,
      `${name}の平均年収は約${Math.trunc(salary)}万円（月収換算で約${Math.trunc(monthly)}万円）で、${compare}です。これは厚生労働省 jobtag のデータに基づく値で、勤務先・地域・経験により幅があります。`,
    ]);
  }

  if (risk !== null) {
    const tier = risk <= 3
      ? '低めで、AI に代替されにくい職業'
      : risk <= 6
        ? '中程度で、業務の一部が AI 補助に移行する可能性'
        : '高めで、業務の多くが AI による代替・補助の対象となる可能性';
    const rationaleStr = rationale ? `主な要因は「${rationale}」。` : '';
    faqs.push([
      `${name}のAI代替リスクはどれくらいですか？`,
      `${name}のAI影響度は10段階中 ${risk} で、${tier}です。${rationaleStr}これは Claude Opus 4.7 による独自スコア（非公式）で、職業選択の唯一の根拠としては使用しないでください。`,
    ]);

    const outlook = risk <= 3
      ? 'AI に代替されにくく、将来性は比較的安定'
      : risk >= 7
        ? 'AI による業務変化が大きく見込まれ、スキルアップや関連職種への転換も視野に'
        : 'AI 影響は中程度で、業務の一部が AI 補助に移行する可能性';
    const workersStr = workers ? `日本での就業者数は約${fmtInt(workers)}人。` : '';
    const recruitStr = recruit !== null && recruit !== undefined ? `求人倍率 ${recruit.toFixed(2)} 倍。` : '';
    faqs.push([
      `${name}の将来性はどうですか？`,
      `AI影響度 ${risk}/10。${outlook}な職業です。${workersStr}${recruitStr}個別の状況に応じた判断が重要です。`,
    ]);
  }

  if (how) {
    let first = how.split('。')[0].trim();
    if (!first) first = how.slice(0, 200).trim();
    if (first.length > 220) first = first.slice(0, 220).trimEnd() + '…';
    faqs.push([
      `${name}になるにはどうすればいいですか？`,
      `${first}。詳しい流れは本ページ内の「${name}になるには・必要な資格」セクションをご覧ください。`,
    ]);
  }

  if (skills.length) {
    const top3 = skills.slice(0, 3).map((s: any) => s.label_ja).filter(Boolean);
    if (top3.length) {
      const skillsStr = top3.join('、');
      let extra = '';
      if (skills.length >= 5) {
        const tail = skills.slice(3, 5).map((s: any) => s.label_ja).filter(Boolean);
        if (tail.length) extra = `加えて、${tail.join('、')}も重要です。`;
      }
      faqs.push([
        `${name}に必要なスキルは何ですか？`,
        `${name}で特に重視されるスキルは、${skillsStr}などです。${extra}詳しいスキル分布は本ページ内の「必要なスキル・知識・能力」セクションをご覧ください。`,
      ]);
    }
  }

  return faqs;
}

function renderOccFaq(rec: Rec): string {
  const faqs = buildOccFaqs(rec);
  if (!faqs.length) return '';
  const items = faqs
    .map(([q, a]) =>
      `<details class="faq-item"><summary>${escapeHtml(q)}</summary><div class="faq-answer">${escapeHtml(a)}</div></details>`,
    )
    .join('');
  return `<section class="faq" aria-label="よくある質問"><h2>よくある質問</h2><div class="faq-list">${items}</div></section>`;
}

function renderTransfer(rec: Rec, nameLookup: Record<number, string>): string {
  const path0 = getTransferPaths()[String(rec.id)];
  if (!path0) return '';
  const candidates = (path0.candidates ?? []).slice(0, 3);
  if (!candidates.length) return '';
  const cards = candidates
    .map((c: any) => {
      const cid = c.id;
      const name = nameLookup[cid] || c.title_ja || '?';
      const href = `/ja/${cid}`;
      const risk = c.ai_risk;
      const sim = c.similarity;
      const riskStr = risk !== null && risk !== undefined ? `${risk}/10` : '—';
      const riskLabel = `AI 影響 ${riskStr}`;
      const simLabel = sim !== null && sim !== undefined ? `類似度 ${Math.round(sim * 100)}%` : '';
      const simHtml = simLabel ? `<span class="tc-similarity">${escapeHtml(simLabel)}</span>` : '';
      return `<a class="transfer-card" href="${href}"><span class="tc-name">${escapeHtml(name)}</span><span class="tc-meta"><span class="tc-risk">${escapeHtml(riskLabel)}</span>${simHtml}</span></a>`;
    })
    .join('');
  const h2 = '似た仕事 / キャリア転換の候補';
  return `<section class="transfer" aria-label="${escapeHtml(h2)}"><h2>${escapeHtml(h2)}</h2><div class="transfer-grid">${cards}</div></section>`;
}

function renderOrgsCerts(rec: Rec): string {
  const orgs = rec.related_orgs ?? [];
  const certs = rec.related_certs_ja ?? [];
  if (!(orgs.length || certs.length)) return '';
  let orgBlock = '';
  if (orgs.length) {
    const items = orgs
      .filter((o: any) => o.name_ja)
      .map((o: any) => `<li><a href="${escapeHtml(o.url || '#')}" rel="external" target="_blank">${escapeHtml(o.name_ja || '')}</a></li>`)
      .join('');
    orgBlock = `<div class="org-cert-block"><h3>関連業界団体</h3><ul class="org-list">${items}</ul></div>`;
  }
  let certBlock = '';
  if (certs.length) {
    const items = certs.map((c) => `<li>${escapeHtml(c)}</li>`).join('');
    certBlock = `<div class="org-cert-block"><h3>関連資格</h3><ul class="cert-list">${items}</ul></div>`;
  }
  return `<section class="orgs-certs"><div class="org-cert-grid">${orgBlock}${certBlock}</div></section>`;
}

function renderProvenance(rec: Rec): string {
  const model = rec.ai_model;
  const scoredAt = rec.ai_scored_at;
  const dsv = rec.data_source_versions ?? {};
  const ipdNum = dsv.ipd_numeric;
  const ipdDesc = dsv.ipd_description;
  const bits: string[] = [];
  if (model && scoredAt) {
    bits.push(`AI 影響度 — モデル <code>${escapeHtml(model)}</code> · スコア取得 <code>${escapeHtml(scoredAt.slice(0, 10))}</code>`);
  }
  if (ipdNum || ipdDesc) {
    const v = ipdNum || ipdDesc;
    bits.push(`データ — 厚労省 / JILPT IPD <code>${escapeHtml(v)}</code>`);
  }
  if (!bits.length) return '';
  return `<p class="provenance">${bits.join(' · ')}</p>`;
}

function renderAiRiskDetail(rec: Rec): string {
  const longText = rec.ai_rationale_long_ja;
  if (!longText) return '';
  const displaceable = rec.ai_displaceable_tasks_ja ?? [];
  const resilient = rec.ai_resilient_tasks_ja ?? [];
  const horizon = rec.ai_horizon_5y_ja || '';
  const score = rec.ai_risk;
  const scoreDisp = score !== null ? `${score}/10` : '—';
  const dispLis = displaceable.map((t) => `<li>${escapeHtml(t)}</li>`).join('');
  const resiLis = resilient.map((t) => `<li>${escapeHtml(t)}</li>`).join('');
  const horizonHtml = horizon
    ? `<p class="ai-horizon"><strong>5-10 年展望:</strong> ${escapeHtml(horizon)}</p>`
    : '';
  return `<section class="ai-risk-detail" aria-labelledby="ai-risk-detail-h2">
        <h2 id="ai-risk-detail-h2">なぜ AI 影響度 ${escapeHtml(scoreDisp)} か</h2>
        <p class="ai-rationale-long">${escapeHtml(longText)}</p>
        <div class="ai-task-grid">
          <div class="ai-task-block">
            <h3>AI に置き換わりやすい業務</h3>
            <ul>${dispLis}</ul>
          </div>
          <div class="ai-task-block">
            <h3>人が残る業務</h3>
            <ul>${resiLis}</ul>
          </div>
        </div>
        ${horizonHtml}
      </section>`;
}

function renderJsonLd(rec: Rec): string {
  const id = rec.id;
  const nameJa = rec.name_ja || '';
  const risk = rec.ai_risk;
  const rationaleJa = rec.ai_rationale_ja || '';
  const descJa = rec.desc_ja || '';
  const salaryMan = rec.salary;
  const workers = rec.workers;
  const age = rec.age;
  const hours = rec.hours;
  const recruit = rec.recruit_ratio;
  const hourly = rec.hourly_wage;
  const mhlwUrl = rec.url;
  const canonical = jaUrl(id);
  const pageName = risk !== null ? `${nameJa} — AI 影響 ${risk}/10` : `${nameJa} — mirai-shigoto.com`;
  const pageDesc = makeDefinition(rec) || rationaleJa || descJa || nameJa;
  const breadcrumbRoot = '日本の職業 AI 影響マップ';
  const homeUrl = 'https://mirai-shigoto.com/';

  const additional: any[] = [];
  if (risk !== null) {
    additional.push({
      '@type': 'PropertyValue',
      name: 'AI risk score (0-10)',
      value: risk,
      description: 'Claude Opus 4.7 による独自 LLM 推定。タスクレベルの AI 影響度を表し、職が消える確率ではありません。',
    });
  }
  if (workers) additional.push({ '@type': 'PropertyValue', name: 'Workforce size', value: workers, unitText: 'persons' });
  if (age) additional.push({ '@type': 'PropertyValue', name: 'Average age', value: age, unitText: 'years' });
  if (hours) additional.push({ '@type': 'PropertyValue', name: 'Monthly working hours', value: hours, unitText: 'hours' });
  if (recruit !== null && recruit !== undefined) additional.push({ '@type': 'PropertyValue', name: 'Effective recruit ratio', value: recruit });
  if (hourly) additional.push({ '@type': 'PropertyValue', name: 'Hourly wage', value: hourly, unitText: 'JPY/hour' });

  const occupationNode: any = {
    '@type': 'Occupation',
    '@id': `${canonical}#occupation`,
    name: nameJa,
    description: pageDesc,
    occupationLocation: { '@type': 'Country', name: 'Japan' },
    occupationalCategory: String(id),
    sameAs: mhlwUrl,
    additionalProperty: additional,
    isPartOf: { '@id': 'https://mirai-shigoto.com/#dataset' },
  };
  const altNames = rec.aliases_ja ?? [];
  if (altNames.length) {
    occupationNode.alternateName = altNames.length > 1 ? altNames : altNames[0];
  }
  if (rec.sector?.ja) occupationNode.industry = rec.sector.ja;
  const cls = rec.classifications ?? {};
  if (cls.mhlw_main || cls.jsoc_main) {
    occupationNode.occupationalCategory = cls.mhlw_main || cls.jsoc_main || String(id);
  }
  if (rec.skills_top10?.length) {
    occupationNode.skills = rec.skills_top10
      .map((s: any) => s.label_ja)
      .filter(Boolean);
  }
  if (rec.related_certs_ja?.length) {
    occupationNode.qualifications = rec.related_certs_ja;
  }
  if (salaryMan) {
    occupationNode.estimatedSalary = {
      '@type': 'MonetaryAmountDistribution',
      name: 'Annual salary (estimated mean from MHLW jobtag)',
      currency: 'JPY',
      duration: 'P1Y',
      median: Math.trunc(salaryMan * 10000),
    };
  }
  if (hours) {
    const annualHours = Math.trunc(hours * 12);
    occupationNode.workHours = `月平均 ${Math.trunc(hours)} 時間（年間約 ${annualHours} 時間）`;
  }
  const tasksLead = rec.tasks_lead_ja || '';
  if (tasksLead) occupationNode.responsibilities = tasksLead.slice(0, 600);
  if (rec.related_certs_ja?.length) {
    occupationNode.educationRequirements = '関連資格：' + rec.related_certs_ja.join('、');
  }
  const longHow = rec.how_to_become_ja || '';
  if (longHow) {
    const firstHow = longHow.split('。')[0].trim();
    if (firstHow && firstHow.length <= 240) {
      occupationNode.experienceRequirements = `${firstHow}。`;
    }
  }

  const graphNodes: any[] = [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageName,
      description: pageDesc,
      isPartOf: { '@id': 'https://mirai-shigoto.com/#website' },
      about: { '@id': `${canonical}#occupation` },
      mainEntity: { '@id': `${canonical}#occupation` },
      primaryImageOfPage: `https://mirai-shigoto.com/api/og?id=${id}`,
      inLanguage: 'ja',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      publisher: { '@id': 'https://mirai-shigoto.com/#organization' },
      author: { '@id': 'https://mirai-shigoto.com/#organization' },
    },
    occupationNode,
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: breadcrumbRoot, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: nameJa, item: canonical },
      ],
    },
  ];

  const faqs = buildOccFaqs(rec);
  if (faqs.length) {
    graphNodes.push({
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: 'ja',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    });
  }

  return JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes }, null, 2);
}

// ─── Page render ─────────────────────────────────────────────────────────────

interface PageProps {
  rec: Rec;
  related: Rec[];
  nameLookup: Record<number, string>;
}

const { rec, related, nameLookup } = Astro.props as PageProps;

const id = rec.id;
const canonical = jaUrl(id);
const nameJa = rec.name_ja || '';
const risk = rec.ai_risk;
const riskStr = risk !== null ? `${risk}/10` : '—';
const rationaleJa = rec.ai_rationale_ja || '';
const descJa = (rec.desc_ja || '').slice(0, 240);
const longWhatJa = rec.what_it_is_ja || '';
const longHowJa = rec.how_to_become_ja || '';
const longCondJa = rec.working_conditions_ja || '';
const salaryMan = rec.salary;
const workers = rec.workers;
const age = rec.age;
const hours = rec.hours;
const recruit = rec.recruit_ratio;
const hourly = rec.hourly_wage;
const mhlwUrl = rec.url;

const riskClass = risk !== null ? `risk-${risk}` : 'risk-na';

const title = `${nameJa}の将来性・年収・AI影響度【${riskStr}】｜未来の仕事`;
const _riskDesc = risk !== null
  ? `AI代替リスクは10段階中${risk}と${risk <= 3 ? '低め' : risk <= 6 ? '中程度' : '高め'}`
  : 'AI影響度を分析';
const _salaryShort = salaryMan ? `年収${Math.trunc(salaryMan)}万円` : '';
const _workersShort = workers ? `就業者${fmtInt(workers)}人` : '';
const _dataParts = [_salaryShort, _workersShort].filter(Boolean).join('・');
const seoDesc = _dataParts
  ? `${nameJa}の${_riskDesc}。${_dataParts}。将来性やなり方、必要なスキルを詳しく解説。`
  : `${nameJa}の${_riskDesc}。将来性やなり方、必要なスキルを詳しく解説。`;

const ogTitle = title.slice(0, 120);
const ogDesc = seoDesc.slice(0, 300);

const rationale = rationaleJa || descJa;

// keywords meta
const aliases = rec.aliases_ja ?? [];
const kwTerms = [nameJa, ...aliases.slice(0, 8)].filter(Boolean);
const keywords = kwTerms.join(', ');

const ctxH2 = `${nameJa}とは`;
const ctxP = longWhatJa || descJa || rationaleJa;
const howH2 = `${nameJa}になるには・必要な資格`;
const condH2 = `${nameJa}の労働条件・働き方`;

const definition = makeDefinition(rec);
const ctxBodyHtml = ctxP ? formatParagraphs(ctxP) : '';
const ctxHtml = `<p class="definition">${escapeHtml(definition)}</p>\n        ${ctxBodyHtml}`.trimEnd();

const howSection = longHowJa
  ? `<section class="how-to-become" aria-label="${escapeHtml(howH2)}">
        <h2>${escapeHtml(howH2)}</h2>
        ${formatParagraphs(longHowJa)}
      </section>`
  : '';
const condSection = longCondJa
  ? `<section class="working-conditions" aria-label="${escapeHtml(condH2)}">
        <h2>${escapeHtml(condH2)}</h2>
        ${formatParagraphs(longCondJa)}
      </section>`
  : '';

const metaRowHtml = renderMetaRow(rec);
const aiRiskDetailHtml = renderAiRiskDetail(rec);
const profileHtml = renderProfileRadar(rec);
const topnHtml = renderTopn(rec);
const faqHtml = renderOccFaq(rec);
const transferHtml = renderTransfer(rec, nameLookup);
const orgsCertsHtml = renderOrgsCerts(rec);
const provenanceHtml = renderProvenance(rec);

const relH2 = '類似する職業';
const relPath = '/ja/';
const relatedListHtml = related
  .map((r) => {
    const rid = r.id;
    const rname = r.name_ja || `#${rid}`;
    const rrisk = r.ai_risk;
    const rriskStr = rrisk !== null ? `${rrisk}/10` : '—';
    return `<li><a class="r-name" href="${relPath}${rid}">${escapeHtml(rname)}</a><span class="r-risk">AI 影響 ${rriskStr}</span></li>`;
  })
  .join('\n          ');
const legacyRelatedHtml = transferHtml
  ? ''
  : `<section class="related" aria-label="${escapeHtml(relH2)}">
        <h2>${escapeHtml(relH2)}</h2>
        <ul>
          ${relatedListHtml}
        </ul>
      </section>`;

// Display formatters
const salaryInt = salaryMan ? Math.trunc(salaryMan) : '—';
const ageDisp = age ?? '—';
const hoursDisp = hours ? Math.trunc(hours) : '—';
const recruitDisp = recruit !== null && recruit !== undefined ? recruit : '—';
const hourlyDisp = hourly ? `¥${fmtInt(hourly)}` : '—';
const riskNumDisp = risk !== null ? risk : '—';
const workersCell = workers ? `${fmtInt(workers)} 人` : '—';
const ageCell = age ? `${ageDisp} 歳` : '—';
const hoursCell = hours ? `${hoursDisp} 時間/月` : '—';
const salaryCell = salaryMan
  ? `¥${fmtInt(Math.trunc(salaryMan * 10000))}（${salaryInt} 万円）`
  : '—（— 万円）';

const riskScoreJs = risk !== null ? String(risk) : 'null';
const riskTierJs = risk !== null && risk >= 7 ? "'high'" : risk !== null && risk >= 5 ? "'mid'" : "'low'";

const shareTextForPost = `${nameJa} の AI 影響度は ${riskStr}。日本 552 職種の AI 影響マップ（非公式・独自分析）。`;
const copyToastText = 'コピーしました';

const jsonLd = renderJsonLd(rec);

// JSON encode helper for inline JS string literals
function jsStr(s: string): string {
  return JSON.stringify(s);
}
---
<BaseLayout
  title={title}
  description={seoDesc}
  keywords={keywords}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDesc}
  ogImage={`https://mirai-shigoto.com/api/og?id=${id}`}
  ogType="article"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={`
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
