// The DetailFile → Rec adapter lives in src/data/lib/adapt-detail.ts so that
// both the module body (via static import, when needed) and getStaticPaths
// (via dynamic import, due to Astro hoisting) can share one implementation.
// The audit's #2.2 finding was that this file used to duplicate the adapter
// locally inside getStaticPaths — that duplication is gone now.

// ─── getStaticPaths ──────────────────────────────────────────────────────────

export async function getStaticPaths() {
  const RELATED = 5;

  // Step 8: detail records derived directly from the knowledge graph.
  // The auxiliary projections (profile5 + transfer_paths) are still read
  // from public/ inside the page body (see getProfile5 / getTransferPaths
  // lazy getters) — those migrate in a later step.
  const { loadGraph } = await import('@/graph');
  const { buildOccupationDetailFile } = await import('@/views/occupation-detail');
  const { adaptDetailFile } = await import('../../data/lib/adapt-detail.js');

  const graph = await loadGraph();
  const all: Rec[] = [];
  for (const [occId] of graph.occupations) {
    const detailFile = buildOccupationDetailFile(graph, occId);
    all.push(adaptDetailFile(detailFile));
  }
  all.sort((a, b) => a.id - b.id);

  // Build name lookup keyed by occupation id.
  const nameLookup: Record<number, string> = {};
  for (const r of all) nameLookup[r.id] = r.name_ja;

  // Phase A: build ranking-hits-by-occ ONCE for all 556 spokes by importing
  // buildRankings here in getStaticPaths. Then pass it through props so each
  // page render can look up "which rankings does my id appear in".
  const { buildRankings: _buildRankings } = await import('../../data/lib/rankings.js');
  const { buildRankingHitsByOcc: _buildRH } = await import('../../data/lib/spoke-hub-graph.js');
  const { buildSameRiskNeighbors: _buildSRN } = await import('../../data/lib/spoke-spoke-graph.js');
  const _rankingResults = _buildRankings();
  const rankingHitsByOcc = _buildRH(_rankingResults.results.values());
  // Serialize Map to array-of-pairs for prop transport (Astro can't pass Map).
  const rankingHitsArr: Array<[number, Array<{ slug: string; rank: number }>]> = [];
  for (const [k, v] of rankingHitsByOcc) {
    rankingHitsArr.push([k, v.map((h) => ({ slug: h.slug, rank: h.rank }))]);
  }

  // Phase C: build cross-sector same-risk neighbors ONCE (symmetric).
  const _sameRiskInputs = all.map((r) => ({
    id: r.id,
    name_ja: r.name_ja,
    ai_risk: r.ai_risk,
    sector_id: r.sector?.id ?? null,
    sector_ja: r.sector?.ja ?? null,
    workers: r.workers,
  }));
  const _srnMap = _buildSRN(_sameRiskInputs, { span: 1, topN: 5 });
  const sameRiskArr: Array<[number, Array<{ id: number; name_ja: string; ai_risk: number | null; sector_id: string | null; sector_ja: string | null; workers: number | null }>]> = [];
  for (const [k, v] of _srnMap) {
    sameRiskArr.push([k, v.slice(0, 5)]); // cap final view at 5 even if symmetrize added a few
  }

  function pickRelated(rec: Rec, count = RELATED): Rec[] {
    const rid = rec.id;
    const risk = rec.ai_risk;
    const chosen: Rec[] = [];
    const chosenIds = new Set<number>();
    if (risk !== null) {
      const same = all.filter(
        (r) => r.id !== rid && r.ai_risk !== null && Math.abs(r.ai_risk - risk) <= 1,
      );
      same.sort((a, b) => {
        const da = Math.abs((a.ai_risk ?? 0) - risk);
        const db = Math.abs((b.ai_risk ?? 0) - risk);
        if (da !== db) return da - db;
        const na = Math.abs(a.id - rid);
        const nb = Math.abs(b.id - rid);
        if (na !== nb) return na - nb;
        return a.id - b.id;
      });
      for (const r of same) {
        if (chosen.length >= 3) break;
        chosen.push(r);
        chosenIds.add(r.id);
      }
    }
    const neighbors = all
      .filter((r) => r.id !== rid && !chosenIds.has(r.id))
      .sort((a, b) => {
        const na = Math.abs(a.id - rid);
        const nb = Math.abs(b.id - rid);
        if (na !== nb) return na - nb;
        return a.id - b.id;
      });
    for (const r of neighbors) {
      if (chosen.length >= count) break;
      chosen.push(r);
      chosenIds.add(r.id);
    }
    return chosen.slice(0, count);
  }

  // URL params are NOT zero-padded — legacy URLs are /ja/1, /ja/162, /ja/584
  // (no leading zeros). Astro emits dist-astro/ja/{id}.html matching that.
  // The data filename in dist/data.detail/{padded}.json IS zero-padded; that
  // padding is handled inside the JSON load step, not in URLs.
  return all.map((rec) => ({
    params: { id: String(rec.id) },
    props: { rec, related: pickRelated(rec), nameLookup, rankingHitsArr, sameRiskArr },
  }));
}

// ─── Helpers (mirror Python helpers) ─────────────────────────────────────────
// escapeHtml is imported at the top of the file from '@/lib/safe-html'.

// fmtInt: imported at top of file from '@/lib/num'.

const NOUN_FINAL_ENDINGS = [
  '職業', '仕事', '技術者', '職人', '担当者', '専門職', '技能職',
  'オペレーター', 'エンジニア', 'デザイナー', 'プログラマー',
  '従事者', '作業員', '者', '士', '員', '家', '師', '工',
];

function endsWithAny(s: string, suffixes: string[]): boolean {
  return suffixes.some((suf) => s.endsWith(suf));
}

function makeDefinition(rec: Rec): string {
  const name = (rec.name_ja || '').trim();
  const summary = (rec.desc_ja || '').trim();
  if (!summary) {
    const sectorJa = rec.sector?.ja || '';
    if (sectorJa) return `${name}とは、${sectorJa}業界に属する職業です。`;
    return `${name}とは、日本の職業の一つです。`;
  }
  let first = summary.split('。')[0].trim();
  if (!first) first = summary.replace(/[。.]+$/, '').trim();
  if (first.startsWith(`${name}とは`) || first.startsWith(`${name}は`)) {
    if (!first.endsWith('です') && !first.endsWith('ます') && !first.endsWith('である')) {
      return endsWithAny(first, NOUN_FINAL_ENDINGS) ? `${first}です。` : `${first}職業です。`;
    }
    return `${first}。`;
  }
  if (endsWithAny(first, NOUN_FINAL_ENDINGS)) return `${name}とは、${first}です。`;
  return `${name}とは、${first}職業です。`;
}

function formatParagraphs(text: string | null): string {
  if (!text) return '';
  const normalized = text.replace(/\n　/g, '\n\n').replace(/\r\n/g, '\n');
  const chunks = normalized.split(/\n\s*\n+/).map((c) => c.trim()).filter(Boolean);
  if (!chunks.length) return `<p>${escapeHtml(text.trim())}</p>`;
  return chunks.map((c) => `<p>${escapeHtml(c)}</p>`).join('\n        ');
}

function jaUrl(id: number): string {
  return `https://mirai-shigoto.com/ja/${id}`;
}

function bandLabel(field: string, band: string | null): string | null {
  if (!band) return null;
  const labels: Record<string, Record<string, string>> = {
    risk_band: { low: 'AI 影響 低', mid: 'AI 影響 中', high: 'AI 影響 高' },
    workforce_band: { small: '規模 小', mid: '規模 中', medium: '規模 中', large: '規模 大' },
    demand_band: { cool: '需要 安定', warm: '需要 旺盛', hot: '需要 過熱' },
  };
  return labels[field]?.[band] ?? null;
}

function bandClass(field: string, band: string | null): string {
  if (!band) return '';
  if (field === 'risk_band') return `band-${band}`;
  if (field === 'workforce_band') {
    return ({ small: 'band-low', mid: 'band-mid', medium: 'band-mid', large: 'band-high' } as Record<string, string>)[band] ?? '';
  }
  if (field === 'demand_band') {
    return ({ cool: 'band-low', warm: 'band-mid', hot: 'band-high' } as Record<string, string>)[band] ?? '';
  }
  return '';
}

function renderMetaRow(rec: Rec): string {
  const parts: string[] = [];
  const sectorName = rec.sector?.ja || '';
  if (sectorName) {
    const href = `/ja/sectors/${rec.sector?.id}`;
    parts.push(`<a class="sector-chip" href="${escapeHtml(href)}">${escapeHtml(sectorName)}</a>`);
  }
  for (const f of ['risk_band', 'workforce_band', 'demand_band'] as const) {
    const b = rec[f];
    const label = bandLabel(f, b);
    if (label) parts.push(`<span class="band ${bandClass(f, b)}">${escapeHtml(label)}</span>`);
  }
  if (!parts.length) return '';
  return `<div class="meta-row">${parts.join('')}</div>`;
}

// Shared template — single source of truth in src/templates/ProfileRadar.
// Adapts getProfile5()[id] into the narrow ProfileRadarInput shape;
// missing entry collapses to an all-null input which the template
// short-circuits to empty output.
function renderProfileRadar(rec: Rec): string {
  const profile = getProfile5()[String(rec.id)];
  return renderProfileRadarTemplate({
    creative: profile?.creative ?? null,
    social: profile?.social ?? null,
    judgment: profile?.judgment ?? null,
    physical: profile?.physical ?? null,
    routine: profile?.routine ?? null,
  });
}

function renderTopn(rec: Rec): string {
  const skills = rec.skills_top10 ?? [];
  const knowledge = rec.knowledge_top5 ?? [];
  const abilities = rec.abilities_top5 ?? [];
  if (!(skills.length || knowledge.length || abilities.length)) return '';
  function block(title: string, items: TopNEntry[]): string {
    if (!items.length) return '';
    const lis = items
      .map((it) => {
        const lab = it.label_ja || '';
        const score = (it.score ?? 0).toFixed(1);
        return `<li><span class="topn-name">${escapeHtml(lab)}</span><span class="topn-score">${score}</span></li>`;
      })
      .join('');
    return `<div class="topn-block"><h3>${escapeHtml(title)}</h3><ol>${lis}</ol></div>`;
  }
  const h2 = '必要なスキル・知識・能力';
  const body = block('スキル Top 10', skills) + block('知識 Top 5', knowledge) + block('能力 Top 5', abilities);
  return `<section class="topn" aria-label="${escapeHtml(h2)}"><h2>${escapeHtml(h2)}</h2><div class="topn-grid">${body}</div></section>`;
}

function buildOccFaqs(rec: Rec): [string, string][] {
  const name = rec.name_ja || '';
  const salary = rec.salary;
  const workers = rec.workers;
  const recruit = rec.recruit_ratio;
  const risk = rec.ai_risk;
  const rationale = (rec.ai_rationale_ja || '').trim().replace(/。$/, '').trim();
  const how = (rec.how_to_become_ja || '').trim();
  const skills = rec.skills_top10 ?? [];
  const faqs: [string, string][] = [];

  if (salary) {
    const monthly = salary / 12;
    const compare = salary > 500
      ? '日本全体の平均年収（約460万円）を上回る水準'
      : salary < 420
        ? '日本全体の平均年収（約460万円）を下回る水準'
        : '日本全体の平均年収（約460万円）と同程度';
    faqs.push([
      `${name}の年収はいくらですか？`,
      `${name}の平均年収は約${Math.trunc(salary)}万円（月収換算で約${Math.trunc(monthly)}万円）で、${compare}です。これは厚生労働省 jobtag のデータに基づく値で、勤務先・地域・経験により幅があります。`,
    ]);
  }

  if (risk !== null) {
    const tier = risk <= 3
      ? '低めで、AI に代替されにくい職業'
      : risk <= 6
        ? '中程度で、業務の一部が AI 補助に移行する可能性'
        : '高めで、業務の多くが AI による代替・補助の対象となる可能性';
    const rationaleStr = rationale ? `主な要因は「${rationale}」。` : '';
    faqs.push([
      `${name}のAI代替リスクはどれくらいですか？`,
      `${name}のAI影響度は10段階中 ${risk} で、${tier}です。${rationaleStr}これは Claude Opus 4.7 による独自スコア（非公式）で、職業選択の唯一の根拠としては使用しないでください。`,
    ]);

    const outlook = risk <= 3
      ? 'AI に代替されにくく、将来性は比較的安定'
      : risk >= 7
        ? 'AI による業務変化が大きく見込まれ、スキルアップや関連職種への転換も視野に'
        : 'AI 影響は中程度で、業務の一部が AI 補助に移行する可能性';
    const workersStr = workers ? `日本での就業者数は約${fmtInt(workers)}人。` : '';
    const recruitStr = recruit !== null && recruit !== undefined ? `求人倍率 ${recruit.toFixed(2)} 倍。` : '';
    faqs.push([
      `${name}の将来性はどうですか？`,
      `AI影響度 ${risk}/10。${outlook}な職業です。${workersStr}${recruitStr}個別の状況に応じた判断が重要です。`,
    ]);
  }

  if (how) {
    let first = how.split('。')[0].trim();
    if (!first) first = how.slice(0, 200).trim();
    if (first.length > 220) first = first.slice(0, 220).trimEnd() + '…';
    faqs.push([
      `${name}になるにはどうすればいいですか？`,
      `${first}。詳しい流れは本ページ内の「${name}になるには・必要な資格」セクションをご覧ください。`,
    ]);
  }

  if (skills.length) {
    const top3 = skills.slice(0, 3).map((s) => s.label_ja).filter(Boolean);
    if (top3.length) {
      const skillsStr = top3.join('、');
      let extra = '';
      if (skills.length >= 5) {
        const tail = skills.slice(3, 5).map((s) => s.label_ja).filter(Boolean);
        if (tail.length) extra = `加えて、${tail.join('、')}も重要です。`;
      }
      faqs.push([
        `${name}に必要なスキルは何ですか？`,
        `${name}で特に重視されるスキルは、${skillsStr}などです。${extra}詳しいスキル分布は本ページ内の「必要なスキル・知識・能力」セクションをご覧ください。`,
      ]);
    }
  }

  return faqs;
}

// Shared template — single source of truth in src/templates/OccFaq.
// Adapts the page-local buildOccFaqs(rec) Q/A tuples into the template.
function renderOccFaq(rec: Rec): string {
  return renderOccFaqTemplate(buildOccFaqs(rec));
}

// Shared template — single source of truth in src/templates/Transfer.
// Adapter resolves the nameLookup ?? title_ja ?? '?' fallback chain
// and slices to TOP_N (Phase C raised 4→5) before handing the flat
// candidate rows to the template.
function renderTransfer(rec: Rec, nameLookup: Record<number, string>): string {
  const path0 = getTransferPaths()[String(rec.id)];
  if (!path0) return '';
  const cards = path0.candidates.slice(0, 5).map((c) => ({
    id: c.id,
    name: nameLookup[c.id] || c.title_ja || '?',
    aiRisk: c.ai_risk,
    similarity: c.similarity,
  }));
  return renderTransferTemplate(cards);
}

// Shared template — single source of truth in src/templates/OrgsCerts.
// Adapts the page-local Rec into the narrow OrgsCertsInput shape.
function renderOrgsCerts(rec: Rec): string {
  return renderOrgsCertsTemplate({
    orgs: (rec.related_orgs ?? []).map((o) => ({
      nameJa: o.name_ja ?? null,
      url: o.url ?? null,
    })),
    certs: rec.related_certs_ja ?? [],
  });
}

// Shared template — single source of truth in src/templates/Provenance.
// Adapts the page-local Rec into the narrow ProvenanceInput shape.
function renderProvenance(rec: Rec): string {
  const dsv = rec.data_source_versions ?? {};
  return renderProvenanceTemplate({
    aiModel: rec.ai_model,
    aiScoredAt: rec.ai_scored_at,
    ipdNumeric: dsv.ipd_numeric ?? null,
    ipdDescription: dsv.ipd_description ?? null,
  });
}

// Shared template — single source of truth in src/templates/AiRiskDetail.
// Adapts the page-local Rec into the narrow AiRiskDetailInput shape.
function renderAiRiskDetail(rec: Rec): string {
  return renderAiRiskDetailTemplate({
    aiRisk: rec.ai_risk,
    rationaleLongJa: rec.ai_rationale_long_ja,
    displaceableTasksJa: rec.ai_displaceable_tasks_ja ?? [],
    resilientTasksJa: rec.ai_resilient_tasks_ja ?? [],
    horizon5yJa: rec.ai_horizon_5y_ja,
  });
}

function renderJsonLd(rec: Rec): string {
  const id = rec.id;
  const nameJa = rec.name_ja || '';
  const risk = rec.ai_risk;
  const rationaleJa = rec.ai_rationale_ja || '';
  const descJa = rec.desc_ja || '';
  const salaryMan = rec.salary;
  const workers = rec.workers;
  const age = rec.age;
  const hours = rec.hours;
  const recruit = rec.recruit_ratio;
  const hourly = rec.hourly_wage;
  const mhlwUrl = rec.url;
  const canonical = jaUrl(id);
  const pageName = risk !== null ? `${nameJa} — AI 影響 ${risk}/10` : `${nameJa} — mirai-shigoto.com`;
  const pageDesc = makeDefinition(rec) || rationaleJa || descJa || nameJa;
  const breadcrumbRoot = '日本の職業 AI 影響マップ';
  const homeUrl = 'https://mirai-shigoto.com/';

  const additional: JsonLdPropertyValue[] = [];
  if (risk !== null) {
    additional.push({
      '@type': 'PropertyValue',
      name: 'AI risk score (0-10)',
      value: risk,
      description: 'Claude Opus 4.7 による独自 LLM 推定。タスクレベルの AI 影響度を表し、職が消える確率ではありません。',
    });
  }
  if (workers) additional.push({ '@type': 'PropertyValue', name: 'Workforce size', value: workers, unitText: 'persons' });
  if (age) additional.push({ '@type': 'PropertyValue', name: 'Average age', value: age, unitText: 'years' });
  if (hours) additional.push({ '@type': 'PropertyValue', name: 'Monthly working hours', value: hours, unitText: 'hours' });
  if (recruit !== null && recruit !== undefined) additional.push({ '@type': 'PropertyValue', name: 'Effective recruit ratio', value: recruit });
  if (hourly) additional.push({ '@type': 'PropertyValue', name: 'Hourly wage', value: hourly, unitText: 'JPY/hour' });

  const occupationNode: JsonLdOccupation = {
    '@type': 'Occupation',
    '@id': `${canonical}#occupation`,
    name: nameJa,
    description: pageDesc,
    occupationLocation: { '@type': 'Country', name: 'Japan' },
    occupationalCategory: String(id),
    sameAs: mhlwUrl,
    additionalProperty: additional,
    isPartOf: { '@id': 'https://mirai-shigoto.com/#dataset' },
  };
  const altNames = rec.aliases_ja ?? [];
  if (altNames.length) {
    occupationNode.alternateName = altNames.length > 1 ? altNames : altNames[0];
  }
  if (rec.sector?.ja) occupationNode.industry = rec.sector.ja;
  const cls = rec.classifications ?? {};
  if (cls.mhlw_main || cls.jsoc_main) {
    occupationNode.occupationalCategory = cls.mhlw_main || cls.jsoc_main || String(id);
  }
  if (rec.skills_top10?.length) {
    occupationNode.skills = rec.skills_top10
      .map((s) => s.label_ja)
      .filter(Boolean);
  }
  if (rec.related_certs_ja?.length) {
    occupationNode.qualifications = rec.related_certs_ja;
  }
  if (salaryMan) {
    occupationNode.estimatedSalary = {
      '@type': 'MonetaryAmountDistribution',
      name: 'Annual salary (estimated mean from MHLW jobtag)',
      currency: 'JPY',
      duration: 'P1Y',
      median: Math.trunc(salaryMan * 10000),
    };
  }
  if (hours) {
    const annualHours = Math.trunc(hours * 12);
    occupationNode.workHours = `月平均 ${Math.trunc(hours)} 時間（年間約 ${annualHours} 時間）`;
  }
  const tasksLead = rec.tasks_lead_ja || '';
  if (tasksLead) occupationNode.responsibilities = tasksLead.slice(0, 600);
  if (rec.related_certs_ja?.length) {
    occupationNode.educationRequirements = '関連資格：' + rec.related_certs_ja.join('、');
  }
  const longHow = rec.how_to_become_ja || '';
  if (longHow) {
    const firstHow = longHow.split('。')[0].trim();
    if (firstHow && firstHow.length <= 240) {
      occupationNode.experienceRequirements = `${firstHow}。`;
    }
  }

  const graphNodes: JsonLdGraphNode[] = [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageName,
      description: pageDesc,
      isPartOf: { '@id': 'https://mirai-shigoto.com/#website' },
      about: { '@id': `${canonical}#occupation` },
      mainEntity: { '@id': `${canonical}#occupation` },
      primaryImageOfPage: `https://mirai-shigoto.com/api/og?id=${id}`,
      inLanguage: 'ja',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      publisher: { '@id': 'https://mirai-shigoto.com/#organization' },
      author: { '@id': 'https://mirai-shigoto.com/#organization' },
    },
    occupationNode,
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: breadcrumbRoot, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: nameJa, item: canonical },
      ],
    },
  ];

  const faqs = buildOccFaqs(rec);
  if (faqs.length) {
    graphNodes.push({
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: 'ja',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    });
  }

  return JSON.stringify({ '@context': 'https://schema.org', '@graph': graphNodes }, null, 2);
}

// ─── Page render ─────────────────────────────────────────────────────────────

interface PageProps {
  rec: Rec;
  related: Rec[];
  nameLookup: Record<number, string>;
  rankingHitsArr: Array<[number, Array<{ slug: string; rank: number }>]>;
  sameRiskArr: Array<[number, SpokeNeighbor[]]>;
}

const { rec, related, nameLookup, rankingHitsArr, sameRiskArr } = Astro.props as PageProps;

// Phase C: lookup THIS spoke's same-risk neighbors from the pre-built array.
const _sameRiskMap = new Map<number, SpokeNeighbor[]>(sameRiskArr);
const _myNeighbors = _sameRiskMap.get(rec.id) ?? [];
const sameRiskHtml = renderSameRiskSection(_myNeighbors, rec.ai_risk);

// Phase A: rebuild ranking-hits Map from the array passed via props.
// (Astro can't transport Map across getStaticPaths → component.)
const _rankingHitsByOcc = new Map<number, ReadonlyArray<RankingHit>>(
  rankingHitsArr.map(([id, arr]) => [id, arr.map((h) => ({ slug: h.slug as RankingHit['slug'], rank: h.rank }))]),
);
// Read this occupation's full DetailFileMin (we have rec but it's the legacy
// adapted shape; computeSpokeHubs needs the original shape's top-N arrays).
// We re-read the JSON file here since it's small and one extra read per page
// is negligible (~1ms per spoke build).
const _detailRaw = (() => {
  const padded = String(rec.id).padStart(4, '0');
  try {
    return JSON.parse(readFileSync(path.join(process.cwd(), 'public', 'data.detail', `${padded}.json`), 'utf8'));
  } catch {
    return null;
  }
})();
const _spokeHubs = _detailRaw
  ? computeSpokeHubs(_detailRaw, { rankingHitsByOcc: _rankingHitsByOcc })
  : { groups: [], total: 0 };
const relatedHubsHtml = renderSpokeHubsSection(_spokeHubs);

const id = rec.id;
const canonical = jaUrl(id);
const nameJa = rec.name_ja || '';
const risk = rec.ai_risk;
const riskStr = risk !== null ? `${risk}/10` : '—';
const rationaleJa = rec.ai_rationale_ja || '';
const descJa = (rec.desc_ja || '').slice(0, 240);
const longWhatJa = rec.what_it_is_ja || '';
const longHowJa = rec.how_to_become_ja || '';
const longCondJa = rec.working_conditions_ja || '';
const salaryMan = rec.salary;
const workers = rec.workers;
const age = rec.age;
const hours = rec.hours;
const recruit = rec.recruit_ratio;
const hourly = rec.hourly_wage;
const mhlwUrl = rec.url;

const riskClass = risk !== null ? `risk-${risk}` : 'risk-na';

const title = `${nameJa}の将来性・年収・AI影響度【${riskStr}】｜未来の仕事`;
const _riskDesc = risk !== null
  ? `AI代替リスクは10段階中${risk}と${risk <= 3 ? '低め' : risk <= 6 ? '中程度' : '高め'}`
  : 'AI影響度を分析';
const _salaryShort = salaryMan ? `年収${Math.trunc(salaryMan)}万円` : '';
const _workersShort = workers ? `就業者${fmtInt(workers)}人` : '';
const _dataParts = [_salaryShort, _workersShort].filter(Boolean).join('・');
const seoDesc = _dataParts
  ? `${nameJa}の${_riskDesc}。${_dataParts}。将来性やなり方、必要なスキルを詳しく解説。`
  : `${nameJa}の${_riskDesc}。将来性やなり方、必要なスキルを詳しく解説。`;

const ogTitle = title.slice(0, 120);
const ogDesc = seoDesc.slice(0, 300);

const rationale = rationaleJa || descJa;

// v2: one-line callout under risk badge — band-derived (no fabricated displacement %).
const oneLineText = risk === null
  ? 'AI 影響度未評価。'
  : risk >= 9
    ? '定型業務が中心。AI による自動化候補が多く、今すぐ転職方向を考えるレベル。'
    : risk >= 7
      ? 'AI 影響度が高い。業務再設計や転職方向の検討が早めに必要。'
      : risk >= 4
        ? 'AI 影響度は中程度。業務の一部が AI 補助に移行する見込み。'
        : '低 AI 影響。専門性と判断が必要な業務が中心で、当面は安定。';

// keywords meta
const aliases = rec.aliases_ja ?? [];
const kwTerms = [nameJa, ...aliases.slice(0, 8)].filter(Boolean);
const keywords = kwTerms.join(', ');

const ctxH2 = `${nameJa}とは`;
const ctxP = longWhatJa || descJa || rationaleJa;
const howH2 = `${nameJa}になるには・必要な資格`;
const condH2 = `${nameJa}の労働条件・働き方`;

const definition = makeDefinition(rec);
const ctxBodyHtml = ctxP ? formatParagraphs(ctxP) : '';
const ctxHtml = `<p class="definition">${escapeHtml(definition)}</p>\n        ${ctxBodyHtml}`.trimEnd();

const howSection = longHowJa
  ? `<section class="how-to-become" aria-label="${escapeHtml(howH2)}">
        <h2>${escapeHtml(howH2)}</h2>
        ${formatParagraphs(longHowJa)}
      </section>`
  : '';
const condSection = longCondJa
  ? `<section class="working-conditions" aria-label="${escapeHtml(condH2)}">
        <h2>${escapeHtml(condH2)}</h2>
        ${formatParagraphs(longCondJa)}
      </section>`
  : '';

const metaRowHtml = renderMetaRow(rec);
const aiRiskDetailHtml = renderAiRiskDetail(rec);
const profileHtml = renderProfileRadar(rec);
const topnHtml = renderTopn(rec);
const faqHtml = renderOccFaq(rec);
const transferHtml = renderTransfer(rec, nameLookup);
const orgsCertsHtml = renderOrgsCerts(rec);
const provenanceHtml = renderProvenance(rec);

const relH2 = '類似する職業';
const relPath = '/ja/';
const relatedListHtml = related
  .map((r) => {
    const rid = r.id;
    const rname = r.name_ja || `#${rid}`;
    const rrisk = r.ai_risk;
    const rriskStr = rrisk !== null ? `${rrisk}/10` : '—';
    return `<li><a class="r-name" href="${relPath}${rid}">${escapeHtml(rname)}</a><span class="r-risk">AI 影響 ${rriskStr}</span></li>`;
  })
  .join('\n          ');
const legacyRelatedHtml = transferHtml
  ? ''
  : `<section class="related" aria-label="${escapeHtml(relH2)}">
        <h2>${escapeHtml(relH2)}</h2>
        <ul>
          ${relatedListHtml}
        </ul>
      </section>`;

// Display formatters
const salaryInt = salaryMan ? Math.trunc(salaryMan) : '—';
const ageDisp = age ?? '—';
const hoursDisp = hours ? Math.trunc(hours) : '—';
const recruitDisp = recruit !== null && recruit !== undefined ? recruit : '—';
const hourlyDisp = hourly ? `¥${fmtInt(hourly)}` : '—';
const riskNumDisp = risk !== null ? risk : '—';
const workersCell = workers ? `${fmtInt(workers)} 人` : '—';
const ageCell = age ? `${ageDisp} 歳` : '—';
const hoursCell = hours ? `${hoursDisp} 時間/月` : '—';
const salaryCell = salaryMan
  ? `¥${fmtInt(Math.trunc(salaryMan * 10000))}（${salaryInt} 万円）`
  : '—（— 万円）';

const riskScoreJs = risk !== null ? String(risk) : 'null';
const riskTierJs = risk !== null && risk >= 7 ? "'high'" : risk !== null && risk >= 5 ? "'mid'" : "'low'";

const shareTextForPost = `${nameJa} の AI 影響度は ${riskStr}。日本 552 職種の AI 影響マップ（非公式・独自分析）。`;
const copyToastText = 'コピーしました';

const jsonLd = renderJsonLd(rec);

// JSON encode helper for inline JS string literals
function jsStr(s: string): string {
  return JSON.stringify(s);
}
---
<BaseLayout
  title={title}
  description={seoDesc}
  keywords={keywords}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDesc}
  ogImage={`https://mirai-shigoto.com/api/og?id=${id}`}
  ogType="article"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head" set:html={`
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    /* v2 Warm Editorial — single-theme; aliases (--bg/--fg/--accent/--border) preserved
       for canonical-css.ts footer + render-function selectors. */
    :root{
      --cream:#FAF6EE;--cream-2:#F2EADB;--paper:#FFFFFF;
