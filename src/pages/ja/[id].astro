---
/**
 * [id].astro — per-occupation detail page (JA only).
 *
 * Renders one HTML page per occupation, generated statically via
 * getStaticPaths() reading public/data.detail/<id>.json. Page sections:
 *   - JSON-LD (WebPage + Occupation + BreadcrumbList + FAQPage)
 *   - Risk card + AI rationale long-form (if present)
 *   - Stats dl
 *   - "what is", "how to become", "working conditions" sections
 *   - 5-axis profile radar (data.profile5.json)
 *   - Top-N skills/knowledge/abilities
 *   - FAQ (auto-generated from data)
 *   - Transfer paths (data.transfer_paths.json) or legacy related fallback
 *   - Orgs/certs side-by-side
 *   - Provenance footnote + sources list + share/follow block
 *
 * The inline CSS is preserved verbatim from the v1.x design — a future
 * refactor can extract it into shared classes once we can see what's truly
 * common across detail / sector / ranking pages.
 */
import { readFileSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { escapeHtml } from '@/lib/safe-html';
import { fmtInt } from '@/lib/num';
import { renderProvenance as renderProvenanceTemplate } from '@/templates/Provenance';
import { renderOrgsCerts as renderOrgsCertsTemplate } from '@/templates/OrgsCerts';
import { renderAiRiskDetail as renderAiRiskDetailTemplate } from '@/templates/AiRiskDetail';
import { renderOccFaq as renderOccFaqTemplate } from '@/templates/OccFaq';
import { renderProfileRadar as renderProfileRadarTemplate } from '@/templates/ProfileRadar';
import { renderTransfer as renderTransferTemplate } from '@/templates/Transfer';
import {
  computeSpokeHubs,
  buildRankingHitsByOcc,
  renderSpokeHubsSection,
  RELATED_HUBS_CSS,
  type RankingHit,
} from '../../data/lib/spoke-hub-graph';
import {
  buildSameRiskNeighbors,
  renderSameRiskSection,
  SAME_RISK_CSS,
  type SpokeNeighbor,
} from '../../data/lib/spoke-spoke-graph';

// ─── Build-time data sources ────────────────────────────────────────────────
// NOTE: Astro hoists getStaticPaths into its own module scope, so anything it
// references must be either inline-defined inside it or imported at the top.
// We expose DATA_DETAIL etc. through a single helper module so getStaticPaths
// and the body share the same data. To keep this PR self-contained, we keep
// constants and helpers at module scope but do all I/O inside the bodies of
// getStaticPaths and the page render — Astro's static analysis allows that.

const DATE_PUBLISHED = '2026-04-25';
const DATE_MODIFIED = '2026-04-30';
const RELATED_COUNT = 5;

function readJsonSafe<T = unknown>(p: string): T | null {
  try {
    return JSON.parse(readFileSync(p, 'utf8')) as T;
  } catch {
    return null;
  }
}

function paths(): { detail: string; profile5: string; transfer: string } {
  const repo = path.resolve(process.cwd());
  return {
    detail: path.join(repo, 'public', 'data.detail'),
    profile5: path.join(repo, 'public', 'data.profile5.json'),
    transfer: path.join(repo, 'public', 'data.transfer_paths.json'),
  };
}

