---
/**
 * about.astro — データについて（出典の要約・スコアの目安・用語集・FAQ・免責）。
 *
 * 採点の詳しい手順とデータ整理は /methodology に集約済み。本ページは出典の要約、
 * 読者向けの目安、用語集（旧 /about/glossary を統合）、注意事項、FAQ を担当する。
 * 共通文書 CSS は canonical/doc.ts。インライン JS なし（theme toggle は廃止）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { CANONICAL_DOC_CSS, heatBg } from '@/lib/canonical/doc';

// Last content-change date — bump when this page's content actually changes.
// Static (NOT the build clock): a build-time date drifted the SEO baseline on
// every new UTC day. See ai-adoption.ts for the data-derived equivalent.
const pageLastUpdated = '2026-06-02';

const SCALE: { range: string; mid: number; desc: string }[] = [
  { range: '0–2（最小）', mid: 1, desc: '物理・現場仕事（清掃、林業、調理、配送）' },
  { range: '2–4（低）', mid: 3, desc: '肉体労働＋一部対人（建設、介護、ドライバー、美容師）' },
  { range: '4–6（中）', mid: 5, desc: '知識・対人・判断の混合（看護師、教員、医師、管理職、技術者）' },
  { range: '6–8（高）', mid: 7, desc: '情報・事務・専門の知識労働（会計士、士業、プログラマー、各種事務）' },
  { range: '8–10（最大）', mid: 9, desc: '定型デジタル処理（データ入力、文字起こし、コールセンター、翻訳）' },
];

const GLOSSARY: { t: string; en: string; d: string }[] = [
  { t: 'AI 影響度', en: 'AI Impact / Transformation', d: '各職業の仕事のうち AI でこなせる部分がどれくらいかを 0〜10 で評価したスコア。本サイト独自分析（Claude Opus 4.8・AIOIS-10）で算出。仕事が消える確率ではなく、仕事がどれだけ作り変えられるかを示す。' },
  { t: 'Risk Band', en: 'low / mid / high', d: 'AI 影響度の 3 区分：low（≤3.9）／ mid（≤6.9）／ high（>6.9）。視覚的なリスク感の表現。' },
  { t: 'Demand Band', en: 'cold / normal / hot', d: '有効求人倍率の 3 区分：cold（<1.0）／ normal（<2.0）／ hot（≥2.0）。労働市場の需給状況。' },
  { t: 'Workforce Band', en: 'small / mid / large', d: '就業者数の 3 区分：small（<2 万人）／ mid（<10 万人）／ large（≥10 万人）。労働市場の規模。' },
  { t: '有効求人倍率', en: 'Effective Recruit Ratio', d: '1 人の求職者あたり何件の求人があるかを表す比率。1.0 超で売り手市場（人手不足傾向）、1.0 未満で買い手市場。' },
  { t: 'セクター', en: 'Sector', d: '本サイトの 16 業界分類。職業を理解しやすい単位でグループ化（医療・福祉・教育・建設・IT 等）。' },
  { t: 'RIASEC', en: 'Holland Code', d: 'John Holland 提唱の職業興味 6 類型：R（現実的）／ I（研究的）／ A（芸術的）／ S（社会的）／ E（企業的）／ C（慣習的）。' },
  { t: 'IPD', en: '職業情報データベース v7.00', d: 'JILPT が公開する職業情報データベース。本サイトのソースデータの一つ。556 職業 × 数百項目の構造化データ。' },
  { t: 'Transfer Path', en: '転職候補', d: '各職業から「同じ業界＋より AI 影響度が低い」候補職業を cosine 類似度で抽出した転換マップ。各職業ページに 3 候補を表示。' },
  { t: 'Top-N', en: '上位スキル/知識/能力', d: '各職業の IPD スコアが高い順に上位 N 項目を抽出したリスト。スキル 10／知識 5／能力 5 がデフォルト。' },
  { t: '業務独占資格', en: 'Exclusive License', d: '法律で「資格保有者しかできない」と定められた業務範囲がある資格。医師・看護師・薬剤師・弁護士・公認会計士など。最も入りにくい高い壁。' },
  { t: '名称独占資格', en: 'Title-Only License', d: '資格保有者しか名乗れないが業務独占はない資格。介護福祉士・社会福祉士・管理栄養士等。市場価値はあるが業務独占ほどの保護はない。' },
];

const jsonLd = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mirai-shigoto.com/about#webpage",
      "name": "データについて — mirai-shigoto.com",
      "url": "https://mirai-shigoto.com/about",
      "description": "mirai-shigoto.com のデータソース要約、AI 影響スコアの目安、用語集、注意事項、よくある質問。",
      "inLanguage": ["ja"],
      "isPartOf": { "@id": "https://mirai-shigoto.com/#website" },
      "about": { "@id": "https://mirai-shigoto.com/#organization" },
      "publisher": { "@id": "https://mirai-shigoto.com/#organization" },
      "datePublished": "2026-05-02",
      "dateModified": "${pageLastUpdated}",
      "breadcrumb": { "@id": "https://mirai-shigoto.com/about#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mirai-shigoto.com/about#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "日本の職業 AI 影響マップ", "item": "https://mirai-shigoto.com/" },
        { "@type": "ListItem", "position": 2, "name": "データについて", "item": "https://mirai-shigoto.com/about" }
      ]
    }
  ]
}`;
---
<BaseLayout
  title="データについて — mirai-shigoto.com"
  description="mirai-shigoto.com のデータソース要約、AI 影響スコアの目安、用語集、注意事項、FAQ。詳しい採点手順は評価プロセスへ。"
  canonical="https://mirai-shigoto.com/about"
  keywords="未来の仕事, AI 影響度, データ出典, 厚生労働省 jobtag, JILPT, 職業情報データベース, Claude Opus 4.8, AIOIS-10, 用語集, FAQ, mirai shigoto"
  ogTitle="データについて — mirai-shigoto.com"
  ogDescription="データソース要約、AI 影響スコアの目安、用語集、注意事項、FAQ。"
  ogImage="https://mirai-shigoto.com/api/og?page=about"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={CANONICAL_DOC_CSS} />

  <div id="wrapper">
    <div class="top-banner">
      <span class="badge">非公式</span>
      <span>本サイトは独自分析サイトです。厚労省・JILPT・job tag の公式見解ではありません。</span>
    </div>

    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>データについて</span></nav>

    <h1>データに<span class="accent">ついて</span></h1>
    <p class="subtitle">データソースの要約・スコアの目安・用語集・よくある質問</p>
    <p class="meta-line">最終更新 {pageLastUpdated}</p>

    <p class="lead">
      本サイトの基礎データは、すべて<strong>公開されている公的情報</strong>から取得しています。AI 影響度スコアのみが独自分析です。採点の詳しい手順とデータの整え方は <a href="/methodology">評価プロセス</a>、基準そのものの定義は <a href="/standard">AIOIS-10 標準</a> を参照してください。
    </p>

    <h2><span class="num">1.</span>データソース（要約）</h2>
    <div class="src-card">
      <div class="src-row"><span class="src-label">職業マスタ</span><span><a href="https://shigoto.mhlw.go.jp/User/" target="_blank" rel="noopener noreferrer">厚生労働省「職業情報提供サイト（job tag）」</a>／著作権者 JILPT「職業情報データベース」v7.00</span></div>
      <div class="src-row"><span class="src-label">労働統計</span><span>賃金構造基本統計調査・労働力調査・ハローワーク求人統計（年収・就業者数・有効求人倍率）</span></div>
      <div class="src-row"><span class="src-label">AI 影響スコア</span><span>本サイト独自分析（Claude Opus 4.8 採点、2026-05-30、<a href="/standard">AIOIS-10</a> v1.0）</span></div>
    </div>
    <p>各出典の正式名・利用条件・引用ルールの詳細は <a href="/methodology">評価プロセス</a> にまとめています。</p>

    <h2><span class="num">2.</span>スコアの目安</h2>
    <p>トップ指標「AI 影響」は <strong>0.0〜10.0</strong> の<strong>変化の大きさ</strong>（仕事のやり方が AI でどれだけ作り変えられるか）です。統計調査ではなく、職業データにもとづく現行 AI 時点の見立てです。</p>
    <div class="scale">
      <dl>
        {SCALE.map((s) => (
          <>
            <dt style={`background:${heatBg(s.mid, 'up')};border-radius:5px;padding:2px 8px`}>{s.range}</dt>
            <dd>{s.desc}</dd>
          </>
        ))}
      </dl>
    </div>
    <p><em>注意：変化の大きさが高い ≠ 仕事が消える。</em>「仕事がどれだけ作り変えられるか」であり「失職確率」ではありません。後者は別指数の<strong>仕事が減るリスク</strong>（多くの仕事でより低く出ます）。点が高い仕事の多くは<strong>なくなるのではなく作り変えられます</strong>。</p>

    <h2><span class="num">3.</span>用語集</h2>
    <div class="glossary">
      {GLOSSARY.map((g) => (
        <div class="gloss-item">
          <h3>{g.t}<span class="term-en">{g.en}</span></h3>
          <p>{g.d}</p>
        </div>
      ))}
    </div>

    <h2><span class="num">4.</span>注意事項</h2>
    <p><strong>本サイトは非公式サイトです。</strong>厚生労働省、job tag、JILPT その他の公的機関と<strong>提携・協力・承認関係にあるものではありません</strong>。</p>
    <p>AI 影響度スコア、リスク分類、ランキング、可視化結果は、本サイト独自の分析・加工によるもので、<strong>公的機関の公式見解、評価、推奨を示すものではありません</strong>。</p>
    <p>本サイトの情報は、職業選択、転職、採用、人事判断等に関する<strong>参考情報</strong>として提供しており、特定の判断や結果を保証するものではありません。重要な意思決定にあたっては、複数の情報源をご確認ください。</p>
    <p>掲載内容について公的機関（厚労省・JILPT）への問い合わせは行わないでください。本サイトは独自分析であり、公式見解とは独立しています。詳細は <a href="/compliance">コンプライアンス</a> ページをご確認ください。</p>

    <h2><span class="num">5.</span>よくある質問</h2>
    <div class="faq">
      <details>
        <summary>このスコアは公式なものですか？</summary>
        <p>いいえ。<strong>厚生労働省や JILPT の公式評価ではありません</strong>。本サイトの独自分析（LLM による採点）です。参考情報としてご利用ください。</p>
      </details>
      <details>
        <summary>AI 影響 9/10 と出ました。仕事を辞めるべきですか？</summary>
        <p>いいえ。スコアは「仕事が消える」予言ではなく、「AI が業務をどれほど作り変えるか」の推定値です。多くの高スコア職は<strong>置換ではなく再構成</strong>されます。ツールを使いこなすスキル習得の方が重要です。</p>
      </details>
      <details>
        <summary>採点はどれくらい正確ですか？</summary>
        <p>これは LLM の主観評価で、統計的検証はされていません。同じ職業でも別の採点者なら ±1〜2 ぶれる可能性があります。<strong>絶対値より相対比較</strong>（A 職業と B 職業の大小関係）の方が情報量があります。手順は <a href="/methodology">評価プロセス</a> を参照。</p>
      </details>
      <details>
        <summary>どれくらいの頻度で更新されますか？</summary>
        <p>AI スコアは LLM の能力進化に応じて更新します。直近の採点は 2026-05-30（<a href="/standard">AIOIS-10</a> v1.0）。元データ（jobtag／JILPT）の更新サイクルとは独立に、本サイトが必要と判断したタイミングで再採点します。</p>
      </details>
      <details>
        <summary>自分の職業がリストに見つかりません。</summary>
        <p>本サイトは厚労省 jobtag の 556 職業を採用しています。新しい職種（プロンプトエンジニア、AI 倫理担当など）はまだ含まれていません。<strong>既存の最も近い職業</strong>を参考にしてください。</p>
      </details>
    </div>

    <h2><span class="num">6.</span>運営会社</h2>
    <p>本サイト「mirai-shigoto.com」は、<strong>ZKSC株式会社</strong>（東京・日本／<a href="https://zksc.io" target="_blank" rel="noopener noreferrer">zksc.io</a>）が運営する独自分析プロジェクトです。ZKSC は金融戦略とテクノロジーを軸に、構造化された分析とデータの可視化に取り組んでいます。</p>
    <p>本サイトの AI 影響度スコアは Claude Opus 4.8 による独立した分析（<a href="/standard">AIOIS-10</a>）であり、公的機関の公式見解を代表するものではありません。</p>

    <Footer />
  </div>
</BaseLayout>
