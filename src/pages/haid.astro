---
/**
 * haid.astro — HAID v1.0 標準ページ（人類と AI の距離 10 段階の定義）。
 *
 * 定義のみ。人数・確度チップ・インライン JS なし。共通文書 CSS は
 * canonical/doc.ts（CANONICAL_DOC_CSS）。ページ固有色は _haid-css.ts。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { CANONICAL_DOC_CSS } from '@/lib/canonical/doc';
import { OCCUPATION_COUNT, siteConfig } from '@/site/config';
import {
  HAID_BOUNDARIES,
  HAID_CANONICAL_PATH,
  HAID_CASES,
  HAID_CERTAINTY_JA,
  HAID_GRADE_JA,
  HAID_LEAD_JA,
  HAID_LEVELS,
  HAID_LEVELS_NOTE_JA,
  HAID_LICENSE,
  HAID_LICENSE_URL,
  HAID_NAME_JA,
  HAID_RELATIONS,
  HAID_SPEC_DATE,
  HAID_SPEC_VERSION,
  HAID_TERMS,
  haidBoundaryBefore,
} from '@/site/haid-spec';
import { HAID_CSS } from './_haid-css';

const canonical = `${siteConfig.origin}${HAID_CANONICAL_PATH}`;
const pageLastUpdated = HAID_SPEC_DATE; // static: the page changes only when the spec changes
const title = 'HAID 標準 — 人類と AI の距離 10 段階 | mirai-shigoto.com';
const description = '人と生成 AI の関係を、行動で判定できる 10 の段階に分けて測る公開基準 HAID v1.0。無縁・道具・同席・一体の 4 つの関係、用語の定義、判定規則、測定と報告の方法、境界事例。';
const ogTitle = 'HAID 標準 — 人類と AI の距離 10 段階';
const ogDescription = '人と生成 AI の関係を 10 の段階で測る公開基準。無縁・道具・同席・一体の 4 つの関係。利用率ではなく、段階の分布で報告する。';
const keywords = 'HAID, 人類と AI の距離, 10 段階, 生成 AI, AI 利用, 公開基準, スタンダード, Human-AI Distance';

const relationJa = Object.fromEntries(HAID_RELATIONS.map((r) => [r.id, r.ja]));

const CERTAINTY_ITEMS = [
  { key: 'measured', explanation: '統計機関の定義にもとづく実測値' },
  { key: 'residual', explanation: '他の段階から引いて出す値' },
  { key: 'lower_bound', explanation: '1 社の公表値だけで下限が決まり、上限は分からない' },
  { key: 'range', explanation: '錨点と重なり率から低・中・高で推定できる' },
  { key: 'none', explanation: '公開データが存在しない' },
] as const;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      name: 'HAID 標準 — 人類と AI の距離 10 段階',
      url: canonical,
      description,
      inLanguage: ['ja'],
      isPartOf: { '@id': `${siteConfig.origin}/#website` },
      datePublished: HAID_SPEC_DATE,
      dateModified: pageLastUpdated,
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      mainEntity: { '@id': `${canonical}#techarticle` },
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.lead'] },
    },
    {
      '@type': 'TechArticle',
      '@id': `${canonical}#techarticle`,
      headline: 'HAID — 人類と AI の距離 10 段階の定義',
      description,
      abstract:
        'HAID (Human–AI Distance) is a ten-level, behaviourally defined scale of how close a person is to generative AI. Levels nest (each level implies the ones below) and group into four relations: Unreached (1–2), Tool (3–6), Presence (7–8), Union (9–10). Populations are reported as level distributions, never as a single adoption rate. Payment is an attribute, not a level.',
      keywords,
      url: canonical,
      inLanguage: 'ja',
      datePublished: HAID_SPEC_DATE,
      dateModified: pageLastUpdated,
      version: HAID_SPEC_VERSION,
      license: HAID_LICENSE_URL,
      author: { '@id': `${siteConfig.origin}/#organization` },
      publisher: { '@id': `${siteConfig.origin}/#organization` },
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
      about: {
        '@type': 'DefinedTermSet',
        '@id': `${canonical}#haid`,
        name: 'HAID',
        alternateName: HAID_NAME_JA,
        hasDefinedTerm: HAID_LEVELS.map((l) => ({
          '@type': 'DefinedTerm',
          '@id': `${canonical}#level-${l.level}`,
          termCode: `HAID-${l.level}`,
          position: l.level,
          name: l.ja,
          alternateName: l.en,
          description: l.criterion_ja,
          inDefinedTermSet: { '@id': `${canonical}#haid` },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '日本の職業 AI 影響マップ', item: `${siteConfig.origin}/` },
        { '@type': 'ListItem', position: 2, name: 'HAID 標準', item: canonical },
      ],
    },
  ],
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={`${siteConfig.origin}/api/og?page=haid`}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={CANONICAL_DOC_CSS + HAID_CSS} />

  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>HAID 標準</span></nav>

    <h1>HAID <span class="accent">標準</span></h1>
    <p class="subtitle">人類と AI の距離を 10 段階で測る、公開リファレンス基準（v{HAID_SPEC_VERSION}）</p>
    <p class="meta-line">制定 {HAID_SPEC_DATE} ・ HAID v{HAID_SPEC_VERSION} ・ {HAID_LICENSE}</p>

    <p class="lead">{HAID_LEAD_JA[0]}</p>
    <p class="lead">{HAID_LEAD_JA[1]}</p>
    <p>定義は本ページ。世界の現状（各段階の人数）は <a href="/aiadoption">人類と AI の距離 — 現状</a> に四半期ごとに公開します。職業の側から AI を測る基準は <a href="/standard">AIOIS-10</a> です。</p>

    <h2>4 つの関係</h2>
    <p>10 の段階は 4 つの関係に分かれます。関係のあいだの境目は<strong>程度の差ではなく、種類の差</strong>です。同じ関係の中では、上の段階は下の段階の条件をすべて満たします。</p>
    <div class="emfo haid-emfo">
      {HAID_RELATIONS.map((r) => (
        <div class={`stage s${r.order}`}>
          <div class="n">{r.tagline_ja}</div>
          <div class="en">{r.ja} <small>{r.en}</small></div>
          <div class="d">{r.description_ja}</div>
          <div class="lv">第 {r.levels[0]}〜{r.levels[1]} 段階</div>
        </div>
      ))}
    </div>

    <h2>10 の段階</h2>
    <p>各段階の判定条件は、特定の製品や国に依存しない行動で書いてあります。「観測窓」はその行動をいつまでさかのぼって数えるか、「測り方」はその段階をどの等級のデータで測れるかです。</p>
    {HAID_LEVELS.map((l) => {
      const b = haidBoundaryBefore(l.level);
      return (
        <>
          {b && (
            <div class="haid-boundary" role="separator" aria-label={`境目：${b.ja}`}>
              <span class="c">第 {b.from} → {b.to} 段階</span>
              <span class="t">{b.ja}</span>
            </div>
          )}
          <div class={`dim haid-rel-${l.relation}`} id={`level-${l.level}`}>
            <div class="head">
              <span class="code">第 {l.level} 段階</span>
              <span class="name">{l.ja}<span class="en">{l.en}</span></span>
              <span class="stage-tag">{relationJa[l.relation]}</span>
            </div>
            <div class="body">
              {l.criterion_ja}
              <div class="haid-meta">
                <span>観測窓：{l.window_ja}</span>
                <span>測り方：{l.measurement_ja}</span>
              </div>
            </div>
          </div>
        </>
      );
    })}
    <p>{HAID_LEVELS_NOTE_JA}</p>

    <h2>判定の規則</h2>
    <ul>
      <li>各人は、条件を満たす段階のうち最も高いものに属する。段階は第 1 から第 10 に向かって「AI に近い」と定義する。</li>
      <li>集団については、第 k 段階以上にいる人数 N(≥k) と、ちょうど第 k 段階にいる人数 n(k) の両方を報告する。N(≥k) は k について単調に減る。n(1) から n(10) の合計は人類の総数に一致する。</li>
      <li>分母は常に人類の総数とし、端末数・契約数・アカウント数を分母にしない。</li>
    </ul>
    <div class="formula">
      <div class="flabel">Nesting</div>
      <div class="row"><span class="k">N(≥k)</span> ＝ 第 k 段階以上にいる人数。k が大きいほど単調に減る。<br /><span class="k">n(k)</span> ＝ N(≥k) − N(≥k+1)。n(1) から n(10) の合計は人類の総数に一致する。</div>
    </div>

    <h2>用語の定義</h2>
    <div class="glossary">
      {HAID_TERMS.map((t) => (
        <div class="gloss-item">
          <h3>{t.ja}<span class="term-en">{t.en}</span></h3>
          <p>{t.definition_ja}</p>
        </div>
      ))}
    </div>

    <h2>測定と報告の方法</h2>
    <ul>
      <li>データの 4 等級: A {HAID_GRADE_JA.A} / B {HAID_GRADE_JA.B} / C {HAID_GRADE_JA.C} / D {HAID_GRADE_JA.D}。各段階の数字は、どの等級を使ったかを明記する。</li>
      <li>口径は 30 日。週次の数字を月次に直すときは、同じ事業者が同時に公表した比率、または出典を明記した調査の比率だけを使う。手書きの係数は使わない。</li>
      <li>複数の製品にまたがる同一人物の重なりは、第 4・5 段階でのみ引く。重なり率は調査にもとづき、公開する。</li>
      <li>各段階は低・中・高の 3 値で報告する。見出しの数字は有効数字 1 けた、表は 2 けた。</li>
      <li>時点は用いた錨点の最新日付。四半期ごとに 1 回公開し、各回に版番号を付ける。過去の回は書き換えない。</li>
    </ul>

    <h2>確度と図示の規則</h2>
    <p>数字には必ず確度を添えます。確度は図の描き方も決めます。</p>
    <div class="scale">
      <dl>
        {CERTAINTY_ITEMS.map((item) => (
          <><dt>{HAID_CERTAINTY_JA[item.key] + '\u00a0'}</dt><dd>{item.explanation}</dd></>
        ))}
      </dl>
    </div>
    <ul>
      <li>確度が「下限のみ」の段階は、隣の段階との境目を実線で描かない。点図では境目をぼかすか 1 つの帯にまとめ、幅を注記する。</li>
      <li>人数が極端に少ない段階は、実面積では見えないため最小サイズで描き、「実際の割合より大きく描いている」と明記する。</li>
      <li>4 つの関係の境目 3 本は、段階の境目より太く描く。</li>
    </ul>
    <div class="scale">
      <dl>
        {HAID_BOUNDARIES.map((b) => (
          <><dt>第 {b.from} → {b.to} 段階</dt><dd>{b.ja} <small>{b.en}</small></dd></>
        ))}
      </dl>
    </div>

    <h2>境界事例（v{HAID_SPEC_VERSION} の裁定）</h2>
    <p>判定に迷う場面の裁定です。事例は版を重ねて追加しますが、一度出した裁定は動かしません。</p>
    <div class="wrap-x" tabindex="0" role="region" aria-label="横スクロールできる表">
      <table class="ex">
        <thead>
          <tr><th>事例</th><th>段階</th><th>注記</th></tr>
        </thead>
        <tbody>
          {HAID_CASES.map((c) => (
            <tr>
              <td>{c.case_ja}</td>
              <td>{c.levels.length === 0 ? '対象外' : c.levels.map((n) => `第 ${n} 段階`).join(' / ')}</td>
              <td>{c.note_ja ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>準拠</h2>
    <div class="callout">
      <p>完全準拠: 10 の段階すべてを、本標準の定義・観測窓・口径で、確度と出典を付けて報告する。</p>
      <p>部分準拠: 一部の段階だけを報告する。ただし定義・観測窓・口径は変えない。表記例: 「HAID v1.0 に部分準拠（第 4・5 段階）」。</p>
      <p>調査票に「過去 30 日に、自分から生成 AI に入力しましたか」「過去 7 日に」の 2 問を本標準の定義どおりに置けば、第 4・5 段階への部分準拠になる。</p>
    </div>

    <h2>改定・引用・ライセンス</h2>
    <ul>
      <li>段階の番号は付け直さず、再利用しない。一度「第 7 段階」と引用されたら、その意味は変えない。</li>
      <li>境界事例の追加は小版（v1.1）、段階の意味の変更は大版（v2.0）。旧版は消さずに残す。</li>
      <li>将来より細かい区別が要るときは、段階の内側で枝分かれさせる（例: 8.1）。第 11 段階は作らない。第 10 段階は定義上の天井とする。</li>
      <li>引用: mirai-shigoto.com「人類と AI の距離 10 段階（HAID）」v1.0。現状の数字を引くときは公開回（例: 2026-Q3）を添える。</li>
      <li><strong>ライセンス</strong>：定義と公開データは {HAID_LICENSE}。機械可読の定義は <a href="/data.haid-spec.json">data.haid-spec.json</a>。</li>
    </ul>
    <h3>改定履歴</h3>
    <ul>
      <li>v1.0 — 2026-09-11 制定。</li>
    </ul>

    <h2>測らないもの（既知の限界）</h2>
    <ul>
      <li>仕事での利用は段階に含めない。世界全体の人数が存在しないため、各国の調査を参照として添えるにとどめる。</li>
      <li>対価は段階ではなく属性。「第 4 段階以上のうち、対価を払っている人」として別に報告する。</li>
      <li>脳と機械の直接接続のような身体的な関係は、この尺度の外に置く。</li>
      <li>AI そのものは分母に入れない。分母は人であり、これは版を重ねても変えない。</li>
      <li>第 3 段階は 1 社の公表値だけで下限が決まるため、真の値はつねにそれより大きい。第 6 段階は現時点ではコーディング用のエージェントしか観測できない。</li>
    </ul>

    <p>職業の側から見た AI の影響は <a href="/standard">AIOIS-10 標準</a>、日本の {OCCUPATION_COUNT.SCORED} 職業への当てはめは <a href="/">職業マップ</a> と <a href="/me">自分の現在地</a> へ。</p>
    <Footer />
  </div>
</BaseLayout>
