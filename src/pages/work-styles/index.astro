---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { OCCUPATION_COUNT } from '@/site/config';
import { WORK_STYLES_CONFIGS } from '@/views/genre-configs';
import { loadAllDetails, buildGenreResult, buildGenreIndexSpotlight } from '@/views/genre-hub';
import { renderGenreIndexJsonLd, renderGenreHubIndexCards, renderGenreIndexSpotlight, GENRE_HUB_CSS } from '@/templates/Hub';

const details = loadAllDetails();
const n = WORK_STYLES_CONFIGS.length;
const cards = WORK_STYLES_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return {
    slug: cfg.slug, short_ja: cfg.short_ja, description_ja: cfg.description_ja,
    count: r.items.length, top: r.items[0]?.name_ja ?? '',
    countLabel: `TOP ${r.items.length} 職業`,
  };
});

const canonical = 'https://mirai-shigoto.com/work-styles';
const title = `働き方から職業を探す｜業務形態 ${n} 軸別 hub | 未来の仕事`;
const seoDesc = '屋内/屋外・移動・シフト・チームなど、働き方の特性で職業を分類。自分のライフスタイルに合う仕事を探せます。';
const jsonLd = renderGenreIndexJsonLd(canonical, '働き方から探す', seoDesc);
const cardsHtml = renderGenreHubIndexCards(cards, 'work-styles');
const spotlightHtml = renderGenreIndexSpotlight(buildGenreIndexSpotlight(details, WORK_STYLES_CONFIGS, 12));
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=work-styles" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>働き方から探す</span></nav>
    <header id="content">
      <h1><span class="accent">働き方から職業を探す</span></h1>
      <p class="sub">業務形態 <strong>{n} 軸</strong> で {OCCUPATION_COUNT.SCORED} 職業を分類</p>
      <p class="intro">屋外/屋内・移動の多さ・シフト勤務・チーム作業・座り仕事など、働き方の特性で職業を整理しました。ライフスタイルとの相性で職業を選びたい人向け。</p>
    </header>
    <section><h2>働き方 {n} 軸</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Fragment set:html={spotlightHtml} />
    <Footer />
  </div>
</BaseLayout>
