---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '@/site/config';
import { AI_ADOPTION_CSS } from './_ai-adoption-css';

type FreshnessStatus = 'fresh' | 'review_needed' | 'stale';

interface SourceRow {
  id: string;
  metric: string;
  entity: string;
  value: number;
  derived_value: number;
  unit: string;
  period: string;
  published_at: string;
  age_days: number;
  source_label: string;
  source_name: string;
  source_url: string;
  confidence: 'high' | 'medium' | 'low';
  stale_after_days: number;
  freshness_status: FreshnessStatus;
  used_by: string[];
  note: string;
}

interface LayerRow {
  id: 'N_dev' | 'N_pro' | 'N_free' | 'N_passive';
  label_ja: string;
  short_label_ja: string;
  formula_ja: string;
  rationale_ja: string;
  risk_ja: string;
  color: string;
  value: number;
  freshness_status: FreshnessStatus;
  inputs: SourceRow[];
}

interface ParameterDef {
  value: number;
  label_ja: string;
  rationale_ja: string;
}

interface DashboardPayload {
  model_version: string;
  period: string;
  updated_at: string;
  title_ja: string;
  subtitle_ja: string;
  summary: {
    self_users: number;
    developer_users: number;
    paid_users: number;
    free_users: number;
    passive_only_users: number;
    internet_users: number;
    population: number;
    offline_people: number;
  };
  layers: LayerRow[];
  assumptions: {
    parameters: Record<string, ParameterDef>;
  };
  sources: SourceRow[];
}

const dataPath = join(process.cwd(), 'public', 'data.ai-adoption.json');
const dashboard = JSON.parse(readFileSync(dataPath, 'utf-8')) as DashboardPayload;
const canonical = `${siteConfig.origin}/aiadoption`;
const { summary } = dashboard;

// ---------------------------------------------------------------------------
// Formatting
// ---------------------------------------------------------------------------
const compactFormatter = new Intl.NumberFormat('ja-JP', { notation: 'compact', maximumFractionDigits: 1 });
const compact = (value: number): string => compactFormatter.format(value);

// Headline rounding: whole 億 only ("およそ 15 億人"), never a decimal.
const approxOku = (value: number): string => `${Math.round(value / 1e8)} 億`;

// `updated_at` is the latest observation `as_of_date` (see projection). The
// first screen states the month only; the exact day sits with the sources.
const asOfMonth = ((): string => {
  const match = /^(\d{4})-(\d{2})/.exec(dashboard.updated_at);
  if (!match) return dashboard.updated_at;
  return `${match[1]} 年 ${Number(match[2])} 月`;
})();

const layerById = (id: LayerRow['id']): LayerRow => {
  const layer = dashboard.layers.find((row) => row.id === id);
  if (!layer) throw new Error(`[aiadoption] layer ${id} missing from payload`);
  return layer;
};
const devLayer = layerById('N_dev');
const proLayer = layerById('N_pro');
const freeLayer = layerById('N_free');
const passiveLayer = layerById('N_passive');

// ---------------------------------------------------------------------------
// Copy
// ---------------------------------------------------------------------------
const headline = `自分で生成 AI を使っている人は、およそ ${approxOku(summary.self_users)}人。`;
const headlinePlain = headline.replace(/。$/, '');

// Four separate populations. Each card says what it counts and how it relates
// to the others. They are never summed and never drawn as a 100% split.
const groupCards = [
  {
    id: 'self',
    label: '自分で使う人',
    value: summary.self_users,
    relation: '4 つの人数のうち、いちばん広い集まり',
    note: 'ChatGPT や Gemini などの生成 AI を、自分の意思で開いて使う人。有料も無料も、開発者も含む。',
    color: 'var(--accent-deep)',
    primary: true,
  },
  {
    id: 'paid',
    label: proLayer.label_ja,
    value: summary.paid_users,
    relation: '自分で使う人の一部',
    note: '個人向けの有料プランを契約している人。年間売上を 1 人あたり料金で割って見積もる。',
    color: proLayer.color,
    primary: false,
  },
  {
    id: 'dev',
    label: devLayer.label_ja,
    value: summary.developer_users,
    relation: '自分で使う人の一部',
    note: 'GitHub Copilot や Cursor など、コードを書くための AI ツールを使う開発者。仕事全般の利用ではない。',
    color: devLayer.color,
    primary: false,
  },
  {
    id: 'passive',
    label: passiveLayer.label_ja,
    value: summary.passive_only_users,
    relation: '上の 3 つとは別に数える',
    note: 'スマホや PC に AI 機能が入っているが、本人が開くとは限らない人。自分で使う人には足さない。',
    color: passiveLayer.color,
    primary: false,
  },
];

const offlineLine = `世界はおよそ ${approxOku(summary.population)}人。そのうちおよそ ${approxOku(summary.offline_people)}人はまだインターネットを使っていない。`;

// ---------------------------------------------------------------------------
// Method section
// ---------------------------------------------------------------------------
const formulaTextByLayer: Record<LayerRow['id'], string> = {
  N_dev: 'N_dev = 開発者向け AI 利用者の合計 × (1 - 同じ人の重なり)',
  N_pro: 'N_pro = Σ(年間売上 ARR ÷ 1 人あたり年間売上 ARPU) - 上の層との重なり',
  N_free: 'N_free = Σ(月間利用者 MAU × 1 人あたり補正) - 上の層との重なり',
  N_passive: 'N_passive = AI 対応端末数 × 利用できる割合 × 有効化率 - すでに使う人との重なり',
};

const formulaCards = [
  { title: '自分で使う人', code: '自分で使う人 = N_dev + N_pro + N_free' },
  ...dashboard.layers.map((layer) => ({ title: layer.label_ja, code: formulaTextByLayer[layer.id] })),
  { title: 'インターネットを使っていない人', code: 'インターネットを使っていない人 = 世界の総人口 − インターネット利用者' },
];

const formulaTerms = [
  ['ARR', '年間売上。ユーザー数が未公開の会社で、人数を推定するための代わりの数字。'],
  ['ARPU', '1 人あたり年間売上。ARR を人数に直すときに使う。'],
  ['MAU', '月間利用者数。無料利用者を推定するときの中心データ。'],
  ['重なり', '同じ人が複数の AI サービスを使っている分。ここを引かないと人数が多く見える。'],
];

const parameterRows = Object.entries(dashboard.assumptions.parameters).map(([key, def]) => ({
  key,
  label: def.label_ja,
  rationale: def.rationale_ja,
  display: key.endsWith('_usd') ? `${def.value} ドル` : `${Math.round(def.value * 100)}%`,
}));

// ---------------------------------------------------------------------------
// Sources section
// ---------------------------------------------------------------------------
const entityLabel = (entity: string): string => {
  if (entity === 'World') return '世界';
  if (entity === 'Other developer AI tools') return 'その他の開発者向け AI';
  if (entity === 'OpenAI consumer products') return 'OpenAI 個人向け';
  if (entity === 'Anthropic consumer products') return 'Anthropic 個人向け';
  if (entity === 'Perplexity consumer products') return 'Perplexity 個人向け';
  if (entity === 'Other consumer AI products') return 'その他の個人向け AI';
  if (entity === 'Regional AI apps') return '各地域の AI アプリ';
  if (entity === 'Apple Intelligence eligible devices') return 'Apple Intelligence 対応端末';
  if (entity === 'Windows Copilot eligible PCs') return 'Windows Copilot 対応 PC';
  if (entity === 'Android Gemini eligible devices') return 'Android Gemini 対応端末';
  if (entity === 'Regional OS-level AI devices') return '各地域の端末 AI';
  return entity;
};
const unitLabel = (unit: string): string => {
  if (unit === 'people') return '人';
  if (unit === 'devices') return '台';
  return unit;
};

// Per-source freshness only. A source past its `stale_after_days` gets a chip
// on its own card; there is no model-level "health" figure anywhere on the page.
const staleChipLabel = (status: FreshnessStatus): string | null => {
  if (status === 'stale') return '期限切れ';
  if (status === 'review_needed') return '見直し時期';
  return null;
};
const sourceAgeLabel = (source: SourceRow): string =>
  `公開 ${source.published_at} / 見直し目安 ${source.stale_after_days} 日`;

const sourceGroupMeta = [
  { id: 'base', title: '人口とインターネット利用者', note: '第一画面の「およそ 83 億人」と「22 億人」の元になる数字。', metrics: ['global_population', 'global_internet_users'] },
  { id: 'developer', title: devLayer.label_ja, note: 'コードを書くための AI ツールの利用者を見る。', metrics: ['developer_active_users'] },
  { id: 'paid', title: proLayer.label_ja, note: 'ARR を使い、有料ユーザーの目安に直す。', metrics: ['vendor_arr_usd'] },
  { id: 'free', title: freeLayer.label_ja, note: 'Web やアプリの月間利用を使う。', metrics: ['platform_mau_proxy'] },
  { id: 'passive', title: passiveLayer.label_ja, note: 'OS や端末に入った AI の対象端末を見る。', metrics: ['passive_eligible_devices'] },
];

const sourceGroups = sourceGroupMeta
  .map((group) => ({
    ...group,
    sources: dashboard.sources.filter((source) => group.metrics.includes(source.metric)),
  }))
  .filter((group) => group.sources.length > 0);

// ---------------------------------------------------------------------------
// SEO
// ---------------------------------------------------------------------------
const description = `世界で自分から生成 AI を使う人はおよそ ${approxOku(summary.self_users)}人（${asOfMonth}時点の推計）。お金を払って使う人、開発で毎日使う人、端末に入っているだけの人を足し合わせずに別々に見積もり、計算式と出典を公開します。`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${dashboard.title_ja} - mirai-shigoto.com`,
  description,
  url: canonical,
  inLanguage: 'ja',
  isAccessibleForFree: true,
  dateModified: dashboard.updated_at,
  measurementTechnique: 'Proxy metrics, ARR back-calculation, traffic alignment, device activation model, and overlap de-duplication. Groups are published separately; they are not a 100% decomposition.',
  variableMeasured: [
    { '@type': 'PropertyValue', name: '自分で生成 AI を使う人', value: summary.self_users, unitText: 'people' },
    ...dashboard.layers.map((layer) => ({
      '@type': 'PropertyValue',
      name: layer.label_ja,
      value: layer.value,
      unitText: 'people',
    })),
    { '@type': 'PropertyValue', name: '世界の総人口', value: summary.population, unitText: 'people' },
    { '@type': 'PropertyValue', name: 'インターネット利用者', value: summary.internet_users, unitText: 'people' },
    { '@type': 'PropertyValue', name: 'インターネットを使っていない人', value: summary.offline_people, unitText: 'people' },
  ],
});
---
<BaseLayout
  title={`${headlinePlain} | ${dashboard.title_ja} - mirai-shigoto.com`}
  description={description}
  canonical={canonical}
  keywords="生成 AI, 利用者数, 世界, ChatGPT, Claude, Gemini, ARR, MAU, 推計"
  ogTitle={`${headlinePlain} | ${dashboard.title_ja}`}
  ogDescription="有料、開発者、端末搭載を足し合わせずに別々に見積もる、世界の生成 AI 利用状況の推計。"
  ogType="article"
  ogImage={`${siteConfig.origin}/api/og?page=aiadoption`}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={AI_ADOPTION_CSS} />

  <article class="ai-adoption-page" aria-labelledby="aiAdoptionTitle">
    <header class="adoption-hero">
      <h1 id="aiAdoptionTitle" class="adoption-headline">
        自分で生成 AI を使っている人は、<span class="headline-tail">およそ <strong class="headline-number">{approxOku(summary.self_users)}</strong>人。</span>
      </h1>
      <p class="adoption-hero-note">{asOfMonth}時点の推計です。国勢調査のような実数ではなく、公開データから見積もった数字です。</p>
    </header>

    <section class="group-section" aria-labelledby="groupHeading">
      <h2 id="groupHeading" class="group-heading">4 つの人数は、それぞれ別のものを数えています。足して 100% にはなりません。</h2>
      <div class="group-grid">
        {groupCards.map((card) => (
          <article class={`group-card${card.primary ? ' group-card-primary' : ''}`} style={`--group-color:${card.color}`}>
            <p class="group-label">{card.label}</p>
            <p class="group-value">推計 <strong>{compact(card.value)}</strong>人</p>
            <p class="group-relation">{card.relation}</p>
            <p class="group-note">{card.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="offline-section" aria-label="インターネットを使っていない人">
      <p class="offline-line">{offlineLine}</p>
      <p class="offline-note">上の 4 つの人数は、この {approxOku(summary.offline_people)}人を含みません。</p>
    </section>

    <section class="wide-panel formula-panel" aria-labelledby="formulaHeading">
      <div class="panel-head">
        <h2 id="formulaHeading">どうやって計算したか</h2>
        <p class="panel-sub">観測日 {dashboard.updated_at} / 期間 {dashboard.period} / モデル v{dashboard.model_version}</p>
      </div>
      <p class="method-note">人数が公表されていないものは、年間売上（ARR）、月間利用者（MAU）、対応端末数から見積もります。同じ人を二度数えないよう、開発者、有料、無料、端末搭載の順に重なりを引きます。4 つの人数はそれぞれ別に出しているので、足し合わせても意味を持ちません。</p>
      <div class="formula-grid">
        {formulaCards.map((card) => (
          <div class="formula-card">
            <h3>{card.title}</h3>
            <code class="formula-code">{card.code}</code>
          </div>
        ))}
      </div>
      <div class="formula-primer" aria-label="式で使う言葉">
        <h3>式で使う言葉</h3>
        <dl>
          {formulaTerms.map(([term, definition]) => (
            <>
              <dt>{term}</dt>
              <dd>{definition}</dd>
            </>
          ))}
        </dl>
      </div>
      <div class="formula-primer" aria-label="使っている仮定">
        <h3>使っている仮定</h3>
        <dl>
          {parameterRows.map((row) => (
            <>
              <dt>{row.label} <span class="parameter-value">{row.display}</span></dt>
              <dd>{row.rationale}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <section class="wide-panel source-panel" aria-labelledby="sourceHeading">
      <div class="panel-head">
        <h2 id="sourceHeading">入力データと出典</h2>
        <p class="panel-sub">どの数字を、何のために使うか</p>
      </div>
      <p class="method-note">各データは「元の値」と「人数に直した値」を分けて示します。見直し目安を過ぎたデータは、そのカードにだけ印をつけます。</p>
      <div class="source-groups">
        {sourceGroups.map((group) => (
          <section class="source-group" aria-label={group.title}>
            <div class="source-group-head">
              <div>
                <h3>{group.title}</h3>
                <p>{group.note}</p>
              </div>
              <span>{group.sources.length} 件</span>
            </div>
            <div class="source-card-grid">
              {group.sources.map((source) => {
                const chip = staleChipLabel(source.freshness_status);
                return (
                  <article class={`source-card source-card-${source.freshness_status}`}>
                    <div class="source-card-top">
                      <h4>{entityLabel(source.entity)}</h4>
                      {chip ? <span class={`status-chip status-${source.freshness_status}`}>{chip}</span> : null}
                    </div>
                    <div class="source-metrics">
                      <div>
                        <span>元の値</span>
                        <strong>{compact(source.value)} {unitLabel(source.unit)}</strong>
                      </div>
                      <div>
                        <span>人数換算</span>
                        <strong>{compact(source.derived_value)}</strong>
                      </div>
                    </div>
                    <p class="source-foot">
                      <span>{sourceAgeLabel(source)}</span>
                      <a href={source.source_url} target="_blank" rel="noopener noreferrer">{source.source_label} ↗</a>
                    </p>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="wide-panel" aria-labelledby="methodHeading">
      <h2 id="methodHeading">この数字の読み方</h2>
      <p class="method-note">
        このページの人数は、すべて推計です。会社発表、Web の利用統計、端末の出荷数など、性質の違う数字を人数に直しているので、桁と傾向を見るための数字として読んでください。日本の仕事については、<a href="/">職業マップ</a> と <a href="/me">自分の現在地</a> をご覧ください。
      </p>
    </section>

    <Footer />
  </article>
</BaseLayout>
