---
/**
 * aiadoption.astro — 人類と AI の距離（HAID の四半期現状ページ、最新回）。
 *
 * Renders the newest release from public/data.haid-latest.json through
 * _HaidReleasePage.astro. Archived releases live at /aiadoption/<release>.
 */
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import HaidReleasePage from './_HaidReleasePage.astro';
import type { HaidLatestPayload } from '@/site/haid-release-types';
import { loadHaidReleaseLabels } from './_haid-release-labels';

const payload: HaidLatestPayload = JSON.parse(
  await readFile(join(process.cwd(), 'public', 'data.haid-latest.json'), 'utf-8'),
);
const labels = await loadHaidReleaseLabels(payload.releases);
---
<HaidReleasePage payload={payload} labels={labels} />
