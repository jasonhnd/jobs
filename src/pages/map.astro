---
/**
 * map.astro — 職業マップ (interactive squarified treemap of all 552 jobs).
 *
 * Inline JS preserved verbatim — including the mobile-scroll-to-top fix
 * from commit 1e8976a9 (atomic replaceChildren() render + ResizeObserver
 * width-only resize, see Design-Mobile.md §4.4.1). Do NOT refactor the
 * inline JS to React or split into modules; the entire interactive treemap
 * layout, list-view toggle, bottom sheet, and search suggest are
 * intentionally one IIFE.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { MAP_PAGE_CSS } from './_map-css';

const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "日本の全 552 職業 × AI 影響度マップ",
  "description": "厚生労働省 job tag + 独立行政法人 労働政策研究・研修機構（JILPT）のデータをもとに、日本の 552 職業の AI 影響度・年収・就業者数を可視化したインタラクティブヒートマップ。",
  "url": "https://mirai-shigoto.com/map",
  "license": "https://opensource.org/licenses/MIT",
  "isAccessibleForFree": true,
  "creator": { "@type": "Organization", "name": "Mirai-Shigoto" },
  "distribution": [{
    "@type": "DataDownload",
    "encodingFormat": "application/json",
    "contentUrl": "https://mirai-shigoto.com/data.treemap.json"
  }],
  "keywords": ["AI 影響", "職業", "ヒートマップ", "552 職業", "厚生労働省", "JILPT"],
  "inLanguage": ["ja"]
}`;
---
<BaseLayout
  title="職業マップ｜全 552 職業 × AI 影響度ヒートマップ — Mirai-Shigoto"
  description="日本の全 552 職業を就業者数 × AI 影響度で可視化。事務、専門・技術、サービス…分野別に AI で大きく変わる仕事を一目で確認。タップで職業詳細へ。"
  canonical="https://mirai-shigoto.com/map"
  ogTitle="職業マップ｜全 552 職業 × AI 影響度ヒートマップ"
  ogDescription="日本の全 552 職業を就業者数 × AI 影響度で可視化。事務、専門・技術、サービス…分野別に AI で大きく変わる仕事を一目で確認。"
  ogImage="https://mirai-shigoto.com/api/og?page=map"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <link rel="preload" href="/data.treemap.json" as="fetch" crossorigin="anonymous" slot="head" />
  <link rel="preload" href="/data.sectors.json" as="fetch" crossorigin="anonymous" slot="head" />

  <style slot="head" set:html={MAP_PAGE_CSS} />

  <header class="map-head">
    <a class="back" href="/" aria-label="トップへ戻る">← トップ</a>
    <h1>職業マップ</h1>
  </header>

  <form class="map-search" id="searchForm" role="search" autocomplete="off">
    <input type="search" class="map-search-input" id="searchInput"
           placeholder="気になる職業を入力" aria-label="職業を検索" />
    <button type="submit" class="map-search-btn">診断</button>
    <ul class="map-suggest" id="searchSuggest" role="listbox" aria-label="検索候補"></ul>
  </form>

  <nav class="map-chips-row" aria-label="セクター絞り込み">
    <div class="map-chips" id="sectorChips" role="tablist">
      <button type="button" class="chip active" data-sector="all" role="tab" aria-selected="true">全て</button>
    </div>
    <select class="map-sort" id="sortSelect" aria-label="並べ替え">
      <option value="ai_risk_desc">AI影響↓</option>
      <option value="ai_risk_asc">AI影響↑</option>
      <option value="salary_desc">年収↓</option>
      <option value="workers_desc">就業者数↓</option>
    </select>
    <button type="button" class="map-view-toggle" id="viewToggle"
            aria-label="リスト表示に切り替え" title="リスト表示に切り替え"
            aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <circle cx="3.5" cy="6" r="1.2" fill="currentColor"/>
        <circle cx="3.5" cy="12" r="1.2" fill="currentColor"/>
        <circle cx="3.5" cy="18" r="1.2" fill="currentColor"/>
      </svg>
    </button>
  </nav>

  {/* RA-012 (2026-05-18): inner <main> would nest inside BaseLayout's
      <main id="main-content">. Replaced with semantic <article>. */}
  <article aria-label="職業マップ">
    <div class="legend" aria-hidden="true">
      <span>面積 ≈ 就業者数</span>
      <span class="swatches">
        <span style="background:#0F8A66"></span>
        <span style="background:#5BA84F"></span>
        <span style="background:#D9A03B"></span>
        <span style="background:#E27A33"></span>
        <span style="background:#C4422F"></span>
      </span>
      <span>色 = AI 影響(低 → 高)</span>
    </div>

    <div id="mapContent" role="region" aria-label="552 職業の AI 影響ヒートマップ">
      <div class="map-skeleton">
        <div class="sector-section"><div class="sector-grid"></div></div>
        <div class="sector-section"><div class="sector-grid"></div></div>
        <div class="sector-section"><div class="sector-grid"></div></div>
      </div>
    </div>
  </article>

  <Footer />

  <div id="cellTooltip" class="cell-tooltip" role="tooltip" aria-hidden="true" hidden>
    <strong class="ct-name"></strong>
    <span class="ct-stats">
      <span class="ct-risk risk-pill"></span>
      <span class="ct-salary"></span>
      <span class="ct-workers"></span>
    </span>
    <span class="ct-sector"></span>
  </div>

  <div class="sheet-backdrop" id="sheetBackdrop" aria-hidden="true"></div>
  <aside class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" hidden>
    <button type="button" class="sheet-handle" aria-label="閉じる" id="sheetHandle"></button>
    <button type="button" class="sheet-close" id="sheetClose" aria-label="閉じる">×</button>
    <h2 id="sheetTitle"></h2>
    <span class="sheet-rank" id="sheetRank" hidden></span>
    <ul class="sheet-stats">
      <li><span class="label">AI 影響度</span><span class="value" id="sheetRisk"></span></li>
      <li><span class="label">年収</span><span class="value" id="sheetSalary"></span></li>
      <li><span class="label">就業者数</span><span class="value" id="sheetWorkers"></span></li>
    </ul>
    <a class="sheet-cta" id="sheetCta" href="">詳細を見る →</a>
  </aside>

  <script slot="bodyEnd" is:inline>
  (function () {
    'use strict';

    var DATA_URL = '/data.treemap.json';
    var SECTORS_URL = '/data.sectors.json';
    var SEARCH_URL = '/data.search.json';
    var FETCH_TIMEOUT_MS = 10000;

    var allRecords = [];
    var sectorMeta = [];
    var sectorOrder = [];
    var byId = {};
    var bySector = {};
    var rankByJobId = {};
    var searchDocs = null;
    var currentSector = 'all';
    var currentSort = 'ai_risk_desc';
    var openJobId = null;

    var RISK_PALETTE = ['#0F8A66', '#5BA84F', '#D9A03B', '#E27A33', '#C4422F'];
    function colorForRisk(risk) {
      if (risk <= 2) return RISK_PALETTE[0];
      if (risk <= 4) return RISK_PALETTE[1];
      if (risk <= 6) return RISK_PALETTE[2];
      if (risk <= 8) return RISK_PALETTE[3];
      return RISK_PALETTE[4];
    }

    var $content = document.getElementById('mapContent');
    var $chips = document.getElementById('sectorChips');
    var $sort = document.getElementById('sortSelect');
    var $searchForm = document.getElementById('searchForm');
    var $searchInput = document.getElementById('searchInput');
    var $suggest = document.getElementById('searchSuggest');
    var $sheet = document.getElementById('sheet');
    var $sheetBackdrop = document.getElementById('sheetBackdrop');
    var $sheetTitle = document.getElementById('sheetTitle');
    var $sheetRank = document.getElementById('sheetRank');
    var $sheetRisk = document.getElementById('sheetRisk');
    var $sheetSalary = document.getElementById('sheetSalary');
    var $sheetWorkers = document.getElementById('sheetWorkers');
    var $sheetCta = document.getElementById('sheetCta');

    function fmtSalary(s) { if (s == null) return '—'; return Math.round(s) + ' 万円'; }
    function fmtWorkers(w) {
      if (w == null) return '—';
      if (w >= 10000) return (w / 10000).toFixed(0) + ' 万人';
      return w.toLocaleString('ja-JP') + ' 人';
    }
    function riskLabel(r) {
      if (r >= 9) return r + '/10 ▲ 大きく変わる仕事';
      if (r >= 7) return r + '/10 ▲ 影響大';
      if (r >= 4) return r + '/10 ▼ 中程度';
      return r + '/10 ◎ 影響小';
    }
    function ga(name, params) {
      try { if (typeof gtag === 'function') gtag('event', name, params || {}); } catch (e) {}
    }
    function fetchWithTimeout(url, ms) {
      return new Promise(function (resolve, reject) {
        var done = false;
        var t = setTimeout(function () { if (!done) { done = true; reject(new Error('timeout')); } }, ms);
        fetch(url, { credentials: 'omit' })
          .then(function (r) {
            if (!done) { done = true; clearTimeout(t); }
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(resolve)
          .catch(function (e) { if (!done) { done = true; clearTimeout(t); } reject(e); });
      });
    }

    function readUrlState() {
      var p = new URLSearchParams(location.search);
      return {
        sector: p.get('sector') || 'all',
        sort:   p.get('sort')   || 'ai_risk_desc',
        job:    p.get('job') ? parseInt(p.get('job'), 10) : null
      };
    }
    function writeUrlState() {
      var p = new URLSearchParams();
      if (currentSector !== 'all') p.set('sector', currentSector);
      if (currentSort !== 'ai_risk_desc') p.set('sort', currentSort);
      if (openJobId != null) p.set('job', String(openJobId));
      var qs = p.toString();
      var newPath = location.pathname + (qs ? '?' + qs : '');
      if (newPath !== location.pathname + location.search) {
        history.replaceState(null, '', newPath);
      }
    }

    function comparator() {
      switch (currentSort) {
        case 'ai_risk_asc':  return function (a, b) { return (a.ai_risk || 0) - (b.ai_risk || 0); };
        case 'salary_desc':  return function (a, b) { return (b.salary || 0) - (a.salary || 0); };
        case 'workers_desc': return function (a, b) { return (b.workers || 0) - (a.workers || 0); };
        default:             return function (a, b) { return (b.ai_risk || 0) - (a.ai_risk || 0); };
      }
    }

    function renderChips() {
      var frag = document.createDocumentFragment();
      sectorMeta.forEach(function (s) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip';
        b.dataset.sector = s.id;
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', 'false');
        b.textContent = s.ja;
        if (s.id === currentSector) {
          b.classList.add('active');
          b.setAttribute('aria-selected', 'true');
          var allBtn = $chips.querySelector('.chip[data-sector="all"]');
          if (allBtn) {
            allBtn.classList.remove('active');
            allBtn.setAttribute('aria-selected', 'false');
          }
        }
        frag.appendChild(b);
      });
      $chips.appendChild(frag);
    }

    // ── Squarified treemap (Bruls/Huijsen/van Wijk 2000) ─────────────────
    // Implements the headline §4.4 D4=C approach: each sector gets its own
    // proper squarified treemap (cell area exactly proportional to workers,
    // aspect ratios kept close to 1). Beats the earlier flex-grid (D4=A
    // fallback) by representing area faithfully and filling the container
    // with no gaps. ~80 lines of math; cell DOM is unchanged.
    function squarifyWorst(row, minSide) {
      if (!row.length) return Infinity;
      var sum = 0, mx = -Infinity, mn = Infinity;
      for (var i = 0; i < row.length; i++) {
        var a = row[i].area;
        sum += a;
        if (a > mx) mx = a;
        if (a < mn) mn = a;
      }
      var sideSq = minSide * minSide;
      var sumSq = sum * sum;
      return Math.max((sideSq * mx) / sumSq, sumSq / (sideSq * mn));
    }
    function squarifyLayoutRow(row, x, y, w, h) {
      // The shorter side is iterated; the longer side absorbs the row's
      // total area divided by the shorter side. Each cell's other dimension
      // is its area / row breadth.
      var sum = 0;
      for (var i = 0; i < row.length; i++) sum += row[i].area;
      if (w >= h) {
        // horizontal sweep — row stacks vertically along height h
        var rowW = sum / h;
        var cy = 0;
        for (var j = 0; j < row.length; j++) {
          var cellH = row[j].area / rowW;
          row[j].rect = { x: x, y: y + cy, w: rowW, h: cellH };
          cy += cellH;
        }
        return rowW;
      } else {
        var rowH = sum / w;
        var cx = 0;
        for (var k = 0; k < row.length; k++) {
          var cellW = row[k].area / rowH;
          row[k].rect = { x: x + cx, y: y, w: cellW, h: rowH };
          cx += cellW;
        }
        return rowH;
      }
    }
    function squarifyStep(items, row, x, y, w, h) {
      if (!items.length) {
        if (row.length) squarifyLayoutRow(row, x, y, w, h);
        return;
      }
      var next = items[0];
      var minSide = Math.min(w, h);
      var tryRow = row.concat([next]);
      if (row.length === 0 || squarifyWorst(tryRow, minSide) <= squarifyWorst(row, minSide)) {
        squarifyStep(items.slice(1), tryRow, x, y, w, h);
      } else {
        var consumed = squarifyLayoutRow(row, x, y, w, h);
        if (w >= h) {
          squarifyStep(items, [], x + consumed, y, w - consumed, h);
        } else {
          squarifyStep(items, [], x, y + consumed, w, h - consumed);
        }
      }
    }
    function squarify(items, w, h) {
      if (!items.length) return;
      var totalValue = 0;
      for (var i = 0; i < items.length; i++) totalValue += items[i].value;
      if (totalValue <= 0) return;
      var scale = (w * h) / totalValue;
      var sorted = items.slice().sort(function (a, b) { return b.value - a.value; });
      for (var j = 0; j < sorted.length; j++) sorted[j].area = sorted[j].value * scale;
      squarifyStep(sorted, [], 0, 0, w, h);
    }

    // Section container height grows with occupation count; clamped so the
    // smallest sectors don't look anemic and the largest don't take 2 screens.
    function sectorContainerHeight(count) {
      return Math.max(180, Math.min(480, count * 16));
    }

    // ── Min-size threshold + "その他" merge (Design-Mobile.md §4.4) ──────
    // Cells smaller than 44×44 (touch target) are merged into a single
    // "その他 (n 職業)" tile pinned to the end of the sector. Keeps every
    // visible cell tappable without sacrificing the area-fidelity the
    // squarified algorithm gives the rest.
    function mergeSmallCells(records, container_w, container_h) {
      var totalWorkers = 0;
      for (var i = 0; i < records.length; i++) totalWorkers += (records[i].workers || 0);
      if (totalWorkers <= 0) return records.slice();
      var minArea = 44 * 44;
      var areaScale = (container_w * container_h) / totalWorkers;
      var kept = [];
      var mergedWorkers = 0;
      var mergedCount = 0;
      var mergedRiskSum = 0;
      records.forEach(function (r) {
        var area = (r.workers || 0) * areaScale;
        if (area >= minArea) {
          kept.push(r);
        } else {
          mergedWorkers += (r.workers || 0);
          mergedRiskSum += (r.ai_risk || 5);
          mergedCount += 1;
        }
      });
      if (mergedCount > 0) {
        kept.push({
          id: '__others__',
          name_ja: 'その他 (' + mergedCount + ' 職業)',
          workers: mergedWorkers,
          ai_risk: Math.round(mergedRiskSum / mergedCount),
          sector_id: records[0] && records[0].sector_id,
          __synthetic: true
        });
      }
      return kept;
    }

    function renderMap() {
      // Build the new tree off-DOM first; we attach it via a single atomic
      // replaceChildren() at the end. NEVER do `$content.innerHTML = ''` here
      // — see Design-Mobile.md §4.4.1 (重渲染契約) for the bug that motivates
      // this rule. Wipe-and-rebuild creates a synchronous reflow with
      // height=0, the browser clamps scrollTop to 0, and the user gets
      // teleported to the top whenever any code path calls renderMap()
      // (most painfully: the resize handler firing on mobile URL-bar hide).
      var frag = document.createDocumentFragment();
      var sectorsToShow = (currentSector === 'all')
        ? sectorOrder
        : (bySector[currentSector] ? [currentSector] : sectorOrder);
      var sortFn = comparator();
      // Container width: the live computed inner width of the content area.
      // Falls back to viewport width if main isn't measurable yet. Squarify
      // depends ONLY on width — height is derived per-sector from record
      // count — so width is the only resize signal we ever need to react to.
      var container_w = $content.clientWidth || (Math.min(window.innerWidth, 868) - 32);
      sectorsToShow.forEach(function (sid) {
        var recs = (bySector[sid] || []).slice().sort(sortFn);
        if (!recs.length) return;
        var section = document.createElement('section');
        section.className = 'sector-section';
        section.dataset.sector = sid;
        var sm = sectorMeta.filter(function (s) { return s.id === sid; })[0] || { ja: sid };

        var head = document.createElement('header');
        head.className = 'sector-head';
        var name = document.createElement('h2');
        name.className = 'sector-name';
        name.textContent = sm.ja;
        var meta = document.createElement('span');
        meta.className = 'sector-meta';
        meta.textContent = recs.length + ' 職業 ・ 平均 AI ' + (sm.mean_ai_risk != null ? sm.mean_ai_risk.toFixed(1) : '—');
        head.appendChild(name);
        head.appendChild(meta);
        section.appendChild(head);

        var container_h = sectorContainerHeight(recs.length);
        var laidOut = mergeSmallCells(recs, container_w, container_h);
        // Squarified algorithm needs items with .value (== area weight).
        var items = laidOut.map(function (r) {
          return { ref: r, value: r.workers || 1 };
        });
        squarify(items, container_w, container_h);

        var canvas = document.createElement('div');
        canvas.className = 'sector-canvas';
        canvas.style.height = container_h + 'px';
        items.forEach(function (it) {
          var r = it.ref;
          var rect = it.rect;
          if (!rect) return;
          var cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'cell' + (r.__synthetic ? ' cell-others' : '');
          if (!r.__synthetic) cell.dataset.id = r.id;
          cell.setAttribute('aria-label', r.__synthetic
            ? r.name_ja + '（小規模職業をまとめた領域）'
            : r.name_ja + '：AI 影響 ' + (r.ai_risk || '?') + '/10、就業者数 ' + fmtWorkers(r.workers));
          cell.style.left   = rect.x.toFixed(1) + 'px';
          cell.style.top    = rect.y.toFixed(1) + 'px';
          // Min 28px enforces a tappable, label-readable cell — squarified
          // geometry can produce slivers smaller than the font line-height
          // even after mergeSmallCells(); clamping at 28 lets the label's
          // text-overflow: ellipsis (see _map-css.ts .cell .name) take over.
          cell.style.width  = Math.max(rect.w - 2, 28).toFixed(1) + 'px';
          cell.style.height = Math.max(rect.h - 2, 28).toFixed(1) + 'px';
          cell.style.background = colorForRisk(r.ai_risk || 5);
          if (r.__synthetic) cell.style.background = 'repeating-linear-gradient(45deg, ' + colorForRisk(r.ai_risk) + ', ' + colorForRisk(r.ai_risk) + ' 6px, rgba(255,255,255,0.18) 6px, rgba(255,255,255,0.18) 12px)';
          var span = document.createElement('span');
          span.className = 'name';
          span.textContent = r.name_ja;
          cell.appendChild(span);
          canvas.appendChild(cell);
        });
        section.appendChild(canvas);
        frag.appendChild(section);
      });
      // Atomic swap (Design-Mobile.md §4.4.1 L1). replaceChildren is one
      // DOM operation; the document height steps from old to new without
      // visiting 0, so scrollTop is preserved (only clamped in the rare
      // case where new height < current scrollY).
      $content.replaceChildren(frag);
    }

    // Re-layout when the container width actually changes — and ONLY then.
    // (Design-Mobile.md §4.4.1 L2 + L3.) Two earlier-design pitfalls we
    // explicitly avoid here:
    //
    //   1. We do NOT listen on window.resize. Mobile Safari / Chrome fire
    //      that event when the URL bar collapses on downward scroll, even
    //      though the viewport WIDTH is unchanged. With wipe-and-rebuild
    //      rendering (now fixed via L1) that mis-trigger teleported the
    //      user to the top on every other swipe.
    //   2. We listen on the $content element itself, not the window. If a
    //      future layout introduces a sidebar, the window width may stay
    //      constant while $content's width shrinks — ResizeObserver catches
    //      that, window.resize would not.
    (function () {
      var prevWidth = 0;
      var t = null;
      var ro = new ResizeObserver(function (entries) {
        var w = entries[0] && entries[0].contentRect ? entries[0].contentRect.width : $content.clientWidth;
        if (w === prevWidth) return; // height-only change → no work
        prevWidth = w;
        if (t) clearTimeout(t);
        t = setTimeout(function () {
          if (!listMode && allRecords.length) renderMap();
        }, 200);
      });
      ro.observe($content);
    })();

    function showError() {
      $content.innerHTML = '<div class="map-error"><p>データを読み込めません。<br />通信状況をご確認ください。</p><button type="button" id="retryBtn">再読み込み</button></div>';
      var $r = document.getElementById('retryBtn');
      if ($r) $r.addEventListener('click', function () { location.reload(); });
    }

    function openSheet(jobId) {
      var r = byId[jobId];
      if (!r) return;
      openJobId = jobId;
      $sheetTitle.textContent = r.name_ja;
      var rank = rankByJobId[jobId];
      if (rank && rank <= 50) {
        $sheetRank.textContent = 'AI 影響 ランキング 第 ' + rank + ' 位';
        $sheetRank.hidden = false;
      } else {
        $sheetRank.hidden = true;
      }
      $sheetRisk.textContent = riskLabel(r.ai_risk || 0);
      $sheetSalary.textContent = fmtSalary(r.salary);
      $sheetWorkers.textContent = fmtWorkers(r.workers);
      $sheetCta.href = '/ja/' + r.id;
      $sheet.hidden = false;
      requestAnimationFrame(function () {
        $sheet.classList.add('open');
        $sheetBackdrop.classList.add('open');
      });
      writeUrlState();
      ga('map_cell_tap', { job_id: jobId, sector: r.sector_id, rank: rank || 0 });
    }
    function closeSheet() {
      if (!$sheet.classList.contains('open')) return;
      $sheet.classList.remove('open');
      $sheetBackdrop.classList.remove('open');
      openJobId = null;
      writeUrlState();
      setTimeout(function () {
        if (!$sheet.classList.contains('open')) $sheet.hidden = true;
      }, 320);
    }
    document.getElementById('sheetClose').addEventListener('click', closeSheet);
    document.getElementById('sheetHandle').addEventListener('click', closeSheet);
    $sheetBackdrop.addEventListener('click', closeSheet);
    $sheetCta.addEventListener('click', function () {
      ga('map_detail_click', { job_id: openJobId });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && $sheet.classList.contains('open')) closeSheet();
    });

    $content.addEventListener('click', function (e) {
      var t = e.target.closest('.cell');
      if (!t || !t.dataset.id) return;
      openSheet(parseInt(t.dataset.id, 10));
    });

    // RA-127 — hover tooltip on pointer:fine devices only (mobile keeps click → bottom sheet)
    var canHover = (typeof matchMedia === 'function') && matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (canHover) {
      var $tooltip = document.getElementById('cellTooltip');
      var $ttName = $tooltip.querySelector('.ct-name');
      var $ttRisk = $tooltip.querySelector('.ct-risk');
      var $ttSalary = $tooltip.querySelector('.ct-salary');
      var $ttWorkers = $tooltip.querySelector('.ct-workers');
      var $ttSector = $tooltip.querySelector('.ct-sector');
      var ttHideTimer = null;
      var ttCurrentId = null;
      function riskClass(n) { return n <= 4 ? 'low' : n <= 6 ? 'mid' : 'high'; }
      function fmtSalary(s) { return (s == null) ? '' : '年収 ' + s + ' 万円'; }
      function fmtWorkers(w) {
        if (w == null) return '';
        if (w >= 10000) return '就業者 ' + (w / 10000).toFixed(1).replace(/\.0$/, '') + ' 万人';
        return '就業者 ' + w.toLocaleString('ja-JP') + ' 人';
      }
      function positionTooltip(cellEl) {
        var r = cellEl.getBoundingClientRect();
        var tw = $tooltip.offsetWidth || 240;
        var th = $tooltip.offsetHeight || 80;
        var x = r.right + 8;
        var y = r.top;
        if (x + tw > window.innerWidth - 8) x = r.left - tw - 8;
        if (x < 8) x = 8;
        if (y + th > window.innerHeight - 8) y = window.innerHeight - th - 8;
        if (y < 8) y = 8;
        $tooltip.style.left = x + 'px';
        $tooltip.style.top = y + 'px';
      }
      function showTooltip(cellEl) {
        var id = parseInt(cellEl.dataset.id, 10);
        if (!id || !byId[id]) return;
        var r = byId[id];
        ttCurrentId = id;
        if (ttHideTimer) { clearTimeout(ttHideTimer); ttHideTimer = null; }
        $ttName.textContent = r.name_ja || '';
        $ttRisk.className = 'ct-risk risk-pill ' + riskClass(r.ai_risk);
        $ttRisk.textContent = 'AI ' + r.ai_risk + '/10';
        $ttSalary.textContent = fmtSalary(r.salary);
        $ttWorkers.textContent = fmtWorkers(r.workers);
        $ttSector.textContent = r.sector_ja || '';
        $tooltip.hidden = false;
        $tooltip.setAttribute('aria-hidden', 'false');
        positionTooltip(cellEl);
        void $tooltip.offsetWidth;
        $tooltip.setAttribute('data-visible', 'true');
      }
      function hideTooltip() {
        $tooltip.setAttribute('data-visible', 'false');
        ttCurrentId = null;
        if (ttHideTimer) clearTimeout(ttHideTimer);
        ttHideTimer = setTimeout(function () {
          $tooltip.hidden = true;
          $tooltip.setAttribute('aria-hidden', 'true');
        }, 200);
      }
      $content.addEventListener('mouseenter', function (e) {
        var t = e.target.closest && e.target.closest('.cell');
        if (!t || !t.dataset.id) return;
        if (ttCurrentId === parseInt(t.dataset.id, 10)) return;
        showTooltip(t);
      }, true);
      $content.addEventListener('mouseleave', function (e) {
        var t = e.target.closest && e.target.closest('.cell');
        if (!t) return;
        hideTooltip();
      }, true);
      window.addEventListener('scroll', hideTooltip, { passive: true });
    }

    $chips.addEventListener('click', function (e) {
      var t = e.target.closest('.chip');
      if (!t) return;
      var sid = t.dataset.sector;
      if (sid === currentSector) return;
      currentSector = sid;
      $chips.querySelectorAll('.chip').forEach(function (c) {
        c.classList.toggle('active', c.dataset.sector === sid);
        c.setAttribute('aria-selected', c.dataset.sector === sid ? 'true' : 'false');
      });
      renderMap();
      writeUrlState();
      ga('map_filter', { sector: sid, sort: currentSort });
    });
    $sort.addEventListener('change', function () {
      currentSort = $sort.value;
      renderMap();
      writeUrlState();
      ga('map_filter', { sector: currentSector, sort: currentSort });
    });

    function loadSearchIndex() {
      if (searchDocs) return Promise.resolve(searchDocs);
      return fetchWithTimeout(SEARCH_URL, FETCH_TIMEOUT_MS).then(function (j) {
        searchDocs = j.documents || [];
        return searchDocs;
      });
    }
    function rankMatches(q) {
      q = q.trim().toLowerCase();
      if (!q || !searchDocs) return [];
      var exact = [], starts = [], contains = [];
      searchDocs.forEach(function (d) {
        var hay = (d.title_ja || '').toLowerCase();
        var aliases = (d.aliases_ja || []).map(function (a) { return (a || '').toLowerCase(); });
        var allFields = [hay].concat(aliases);
        var hit = false, isExact = false, isStart = false;
        for (var i = 0; i < allFields.length; i++) {
          var f = allFields[i];
          if (f === q) { isExact = true; hit = true; break; }
          if (f.indexOf(q) === 0) { isStart = true; hit = true; }
          else if (f.indexOf(q) >= 0) { hit = true; }
        }
        if (!hit) return;
        if (isExact) exact.push(d);
        else if (isStart) starts.push(d);
        else contains.push(d);
      });
      var lengthAsc = function (a, b) { return (a.title_ja || '').length - (b.title_ja || '').length; };
      return exact.concat(starts.sort(lengthAsc), contains.sort(lengthAsc)).slice(0, 8);
    }
    // Build the suggest list with DOM APIs rather than innerHTML so titles
    // and ids from /data.search.json can't smuggle markup into the page.
    // The data is build-time JSON so the attack surface is data corruption
    // rather than user input, but this keeps the boundary clean.
    function renderSuggest(matches) {
      $suggest.replaceChildren();
      if (!matches.length) {
        $suggest.classList.remove('open');
        return;
      }
      for (var i = 0; i < matches.length; i++) {
        var d = matches[i];
        var li = document.createElement('li');
        li.dataset.id = String(d.id);
        li.setAttribute('role', 'option');
        if (i === 0) {
          li.classList.add('focused');
          li.setAttribute('aria-selected', 'true');
        }
        var nameSpan = document.createElement('span');
        nameSpan.textContent = d.title_ja || '';
        var riskSpan = document.createElement('span');
        riskSpan.className = 'risk';
        riskSpan.textContent = 'AI ' + (d.ai_risk != null ? d.ai_risk : '?') + '/10';
        li.appendChild(nameSpan);
        li.appendChild(riskSpan);
        $suggest.appendChild(li);
      }
      $suggest.classList.add('open');
    }
    var searchDebounce;
    $searchInput.addEventListener('input', function () {
      clearTimeout(searchDebounce);
      var q = $searchInput.value;
      if (!q.trim()) { $suggest.classList.remove('open'); return; }
      searchDebounce = setTimeout(function () {
        loadSearchIndex().then(function () { renderSuggest(rankMatches(q)); });
      }, 100);
    });
    $searchInput.addEventListener('blur', function () {
      setTimeout(function () { $suggest.classList.remove('open'); }, 150);
    });
    $searchInput.addEventListener('keydown', function (e) {
      var items = $suggest.querySelectorAll('li');
      if (!items.length) return;
      var idx = -1;
      items.forEach(function (li, i) { if (li.classList.contains('focused')) idx = i; });
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        var next = (idx + 1) % items.length;
        items.forEach(function (li, i) { li.classList.toggle('focused', i === next); });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        var prev = (idx - 1 + items.length) % items.length;
        items.forEach(function (li, i) { li.classList.toggle('focused', i === prev); });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        var sel = items[idx >= 0 ? idx : 0];
        if (sel) location.href = '/ja/' + sel.dataset.id;
      }
    });
    $searchForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var items = $suggest.querySelectorAll('li');
      var first = items[0];
      if (first) location.href = '/ja/' + first.dataset.id;
    });
    $suggest.addEventListener('click', function (e) {
      var li = e.target.closest('li[data-id]');
      if (!li) return;
      location.href = '/ja/' + li.dataset.id;
    });

    function init() {
      var s = readUrlState();
      currentSector = s.sector;
      currentSort = s.sort;
      if (s.sort && $sort) $sort.value = s.sort;

      Promise.all([
        fetchWithTimeout(DATA_URL, FETCH_TIMEOUT_MS),
        fetchWithTimeout(SECTORS_URL, FETCH_TIMEOUT_MS)
      ]).then(function (results) {
        allRecords = results[0] || [];
        var sectorsJson = results[1] || {};
        sectorMeta = sectorsJson.sectors || [];
        sectorOrder = sectorMeta.map(function (s) { return s.id; });

        allRecords.forEach(function (r) {
          byId[r.id] = r;
        });
        allRecords.forEach(function (r) {
          var sid = r.sector_id || 'unknown';
          if (!bySector[sid]) bySector[sid] = [];
          bySector[sid].push(r);
        });
        var ranked = allRecords.slice().sort(function (a, b) {
          var d = (b.ai_risk || 0) - (a.ai_risk || 0);
          if (d !== 0) return d;
          return (b.workers || 0) - (a.workers || 0);
        });
        ranked.forEach(function (r, i) { rankByJobId[r.id] = i + 1; });

        renderChips();
        renderMap();

        if (s.job && byId[s.job]) {
          requestAnimationFrame(function () { openSheet(s.job); });
        }

        var ref = 'direct';
        if (document.referrer) {
          try {
            var u = new URL(document.referrer);
            if (u.hostname === location.hostname) {
              if (u.pathname === '/' || u.pathname === '/index.html') ref = 'home_card';
              else if (u.pathname.indexOf('/ja/') === 0) ref = 'detail';
              else ref = 'internal';
            } else {
              ref = 'external';
            }
          } catch (e) {}
        }
        ga('map_open', { referrer: ref });
      }).catch(function (err) {
        console.warn('[map] data load failed:', err);
        showError();
      });
    }

    // ── List view toggle (Design-Mobile.md §4.13 a11y fallback) ───────────
    // Switches between the visual treemap render and an ordered-list
    // representation that's friendlier for screen readers / keyboard users.
    var $viewToggle = document.getElementById('viewToggle');
    var listMode = false;
    function renderList() {
      // Same atomic-swap contract as renderMap — see Design-Mobile.md
      // §4.4.1. Build the new ordered-list tree off-DOM, attach via a
      // single replaceChildren() at the end. Never wipe innerHTML first.
      var frag = document.createDocumentFragment();
      var sectorsToShow = (currentSector === 'all')
        ? sectorOrder
        : (bySector[currentSector] ? [currentSector] : sectorOrder);
      var sortFn = comparator();
      sectorsToShow.forEach(function (sid) {
        var recs = (bySector[sid] || []).slice().sort(sortFn);
        if (!recs.length) return;
        var sm = sectorMeta.filter(function (s) { return s.id === sid; })[0] || { ja: sid };
        var section = document.createElement('section');
        section.className = 'map-list-section';
        var h = document.createElement('h2');
        h.textContent = sm.ja + ' (' + recs.length + ' 職業)';
        section.appendChild(h);
        var ol = document.createElement('ol');
        recs.forEach(function (r) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '/ja/' + r.id;
          a.setAttribute('aria-label', r.name_ja + '：AI 影響 ' + (r.ai_risk || '?') + '/10、年収 ' + fmtSalary(r.salary) + '、就業者数 ' + fmtWorkers(r.workers));
          var sw = document.createElement('span');
          sw.className = 'swatch';
          sw.style.background = colorForRisk(r.ai_risk || 5);
          var nm = document.createElement('span');
          nm.className = 'name';
          nm.textContent = r.name_ja;
          var st = document.createElement('span');
          st.className = 'stats';
          st.textContent = 'AI ' + (r.ai_risk || '?') + '/10 ・ ' + fmtWorkers(r.workers);
          a.appendChild(sw); a.appendChild(nm); a.appendChild(st);
          li.appendChild(a);
          ol.appendChild(li);
        });
        section.appendChild(ol);
        frag.appendChild(section);
      });
      $content.replaceChildren(frag);
    }
    function applyView() {
      if (listMode) renderList(); else renderMap();
    }
    // Override later renderMap calls' callsites by wrapping them — chip /
    // sort handlers already call renderMap directly. Easiest: intercept by
    // re-binding handlers. We monkey-patch the existing chip/sort listeners
    // by wrapping the renderMap function.
    var _origRenderMap = renderMap;
    renderMap = function () { if (listMode) renderList(); else _origRenderMap(); };
    $viewToggle.addEventListener('click', function () {
      listMode = !listMode;
      $viewToggle.setAttribute('aria-pressed', listMode ? 'true' : 'false');
      $viewToggle.setAttribute('aria-label', listMode ? 'マップ表示に切り替え' : 'リスト表示に切り替え');
      $viewToggle.setAttribute('title', listMode ? 'マップ表示に切り替え' : 'リスト表示に切り替え');
      applyView();
    });

    // ── Bottom sheet drag-to-dismiss (Design-Mobile.md §4.5 D3=A) ─────────
    // Touch-driven downward drag closes the sheet. Velocity > 0.3 px/ms
    // closes immediately; otherwise we close if the drag exceeds half the
    // sheet's height. Pulled into a small state machine to coexist with
    // scroll inside the sheet — only drags that start on the handle or in
    // the upper 60px count as dismiss gestures, the rest scroll content.
    (function () {
      var dragStartY = null, dragStartT = 0, sheetHeight = 0, dragged = false;
      function onTouchStart(e) {
        if (!$sheet.classList.contains('open')) return;
        var t = e.touches[0];
        // Allow drag from anywhere in the upper 64px (header zone) or the
        // explicit drag handle. Below that, let native scroll happen.
        var rect = $sheet.getBoundingClientRect();
        var localY = t.clientY - rect.top;
        if (localY > 64) return;
        dragStartY = t.clientY;
        dragStartT = Date.now();
        sheetHeight = rect.height;
        dragged = false;
      }
      function onTouchMove(e) {
        if (dragStartY == null) return;
        var dy = e.touches[0].clientY - dragStartY;
        if (dy <= 0) return; // only downward drag counts
        dragged = true;
        $sheet.style.transition = 'none';
        $sheet.style.transform = 'translateY(' + dy + 'px)';
        // dim backdrop progressively
        var progress = Math.min(1, dy / sheetHeight);
        $sheetBackdrop.style.opacity = String(1 - progress * 0.6);
        // prevent body scroll while dragging
        if (e.cancelable) e.preventDefault();
      }
      function onTouchEnd(e) {
        if (dragStartY == null) return;
        var dy = (e.changedTouches[0].clientY) - dragStartY;
        var dt = Math.max(1, Date.now() - dragStartT);
        var velocity = dy / dt; // px / ms
        $sheet.style.transition = '';
        $sheet.style.transform = '';
        $sheetBackdrop.style.opacity = '';
        // Threshold: velocity > 0.3 px/ms OR drag > 50% of sheet height
        if (dragged && (velocity > 0.3 || dy > sheetHeight * 0.5)) {
          closeSheet();
        }
        dragStartY = null;
        dragged = false;
      }
      $sheet.addEventListener('touchstart', onTouchStart, { passive: true });
      $sheet.addEventListener('touchmove',  onTouchMove,  { passive: false });
      $sheet.addEventListener('touchend',   onTouchEnd,   { passive: true });
      $sheet.addEventListener('touchcancel', function () {
        $sheet.style.transition = '';
        $sheet.style.transform = '';
        $sheetBackdrop.style.opacity = '';
        dragStartY = null; dragged = false;
      }, { passive: true });
    })();

    // ── iOS visualViewport keyboard fit (Design-Mobile.md §4.3.3) ─────────
    // iOS Safari does not shrink window.innerHeight when the keyboard pops
    // up, so an absolute-positioned dropdown can end up under the keyboard.
    // We use the visualViewport API to compute available space below the
    // input and clamp the dropdown's max-height accordingly. Same pattern
    // as Design.md §7.12 P0-D F1.
    (function () {
      if (!window.visualViewport) return;
      function fit() {
        if (!$suggest.classList.contains('open')) return;
        var vv = window.visualViewport;
        var inputRect = $searchInput.getBoundingClientRect();
        var spaceBelow = vv.height - (inputRect.bottom - vv.offsetTop) - 12;
        // floor at 160px to keep at least one full result visible
        $suggest.style.maxHeight = Math.max(160, spaceBelow) + 'px';
      }
      $searchInput.addEventListener('focus', fit);
      window.visualViewport.addEventListener('resize', fit);
      window.visualViewport.addEventListener('scroll', fit);
    })();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
</BaseLayout>
