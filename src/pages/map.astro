---
/**
 * map.astro — 職業マップ (interactive squarified treemap of all 556 jobs).
 *
 * Page JS lives in _map-inline.js and is injected as a static inline
 * <script> via set:html, preserving the CSP hash model while keeping this
 * Astro file below the 800-line guide. Keep the interactive treemap layout,
 * list-view toggle, bottom sheet, and search suggest as one IIFE.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { MAP_PAGE_CSS } from './_map-css';

const MAP_INLINE_JS = readFileSync(
  join(process.cwd(), 'src', 'pages', '_map-inline.js'),
  'utf-8',
);

const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "日本の全 556 職業 × AI 影響度マップ",
  "description": "厚生労働省 job tag + 独立行政法人 労働政策研究・研修機構（JILPT）のデータをもとに、日本の 556 職業の AI 影響度・年収・就業者数を可視化したインタラクティブヒートマップ。",
  "url": "https://mirai-shigoto.com/map",
  "license": "https://opensource.org/licenses/MIT",
  "isAccessibleForFree": true,
  "creator": { "@type": "Organization", "name": "Mirai-Shigoto" },
  "distribution": [{
    "@type": "DataDownload",
    "encodingFormat": "application/json",
    "contentUrl": "https://mirai-shigoto.com/data.treemap.json"
  }],
  "keywords": ["AI 影響", "職業", "ヒートマップ", "556 職業", "厚生労働省", "JILPT"],
  "inLanguage": ["ja"]
}`;
---
<BaseLayout
  title="職業マップ｜全 556 職業 × AI 影響度ヒートマップ — Mirai-Shigoto"
  description="日本の全 556 職業を就業者数 × AI 影響度で可視化。事務、専門・技術、サービス…分野別に AI で大きく変わる仕事を一目で確認。タップで職業詳細へ。"
  canonical="https://mirai-shigoto.com/map"
  ogTitle="職業マップ｜全 556 職業 × AI 影響度ヒートマップ"
  ogDescription="日本の全 556 職業を就業者数 × AI 影響度で可視化。事務、専門・技術、サービス…分野別に AI で大きく変わる仕事を一目で確認。"
  ogImage="https://mirai-shigoto.com/api/og?page=map"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <link rel="preload" href="/data.treemap.json" as="fetch" crossorigin="anonymous" slot="head" />
  <link rel="preload" href="/data.sectors.json" as="fetch" crossorigin="anonymous" slot="head" />

  <style slot="head" set:html={MAP_PAGE_CSS} />

  <header class="map-head">
    <a class="back" href="/" aria-label="トップへ戻る">← トップ</a>
    <h1>職業マップ</h1>
  </header>

  <form class="map-search" id="searchForm" role="search" autocomplete="off">
    <input type="search" class="map-search-input" id="searchInput"
           placeholder="気になる職業を入力" aria-label="職業を検索" />
    <button type="submit" class="map-search-btn">診断</button>
    <ul class="map-suggest" id="searchSuggest" role="listbox" aria-label="検索候補"></ul>
  </form>

  <nav class="map-chips-row" aria-label="セクター絞り込み">
    <div class="map-chips" id="sectorChips" role="tablist">
      <button type="button" class="chip active" data-sector="all" role="tab" aria-selected="true">全て</button>
    </div>
    <select class="map-sort" id="sortSelect" aria-label="並べ替え">
      <option value="ai_risk_desc">AI影響↓</option>
      <option value="ai_risk_asc">AI影響↑</option>
      <option value="salary_desc">年収↓</option>
      <option value="workers_desc">就業者数↓</option>
    </select>
    <button type="button" class="map-view-toggle" id="viewToggle"
            aria-label="リスト表示に切り替え" title="リスト表示に切り替え"
            aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <circle cx="3.5" cy="6" r="1.2" fill="currentColor"/>
        <circle cx="3.5" cy="12" r="1.2" fill="currentColor"/>
        <circle cx="3.5" cy="18" r="1.2" fill="currentColor"/>
      </svg>
    </button>
  </nav>

  {/* RA-012 (2026-05-18): inner <main> would nest inside BaseLayout's
      <main id="main-content">. Replaced with semantic <article>. */}
  <article aria-label="職業マップ">
    <div class="legend" aria-hidden="true">
      <span>面積 ≈ 就業者数</span>
      <span class="swatches">
        <span style="background:#0F8A66"></span>
        <span style="background:#5BA84F"></span>
        <span style="background:#D9A03B"></span>
        <span style="background:#E27A33"></span>
        <span style="background:#C4422F"></span>
      </span>
      <span>色 = AI 影響(低 → 高)</span>
    </div>

    <div id="mapContent" role="region" aria-label="556 職業の AI 影響ヒートマップ">
      <div class="map-skeleton">
        <div class="sector-section"><div class="sector-grid"></div></div>
        <div class="sector-section"><div class="sector-grid"></div></div>
        <div class="sector-section"><div class="sector-grid"></div></div>
      </div>
    </div>
  </article>

  <Footer />

  <div id="cellTooltip" class="cell-tooltip" role="tooltip" aria-hidden="true" hidden>
    <strong class="ct-name"></strong>
    <span class="ct-stats">
      <span class="ct-risk risk-pill"></span>
      <span class="ct-salary"></span>
      <span class="ct-workers"></span>
    </span>
    <span class="ct-sector"></span>
  </div>

  <div class="sheet-backdrop" id="sheetBackdrop" aria-hidden="true"></div>
  <aside class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" hidden>
    <button type="button" class="sheet-handle" aria-label="閉じる" id="sheetHandle"></button>
    <button type="button" class="sheet-close" id="sheetClose" aria-label="閉じる">×</button>
    <h2 id="sheetTitle"></h2>
    <span class="sheet-rank" id="sheetRank" hidden></span>
    <ul class="sheet-stats">
      <li><span class="label">AI 影響度</span><span class="value" id="sheetRisk"></span></li>
      <li><span class="label">年収</span><span class="value" id="sheetSalary"></span></li>
      <li><span class="label">就業者数</span><span class="value" id="sheetWorkers"></span></li>
    </ul>
    <a class="sheet-cta" id="sheetCta" href="">詳細を見る →</a>
  </aside>

    <script slot="bodyEnd" is:inline set:html={MAP_INLINE_JS} />
</BaseLayout>
