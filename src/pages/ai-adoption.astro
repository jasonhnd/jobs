---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '@/site/config';
import { AI_ADOPTION_CSS } from './_ai-adoption-css';

interface SourceRow {
  id: string;
  metric: string;
  entity: string;
  value: number;
  derived_value: number;
  unit: string;
  period: string;
  published_at: string;
  age_days: number;
  source_label: string;
  source_name: string;
  source_url: string;
  confidence: 'high' | 'medium' | 'low';
  stale_after_days: number;
  freshness_status: 'fresh' | 'review_needed' | 'stale';
  used_by: string[];
  note: string;
}

interface LayerRow {
  id: string;
  label_ja: string;
  short_label_ja: string;
  formula_ja: string;
  rationale_ja: string;
  risk_ja: string;
  color: string;
  value: number;
  share_of_total: number;
  freshness_status: 'fresh' | 'review_needed' | 'stale';
  inputs: SourceRow[];
}

interface DashboardPayload {
  model_version: string;
  period: string;
  generated_at: string;
  updated_at: string;
  title_ja: string;
  subtitle_ja: string;
  denominator: {
    primary_value: number;
    auxiliary_value: number;
  };
  totals: Record<string, number>;
  rates: {
    explicit_adoption_rate: number;
    passive_touch_rate: number;
    total_touch_rate: number;
    unreached_rate: number;
    population_touch_rate: number;
  };
  layers: LayerRow[];
  sources: SourceRow[];
  freshness: {
    score: number;
    status: 'fresh' | 'review_needed' | 'stale';
  };
}

const dataPath = join(process.cwd(), 'public', 'data.ai-adoption.json');
const dashboard = JSON.parse(readFileSync(dataPath, 'utf-8')) as DashboardPayload;
const canonical = `${siteConfig.origin}/ai-adoption`;

const compact = (value: number): string =>
  new Intl.NumberFormat('ja-JP', { notation: 'compact', maximumFractionDigits: 1 }).format(value);
const pct = (value: number): string =>
  `${(value * 100).toFixed(1)}%`;
const statusLabel = (status: string): string => {
  if (status === 'fresh') return '新しい';
  if (status === 'review_needed') return '確認';
  return '古い';
};
const metricLabel = (metric: string): string => {
  if (metric === 'global_internet_users') return 'ネット利用者';
  if (metric === 'global_population') return '世界人口';
  if (metric === 'developer_active_users') return '開発者向けAI';
  if (metric === 'vendor_arr_usd') return '有料サービス売上';
  if (metric === 'platform_mau_proxy') return '月間利用者';
  if (metric === 'passive_eligible_devices') return 'AI対応端末';
  return metric;
};
const entityLabel = (entity: string): string => {
  if (entity === 'World') return '世界';
  if (entity === 'Other developer AI tools') return 'その他の開発者向けAI';
  if (entity === 'OpenAI consumer products') return 'OpenAI 個人向け';
  if (entity === 'Anthropic consumer products') return 'Anthropic 個人向け';
  if (entity === 'Perplexity consumer products') return 'Perplexity 個人向け';
  if (entity === 'Other consumer AI products') return 'その他の個人向けAI';
  if (entity === 'Regional AI apps') return '各地域のAIアプリ';
  if (entity === 'Apple Intelligence eligible devices') return 'Apple Intelligence 対応端末';
  if (entity === 'Windows Copilot eligible PCs') return 'Windows Copilot 対応PC';
  if (entity === 'Android Gemini eligible devices') return 'Android Gemini 対応端末';
  if (entity === 'Regional OS-level AI devices') return '各地域の端末AI';
  return entity;
};
const unitLabel = (unit: string): string => {
  if (unit === 'people') return '人';
  if (unit === 'devices') return '台';
  return unit;
};
const confidenceLabel = (confidence: string): string => {
  if (confidence === 'high') return '高い';
  if (confidence === 'medium') return '中';
  return '低い';
};
const layerNameById = new Map(dashboard.layers.map((layer) => [layer.id, layer.label_ja]));
const usedByLabel = (ids: string[]): string =>
  ids.map((id) => layerNameById.get(id) ?? (id === 'N_total' ? '基準人数' : id)).join(', ');
const touchedPer100 = Math.round(dashboard.rates.total_touch_rate * 100);
const unreachedPer100 = 100 - touchedPer100;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${dashboard.title_ja} - mirai-shigoto.com`,
  description: '世界のAI利用率を、仕事で深く使う人、有料で使う人、無料で使う人、端末でAIにふれる人、まだ使っていない人に分けて見積もる公開モデル。',
  url: canonical,
  inLanguage: 'ja',
  isAccessibleForFree: true,
  dateModified: dashboard.updated_at,
  measurementTechnique: 'Proxy metrics, ARR back-calculation, traffic alignment, device activation model, and de-duplication funnel.',
  variableMeasured: dashboard.layers.map((layer) => ({
    '@type': 'PropertyValue',
    name: layer.label_ja,
    value: layer.value,
    unitText: 'people',
  })),
});
---
<BaseLayout
  title={`${dashboard.title_ja} | AI利用率ダッシュボード - mirai-shigoto.com`}
  description="世界のAI利用率を、仕事で深く使う人、有料で使う人、無料で使う人、端末でAIにふれる人、まだ使っていない人の5グループに分け、計算式・理由・データの新しさを公開するダッシュボード。"
  canonical={canonical}
  keywords="AI利用率, 生成AI, ChatGPT, Claude, Gemini, ARR, MAU, データの新しさ, D3"
  ogTitle={`${dashboard.title_ja} | AI利用率ダッシュボード`}
  ogDescription="AI利用者を5グループに分け、計算式・理由・データの新しさを公開するモデルページ。"
  ogImage={`${siteConfig.origin}/api/og?page=home`}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={AI_ADOPTION_CSS} />

  <article class="ai-adoption-page" aria-labelledby="aiAdoptionTitle">
    <p class="adoption-kicker">AI adoption monitor</p>
    <h1 id="aiAdoptionTitle" class="adoption-title">{dashboard.title_ja}</h1>
    <p class="adoption-lede">{dashboard.subtitle_ja} 上から順に重なりを引き、同じ人を二度数えないようにします。</p>

    <div class="adoption-meta" aria-label="モデル情報">
      <span class="meta-pill">期間: {dashboard.period}</span>
      <span class="meta-pill">更新: {dashboard.updated_at}</span>
      <span class={`meta-pill status-chip status-${dashboard.freshness.status}`}>
        データ: {statusLabel(dashboard.freshness.status)} {Math.round(dashboard.freshness.score * 100)}%
      </span>
      <span class="meta-pill">モデル v{dashboard.model_version}</span>
    </div>

    <section class="summary-grid" aria-label="主な数字">
      <div class="metric-card">
        <p class="metric-label">AIにふれる人</p>
        <p class="metric-value">{pct(dashboard.rates.total_touch_rate)}</p>
        <p class="metric-note">自分で使う人と、端末のAIにふれる人を合わせた割合。</p>
      </div>
      <div class="metric-card">
        <p class="metric-label">自分で使う人</p>
        <p class="metric-value">{pct(dashboard.rates.explicit_adoption_rate)}</p>
        <p class="metric-note">仕事で深く使う、有料で使う、無料で使う人。</p>
      </div>
      <div class="metric-card">
        <p class="metric-label">まだ使っていない人</p>
        <p class="metric-value">{pct(dashboard.rates.unreached_rate)}</p>
        <p class="metric-note">重なりを引いた後の残り。</p>
      </div>
      <div class="metric-card">
        <p class="metric-label">基準人数</p>
        <p class="metric-value">{compact(dashboard.denominator.primary_value)}</p>
        <p class="metric-note">世界のインターネット利用者を基準にする。</p>
      </div>
    </section>

    <section class="dashboard-shell" aria-label="AI利用率の内訳">
      <div class="chart-panel">
        <div class="panel-head">
          <h2>100人で見る5グループ</h2>
          <p class="panel-sub">点1つ = 1%</p>
        </div>
        <div class="impact-row" aria-label="100人あたりのAI利用イメージ">
          <div>
            <span class="impact-number">{touchedPer100}</span><span class="impact-unit">人</span>
            <p>100人のうちAIにふれる人</p>
          </div>
          <div>
            <span class="impact-number muted">{unreachedPer100}</span><span class="impact-unit">人</span>
            <p>まだ使っていない人</p>
          </div>
        </div>
        <div id="aiAdoptionLayerChart" class="chart-stage" aria-label="AI利用率の5グループグラフ"></div>
        <ol class="chart-fallback">
          {dashboard.layers.map((layer) => (
            <li>
              <strong>{layer.label_ja}</strong> {compact(layer.value)} ({pct(layer.share_of_total)})
            </li>
          ))}
        </ol>
      </div>

      <aside class="explain-panel" aria-live="polite">
        <div class="panel-head">
          <h2>グループの説明</h2>
          <span id="aiLayerStatus" class="status-chip status-fresh">新しい</span>
        </div>
        <h3 id="aiLayerTitle" class="explain-title">{dashboard.layers[2]?.label_ja}</h3>
        <div class="explain-value">
          <span id="aiLayerValue" class="explain-number">{compact(dashboard.layers[2]?.value ?? 0)}</span>
          <span id="aiLayerShare" class="explain-share">{pct(dashboard.layers[2]?.share_of_total ?? 0)}</span>
        </div>
        <div class="explain-block">
          <h3>計算式</h3>
          <code id="aiLayerFormula" class="formula-code">{dashboard.layers[2]?.formula_ja}</code>
        </div>
        <div class="explain-block">
          <h3>理由</h3>
          <p id="aiLayerRationale">{dashboard.layers[2]?.rationale_ja}</p>
        </div>
        <div class="explain-block">
          <h3>注意点</h3>
          <p id="aiLayerRisk">{dashboard.layers[2]?.risk_ja}</p>
        </div>
        <div class="explain-block">
          <h3>使うデータ</h3>
          <div id="aiLayerSources" class="source-mini-list"></div>
        </div>
      </aside>
    </section>

    <section class="two-col" aria-label="変化とデータの新しさ">
      <div class="wide-panel">
        <div class="panel-head">
          <h2>3か月ごとの変化</h2>
          <p class="panel-sub">グループ別人数</p>
        </div>
        <div id="aiAdoptionTrend" class="trend-stage"></div>
      </div>
      <div class="wide-panel">
        <div class="panel-head">
          <h2>データの新しさ</h2>
          <p class="panel-sub">入力ごとの状態</p>
        </div>
        <div id="aiAdoptionFreshness" class="freshness-stage"></div>
      </div>
    </section>

    <section class="wide-panel" aria-labelledby="formulaHeading">
      <h2 id="formulaHeading">公開している計算式</h2>
      <div class="formula-grid">
        {dashboard.layers.map((layer) => (
          <div class="formula-card">
            <h3>{layer.label_ja}</h3>
            <code class="formula-code">{layer.formula_ja}</code>
            <p>{layer.rationale_ja}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-panel" aria-labelledby="sourceHeading">
      <h2 id="sourceHeading">入力データと更新日</h2>
      <p class="method-note">各入力は、値だけでなく、出所、公開日、使うグループ、データの新しさを持ちます。モデルはこれらを集めて最終JSONを作ります。</p>
      <div class="source-table-wrap">
        <table class="source-table">
          <thead>
            <tr>
              <th>数字の種類</th>
              <th>対象</th>
              <th>値</th>
              <th>人数に直した値</th>
              <th>期間</th>
              <th>公開日</th>
              <th>新しさ</th>
              <th>信頼度</th>
              <th>使う先</th>
              <th>出所</th>
            </tr>
          </thead>
          <tbody>
            {dashboard.sources.map((source) => (
              <tr>
                <td data-label="数字の種類">{metricLabel(source.metric)}</td>
                <td data-label="対象">{entityLabel(source.entity)}</td>
                <td data-label="値" class="num">{compact(source.value)} {unitLabel(source.unit)}</td>
                <td data-label="人数に直した値" class="num">{compact(source.derived_value)}</td>
                <td data-label="期間">{source.period}</td>
                <td data-label="公開日" class="num">{source.published_at}</td>
                <td data-label="新しさ"><span class={`status-chip status-${source.freshness_status}`}>{statusLabel(source.freshness_status)}</span></td>
                <td data-label="信頼度">{confidenceLabel(source.confidence)}</td>
                <td data-label="使う先">{usedByLabel(source.used_by)}</td>
                <td data-label="出所"><a href={source.source_url} target="_blank" rel="noopener noreferrer">{source.source_label}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="wide-panel" aria-labelledby="methodHeading">
      <h2 id="methodHeading">モデルの読み方</h2>
      <p class="method-note">
        このモデルでは、人数が公表されていないものを、ARR、MAU、端末数などから見積もります。大事なのは単純に足し算しないことです。仕事で深く使う人、有料で使う人、無料で使う人、端末でAIにふれる人の順に、同じ人の重なりを引きます。
      </p>
    </section>

    <script id="aiAdoptionData" type="application/json" set:html={JSON.stringify(dashboard)}></script>

    <script>
      import * as d3 from 'd3';

      interface SourceRow {
        id: string;
        entity: string;
        derived_value: number;
        published_at: string;
        freshness_status: 'fresh' | 'review_needed' | 'stale';
        confidence: string;
        source_url: string;
        source_label: string;
      }

      interface LayerRow {
        id: string;
        label_ja: string;
        short_label_ja: string;
        formula_ja: string;
        rationale_ja: string;
        risk_ja: string;
        color: string;
        value: number;
        share_of_total: number;
        freshness_status: 'fresh' | 'review_needed' | 'stale';
        inputs: SourceRow[];
      }

      interface TrendRow {
        period: string;
        N_dev: number;
        N_pro: number;
        N_free: number;
        N_passive: number;
        N_unreached: number;
      }

      interface Payload {
        denominator: { primary_value: number };
        layers: LayerRow[];
        sources: Array<SourceRow & { metric: string; age_days: number }>;
        trend: TrendRow[];
      }

      const dataNode = document.getElementById('aiAdoptionData');
      const payload = dataNode?.textContent ? JSON.parse(dataNode.textContent) as Payload : null;
      const selected = { id: 'N_free' };

      const compactNumber = new Intl.NumberFormat('ja-JP', {
        notation: 'compact',
        maximumFractionDigits: 1,
      });

      function fmt(value: number): string {
        return compactNumber.format(value);
      }

      function pct(value: number): string {
        return `${(value * 100).toFixed(1)}%`;
      }

      function statusLabel(status: string): string {
        if (status === 'fresh') return '新しい';
        if (status === 'review_needed') return '確認';
        return '古い';
      }

      function statusFill(status: string): string {
        if (status === 'fresh') return '#D0E3D6';
        if (status === 'review_needed') return '#F4E7CE';
        return '#F0D6CC';
      }

      function statusText(status: string): string {
        if (status === 'fresh') return '#48705F';
        if (status === 'review_needed') return '#8A6A2A';
        return '#A24A28';
      }

      function entityLabel(entity: string): string {
        if (entity === 'World') return '世界';
        if (entity === 'Other developer AI tools') return 'その他の開発者向けAI';
        if (entity === 'OpenAI consumer products') return 'OpenAI 個人向け';
        if (entity === 'Anthropic consumer products') return 'Anthropic 個人向け';
        if (entity === 'Perplexity consumer products') return 'Perplexity 個人向け';
        if (entity === 'Other consumer AI products') return 'その他の個人向けAI';
        if (entity === 'Regional AI apps') return '各地域のAIアプリ';
        if (entity === 'Apple Intelligence eligible devices') return 'Apple Intelligence 対応端末';
        if (entity === 'Windows Copilot eligible PCs') return 'Windows Copilot 対応PC';
        if (entity === 'Android Gemini eligible devices') return 'Android Gemini 対応端末';
        if (entity === 'Regional OS-level AI devices') return '各地域の端末AI';
        return entity;
      }

      interface WaffleUnit {
        index: number;
        layer: LayerRow;
      }

      function makeWaffleUnits(layers: LayerRow[]): WaffleUnit[] {
        const counts = layers.map((layer) => {
          const raw = layer.share_of_total * 100;
          const count = Math.floor(raw);
          return { layer, count, remainder: raw - count };
        });
        let left = 100 - d3.sum(counts, (item) => item.count);
        counts
          .slice()
          .sort((a, b) => d3.descending(a.remainder, b.remainder))
          .forEach((item) => {
            if (left <= 0) return;
            item.count += 1;
            left -= 1;
          });
        const units: WaffleUnit[] = [];
        for (const item of counts) {
          for (let i = 0; i < item.count; i += 1) {
            units.push({ index: units.length, layer: item.layer });
          }
        }
        return units.slice(0, 100);
      }

      function selectLayer(layerId: string): void {
        if (!payload) return;
        const layer = payload.layers.find((item) => item.id === layerId);
        if (!layer) return;
        selected.id = layerId;
        const title = document.getElementById('aiLayerTitle');
        const value = document.getElementById('aiLayerValue');
        const share = document.getElementById('aiLayerShare');
        const formula = document.getElementById('aiLayerFormula');
        const rationale = document.getElementById('aiLayerRationale');
        const risk = document.getElementById('aiLayerRisk');
        const status = document.getElementById('aiLayerStatus');
        const sources = document.getElementById('aiLayerSources');
        if (title) title.textContent = layer.label_ja;
        if (value) value.textContent = fmt(layer.value);
        if (share) share.textContent = pct(layer.share_of_total);
        if (formula) formula.textContent = layer.formula_ja;
        if (rationale) rationale.textContent = layer.rationale_ja;
        if (risk) risk.textContent = layer.risk_ja;
        if (status) {
          status.className = `status-chip status-${layer.freshness_status}`;
          status.textContent = statusLabel(layer.freshness_status);
        }
        if (sources) {
          const rows = layer.inputs.slice(0, 5).map((source) => {
            const item = document.createElement('a');
            item.href = source.source_url;
            item.target = '_blank';
            item.rel = 'noopener noreferrer';
            item.className = 'source-mini';
            const name = document.createElement('strong');
            name.textContent = entityLabel(source.entity);
            const meta = document.createElement('span');
            meta.textContent = `${fmt(source.derived_value)} / ${source.published_at}`;
            item.append(name, meta);
            return item;
          });
          sources.replaceChildren(...rows);
        }
        updateLayerSelection();
      }

      function updateLayerSelection(): void {
        const stageSelector = '#aiAdoptionLayerChart';
        d3.selectAll<SVGCircleElement, WaffleUnit>(`${stageSelector} .waffle-dot`)
          .classed('is-selected', (d) => d.layer.id === selected.id)
          .attr('aria-pressed', (d) => String(d.layer.id === selected.id))
          .transition()
          .duration(220)
          .ease(d3.easeCubicOut)
          .attr('r', function (this: SVGCircleElement, d) {
            const baseRadius = Number(this.dataset.baseRadius);
            const selectedRadius = Number(this.dataset.selectedRadius);
            return d.layer.id === selected.id ? selectedRadius : baseRadius;
          });

        d3.selectAll<SVGGElement, { layer: LayerRow }>(`${stageSelector} .stack-segment`)
          .classed('is-selected', (d) => d.layer.id === selected.id)
          .attr('aria-pressed', (d) => String(d.layer.id === selected.id));

        d3.selectAll<SVGGElement, LayerRow>(`${stageSelector} .layer-tile`)
          .classed('is-selected', (d) => d.id === selected.id)
          .attr('aria-pressed', (d) => String(d.id === selected.id));
      }

      function renderLayerChart(): void {
        if (!payload) return;
        const el = document.getElementById('aiAdoptionLayerChart');
        if (!el) return;
        const layers = payload.layers;
        const width = Math.max(320, el.clientWidth || 720);
        const small = width < 620;
        const columns = small ? 10 : 20;
        const units = makeWaffleUnits(layers);
        const cell = Math.min(small ? 30 : 32, Math.max(22, (width - 34) / columns));
        const baseDotRadius = cell * 0.39;
        const selectedDotRadius = cell * 0.48;
        const rowsCount = Math.ceil(units.length / columns);
        const gridW = columns * cell;
        const gridH = rowsCount * cell;
        const gridX = (width - gridW) / 2;
        const gridY = 16;
        const barX = 20;
        const barY = gridY + gridH + 40;
        const barW = width - 40;
        const barH = 34;
        const tileGap = 8;
        const tileCols = small ? 1 : 5;
        const tileW = (width - 40 - tileGap * (tileCols - 1)) / tileCols;
        const tileH = small ? 44 : 56;
        const tileY = barY + barH + 24;
        const tileRows = Math.ceil(layers.length / tileCols);
        const height = tileY + tileRows * tileH + (tileRows - 1) * tileGap + 18;
        const color = new Map(layers.map((layer) => [layer.id, layer.color]));
        const touchedShare = 1 - (layers.find((layer) => layer.id === 'N_unreached')?.share_of_total ?? 0);

        d3.select(el).selectAll('*').remove();
        const svg = d3.select(el)
          .append('svg')
          .attr('viewBox', `0 0 ${width} ${height}`)
          .attr('role', 'img')
          .attr('aria-label', 'AI利用率を100人で見た5グループ');

        svg.append('text')
          .attr('class', 'waffle-caption')
          .attr('x', width / 2)
          .attr('y', 4)
          .attr('text-anchor', 'middle')
          .attr('dominant-baseline', 'hanging')
          .text('100人のインターネット利用者');

        const dots = svg.append('g')
          .attr('class', 'waffle-grid')
          .attr('transform', `translate(${gridX},${gridY})`)
          .selectAll<SVGCircleElement, WaffleUnit>('circle')
          .data(units)
          .join('circle')
          .attr('class', (d) => `waffle-dot${d.layer.id === selected.id ? ' is-selected' : ''}`)
          .attr('data-layer-id', (d) => d.layer.id)
          .attr('data-base-radius', String(baseDotRadius))
          .attr('data-selected-radius', String(selectedDotRadius))
          .attr('cx', (d) => (d.index % columns) * cell + cell / 2)
          .attr('cy', (d) => Math.floor(d.index / columns) * cell + cell / 2)
          .attr('r', (d) => d.layer.id === selected.id ? selectedDotRadius : baseDotRadius)
          .attr('fill', (d) => d.layer.color)
          .attr('tabindex', 0)
          .attr('role', 'button')
          .attr('aria-pressed', (d) => String(d.layer.id === selected.id))
          .attr('aria-label', (d) => `${d.layer.label_ja}: ${fmt(d.layer.value)}`)
          .on('click', (_event, d) => selectLayer(d.layer.id))
          .on('keydown', (event, d) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectLayer(d.layer.id);
            }
          });
        dots.append('title').text((d) => `${d.layer.label_ja}: ${pct(d.layer.share_of_total)}`);

        const stack = svg.append('g').attr('transform', `translate(${barX},${barY})`);
        stack.append('rect')
          .attr('class', 'stack-track')
          .attr('width', barW)
          .attr('height', barH)
          .attr('rx', 7);

        let cursor = 0;
        const segments = layers.map((layer) => {
          const start = cursor;
          const w = barW * layer.share_of_total;
          cursor += w;
          return { layer, start, w };
        });

        const segment = stack.selectAll<SVGGElement, typeof segments[number]>('g.stack-segment')
          .data(segments)
          .join('g')
          .attr('class', (d) => `stack-segment${d.layer.id === selected.id ? ' is-selected' : ''}`)
          .attr('transform', (d) => `translate(${d.start},0)`)
          .attr('tabindex', 0)
          .attr('role', 'button')
          .attr('aria-pressed', (d) => String(d.layer.id === selected.id))
          .attr('aria-label', (d) => `${d.layer.label_ja}: ${pct(d.layer.share_of_total)}`)
          .on('click', (_event, d) => selectLayer(d.layer.id))
          .on('keydown', (event, d) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectLayer(d.layer.id);
            }
          });

        segment.append('rect')
          .attr('width', (d) => Math.max(1, d.w))
          .attr('height', barH)
          .attr('rx', 6)
          .attr('fill', (d) => color.get(d.layer.id) ?? d.layer.color);

        segment.filter((d) => d.w > 64).append('text')
          .attr('class', 'stack-label')
          .attr('x', (d) => d.w / 2)
          .attr('y', barH / 2)
          .attr('text-anchor', 'middle')
          .attr('dominant-baseline', 'middle')
          .text((d) => `${d.layer.short_label_ja} ${pct(d.layer.share_of_total)}`);

        const touchX = barW * touchedShare;
        stack.append('line')
          .attr('class', 'touch-line')
          .attr('x1', touchX)
          .attr('x2', touchX)
          .attr('y1', -8)
          .attr('y2', barH + 8);
        stack.append('text')
          .attr('class', 'touch-label')
          .attr('x', Math.min(barW - 2, Math.max(2, touchX)))
          .attr('y', -12)
          .attr('text-anchor', touchX > barW * 0.72 ? 'end' : 'start')
          .text(`AIにふれる人 ${Math.round(touchedShare * 100)}人`);

        const tiles = svg.append('g')
          .attr('transform', `translate(20,${tileY})`)
          .selectAll<SVGGElement, LayerRow>('g.layer-tile')
          .data(layers)
          .join('g')
          .attr('class', (d) => `layer-tile${d.id === selected.id ? ' is-selected' : ''}`)
          .attr('transform', (_d, i) => {
            const col = i % tileCols;
            const row = Math.floor(i / tileCols);
            return `translate(${col * (tileW + tileGap)},${row * (tileH + tileGap)})`;
          })
          .attr('tabindex', 0)
          .attr('role', 'button')
          .attr('aria-pressed', (d) => String(d.id === selected.id))
          .attr('aria-label', (d) => `${d.label_ja}: ${fmt(d.value)}`)
          .on('click', (_event, d) => selectLayer(d.id))
          .on('keydown', (event, d) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectLayer(d.id);
            }
          });

        tiles.append('rect')
          .attr('class', 'layer-tile-bg')
          .attr('width', tileW)
          .attr('height', tileH)
          .attr('rx', 7);
        tiles.append('rect')
          .attr('width', 6)
          .attr('height', tileH - 14)
          .attr('x', 8)
          .attr('y', 7)
          .attr('rx', 3)
          .attr('fill', (d) => d.color);
        tiles.append('text')
          .attr('class', 'tile-label')
          .attr('x', 22)
          .attr('y', 20)
          .text((d) => d.short_label_ja);
        tiles.append('text')
          .attr('class', 'tile-value')
          .attr('x', 22)
          .attr('y', 39)
          .text((d) => `${pct(d.share_of_total)} / ${fmt(d.value)}`);
      }

      function renderTrend(): void {
        if (!payload) return;
        const el = document.getElementById('aiAdoptionTrend');
        if (!el) return;
        const width = Math.max(320, el.clientWidth || 520);
        const height = 280;
        const margin = { top: 18, right: 22, bottom: 38, left: 52 };
        const innerW = width - margin.left - margin.right;
        const innerH = height - margin.top - margin.bottom;
        const keys: Array<keyof TrendRow> = ['N_dev', 'N_pro', 'N_free', 'N_passive'];
        const color = new Map(payload.layers.map((layer) => [layer.id, layer.color]));
        const labels = new Map(payload.layers.map((layer) => [layer.id, layer.short_label_ja]));
        const x = d3.scalePoint()
          .domain(payload.trend.map((row) => row.period))
          .range([0, innerW])
          .padding(0.35);
        const maxY = d3.max(payload.trend, (row) => d3.max(keys, (key) => Number(row[key]))) ?? 1;
        const y = d3.scaleLinear().domain([0, maxY]).range([innerH, 0]).nice();

        d3.select(el).selectAll('*').remove();
        const svg = d3.select(el)
          .append('svg')
          .attr('viewBox', `0 0 ${width} ${height}`)
          .attr('role', 'img')
          .attr('aria-label', 'AI利用率の3か月ごとの変化');
        const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

        g.append('g')
          .attr('class', 'axis')
          .attr('transform', `translate(0,${innerH})`)
          .call(d3.axisBottom(x));
        g.append('g')
          .attr('class', 'axis')
          .call(d3.axisLeft(y).ticks(4).tickFormat((d) => fmt(Number(d))));

        for (const key of keys) {
          const seriesLine = d3.line<TrendRow>()
            .x((d) => x(d.period) ?? 0)
            .y((d) => y(Number(d[key])));
          g.append('path')
            .datum(payload.trend)
            .attr('fill', 'none')
            .attr('stroke', color.get(String(key)) ?? '#777')
            .attr('stroke-width', 2)
            .attr('d', seriesLine);
          g.selectAll(`circle.${key}`)
            .data(payload.trend)
            .join('circle')
            .attr('cx', (d) => x(d.period) ?? 0)
            .attr('cy', (d) => y(Number(d[key])))
            .attr('r', 3)
            .attr('fill', color.get(String(key)) ?? '#777');
        }

        const legend = svg.append('g').attr('transform', `translate(${margin.left},${height - 12})`);
        keys.forEach((key, index) => {
          const item = legend.append('g').attr('transform', `translate(${index * 86},0)`);
          item.append('rect')
            .attr('width', 10)
            .attr('height', 10)
            .attr('rx', 2)
            .attr('fill', color.get(String(key)) ?? '#777');
          item.append('text')
            .attr('x', 15)
            .attr('y', 9)
            .attr('class', 'chart-value')
            .text(labels.get(String(key)) ?? String(key));
        });
      }

      function renderFreshness(): void {
        if (!payload) return;
        const el = document.getElementById('aiAdoptionFreshness');
        if (!el) return;
        const rows = payload.sources.slice(0, 18);
        const width = Math.max(320, el.clientWidth || 520);
        const rowH = 26;
        const height = rows.length * rowH + 42;
        const margin = { top: 18, right: 14, bottom: 16, left: 148 };
        const innerW = width - margin.left - margin.right;

        d3.select(el).selectAll('*').remove();
        const svg = d3.select(el)
          .append('svg')
          .attr('viewBox', `0 0 ${width} ${height}`)
          .attr('role', 'img')
          .attr('aria-label', '入力データの新しさ');
        const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

        const row = g.selectAll('g.fresh-row')
          .data(rows)
          .join('g')
          .attr('transform', (_d, i) => `translate(0,${i * rowH})`);

        row.append('text')
          .attr('class', 'chart-value')
          .attr('x', -10)
          .attr('y', 14)
          .attr('text-anchor', 'end')
          .text((d) => d.entity.length > 22 ? `${d.entity.slice(0, 21)}…` : d.entity);

        row.append('rect')
          .attr('x', 0)
          .attr('y', 2)
          .attr('width', innerW)
          .attr('height', 18)
          .attr('rx', 4)
          .attr('fill', (d) => statusFill(d.freshness_status));

        row.append('text')
          .attr('class', 'chart-value')
          .attr('x', 8)
          .attr('y', 15)
          .attr('fill', (d) => statusText(d.freshness_status))
          .text((d) => `${statusLabel(d.freshness_status)} / ${d.age_days}d`);
      }

      function renderAll(): void {
        renderLayerChart();
        renderTrend();
        renderFreshness();
      }

      if (payload) {
        selectLayer(selected.id);
        renderAll();
        const observed = [
          document.getElementById('aiAdoptionLayerChart'),
          document.getElementById('aiAdoptionTrend'),
          document.getElementById('aiAdoptionFreshness'),
        ].filter((item): item is HTMLElement => item != null);
        const resizeObserver = new ResizeObserver(renderAll);
        observed.forEach((item) => resizeObserver.observe(item));
      }
    </script>

    <Footer />
  </article>
</BaseLayout>
