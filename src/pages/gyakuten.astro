---
/**
 * gyakuten.astro — /gyakuten AI働き方診断 front door.
 *
 * Static, build-time rendered guide to the 8 worktype families and the
 * 24 collectible variants. It consumes DIAG-1 generated data and DIAG-9 copy;
 * it does not author diagnostic data or run client-side scoring.
 */
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { CANONICAL_HUB_CSS } from '@/lib/canonical/hub';
import { GYAKUTEN_CSS } from './_gyakuten-css';
import { strictReadJson } from '@/lib/strict-load';
import { TreemapFileSummarySchema } from '@/lib/projection-schemas';
import { WorktypesDataSchema } from '@/data/schema/worktypes';
import { occupationPath } from '@/lib/urls';
import { DISCLAIMER } from '@/site/worktype-copy';
import { buildGyakutenPageModel, formatWorkers } from '@/views/gyakuten-page';

const WORKTYPES_PATH = join(process.cwd(), 'public', 'data.worktypes.json');
const TREEMAP_PATH = join(process.cwd(), 'public', 'data.treemap.json');

const worktypes = strictReadJson(WORKTYPES_PATH, WorktypesDataSchema, 'gyakuten.worktypes');
const treemapRows = strictReadJson(TREEMAP_PATH, TreemapFileSummarySchema, 'gyakuten.treemap');
const {
  canonical,
  title,
  seoDesc,
  keywords,
  jsonLd,
  familyViews,
  variantCount,
  occupationCount,
  pairViews,
} = buildGyakutenPageModel(worktypes, treemapRows);
---
<BaseLayout
  title={title}
  description={seoDesc}
  canonical={canonical}
  keywords={keywords}
  ogTitle={title}
  ogDescription={seoDesc}
  ogImage="https://mirai-shigoto.com/api/og?page=gyakuten"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={CANONICAL_HUB_CSS} />
  <style slot="head" set:html={GYAKUTEN_CSS} />

  <div id="wrapper">
    <nav class="gyakuten-crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">未来の仕事</a>
      <span aria-hidden="true">›</span>
      <span>AI働き方診断 図鑑</span>
    </nav>

    <header class="gyakuten-hero" id="content">
      <div>
        <p class="gyakuten-kicker">AI働き方診断 図鑑</p>
        <h1>8つの家族と<span class="accent">24タイプ</span>から、自分の働き方を探す</h1>
        <p class="gyakuten-lead">
          AI時代、人はどんな働き方に分かれるんだろう。8家族24タイプの図鑑です。あなたの1枚は、9問の診断でめくれます。
        </p>
        <div class="gyakuten-hero-actions">
          <a class="gyakuten-primary" href="/shindan">診断を受ける</a>
          <a class="gyakuten-secondary" href="#zukan">図鑑を見る</a>
        </div>
      </div>
      <aside class="gyakuten-proof" aria-label="診断図鑑の前提">
        <span><strong>{familyViews.length}</strong>家族タイプ</span>
        <span><strong>{variantCount}</strong>バリアント</span>
        <span><strong>{occupationCount}</strong>職業データ</span>
      </aside>
    </header>

    <section class="gyakuten-section" aria-labelledby="familiesHeading">
      <div class="gyakuten-section-head">
        <h2 id="familiesHeading">8家族の全体マップ</h2>
        <p>職業数と代表職業は家族単位の分布です。これは職業データ側の分布であり、診断を受けた人の分布ではありません。珍しさは序列ではなく、静的な分布として読んでください。</p>
      </div>

      <div class="family-grid">
        {familyViews.map((family) => (
          <article class={`family-card family-${family.code.toLowerCase()}`} aria-labelledby={`family-${family.code}`}>
            <div class="family-card-head">
              <div>
                <h3 id={`family-${family.code}`}>{family.name}</h3>
                <p class="family-share">{family.share}</p>
              </div>
            </div>
            <span class="family-rarity">{family.rarityText}</span>
            <dl class="family-copy-grid">
              <div>
                <dt>AIとの関係</dt>
                <dd>{family.aiRelation}</dd>
              </div>
              <div>
                <dt>次の一手</dt>
                <dd>{family.empowerment}</dd>
              </div>
            </dl>
            <div class="family-occ">
              <h4>代表職業</h4>
              <ul class="family-occ-list">
                {family.occupations.map((occupation) => (
                  <li>
                    <a href={occupationPath(occupation.id)}>
                      <span>{occupation.name}</span>
                      <small>{formatWorkers(occupation.workers)}</small>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="gyakuten-section" id="zukan" aria-labelledby="zukanHeading">
      <div class="gyakuten-section-head">
        <h2 id="zukanHeading">24タイプ 図鑑</h2>
        <p>まだ解放されていないタイプは灰色のままです。診断を受けると、自分の家族タイプとバリアントがひとつ開きます。</p>
      </div>

      <div class="zukan">
        {familyViews.map((family) => (
          <section class="zukan-family" aria-labelledby={`zukan-${family.code}`}>
            <div class={`zukan-family-head family-${family.code.toLowerCase()}`}>
              <h3 id={`zukan-${family.code}`}>{family.name}</h3>
              <p>{family.rarityText}</p>
            </div>
            <div class="variant-grid">
              {family.variants.map((variant) => (
                <article class={`variant-card family-${family.code.toLowerCase()}`} aria-label={`${variant.name} ${variant.lockLabel}`}>
                  <span class="variant-status">未解放</span>
                  <h4>{variant.name}</h4>
                  <p>{variant.catch}</p>
                  <p class="variant-lock">{variant.lockLabel}</p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="gyakuten-section" aria-labelledby="pairsHeading">
      <div class="gyakuten-section-head">
        <h2 id="pairsHeading">家族単位の相性</h2>
        <p>相性は家族単位の見方です。バリアントごとの優劣や統計ではなく、持ち味を並べて比べるためのヒントとして読んでください。</p>
      </div>
      <div class="pair-grid">
        {pairViews.map((pair) => (
          <article class="pair-card">
            <h3>{pair.title}</h3>
            <p>{pair.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="final-cta" aria-labelledby="ctaHeading">
      <div>
        <h2 id="ctaHeading">あなたの1タイプを開く</h2>
        <p>図鑑の中で、あなたの1枚はどれでしょう。9問でめくって、近い仕事やシェア用のカードまで見にいきましょう。</p>
      </div>
      <a class="gyakuten-primary" href="/shindan">診断を受ける</a>
    </section>

    <p class="gyakuten-note">{DISCLAIMER}</p>

    <Footer />
  </div>
</BaseLayout>
