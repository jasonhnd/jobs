---
/**
 * src/pages/_IdPageScript.astro — page-local Astro component
 * carrying the per-occupation client-side script.
 *
 * Fires GA4 `result_view` from data-* on a hidden meta div, opens
 * `details.chap` at ≥900px (same matchMedia pattern as rankings/compare),
 * and on load/hashchange opens the chapter that owns the hash target
 * so #323 doors and the chip nav land correctly.
 *
 * CSP hardening (audit CODE-012, 2026-05-17): the inline script body
 * is now byte-identical across every one of 556 occupation pages
 * (no `define:vars`), so one SHA-256 in vercel.json's script-src
 * covers them all. Per-occupation values flow through data-* attributes
 * on a hidden <div> element, which are NOT script content under CSP.
 *
 * History: the v1 [id] page also carried theme-toggle and
 * follow/share handlers, but the theme toggle is forced
 * `display:none` by _id-css.ts and the share buttons live in
 * the canonical <Footer /> component. Both handlers have been removed;
 * if a future page-level button needs JS, add it here.
 *
 * Astro `_`-prefix → not routed; component-only.
 */

interface Props {
  readonly occId: number;
  readonly riskScoreJs: number | null;
  readonly riskTierJs: 'high' | 'mid' | 'low';
}

const { occId, riskScoreJs, riskTierJs } = Astro.props;
// riskScoreJs is encoded as the literal string "" for null so the
// data attribute round-trips through HTML cleanly. The reader script
// turns "" back into null when parsing.
const riskScoreAttr = riskScoreJs == null ? '' : String(riskScoreJs);
---
<div
  data-occupation-page-meta
  data-occ-id={String(occId)}
  data-risk-score={riskScoreAttr}
  data-risk-tier={riskTierJs}
  hidden
  aria-hidden="true"
></div>
<script slot="bodyEnd" is:inline>
  // STATIC body — identical across every /[id] page → one CSP hash.
  // result_view + desktop chapter open (#321 pattern) + hash opens closest chap.
  (function () {
    try {
      var meta = document.querySelector('div[data-occupation-page-meta]');
      if (meta && typeof window.gtag === 'function') {
        var occId = Number(meta.getAttribute('data-occ-id'));
        var riskScoreAttr = meta.getAttribute('data-risk-score') || '';
        var riskScore = riskScoreAttr === '' ? null : Number(riskScoreAttr);
        var riskTier = meta.getAttribute('data-risk-tier') || '';
        window.gtag('event', 'result_view', {
          occupation_id: occId,
          ai_risk_score: riskScore,
          risk_tier: riskTier,
          language: 'ja'
        });
      }
    } catch (e) {}

    function openChapsDesktop() {
      try {
        if (!window.matchMedia('(min-width: 900px)').matches) return;
        var nodes = document.querySelectorAll('details.chap');
        for (var i = 0; i < nodes.length; i++) nodes[i].open = true;
      } catch (e2) {}
    }

    function hashId() {
      var h = location.hash || '';
      if (h.charAt(0) === '#') h = h.slice(1);
      try { return decodeURIComponent(h); } catch (e3) { return h; }
    }

    function markChip(chapId) {
      var chips = document.querySelectorAll('.chipnav a');
      for (var i = 0; i < chips.length; i++) {
        if (chapId && chips[i].getAttribute('href') === '#' + chapId) {
          chips[i].setAttribute('aria-current', 'true');
        } else {
          chips[i].removeAttribute('aria-current');
        }
      }
    }

    function openHashTarget() {
      try {
        var id = hashId();
        if (!id) { markChip(''); return; }
        var el = document.getElementById(id);
        if (!el) return;
        var chap = el.classList && el.classList.contains('chap') ? el : el.closest('details.chap');
        if (chap) chap.open = true;
        markChip(chap ? chap.id : '');
        if (typeof el.scrollIntoView === 'function') {
          el.scrollIntoView({ block: 'start' });
        }
      } catch (e4) {}
    }

    openChapsDesktop();
    openHashTarget();
    window.addEventListener('hashchange', openHashTarget);
  })();
</script>
