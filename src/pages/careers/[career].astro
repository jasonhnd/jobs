---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { loadGraph } from '@/graph';
import { GENRE_HUB_CSS } from '@/templates/Hub';
import { RELATED_CROSS_HUB_CSS } from '@/views/hub-hub-graph';
import { CAREER_PERSONAS, type CareerPersona } from '@/views/careers-meta';
import type { GenreOccupation } from '@/views/genre-hub';
import { buildCareerBindings, buildCareerItems } from './_career-bindings';

export async function getStaticPaths() {
  const { loadAllDetails } = await import('@/views/genre-hub');
  const details = loadAllDetails();
  return CAREER_PERSONAS.map((p) => ({ params: { career: p.slug }, props: { persona: p, items: buildCareerItems(details, p) } }));
}

const { persona, items } = Astro.props as { persona: CareerPersona; items: GenreOccupation[] };
const b = buildCareerBindings({ persona, items, graph: await loadGraph() });
const CAREER_CHAP_CSS = '.hub-slug .chap-body .genre-detail-grid li{word-break:keep-all;line-break:strict}';
---
<BaseLayout title={b.title} description={b.seoDesc} canonical={b.canonical}
  ogImage={b.ogImage} ogTitle={b.title.slice(0, 120)} ogDescription={b.seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={b.jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />
  <style slot="head" set:html={CAREER_CHAP_CSS} />
  <div id="wrapper" class="hub-slug">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/careers" rel="up">キャリア段階から探す</a><span aria-hidden="true">›</span><span>{persona.short_ja}</span></nav>
    <header id="content">
      <h1><span class="accent">{persona.title_ja}</span></h1>
      <p class="sub"><strong>{persona.short_ja}</strong> persona 向けの推薦 TOP {items.length}</p>
    </header>
    <section class="hub-list-sec" aria-label={`推薦 TOP ${items.length}`}>
      <h2>推薦 TOP {items.length}</h2>
      <ol class="rank-list" set:html={b.rankItems} />
    </section>
    <details class="chap">
      <summary>読み方・出典</summary>
      <div class="chap-body">
        <p class="intro" set:html={b.introHtml}></p>
        <section class="genre-detail" aria-label={`${persona.short_ja}の利点と注意点`}>
          <h2>{persona.short_ja} の特徴</h2>
          <div class="genre-detail-grid">
            <div><h3>利点</h3><Fragment set:html={b.advantagesHtml} /></div>
            <div><h3>注意点</h3><Fragment set:html={b.cautionsHtml} /></div>
          </div>
        </section>
        <Fragment set:html={b.statsHtml} />
        <Fragment set:html={b.highlightsHtml} />
        <Fragment set:html={b.sectorChartHtml} />
      </div>
    </details>
    <Fragment set:html={b.faqHtml} />
    <Fragment set:html={b.crossHubHtml} />
    <section aria-label="他のキャリア段階"><h2>他のキャリア段階</h2><Fragment set:html={b.relatedHtml} /></section>
    <Footer />
  </div>
  <script is:inline slot="bodyEnd">
    (function () {
      try {
        if (!window.matchMedia('(min-width: 900px)').matches) return;
        var nodes = document.querySelectorAll('details.chap');
        for (var i = 0; i < nodes.length; i++) nodes[i].open = true;
      } catch (e) {}
    })();
  </script>
</BaseLayout>
