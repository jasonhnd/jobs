---
/**
 * src/pages/_RiskCard.astro — occupation numbers-first verdict card (#323).
 *
 * The type-family copy (kicker / lede / 3-cell grid / one-line) lives in
 * [...id].astro above `#sec-aiois` so this card can lead with the scores.
 *
 * Page-local sibling (Astro `_`-prefix → not routed).
 */

import type { VerdictBinding } from './_id-bindings';

interface Props {
  readonly id: number;
  readonly nameJa: string;
  readonly riskClass: string;
  readonly riskColor?: string;
  readonly riskNumDisp: number | string;
  readonly verdict: VerdictBinding;
}

const { id, nameJa, riskClass, riskColor, riskNumDisp, verdict } = Astro.props;

const shareTitle = `${nameJa}のAI働き方診断`;
const ogHref = `/api/og?id=${id}`;
---
<section
  class={`risk-card verdict-card ${riskClass}`}
  aria-label="AI影響度"
>
  {verdict.showShare && (
    <a
      class="verdict-share"
      href={ogHref}
      target="_blank"
      rel="noopener"
      data-page-share-trigger
      data-share-title={shareTitle}
      aria-label={`${nameJa}のAI働き方診断カードを共有`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2 8 6h3v8h2V6h3l-4-4Zm-7 7v11c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2h-3v2h3v11H7V9h3V7H7c-1.1 0-2 .9-2 2Z" />
      </svg>
      <span>シェア</span>
    </a>
  )}

  <div class="verdict-grid">
    <div class="v-nums" aria-label="AIOIS-10 指標">
      <div class="v-num main">
        <span class="score-label">AI影響度（変化の大きさ）</span>
        {verdict.scored ? (
          <span class="score-num" style={riskColor ? `color:${riskColor}` : undefined}>{verdict.transformationDisp}<small>/10</small></span>
        ) : (
          <span class="score-num unscored">{verdict.transformationDisp}</span>
        )}
      </div>
      {verdict.displacementDisp !== null && (
        <div class="v-num subn">
          <span class="score-label">仕事が減るリスク</span>
          <span class="score-num">{verdict.displacementDisp}<small>/10</small></span>
        </div>
      )}
    </div>

    {verdict.rankLine && <p class="v-rank">{verdict.rankLine}</p>}
    <p class="v-line">{verdict.sentence}</p>
    {verdict.facts && <p class="v-facts">{verdict.facts}</p>}

    {verdict.doors.length > 0 && (
      <div class="v-doors">
        {verdict.doors.map((d) => (
          <a class={d.kind} href={d.href}>{d.label}</a>
        ))}
      </div>
    )}
  </div>
  <span class="risk-num" hidden>{riskNumDisp}<small> / 10</small></span>
</section>
