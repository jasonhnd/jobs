---
/**
 * privacy.astro — プライバシーポリシー.
 *
 * Inline CSS preserved verbatim — extraction into shared classes is a
 * follow-up.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const jsonLd = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mirai-shigoto.com/privacy#webpage",
      "name": "プライバシーポリシー — mirai-shigoto.com",
      "url": "https://mirai-shigoto.com/privacy",
      "description": "mirai-shigoto.com のプライバシーポリシー — 運営者、収集情報、第三者サービス（Google / Cloudflare / Vercel / Resend）、Cookie、保持期間、利用者の権利、お問い合わせ。",
      "inLanguage": ["ja"],
      "isPartOf": { "@id": "https://mirai-shigoto.com/#website" },
      "about": { "@id": "https://mirai-shigoto.com/#organization" },
      "author": { "@id": "https://mirai-shigoto.com/#person" },
      "publisher": { "@id": "https://mirai-shigoto.com/#organization" },
      "datePublished": "2026-04-30",
      "dateModified": "2026-04-30",
      "primaryImageOfPage": "https://mirai-shigoto.com/api/og?page=privacy",
      "breadcrumb": { "@id": "https://mirai-shigoto.com/privacy#breadcrumb" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".privacy-summary"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mirai-shigoto.com/privacy#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "日本の職業 AI 影響マップ",
          "item": "https://mirai-shigoto.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "プライバシーポリシー",
          "item": "https://mirai-shigoto.com/privacy"
        }
      ]
    }
  ]
}`;
---
<BaseLayout
  title="プライバシーポリシー — mirai-shigoto.com"
  description="mirai-shigoto.com のプライバシーポリシー。収集する情報、利用目的、第三者提供、Cookie、保持期間、利用者の権利、お問い合わせ。"
  canonical="https://mirai-shigoto.com/privacy"
  keywords="未来の仕事, プライバシーポリシー, 個人情報保護, Cookie, 第三者提供, GA4, Cloudflare, Vercel, Resend, 利用者の権利, APPI, GDPR, mirai shigoto, privacy policy, data handling"
  ogImage="https://mirai-shigoto.com/api/og?page=privacy"
  ogTitle="プライバシーポリシー — mirai-shigoto.com"
  ogDescription="mirai-shigoto.com のプライバシーポリシー。収集情報、利用目的、第三者提供（GA4 / Cloudflare / Vercel / Resend）、Cookie、保持期間、利用者の権利、お問い合わせ。"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <style slot="head">
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    /* Tokens (:root) + dual-theme blocks: removed 2026-05-16.
       Now emitted globally by Footer.astro via canonical-css.ts (Design.md §18.4). */
    body { font-family: var(--font-sans) !important; }
    /* Heading font-family/weight/letter-spacing inherited from canonical CSS. */
    h1 .accent, h2 .accent { color: var(--accent); font-style: italic; }
    .theme-toggle { display: none !important; }
    .theme-toggle-orig {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--fg2);
      width: 28px; height: 28px;
      border-radius: 999px;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      padding: 0; margin-left: 4px;
      font-family: inherit;
      transition: color 150ms ease, border-color 150ms ease;
      vertical-align: middle;
    }
    .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
    .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .theme-toggle svg { width: 13px; height: 13px; fill: currentColor; }
    .theme-toggle .icon-sun { display: inline-block; }
    .theme-toggle .icon-moon { display: none; }
    html, body {
      background: var(--bg);
      color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic UI", "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.7;
    }
    #wrapper {
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 24px 28px 80px;
    }
    .top-bar {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .top-bar .back {
      color: var(--fg2);
      text-decoration: none;
      font-size: 0.85rem;
    }
    .top-bar .back:hover { color: var(--accent); }
    h1 {
      /* font-size/weight/letter-spacing inherited from canonical (src/lib/canonical-css.ts) */
      margin-bottom: 6px;
    }
    h1 .accent { color: var(--accent); }
    .subtitle {
      color: var(--fg2);
      font-size: 0.9rem;
      margin-bottom: 8px;
    }
    .meta-line {
      color: var(--fg2);
      font-size: 0.78rem;
      margin-bottom: 28px;
      opacity: 0.75;
    }
    h2 {
      /* font-size/weight inherited from canonical (1.15rem / 600) */
      margin-top: 32px;
      margin-bottom: 12px;
      color: var(--fg);
      border-left: 3px solid var(--accent);
      padding-left: 12px;
    }
    h3 {
      /* font-size/weight inherited from canonical (1rem / 600) */
      margin-top: 18px;
      margin-bottom: 6px;
      color: var(--fg);
    }
    p {
      margin-bottom: 12px;
      color: var(--fg);
    }
    ul, ol {
      margin: 0 0 14px 22px;
      color: var(--fg);
    }
    li { margin-bottom: 6px; }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover { text-decoration: underline; }
    strong { color: var(--fg); font-weight: 600; }
    code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: var(--bg2);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--accent);
    }
    .third-party {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px 18px;
      margin: 12px 0;
      font-size: 0.88rem;
    }
    .third-party-row {
      display: grid;
      grid-template-columns: 130px 1fr auto;
      gap: 8px 14px;
      padding: 6px 0;
      border-bottom: 1px solid var(--border);
      align-items: baseline;
    }
    .third-party-row:last-child { border-bottom: none; }
    .third-party-row .name { font-weight: 600; }
    .third-party-row .role { color: var(--fg2); }
    footer {
      margin-top: 40px;
      padding-top: 22px;
      border-top: 1px solid var(--border);
      font-size: 0.72rem;
      color: var(--fg2);
      text-align: center;
    }
    footer a {
      color: var(--accent);
      text-decoration: none;
    }
    footer a:hover {
      text-decoration: underline;
    }
    footer .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      align-items: center;
      margin-bottom: 14px;
    }
    footer .footer-links a {
      color: var(--fg2);
      text-decoration: none;
      padding: 5px 14px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.78rem;
      line-height: 1.2;
      transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
    }
    footer .footer-links a:hover {
      color: var(--accent);
      border-color: var(--accent);
      background: rgba(217, 107, 61, 0.06);
      text-decoration: none;
    }
    footer .footer-meta { color: var(--fg2); font-size: 0.7rem; opacity: 0.92; text-wrap: pretty; line-height: 1.65; }
    footer .footer-meta a { color: var(--accent); }
    footer .footer-meta .nowrap { white-space: nowrap; }
    @media (max-width: 540px) {
      #wrapper { padding: 18px 16px 60px; }
      .third-party-row { grid-template-columns: 1fr; gap: 2px; }
      footer .footer-meta { font-size: 0.66rem; line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
    }
  </style>

  <div id="wrapper">
    <div class="top-bar">
      <a class="back" href="/">
        ← マップへ戻る
      </a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="ライト・ダークモード切替" title="ライト / ダーク切替">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-1-13h2v3h-2V2Zm0 19h2v3h-2v-3ZM2 11h3v2H2v-2Zm17 0h3v2h-3v-2ZM5.6 4.2 7.7 6.3 6.3 7.7 4.2 5.6l1.4-1.4Zm12.7 12.7 2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4ZM5.6 19.8l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1ZM18.3 7.7l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1Z"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
      </button>
    </div>

    <h1>
      <span class="accent">プライバシー</span>ポリシー Policy
    </h1>
    <p class="subtitle">
      mirai-shigoto.com — 日本の職業 AI 影響マップ（非公式・独自分析）
    </p>
    <p class="meta-line">
      最終更新：2026-04-30 ・ バージョン 1.0
    </p>

    <!-- 1 ----------------------------------------------------------- -->
    <h2>
      1. 運営者
    </h2>
    <p>
      本サイト「mirai-shigoto.com」（以下「本サイト」）は、<strong>mirai-shigoto プロジェクト</strong>が運営する独自分析サイトです（連絡先：<a href="mailto:privacy@mirai-shigoto.com">privacy@mirai-shigoto.com</a>）。厚生労働省・job tag・JILPT 等の公開情報を独自に整理・可視化したもので、これらの公的機関とは一切関係がなく、その公式見解を示すものではありません。
    </p>

    <!-- 2 ----------------------------------------------------------- -->
    <h2>
      2. 収集する情報
    </h2>

    <h3>
      2.1 アクセス解析（自動収集）
    </h3>
    <p>
      本サイトは、利用状況の把握とサイト改善のため、以下のアクセス解析サービスを利用しています。これらのサービスは IP アドレス、参照元 URL、ブラウザ情報、ページ閲覧履歴等を収集します。<strong>個人を直接特定する情報（氏名・住所等）は収集しません。</strong>
    </p>

    <h3>
      2.2 メールアドレス（任意提供）
    </h3>
    <p>
      月次レポートの登録フォームに入力された場合のみ、メールアドレスを収集します。職業ごとの詳細レポート希望フォームに入力された場合、登録時に閲覧していた職業 ID も併せて記録します。
    </p>

    <h3>
      2.3 フィードバック（任意提供）
    </h3>
    <p>
      フィードバックフォームに入力された選択肢、自由記述、および任意で添えられたメールアドレスを収集します。メールアドレスは任意項目で、未入力の場合は匿名で受け付けます。
    </p>

    <!-- 3 ----------------------------------------------------------- -->
    <h2>
      3. 利用目的
    </h2>
    <p>
      収集した情報は、以下の目的にのみ利用します。
    </p>
    <ul>
      <li>
        <strong>アクセス解析</strong>：利用状況の把握、コンテンツ改善、サイトパフォーマンス最適化。
      </li>
      <li>
        <strong>メールアドレス</strong>：月次レポートおよび本サイトの更新通知の送信。職業 ID と紐づけて、関連性の高い情報の提供に利用する場合があります。
      </li>
      <li>
        <strong>フィードバック</strong>：本サイトおよび将来のレポート内容の改善。集計された結果を匿名で公表する場合があります。
      </li>
    </ul>
    <p>
      これらの目的を超えて利用する場合は、事前に同意を得ます。広告配信目的での第三者への提供・販売は行いません。
    </p>

    <!-- 4 ----------------------------------------------------------- -->
    <h2>
      4. 第三者提供・委託先
    </h2>
    <p>
      本サイトの運用にあたり、以下の事業者にデータ処理の一部を委託しています。各事業者は自社のプライバシーポリシーに従って情報を取り扱います。サーバー所在地の関係で、米国等の海外にデータが転送される場合があります。
    </p>
    <div class="third-party">
      <div class="third-party-row">
        <div class="name">Google LLC</div>
        <div class="role">
          アクセス解析（Google Analytics 4）
        </div>
        <div><a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">policy ↗</a></div>
      </div>
      <div class="third-party-row">
        <div class="name">Cloudflare, Inc.</div>
        <div class="role">
          DNS、Web Analytics（Cookie 不使用）
        </div>
        <div><a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">policy ↗</a></div>
      </div>
      <div class="third-party-row">
        <div class="name">Vercel Inc.</div>
        <div class="role">
          ホスティング、Web Analytics
        </div>
        <div><a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">policy ↗</a></div>
      </div>
      <div class="third-party-row">
        <div class="name">Resend Inc.</div>
        <div class="role">
          メール配信（登録メールアドレスの保管・配信）
        </div>
        <div><a href="https://resend.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">policy ↗</a></div>
      </div>
    </div>

    <!-- 5 ----------------------------------------------------------- -->
    <h2>
      5. Cookie について
    </h2>
    <p>
      本サイトは Google Analytics 等のサービス提供のため、以下の Cookie を利用します。広告目的の Cookie は設定しません。
    </p>
    <ul>
      <li>
        <code>_ga</code>, <code>_ga_*</code> —
        Google Analytics 4（保持期間：最長 2 年）
      </li>
      <li>
        <code>__cf_bm</code> —
        Cloudflare ボット対策（保持期間：30 分）
      </li>
    </ul>
    <p>
      <strong>Cookie を無効化する方法：</strong>ブラウザの設定から Cookie を拒否できます。Google Analytics については、<a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google の公式オプトアウト用ブラウザ拡張</a>でも無効化できます。Cookie を無効化しても本サイトの基本機能は利用できます。
    </p>

    <!-- 6 ----------------------------------------------------------- -->
    <h2>
      6. 保持期間
    </h2>
    <ul>
      <li>
        <strong>メールアドレス</strong>：登録から配信停止までの期間 + 配信停止後 30 日間（監査・誤操作対応のため）。30 日経過後は速やかに削除します。
      </li>
      <li>
        <strong>アクセス解析データ</strong>：14 ヶ月（Google Analytics 4 のデフォルト保持期間）。
      </li>
      <li>
        <strong>フィードバック</strong>：匿名フィードバックは無期限保管（個人を特定できないため）。メール付きフィードバックは利用者の削除依頼に従って削除します。
      </li>
    </ul>

    <!-- 7 ----------------------------------------------------------- -->
    <h2>
      7. 利用者の権利
    </h2>
    <p>
      日本の個人情報保護法、および海外法令（EU GDPR、米国カリフォルニア州 CCPA/CPRA 等）が適用される場合、利用者は以下の権利を有します。
    </p>
    <ul>
      <li>
        <strong>開示請求</strong>：保有するあなたの情報の開示を求める権利。
      </li>
      <li>
        <strong>訂正・削除請求</strong>：誤った情報の訂正、または情報の削除を求める権利。
      </li>
      <li>
        <strong>配信停止</strong>：受信したすべてのメールに含まれる配信停止リンクから、いつでも配信を停止できます。
      </li>
      <li>
        <strong>苦情申立</strong>：日本の個人情報保護委員会等の監督機関への苦情申立権。
      </li>
    </ul>
    <p>
      権利行使のご請求は、後述のお問い合わせ先までご連絡ください。本人確認の上、合理的な期間内（通常 7 日以内）に対応いたします。
    </p>

    <!-- 8 ----------------------------------------------------------- -->
    <h2>
      8. お問い合わせ
    </h2>
    <p>
      本ポリシーや個人情報の取扱いに関するお問い合わせは、以下までメールでお願いします。
    </p>
    <p>
      <code>privacy@mirai-shigoto.com</code>
    </p>
    <p>
      通常 7 日以内にご返信いたします。
    </p>

    <!-- changes ----------------------------------------------------- -->
    <h2>
      変更履歴
    </h2>
    <ul>
      <li>
        <strong>2026-04-30 v1.0</strong>：初版公開。
      </li>
    </ul>

    <Footer />
  </div>

  <script slot="bodyEnd" is:inline>
    // v1.4.0: language switcher removed — site is JA-only.

    // Theme toggle (light/dark)
    (function themeToggle() {
      const btn = document.getElementById("themeToggle");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const sysLight = matchMedia("(prefers-color-scheme: light)").matches;
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        const cur = document.documentElement.getAttribute("data-theme")
          || (sysLight ? "light" : "dark");
        const next = cur === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
        if (window.gtag) gtag("event", "theme_change", {
          from: cur,
          to: next,
          was_explicit: saved === "light" || saved === "dark",
          system_pref: sysLight ? "light" : "dark"
        });
      });
    })();
  </script>
</BaseLayout>
