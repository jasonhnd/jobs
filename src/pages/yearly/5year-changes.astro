---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { GENRE_HUB_CSS } from '@/templates/Hub';

const canonical = 'https://mirai-shigoto.com/yearly/5year-changes';
const title = '5 年で大きく変わった職業 | 未来の仕事';
const seoDesc = '2021 年から 2026 年で雇用構造・AI 影響が顕著に変化した職業群。技術進化と社会変化が労働市場に与えたインパクトを追跡。';

const SITE = 'https://mirai-shigoto.com';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', '@id': `${canonical}#article`, url: canonical, name: title, headline: '5 年で大きく変わった職業', description: seoDesc, inLanguage: 'ja', datePublished: '2026-05-10', author: { '@id': `${SITE}/#organization` }, publisher: { '@id': `${SITE}/#organization` }, articleSection: '年次レポート' },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: '未来の仕事', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: '年次レポート', item: `${SITE}/yearly` },
      { '@type': 'ListItem', position: 3, name: '5 年変化', item: canonical },
    ] },
  ],
}, null, 2);
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=yearly-5year" ogTitle={title} ogDescription={seoDesc} ogType="article">
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={`
.report-section{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:24px;margin:24px 0}
.report-section h2{font-size:1.15rem;color:var(--accent);margin:0 0 14px;padding:0;border:none}
.report-section p{font-size:.96rem;line-height:1.85;color:var(--fg);margin:0 0 14px}
.report-section ul{padding-left:24px;margin:0 0 14px}
.report-section li{margin-bottom:10px;line-height:1.7}
`} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/yearly" rel="up">年次レポート</a><span aria-hidden="true">›</span><span>5 年変化</span></nav>
    <header id="content">
      <h1><span class="accent">5 年で大きく変わった職業</span></h1>
      <p class="sub">2021 年 → 2026 年の <strong>変化追跡</strong></p>
      <p class="intro">この 5 年で AI・自動化・コロナ・少子高齢化が日本の労働市場に与えた影響を追跡。雇用構造が大きく動いた職業群を整理しました。</p>
    </header>
    <section class="report-section">
      <h2>1. AI コーディング普及で激変した IT 職</h2>
      <p>2022 年の Copilot 公開、2023 年の ChatGPT・GPT-4・Claude 普及により、プログラマー・SE・テスト技術者の業務内訳が大きく変化。下流コーディングは AI 補助が前提となり、上流設計・コードレビュー・複雑判断が人間の役割として強調されるようになった。同時に IT 業界全体の生産性は向上、需要は引き続き強い。</p>
    </section>
    <section class="report-section">
      <h2>2. リモートワーク常態化で変わった事務系・コンサル系</h2>
      <p>コロナで急速に進んだリモートワークが、IT・コンサル・士業の働き方を変えた。出社頻度が減り、地方居住の選択肢が広がった一方、新人教育やチーム形成の課題が顕在化。在宅 + 出社のハイブリッドが定着しつつある。</p>
    </section>
    <section class="report-section">
      <h2>3. 介護需要の継続的拡大</h2>
      <p>団塊世代が後期高齢者に達し、介護福祉士・ヘルパーの需要が一段と強まった。一方で介護報酬と賃金水準は需要に追いついておらず、慢性的人手不足が継続。外国人材の受け入れも本格化。</p>
    </section>
    <section class="report-section">
      <h2>4. クリエイティブ職の生成 AI 直撃</h2>
      <p>2022 年以降の画像生成 AI、2023 年以降の動画・音楽生成 AI で、デザイナー・イラストレーター・翻訳者の業務構造が急変。「AI を使いこなすクリエイター」と「AI に置き換わる工程」の境界線が引かれつつある。</p>
    </section>
    <section class="report-section">
      <h2>5. 物流・配送業の人手不足の深刻化</h2>
      <p>2024 年問題 (運転手の労働時間規制) でトラック業界の人手不足が一段と深刻化。一方で自動運転 AI の進展で 2030 年代に部分代替が見込まれるが、過渡期の人手不足は続く。賃金上昇圧力が継続。</p>
    </section>
    <Footer />
  </div>
</BaseLayout>
