---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { EXPLORE_ROUTES } from '@/views/explore-routes';
import { GENRE_HUB_CSS, renderExploreIndexCards, renderExploreIndexJsonLd } from '@/templates/Hub';

const canonical = 'https://mirai-shigoto.com/explore';
const title = '探す方法 — 7 つの入口 | 未来の仕事';
const seoDesc = '日本 556 職業を 7 つの入口から探せる。業種・ランキング・適職・スキル資格・働き方・比較・方法論。';

const cards = EXPLORE_ROUTES.map((r) => ({
  slug: r.slug, short_ja: r.short_ja, description_ja: r.description_ja,
  genreCount: r.genres.length,
}));
const cardsHtml = renderExploreIndexCards(cards);
const jsonLd = renderExploreIndexJsonLd();
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=explore" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>探す方法</span></nav>
    <header id="content">
      <h1><span class="accent">探す方法</span></h1>
      <p class="sub"><strong>7 つの入口</strong> から日本 556 職業を整理</p>
      <p class="intro">業種・ランキング・適職・スキル資格・働き方・比較・方法論など、7 つの異なる切り口で職業を探せます。あなたの目的・自己理解の深さ・キャリア段階に合わせて使い分けてください。</p>
    </header>
    <section><h2>7 つの入口</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
