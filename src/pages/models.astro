---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '@/site/config';
import {
  buildModelsFeaturePageModel,
  formatJapaneseDate,
  formatModelScore,
  scoreBarWidth,
} from '@/views/models';
import personalityCopy from '../content/model-personality.ja.json';
import storyCopy from '../content/model-story-overrides.ja.json';
import {
  CONSENSUS_VENDOR_UPDATE_NOTE_IMPACT,
  CONSENSUS_VENDOR_UPDATE_NOTE_LEAD,
  CONSENSUS_FLAGSHIP_SWITCH_NOTE_IMPACT,
  CONSENSUS_FLAGSHIP_SWITCH_NOTE_LEAD,
  CONSENSUS_FIFTH_VOTE_NOTE_IMPACT,
  CONSENSUS_FIFTH_VOTE_NOTE_LEAD,
  CONSENSUS_SWITCH_NOTE_IMPACT,
  CONSENSUS_SWITCH_NOTE_LEAD,
  MODELS_HUB_VENDOR_COUNT_LABEL,
  MODELS_HUB_VENDORS_HEADING,
  MODELS_HUB_VENDORS_INTRO,
} from '@/site/consensus-copy';

const projectionRaw = await readFile(join(process.cwd(), 'public', 'data.models_deep.json'), 'utf-8');
const projection = JSON.parse(projectionRaw);
const page = buildModelsFeaturePageModel(projection, personalityCopy, storyCopy);

const pageTitle = 'AIモデル比較 | 未来の仕事';
const pageDescription = page.description;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteConfig.origin}/models#webpage`,
      name: 'AIモデル比較',
      url: `${siteConfig.origin}/models`,
      description: pageDescription,
      inLanguage: 'ja',
      isPartOf: { '@id': `${siteConfig.origin}/#website` },
      datePublished: '2026-07-12',
      dateModified: page.pageLastUpdated,
      breadcrumb: { '@id': `${siteConfig.origin}/models#breadcrumb` },
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.lead'] },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteConfig.origin}/models#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '日本の職業 AI 影響マップ', item: `${siteConfig.origin}/` },
        { '@type': 'ListItem', position: 2, name: 'モデル比較', item: `${siteConfig.origin}/models` },
      ],
    },
  ],
});

const localCss = `
*,*::before,*::after{box-sizing:border-box}
html body.models-surface{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-sans);line-height:1.75;line-break:strict}
html body.models-surface .models-hero h1{font-family:var(--font-serif)!important;font-size:clamp(2rem,4.6vw,4.2rem)!important;font-weight:700!important;line-height:1.1!important}
html body.models-surface .feature-section h2,
html body.models-surface .cta-band h2{font-family:var(--font-serif)!important;font-size:clamp(1.5rem,2.8vw,2.2rem)!important;font-weight:700!important;line-height:1.25!important}
html body.models-surface .current-model-card h2{font-family:var(--font-serif)!important;font-size:1.45rem!important;font-weight:700!important;line-height:1.25!important}
html body.models-surface .contrast-panel h3{font-family:var(--font-serif)!important;font-size:1.18rem!important;font-weight:700!important;line-height:1.35!important}
html body.models-surface .story-head h3{font-family:var(--font-serif)!important;font-size:clamp(1.3rem,2.4vw,1.8rem)!important;font-weight:700!important;line-height:1.3!important}
a{color:var(--accent-deep);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
a:hover{color:var(--accent)}
.models-feature{max-width:1120px;margin:0 auto;padding:32px 20px 80px}
.crumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 26px;color:var(--fg2);font-size:.86rem;line-height:1.5;overflow-wrap:anywhere}
.crumb a{color:var(--fg2);text-decoration:none}
.crumb a:hover{color:var(--accent);text-decoration:underline}
.crumb span[aria-hidden]{color:var(--fg3)}
.models-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,360px);gap:28px;align-items:end;padding:18px 0 32px;border-bottom:1px solid var(--border)}
.models-kicker{margin:0 0 12px;color:var(--accent-deep);font-weight:800;font-size:.84rem;letter-spacing:0}
.models-hero h1{max-width:820px;margin:0;letter-spacing:0;color:var(--fg);overflow-wrap:normal;word-break:normal}
.models-hero .hook{max-width:780px;margin:12px 0 0;font-size:1rem;line-height:1.75;color:var(--fg2);overflow-wrap:break-word;word-break:normal}
.models-hero .lead{max-width:740px;margin:14px 0 0;color:var(--fg2);font-size:1rem;line-height:1.9;overflow-wrap:break-word;word-break:normal}
.current-model-card{border:1px solid var(--border);border-radius:8px;background:var(--bg2);padding:18px;box-shadow:0 1px 0 rgba(0,0,0,.03),0 12px 28px rgba(120,80,30,.06)}
.current-label{margin:0 0 10px;color:var(--fg2);font-size:.78rem;font-weight:800}
.current-model-card h2{margin:0;overflow-wrap:break-word;word-break:normal}
.current-model-card dl{display:grid;grid-template-columns:88px 1fr;gap:9px 12px;margin:14px 0 0}
.current-model-card dt{color:var(--fg2);font-size:.78rem}
.current-model-card dd{margin:0;font-weight:800;overflow-wrap:anywhere}
.current-model-card p{margin:14px 0 0;color:var(--fg2);line-height:1.75;overflow-wrap:break-word;word-break:normal}
.current-model-link{display:inline-flex;align-items:center;justify-content:center;min-height:40px;margin-top:16px;border:1px solid var(--fg);border-radius:6px;padding:0 13px;background:var(--fg);color:var(--bg);font-weight:800;text-decoration:none;overflow-wrap:anywhere}
.current-model-link:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.feature-section{padding:38px 0;border-bottom:1px solid var(--border)}
.feature-section h2{margin:0 0 16px;color:var(--fg);overflow-wrap:break-word;word-break:normal}
.section-intro{max-width:760px;margin:0 0 22px;color:var(--fg2);line-height:1.9;overflow-wrap:break-word;word-break:normal}
html body.models-surface .vendor-card h3{font-family:var(--font-serif)!important;font-size:1.3rem!important;font-weight:700!important;line-height:1.3!important}
.vendor-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:20px 0 0}
.vendor-card{min-width:0;border:1px solid var(--border);border-radius:8px;background:var(--bg2);padding:18px;box-shadow:0 1px 0 rgba(0,0,0,.03),0 12px 28px rgba(120,80,30,.06)}
.vendor-name{margin:0 0 8px;color:var(--accent-deep);font-size:.78rem;font-weight:800;letter-spacing:0}
.vendor-card h3{margin:0;overflow-wrap:break-word;word-break:normal}
.vendor-card h3 a{color:var(--fg);text-decoration:none}
.vendor-card h3 a:hover{color:var(--accent);text-decoration:underline}
.vendor-facts{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;margin:12px 0 0}
.vendor-facts div{display:contents}
.vendor-facts dt{color:var(--fg2);font-size:.78rem}
.vendor-facts dd{margin:0;font-weight:800;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.vendor-personality{margin:12px 0 0;color:var(--fg2);font-size:.92rem;line-height:1.75;overflow-wrap:break-word;word-break:normal}
.vendor-link{display:inline-flex;align-items:center;margin-top:14px;color:var(--accent);font-size:.86rem;font-weight:900;text-decoration:none}
.vendor-link:hover,.vendor-link:focus-visible{text-decoration:underline}
.vendor-history{margin:16px 0 0;border-top:1px solid var(--border);padding-top:12px}
.vendor-history summary{display:flex;align-items:center;min-height:36px;width:max-content;max-width:100%;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--fg);font-size:.82rem;font-weight:800;cursor:pointer;overflow-wrap:break-word;word-break:normal}
.vendor-history summary:hover{border-color:var(--accent);color:var(--accent)}
.vendor-history[open] summary{margin-bottom:10px}
.vendor-history-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.vendor-history-list a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid rgba(92,82,60,.16);color:var(--fg);text-decoration:none;font-size:.9rem}
.vendor-history-list li:last-child a{border-bottom:0}
.vendor-history-list a:hover{color:var(--accent)}
.vendor-history-date{font-weight:900;font-variant-numeric:tabular-nums;color:var(--accent-deep);white-space:nowrap}
.vendor-history-model{min-width:0;font-weight:800;overflow-wrap:break-word;word-break:normal}
.vendor-history-count{white-space:nowrap;color:var(--fg2);font-size:.82rem;font-weight:800}
.vendor-history-empty{margin:16px 0 0;border-top:1px solid var(--border);padding-top:12px;color:var(--fg3);font-size:.82rem}
.contrast{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:22px;align-items:stretch}
.contrast-panel{border:1px solid var(--border);border-radius:8px;background:var(--bg2);padding:20px}
.contrast-panel h3{margin:0 0 12px;overflow-wrap:break-word;word-break:normal}
.consensus-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.consensus-list a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid rgba(92,82,60,.16);font-weight:800;text-decoration:none;color:var(--fg);overflow-wrap:anywhere}
.consensus-list li:last-child a{border-bottom:0}
.arrow{color:var(--accent);font-size:1.15rem}
.contrast-copy{margin:0;color:var(--fg2);line-height:1.9;overflow-wrap:break-word;word-break:normal}
.contrast-copy strong{color:var(--fg)}
.story-list{display:grid;gap:22px;min-width:0}
.story-card{min-width:0;max-width:100%;border:1px solid var(--border);border-radius:8px;background:linear-gradient(180deg,var(--bg2),var(--bg));padding:24px}
.story-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}
.story-head>div{min-width:0}
.story-head h3{margin:0;overflow-wrap:break-word;word-break:normal}
.story-head a{color:var(--fg);text-decoration-thickness:1px;text-underline-offset:4px}
.story-note{max-width:560px;margin:4px 0 0;color:var(--fg2);line-height:1.75;overflow-wrap:break-word;word-break:normal}
.score-bars{display:grid;gap:10px;margin:18px 0 20px}
.score-row{display:grid;grid-template-columns:minmax(0,120px) minmax(0,1fr) 46px;gap:12px;align-items:center;min-width:0}
.score-row span:first-child{min-width:0;font-weight:800;color:var(--fg2);font-size:.9rem;overflow-wrap:break-word;word-break:normal}
.score-track{height:12px;border-radius:999px;background:rgba(92,82,60,.14);overflow:hidden}
.score-fill{display:block;height:100%;border-radius:999px;background:var(--accent)}
.score-row:nth-child(2) .score-fill{background:var(--green-deep)}
.score-row:nth-child(3) .score-fill{background:var(--accent-2)}
.score-value{font-variant-numeric:tabular-nums;text-align:right;font-weight:700}
.quote-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;min-width:0}
.quote-block{margin:0;border-left:4px solid var(--accent);padding:2px 0 2px 16px}
.quote-block:nth-child(2){border-left-color:var(--green-deep)}
.quote-block:nth-child(3){border-left-color:var(--accent-2)}
.quote-block figcaption{font-weight:700;margin-bottom:8px;color:var(--fg)}
.quote-block blockquote{margin:0;color:var(--fg);font-size:1rem;line-height:1.9;overflow-wrap:break-word;word-break:normal}
.cta-band{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;background:var(--fg);color:var(--bg);border-radius:8px;padding:24px}
.cta-band h2{margin:0 0 8px;color:var(--bg)}
.cta-band p{margin:0;line-height:1.75;color:rgba(255,255,255,.82);overflow-wrap:break-word;word-break:normal}
.cta-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end}
.cta-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;border-radius:6px;padding:0 16px;font-weight:800;text-decoration:none;overflow-wrap:anywhere}
.cta-primary{background:var(--bg);color:var(--fg)}
.cta-secondary{border:1px solid rgba(255,255,255,.45);color:var(--bg)}
.data-note{padding:26px 0;color:var(--fg2);font-size:.92rem;line-height:1.8}
.data-note p{margin:0;overflow-wrap:break-word;word-break:normal}
.data-note p + p{margin-top:12px}
.data-note-history{margin-top:16px}
.data-note-history summary{cursor:pointer;font-weight:600;color:var(--fg)}
.data-note-history[open] summary{margin-bottom:12px}
@media(max-width:880px){
  .models-hero,.vendor-grid,.contrast,.quote-grid,.cta-band{grid-template-columns:1fr}
  .cta-actions{justify-content:flex-start}
}
@media(max-width:560px){
  .models-feature{padding:22px 16px 64px}
  .story-card{padding:18px}
  .story-head{display:block}
  .score-row{grid-template-columns:1fr 42px;gap:6px 10px}
  .score-row span:first-child{grid-column:1 / -1}
  .current-model-card dl{grid-template-columns:1fr}
}
`;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${siteConfig.origin}/models`}
  keywords="AIモデル, 職業, AI影響, 未来の仕事"
  ogTitle="AIモデル比較"
  ogDescription={pageDescription}
  bodyClass="models-surface"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={localCss} />

  <div id="wrapper" class="models-feature">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">日本の職業 AI 影響マップ</a>
      <span aria-hidden="true">›</span>
      <span>モデル比較</span>
    </nav>

    <header id="content" class="models-hero">
      <div>
        <p class="models-kicker">モデル比較</p>
        <h1>AIモデル比較</h1>
        <p class="hook">AIモデルは、あなたの仕事をどう見ているか。</p>
        <p class="lead">{page.lead}</p>
      </div>
      <aside class="current-model-card" aria-labelledby="current-model-title">
        <p class="current-label">{page.consensusSummary.label}</p>
        <h2 id="current-model-title">{page.consensusSummary.headline}</h2>
        <dl>
          <dt>{MODELS_HUB_VENDOR_COUNT_LABEL}</dt><dd>{page.consensusSummary.vendorCount}社</dd>
          <dt>最新採点</dt><dd>{formatJapaneseDate(page.consensusSummary.latestRunDate)}</dd>
          <dt>最新モデル</dt><dd><a href={page.consensusSummary.latestModelHref}>{page.consensusSummary.latestModelDisplay}</a></dd>
        </dl>
        <p>{page.consensusSummary.oneLiner}</p>
        {page.consensusSummary.agingNote && <p>{page.consensusSummary.agingNote}</p>}
        <a class="current-model-link" href={page.consensusSummary.latestModelHref}>{page.consensusSummary.latestModelDisplay} の分布を見る</a>
      </aside>
    </header>

    <section class="feature-section" aria-labelledby="models-vendors">
      <h2 id="models-vendors">{MODELS_HUB_VENDORS_HEADING}</h2>
      <p class="section-intro">{MODELS_HUB_VENDORS_INTRO}</p>
      <div class="vendor-grid">
        {page.lanes.map((lane) => (
          <article class="vendor-card" aria-labelledby={`vendor-${lane.provider}`}>
            <p class="vendor-name">{lane.vendorDisplay}</p>
            <h3 id={`vendor-${lane.provider}`}><a href={lane.latest.href}>{lane.latest.modelDisplay}</a></h3>
            <dl class="vendor-facts">
              <div><dt>採点日</dt><dd>{formatJapaneseDate(lane.latest.date)}</dd></div>
              <div><dt>対象</dt><dd>{lane.latest.covered_count}職業</dd></div>
            </dl>
            <p class="vendor-personality">{lane.latest.personality_sentence}</p>
            <a class="vendor-link" href={lane.latest.href}>詳しく見る ›</a>
            {lane.history.length > 0 ? (
              <details class="vendor-history">
                <summary>{lane.historySummary}</summary>
                <ol class="vendor-history-list">
                  {lane.history.map((run) => (
                    <li>
                      <a href={run.href}>
                        <span class="vendor-history-date">{formatJapaneseDate(run.date)}</span>
                        <span class="vendor-history-model">{run.modelDisplay}</span>
                        <span class="vendor-history-count">{run.covered_count}職業</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ) : (
              <p class="vendor-history-empty">{lane.historySummary}</p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-contrast">
      <h2 id="models-contrast">モデルの見方が近い職業・分かれた職業</h2>
      <div class="contrast">
        <div class="contrast-panel">
          <h3>近く見えていた職業</h3>
          <ul class="consensus-list">
            {page.consensus.map((row) => (
              <li><a href={row.href}>{row.title_ja}<span class="arrow" aria-hidden="true">›</span></a></li>
            ))}
          </ul>
        </div>
        <div class="contrast-panel">
          <h3>見方が大きく分かれた職業</h3>
          <p class="contrast-copy">{page.contrastCopy}</p>
        </div>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-stories">
      <h2 id="models-stories">モデルで見方が分かれた職業</h2>
      <p class="section-intro">
        棒は、各モデルが見た「仕事の変わりやすさ」です。理由文は採点時の文章をそのまま載せています。
      </p>
      <div class="story-list">
        {page.stories.map((story) => (
          <article class="story-card">
            <div class="story-head">
              <div>
                <h3><a href={story.href}>{story.title_ja}</a></h3>
                <p class="story-note">{story.editorial_sentence}</p>
              </div>
            </div>

            <div class="score-bars" aria-label={`${story.title_ja}のモデル別スコア`}>
              {story.scores.map((s) => (
                <div class="score-row">
                  <span>{s.modelDisplay}</span>
                  <span class="score-track" aria-hidden="true"><span class="score-fill" style={`width:${scoreBarWidth(s.transformation)}`}></span></span>
                  <span class="score-value">{formatModelScore(s.transformation)}</span>
                </div>
              ))}
            </div>
            <div class="quote-grid">
              {story.scores.map((s) => (
                <figure class="quote-block">
                  <figcaption>{s.modelDisplay} の理由</figcaption>
                  <blockquote>{s.rationale_ja}</blockquote>
                </figure>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-cta">
      <div class="cta-band">
        <div>
          <h2 id="models-cta">あなたの職業では？</h2>
          <p>
            職業ページでは、あなたの仕事についてモデルごとの推移を見られます。まずは診断で近い職業を探すか、職業マップから気になる仕事を開いてください。
          </p>
        </div>
        <div class="cta-actions">
          <a class="cta-primary" href="/shindan">診断をはじめる</a>
          <a class="cta-secondary" href="/map">職業マップを見る</a>
        </div>
      </div>
    </section>

    <section class="data-note" aria-label="データについて">
      <p>
        公開値は複数のAIによる総合です。このページは {page.batchDatesText} の採点結果をもとにしています。各回の対象範囲は {page.coverageRangeText} です。採点方法は <a href="/methodology">評価プロセス</a> と <a href="/standard">AIOIS-10 標準</a> を参照してください。
      </p>
      <p>{CONSENSUS_VENDOR_UPDATE_NOTE_LEAD}</p>
      <p>{CONSENSUS_VENDOR_UPDATE_NOTE_IMPACT}</p>
      <details class="data-note-history">
        <summary>これまでの変更</summary>
        <p>{CONSENSUS_FLAGSHIP_SWITCH_NOTE_LEAD}</p>
        <p>{CONSENSUS_FLAGSHIP_SWITCH_NOTE_IMPACT}</p>
        <p>{CONSENSUS_FIFTH_VOTE_NOTE_LEAD}</p>
        <p>{CONSENSUS_FIFTH_VOTE_NOTE_IMPACT}</p>
        <p>{CONSENSUS_SWITCH_NOTE_LEAD}</p>
        <p>{CONSENSUS_SWITCH_NOTE_IMPACT}</p>
      </details>
    </section>

    <template id="models-projection" set:html={page.projectionJson}></template>

    <Footer />
  </div>
</BaseLayout>
