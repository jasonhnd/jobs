---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { CANONICAL_DOC_CSS } from '@/lib/canonical/doc';
import { siteConfig } from '@/site/config';
import {
  buildModelsFeaturePageModel,
  formatModelScore,
  scoreBarWidth,
} from '@/views/models';
import personalityCopy from '../content/model-personality.ja.json';
import storyCopy from '../content/model-story-overrides.ja.json';

const projectionRaw = await readFile(join(process.cwd(), 'public', 'data.models_deep.json'), 'utf-8');
const projection = JSON.parse(projectionRaw);
const page = buildModelsFeaturePageModel(projection, personalityCopy, storyCopy);

const pageTitle = 'AIモデルは、あなたの仕事をどう見ているか | 未来の仕事';
const pageDescription =
  '3つのAIモデルが556職業を採点した結果から、判断が一致した職業と大きく分かれた職業をストーリーで読む特集ページです。';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteConfig.origin}/models#webpage`,
      name: 'AIモデルは、あなたの仕事をどう見ているか',
      url: `${siteConfig.origin}/models`,
      description: pageDescription,
      inLanguage: 'ja',
      isPartOf: { '@id': `${siteConfig.origin}/#website` },
      datePublished: '2026-07-12',
      dateModified: page.pageLastUpdated,
      breadcrumb: { '@id': `${siteConfig.origin}/models#breadcrumb` },
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.lead'] },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteConfig.origin}/models#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '日本の職業 AI 影響マップ', item: `${siteConfig.origin}/` },
        { '@type': 'ListItem', position: 2, name: 'モデル特集', item: `${siteConfig.origin}/models` },
      ],
    },
  ],
});

const localCss = `
.models-feature{max-width:1080px}
.models-hero{padding:34px 0 24px;border-bottom:1px solid var(--border)}
.models-kicker{margin:0 0 14px;color:var(--accent);font-weight:700;font-size:.86rem;letter-spacing:0}
.models-hero h1{max-width:820px;margin:0;font-family:var(--font-serif);font-size:clamp(2.35rem,4.8vw,4.55rem);line-height:1.08;letter-spacing:0;color:var(--fg)}
.models-hero .hook{max-width:760px;margin:22px 0 0;font-family:var(--font-serif);font-size:clamp(1.18rem,2vw,1.55rem);line-height:1.65;color:var(--fg)}
.models-hero .lead{max-width:720px;margin:16px 0 0;color:var(--fg2);font-size:1rem;line-height:1.9}
.feature-section{padding:38px 0;border-bottom:1px solid var(--border)}
.feature-section h2{margin:0 0 18px;font-family:var(--font-serif);font-size:clamp(1.65rem,3vw,2.3rem);line-height:1.25;color:var(--fg)}
.section-intro{max-width:700px;margin:0 0 22px;color:var(--fg2);line-height:1.9}
.model-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.model-card{border:1px solid var(--border);border-radius:8px;background:var(--bg2);padding:18px;min-height:196px;display:flex;flex-direction:column;gap:12px}
.model-card h3{margin:0;font-family:var(--font-serif);font-size:1.4rem;line-height:1.25}
.model-meta{display:flex;flex-wrap:wrap;gap:8px;color:var(--fg2);font-size:.86rem}
.model-meta span{border:1px solid rgba(92,82,60,.22);border-radius:999px;padding:4px 9px;background:var(--bg)}
.model-card p{margin:auto 0 0;line-height:1.8}
.contrast{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:22px;align-items:stretch}
.contrast-panel{border:1px solid var(--border);border-radius:8px;background:var(--bg2);padding:20px}
.contrast-panel h3{margin:0 0 12px;font-family:var(--font-serif);font-size:1.28rem}
.consensus-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.consensus-list a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid rgba(92,82,60,.16);font-weight:700;text-decoration:none;color:var(--fg)}
.consensus-list li:last-child a{border-bottom:0}
.arrow{color:var(--accent);font-size:1.15rem}
.contrast-copy{margin:0;color:var(--fg2);line-height:1.9}
.contrast-copy strong{color:var(--fg)}
.story-list{display:grid;gap:22px}
.story-card{border:1px solid var(--border);border-radius:8px;background:linear-gradient(180deg,var(--bg2),var(--bg));padding:24px}
.story-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}
.story-head h3{margin:0;font-family:var(--font-serif);font-size:clamp(1.35rem,2.4vw,1.85rem);line-height:1.3}
.story-head a{color:var(--fg);text-decoration-thickness:1px;text-underline-offset:4px}
.story-note{max-width:520px;margin:4px 0 0;color:var(--fg2);line-height:1.75}
.score-bars{display:grid;gap:10px;margin:18px 0 20px}
.score-row{display:grid;grid-template-columns:110px minmax(0,1fr) 46px;gap:12px;align-items:center}
.score-row span:first-child{font-weight:700;color:var(--fg2);font-size:.9rem}
.score-track{height:12px;border-radius:999px;background:rgba(92,82,60,.14);overflow:hidden}
.score-fill{display:block;height:100%;border-radius:999px;background:var(--accent)}
.score-row:nth-child(2) .score-fill{background:var(--green-deep)}
.score-value{font-variant-numeric:tabular-nums;text-align:right;font-weight:700}
.quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.quote-block{margin:0;border-left:4px solid var(--accent);padding:2px 0 2px 16px}
.quote-block:nth-child(2){border-left-color:var(--green-deep)}
.quote-block figcaption{font-weight:700;margin-bottom:8px;color:var(--fg)}
.quote-block blockquote{margin:0;color:var(--fg);font-family:var(--font-serif);font-size:1.02rem;line-height:1.9}
.cta-band{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;background:var(--fg);color:var(--bg);border-radius:8px;padding:24px}
.cta-band h2{margin:0 0 8px;color:var(--bg)}
.cta-band p{margin:0;line-height:1.75;color:rgba(255,255,255,.82)}
.cta-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end}
.cta-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;border-radius:999px;padding:0 16px;font-weight:700;text-decoration:none}
.cta-primary{background:var(--bg);color:var(--fg)}
.cta-secondary{border:1px solid rgba(255,255,255,.45);color:var(--bg)}
.data-note{padding:26px 0;color:var(--fg2);font-size:.92rem;line-height:1.8}
.data-note p{margin:0}
@media(max-width:880px){
  .model-grid,.contrast,.quote-grid,.cta-band{grid-template-columns:1fr}
  .cta-actions{justify-content:flex-start}
}
@media(max-width:560px){
  .story-card{padding:18px}
  .story-head{display:block}
  .score-row{grid-template-columns:88px minmax(0,1fr) 42px}
}
`;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${siteConfig.origin}/models`}
  keywords="AIモデル, 職業, AI影響, 未来の仕事"
  ogTitle="AIモデルは、あなたの仕事をどう見ているか"
  ogDescription={pageDescription}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={`${CANONICAL_DOC_CSS}\n${localCss}`} />

  <div id="wrapper" class="models-feature">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">日本の職業 AI 影響マップ</a>
      <span aria-hidden="true">›</span>
      <span>モデル特集</span>
    </nav>

    <header id="content" class="models-hero">
      <p class="models-kicker">モデル特集</p>
      <h1>AIモデルは、あなたの仕事をどう見ているか</h1>
      <p class="hook">556の職業を、3つのAIモデルがそれぞれ採点した。結果は同じではなかった。</p>
      <p class="lead">
        AIの判断には、それぞれの見方があります。同じ職業でも、現場性を重く見るか、手順化や自動化の進みやすさを重く見るかで、仕事の未来は違って見えます。
      </p>
    </header>

    <section class="feature-section" aria-labelledby="models-cast">
      <h2 id="models-cast">登場モデル</h2>
      <div class="model-grid">
        {page.modelCards.map((card) => (
          <article class="model-card">
            <h3>{card.modelDisplay}</h3>
            <div class="model-meta">
              <span>{card.date}</span>
              <span>{card.covered_count}職業</span>
            </div>
            <p>{card.personality_sentence}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-contrast">
      <h2 id="models-contrast">意見が一致した職業 / 割れた職業</h2>
      <div class="contrast">
        <div class="contrast-panel">
          <h3>近く見えていた職業</h3>
          <ul class="consensus-list">
            {page.consensus.map((row) => (
              <li><a href={row.href}>{row.title_ja}<span class="arrow" aria-hidden="true">›</span></a></li>
            ))}
          </ul>
        </div>
        <div class="contrast-panel">
          <h3>大きく分かれた職業へ</h3>
          <p class="contrast-copy">
            最新の比較では、<strong>{page.latestPair.baseline.modelDisplay}</strong> と <strong>{page.latestPair.candidate.modelDisplay}</strong> が、いくつかの職業をまったく違う角度から見ています。
            次のカードでは、差が大きかった職業を、両モデルの理由文そのままと一緒に読みます。
          </p>
        </div>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-stories">
      <h2 id="models-stories">分かれた職業のストーリー</h2>
      <p class="section-intro">
        棒は、各モデルが見た「仕事の変わりやすさ」です。理由文は採点時の文章をそのまま載せています。
      </p>
      <div class="story-list">
        {page.stories.map((story) => (
          <article class="story-card">
            <div class="story-head">
              <div>
                <h3><a href={story.href}>{story.title_ja}</a></h3>
                <p class="story-note">{story.editorial_sentence}</p>
              </div>
            </div>

            <div class="score-bars" aria-label={`${story.title_ja}のモデル別スコア`}>
              <div class="score-row">
                <span>{page.latestPair.baseline.modelDisplay}</span>
                <span class="score-track" aria-hidden="true"><span class="score-fill" style={`width:${scoreBarWidth(story.baseline_transformation)}`}></span></span>
                <span class="score-value">{formatModelScore(story.baseline_transformation)}</span>
              </div>
              <div class="score-row">
                <span>{page.latestPair.candidate.modelDisplay}</span>
                <span class="score-track" aria-hidden="true"><span class="score-fill" style={`width:${scoreBarWidth(story.candidate_transformation)}`}></span></span>
                <span class="score-value">{formatModelScore(story.candidate_transformation)}</span>
              </div>
            </div>

            <div class="quote-grid">
              <figure class="quote-block">
                <figcaption>{page.latestPair.baseline.modelDisplay} の理由</figcaption>
                <blockquote>{story.baseline_rationale_ja}</blockquote>
              </figure>
              <figure class="quote-block">
                <figcaption>{page.latestPair.candidate.modelDisplay} の理由</figcaption>
                <blockquote>{story.candidate_rationale_ja}</blockquote>
              </figure>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="feature-section" aria-labelledby="models-cta">
      <div class="cta-band">
        <div>
          <h2 id="models-cta">あなたの職業では？</h2>
          <p>
            職業ページでは、あなたの仕事についてモデルごとの推移を見られます。まずは診断で近い職業を探すか、職業マップから気になる仕事を開いてください。
          </p>
        </div>
        <div class="cta-actions">
          <a class="cta-primary" href="/shindan">診断をはじめる</a>
          <a class="cta-secondary" href="/map">職業マップを見る</a>
        </div>
      </div>
    </section>

    <section class="data-note" aria-label="データについて">
      <p>
        このページは {page.batchDatesText} の採点バッチをもとにしています。採点方法は <a href="/methodology">評価プロセス</a> と <a href="/standard">AIOIS-10 標準</a> を参照してください。
      </p>
    </section>

    <template id="models-projection" set:html={page.projectionJson}></template>

    <Footer />
  </div>
</BaseLayout>
