---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { OCCUPATION_COUNT } from '@/site/config';
import { loadGraph } from '@/graph';
import { GENRE_HUB_CSS } from '@/templates/Hub';
import { RELATED_CROSS_HUB_CSS } from '@/views/hub-hub-graph';
import { LIFE_BALANCE_CONFIGS } from '@/views/genre-configs';
import { buildGenreSlugBindings } from '../_genre-slug-bindings';

export async function getStaticPaths() {
  const { loadGraphAdaptedDetails } = await import('@/views/hub');
  const { buildGenreResult } = await import('@/views/genre-hub');
  const details = loadGraphAdaptedDetails(await loadGraph());
  return LIFE_BALANCE_CONFIGS.map((cfg) => ({
    params: { balance: cfg.slug },
    props: { result: buildGenreResult(details, cfg) },
  }));
}

const { result } = Astro.props;
const cfg = result.config;
const b = buildGenreSlugBindings({
  result, graph: await loadGraph(),
  genrePath: 'life-balance', genreLabel: 'ライフバランスから探す', ogParam: 'balance',
  allConfigs: LIFE_BALANCE_CONFIGS, crossHubKey: 'life-balance',
  subTemplate: (s, n) => `<strong>${s}</strong>に向く職業 TOP ${n}（全 ${OCCUPATION_COUNT.SCORED} 職業中）`,
  seoDescTemplate: (s, n, d) => `${s}向きの職業 TOP ${n}。${d.slice(0, 80)}…`,
  titleTemplate: (t, n) => `${t}｜TOP ${n}・AI 影響度付き | 未来の仕事`,
  relatedHeading: '他のライフバランス',
});
---
<BaseLayout title={b.title} description={b.seoDesc} canonical={b.canonical}
  ogImage={b.ogImage} ogTitle={b.title.slice(0, 120)} ogDescription={b.seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={b.jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />
  <div id="wrapper" class="hub-slug">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><a href="/life-balance" rel="up">ライフバランスから探す</a><span aria-hidden="true">›</span><span>{cfg.short_ja}</span></nav>
    <header id="content">
      <h1><span class="accent">{cfg.title_ja}</span></h1>
      <p class="sub" set:html={b.subHtml}></p>
    </header>
    <section class="hub-list-sec" aria-label={`${cfg.short_ja} TOP ${result.items.length}`}>
      <h2>{cfg.short_ja} TOP {result.items.length}</h2>
      <ol class="rank-list" set:html={b.rankItems} />
    </section>
    <details class="chap">
      <summary>読み方・出典</summary>
      <div class="chap-body">
        <p class="intro" set:html={b.introHtml}></p>
        <Fragment set:html={b.aiFactHtml} />
        <Fragment set:html={b.statsHtml} />
        <Fragment set:html={b.highlightsHtml} />
        <Fragment set:html={b.sectorChartHtml} />
      </div>
    </details>
    <Fragment set:html={b.faqHtml} />
    <Fragment set:html={b.crossHubHtml} />
    <section aria-label="他のライフバランス"><h2>他のライフバランス</h2><Fragment set:html={b.relatedHtml} /></section>
    <Footer />
  </div>
  <script is:inline slot="bodyEnd">
    (function () {
      try {
        if (!window.matchMedia('(min-width: 900px)').matches) return;
        var nodes = document.querySelectorAll('details.chap');
        for (var i = 0; i < nodes.length; i++) nodes[i].open = true;
      } catch (e) {}
    })();
  </script>
</BaseLayout>
