---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { LIFE_BALANCE_CONFIGS } from '@/views/genre-configs';
import { loadAllDetails, buildGenreResult } from '@/views/genre-hub';
import { renderGenreIndexJsonLd, renderGenreHubIndexCards, GENRE_HUB_CSS } from '@/templates/Hub';

const details = loadAllDetails();
const n = LIFE_BALANCE_CONFIGS.length;
const cards = LIFE_BALANCE_CONFIGS.map((cfg) => {
  const r = buildGenreResult(details, cfg);
  return {
    slug: cfg.slug, short_ja: cfg.short_ja, description_ja: cfg.description_ja,
    count: r.items.length, top: r.items[0]?.name_ja ?? '',
    countLabel: `TOP ${r.items.length} 職業`,
  };
});

const canonical = 'https://mirai-shigoto.com/life-balance';
const title = `ライフバランスから職業を探す｜育児・介護・健康・趣味と両立 ${n} hub | 未来の仕事`;
const seoDesc = '育児・介護・健康・精神負担・趣味・シニア活躍との両立しやすい職業を一覧。ライフステージ別に向く職業を AI 影響度・年収と共に確認。';
const jsonLd = renderGenreIndexJsonLd(canonical, 'ライフバランスから探す', seoDesc);
const cardsHtml = renderGenreHubIndexCards(cards, 'life-balance');
---
<BaseLayout title={title} description={seoDesc} canonical={canonical}
  ogImage="https://mirai-shigoto.com/api/og?page=life-balance" ogTitle={title} ogDescription={seoDesc}>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={GENRE_HUB_CSS} />
  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>ライフバランスから探す</span></nav>
    <header id="content">
      <h1><span class="accent">ライフバランスから職業を探す</span></h1>
      <p class="sub">ライフ条件 <strong>{n} 軸</strong> で 556 職業を整理</p>
      <p class="intro">育児・介護・健康・精神負担・趣味・シニア活躍との両立など、ライフステージ別に向く職業を一覧。労働時間・AI 影響度を組み合わせて、長く続けやすい仕事を探せます。</p>
    </header>
    <section><h2>ライフバランス {n} 軸</h2><ul class="genre-cards" set:html={cardsHtml} /></section>
    <Footer />
  </div>
</BaseLayout>
