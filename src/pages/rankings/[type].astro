---
import RankingPage from './_OrdinaryRankingPage.astro';
import { loadGraph } from '@/graph';
import { buildRankings } from '@/views/ranking';
import { rankingRoute } from '@/site/route-policy';
export async function getStaticPaths() {
  const { loadOccupationsFromGraph } = await import('@/views/ranking');
  const graph = await loadGraph();
  const { results } = buildRankings(() => loadOccupationsFromGraph(graph));
  return Array.from(results.values()).filter(r => rankingRoute(r.slug).ordinaryProCta)
    .map((r) => ({ params: { type: r.slug }, props: { result: r } }));
}

---
<RankingPage {...Astro.props} />
