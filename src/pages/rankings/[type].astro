---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import MeEntry from '@/components/MeEntry.astro';
import { loadGraph } from '@/graph';
import { buildRankings, loadOccupationsFromGraph, type RankingResult } from '@/views/ranking';
import { escapeHtml } from '@/templates/Ranking';
import { RELATED_CROSS_HUB_CSS } from '@/views/hub-hub-graph';
import { buildRankingsSlugBindings } from './_rankings-bindings';
import { suggestEscapeRoutes, renderEscapeRouteSection } from '@/views/escape-routes';
import { AI_FACT_CSS } from '@/lib/ai-fact-css';
import { RANK_LIST_CSS } from '@/lib/rank-list-css';

const HIGH_RISK_SLUGS = new Set(['ai-risk-high', 'ai-replaced-soon', 'ai-at-risk-but-paid']);

export async function getStaticPaths() {
  const { loadOccupationsFromGraph } = await import('@/views/ranking');
  const graph = await loadGraph();
  const { results } = buildRankings(() => loadOccupationsFromGraph(graph));
  return Array.from(results.values()).map((r) => ({ params: { type: r.slug }, props: { result: r } }));
}

const { result } = Astro.props as { result: RankingResult };
const graphForBindings = await loadGraph();
const b = buildRankingsSlugBindings(result, graphForBindings);

// RA-136 (Sprint 4.2): escape-route strip for high-AI-risk rankings.
// Uses TOP 1 of this ranking as the source job; suggests up to 6 low-risk
// migration candidates (ai_risk ≤ 4).
let escapeRoutesHtml = '';
if (HIGH_RISK_SLUGS.has(result.slug) && result.items.length > 0) {
  const fromJob = result.items[0];
  const allJobs = loadOccupationsFromGraph(graphForBindings);
  const candidates = suggestEscapeRoutes(fromJob, allJobs, 6);
  escapeRoutesHtml = renderEscapeRouteSection(fromJob.title_ja ?? `#${fromJob.id}`, candidates);
}
---
<BaseLayout
  title={result.title}
  description={result.seoDesc}
  canonical={b.canonical}
  ogImage={b.ogImage}
  ogTitle={result.title.slice(0, 120)}
  ogDescription={result.seoDesc}
>
  <script type="application/ld+json" slot="jsonLd" set:html={b.jsonLd} />

  <style slot="head" set:html={`
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}
body{background:var(--bg);color:var(--fg);font-family:var(--font-sans);line-height:1.65;font-feature-settings:"palt"}
a{color:var(--accent-deep);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
a:hover{color:var(--accent)}
#wrapper{max-width:var(--content-max);margin:0 auto;padding:32px 20px 80px}
.crumb{font-size:.85rem;color:var(--fg2);margin-bottom:14px}
.crumb a{color:var(--fg2)}
.crumb span[aria-hidden]{margin:0 8px;color:var(--fg3)}
header{margin-bottom:16px;border-bottom:1px solid var(--border);padding-bottom:14px}
h1{font-family:var(--font-serif);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:600;line-height:1.25;color:var(--fg);margin-bottom:8px}
h1 .accent{color:var(--accent-deep)}
.rk-sum{margin:0;color:var(--fg2);font-size:13.5px;line-height:1.55}
.rk-sum strong{color:var(--fg);font-weight:600}
.sub{color:var(--fg2);font-size:.95rem}
.sub strong{color:var(--accent-deep);font-weight:600}
.intro{margin:16px 0;color:var(--fg);font-size:1.05rem;max-width:64ch}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:32px 0}
.stats>div{background:var(--bg2);border:1px solid var(--border);padding:16px;border-radius:6px}
.stats dt{font-size:.75rem;color:var(--fg2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.stats dd{font-family:var(--font-serif);font-size:1.4rem;font-weight:600;color:var(--fg);font-variant-numeric:tabular-nums}
${AI_FACT_CSS}
section{margin:48px 0}
h2{font-family:var(--font-serif);font-size:1.35rem;font-weight:600;color:var(--fg);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.rk-list-sec{margin:8px 0 28px}
.rk-list-sec h2{font-size:12px;font-weight:600;color:var(--fg2);letter-spacing:.04em;border:none;padding:0;margin:0 0 8px;font-family:var(--font-sans)}
${RANK_LIST_CSS}
.demand-pill{display:inline-block;padding:2px 10px;border-radius:12px;font-size:.75rem;font-weight:600;font-variant-numeric:tabular-nums}
.demand-pill.hot{background:var(--risk-pill-low-bg);color:var(--risk-pill-low-fg)}
.demand-pill.warm{background:var(--risk-pill-mid-bg);color:var(--risk-pill-mid-fg)}
.demand-pill.cool{background:#D8E4F0;color:#3A5F7A}
.demand-pill.cold{background:#E8E4DF;color:#7A6F5E}
.chap-body .stats{margin:16px 0}
.chap-body .highlights{margin:16px 0}
.chap-body .ai-fact{margin-bottom:16px}
.highlights{margin:24px 0}
.highlights ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.highlights li{background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--accent-deep);padding:10px 16px;border-radius:0 6px 6px 0;font-size:.9rem;color:var(--fg);min-height:47px;display:flex;align-items:center}
.sector-chart{margin:24px 0}
.sc-title{font-size:.85rem;color:var(--fg2);margin-bottom:10px;font-weight:500}
.sb-row{display:grid;grid-template-columns:110px 1fr 44px;gap:8px;align-items:center;margin-bottom:5px;font-size:.8rem}
.sb-label{color:var(--fg2);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sb-track{height:14px;background:var(--bg3);border-radius:3px;overflow:hidden}
.sb-fill{display:block;height:100%;background:var(--accent-deep);border-radius:3px;min-width:3px;transition:width .3s}
.sb-count{color:var(--fg3);font-variant-numeric:tabular-nums;text-align:right}
.faq{margin:48px 0}
.faq details{background:var(--bg2);border:1px solid var(--border);border-radius:6px;margin-bottom:8px}
.faq summary{padding:14px 18px;cursor:pointer;font-weight:500;font-size:.95rem;color:var(--fg);list-style:none}
.faq summary::before{content:"Q. ";color:var(--accent);font-weight:700}
.faq summary::-webkit-details-marker{display:none}
.faq .faq-a{padding:0 18px 14px;font-size:.9rem;color:var(--fg2);line-height:1.7}
.related-rankings{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;padding:0;margin:0;list-style:none;grid-auto-rows:1fr}
.related-rankings li a{display:flex;flex-direction:column;padding:14px 16px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;text-decoration:none;color:var(--fg);font-weight:500;transition:border-color 150ms;height:100%}
.related-rankings li a:hover{border-color:var(--accent);color:var(--accent-deep)}
.related-rankings .rr-desc{font-size:.82rem;color:var(--fg2);font-weight:400;margin-top:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;flex:1}
.insights{margin:48px 0}
.insights ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.insights li{background:var(--bg2);border:1px solid var(--border);padding:12px 16px;border-radius:6px;font-size:.9rem;color:var(--fg)}
.insights li strong{color:var(--accent-deep)}
footer{margin-top:64px;padding-top:24px;border-top:1px solid var(--border);font-size:.85rem;color:var(--fg2);text-align:center}
footer .footer-links{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center;margin-bottom:14px}
footer .footer-links a{color:var(--fg2);text-decoration:none;padding:5px 14px;border:1px solid var(--border);border-radius:999px;font-size:.78rem;line-height:1.2;transition:color 150ms ease,border-color 150ms ease,background 150ms ease}
footer .footer-links a:hover{color:var(--accent);border-color:var(--accent);background:rgba(217,107,61,0.06);text-decoration:none}
footer .footer-meta{color:var(--fg2);font-size:.7rem;opacity:.92;text-wrap:pretty;line-height:1.65}
footer .footer-meta a{color:var(--accent)}
footer .footer-meta .nowrap{white-space:nowrap}
@media (max-width:540px){footer .footer-meta{font-size:.66rem;line-height:1.6;word-break:keep-all;overflow-wrap:anywhere}}
/* RA-121 (2026-05-18): mobile sector-bar label no longer truncates.
   Was 100px column with ellipsis -> "クリエイティブ・メ..."; now 128px
   with 2-line wrap, font shrunk to 0.7rem, line-height 1.2. */
@media (max-width:600px){#wrapper{padding:16px 16px 60px}.sb-row{grid-template-columns:128px 1fr 36px;gap:6px;align-items:center}.sb-label{font-size:.7rem;line-height:1.2;white-space:normal;overflow:visible;text-overflow:initial;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:keep-all;overflow-wrap:anywhere}.highlights li{min-height:72px;display:flex;align-items:center;font-size:.85rem;line-height:1.5}}
/* RA-136 (Sprint 4.2): escape-route strip — low-AI-risk migration
   candidates surfaced on high-risk ranking pages. */
.escape-routes{margin:48px 0 32px;padding:24px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;border-left:4px solid var(--accent-deep)}
.escape-routes h2{font-family:var(--font-serif);font-size:1.2rem;font-weight:600;color:var(--accent-deep);margin:0 0 8px;border-bottom:none;padding-bottom:0}
.escape-lede{color:var(--fg2);font-size:.92rem;margin:0 0 16px;line-height:1.6}
.escape-cards{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin:0;padding:0}
.escape-card a{display:flex;flex-direction:column;gap:6px;padding:14px;background:var(--bg);border:1px solid var(--border);border-radius:6px;text-decoration:none;color:var(--fg);transition:border-color 150ms}
.escape-card a:hover{border-color:var(--accent);color:var(--accent-deep)}
.ec-name{font-weight:500;font-size:1rem}
.ec-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ec-sector{font-size:.74rem;color:var(--fg2)}
.ec-reason{font-size:.72rem;color:var(--fg3);font-style:italic}
@media (max-width:600px){.escape-cards{grid-template-columns:1fr}}
`} />
  <style slot="head" set:html={RELATED_CROSS_HUB_CSS} />

  <div id="wrapper">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">未来の仕事</a>
      <span aria-hidden="true">›</span>
      <a href="/rankings" rel="up">ランキング</a>
      <span aria-hidden="true">›</span>
      <span set:html={escapeHtml(result.h1Text)} />
    </nav>

    <header id="content">
      <h1><span class="accent" set:html={escapeHtml(result.h1Text)} /></h1>
      <Fragment set:html={b.summaryHtml} />
    </header>

    <section class="rk-list-sec" aria-label="ランキング">
      <h2>TOP {result.items.length}</h2>
      <ol class="rank-list" set:html={b.rankItems} />
    </section>

    <details class="chap">
      <summary>このランキングの読み方・出典</summary>
      <div class="chap-body">
        <p class="sub" set:html={result.subText} />
        <p class="intro" set:html={b.introInlinedHtml} />
        <Fragment set:html={b.aiFactHtml} />
        <Fragment set:html={b.statsHtml} />
        <Fragment set:html={b.highlightsHtml} />
        <Fragment set:html={b.sectorChartHtml} />
      </div>
    </details>

    <MeEntry source="rankings">
      気になった仕事は、<strong>ほかのランキング</strong>ではどの位置でしょう。
    </MeEntry>

    <Fragment set:html={b.faqHtml} />

    <Fragment set:html={b.crossHubHtml} />

    <section aria-label="他のランキング">
      <h2>他のランキング</h2>
      <Fragment set:html={b.relatedHtml} />
    </section>

    <Fragment set:html={escapeRoutesHtml} />

    <Footer />
  </div>

  {/* Static body: open shared chapters on desktop. No interpolation (#321 / §3.6). */}
  <script is:inline slot="bodyEnd">
    (function () {
      try {
        if (!window.matchMedia('(min-width: 900px)').matches) return;
        var nodes = document.querySelectorAll('details.chap');
        for (var i = 0; i < nodes.length; i++) nodes[i].open = true;
      } catch (e) {}
    })();
  </script>
</BaseLayout>
