---
/**
 * me.astro — /me 自分の現在地 (RA-134, Phase 2 M2).
 *
 * Typeahead-driven self-positioning tool. User types a job name, picks
 * one from the live combobox, and sees:
 *   1. Summary card: sector / AI 影響 / 就業者数 / 年収
 *   2. 39 ranking positions (rank within TOP-N + per-universe percentile)
 *   3. 5 similar jobs (same sector, AI risk ± 1)
 *
 * Data:
 *   /data.search.json        — typeahead corpus (556 docs)
 *   /data.me-positions.json  — pre-computed ranking positions (RA-134
 *                              projection, src/data/projections/me-positions.ts)
 *   /data.treemap.json       — used for similar-job lookups (sector + AI risk)
 *
 * URL bookmark: ?id=<jobId> auto-restores on page load via the same
 * code path the user-driven selection takes; history.replaceState
 * is updated on every selection.
 *
 * CSP: _me-inline.js is injected as one STATIC inline <script> body
 * (no per-build interpolation, no template-string substitutions). One
 * sha256 hash in vercel.json's script-src covers it. See
 * compute-csp-hashes.cjs.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import { OCCUPATION_COUNT } from '@/site/config';
import { QUESTIONS, VARIANT_BUCKETS_BY_FAMILY } from '@/site/worktype-copy';

const canonical = 'https://mirai-shigoto.com/me';
const title = '自分の現在地｜全 39 ランキングでの位置を確認 - 未来の仕事';
const seoDesc =
  `職業を入力するだけで、AI 影響度・年収・就業者数・労働時間など 39 のランキングであなたの仕事が日本のどこにいるかを瞬時に確認。全 ${OCCUPATION_COUNT.SCORED} 職業の中での位置と業種内の類似職を提示。`;

const ME_INLINE_JS = readFileSync(
  join(process.cwd(), 'src', 'pages', '_me-inline.js'),
  'utf-8',
);

function safeJsonForScript(value: unknown): string {
  const text = JSON.stringify(value) ?? 'null';
  return text
    .replace(/<\//g, '<\\/')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
}

const meQuizCopyJson = safeJsonForScript({
  questions: QUESTIONS,
  variantBuckets: VARIANT_BUCKETS_BY_FAMILY,
  // /me screen 3 headings address この仕事 as the visitor's own job.
  // Separate from GAP in worktype-copy.ts, which still frames a looked-up occupation.
  gap: {
    aligned: {
      heading: 'この仕事は、あなたの得意な進め方に近いです',
      reading: 'この仕事は、あなたがふだん使いやすい進め方と近いところがあります。',
      action: 'AIで変わる作業を確認しながら、今の強みをどの業務で伸ばすか見てみましょう。',
    },
    hidden_strength: {
      heading: 'あなたの強みが、この仕事ではまだ眠っています',
      reading: 'あなたの{strengths}という強みが、この仕事ではまだ使い切れていないかもしれません。',
      action: 'その強みを使える役割に広げるか、近い職業も比べてみましょう。',
    },
    hidden_risk: {
      heading: 'この仕事での進め方は、これから変えていけます',
      reading: 'この仕事では、判断、人との接点、AIを使った進め方がこれから効きやすくなります。',
      action: '判断を加える練習、人との接点を増やす工夫、AI補助のワークフローから始めましょう。',
    },
  },
});

// JSON-LD: @graph form pairs WebApplication (semantic app classification)
// with WebPage (page-identity node required by scripts/verify-jsonld.cjs §6.3,
// which expects every page to carry one of WebPage / Article / TechArticle /
// CollectionPage / QAPage / Dataset). WebApplication alone is not on that
// allow-list, which left /me failing the SEO Baseline verify-jsonld check
// since the page was added.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      name: title,
      url: canonical,
      description: seoDesc,
      inLanguage: 'ja',
      isPartOf: { '@type': 'WebSite', name: 'Mirai-Shigoto', url: 'https://mirai-shigoto.com/' },
    },
    {
      '@type': 'WebApplication',
      name: '自分の現在地 — Mirai-Shigoto',
      url: canonical,
      description: seoDesc,
      applicationCategory: 'CareerToolApplication',
      operatingSystem: 'Web',
      inLanguage: ['ja'],
      isAccessibleForFree: true,
    },
  ],
});
---
<BaseLayout
  title={title}
  description={seoDesc}
  canonical={canonical}
  ogTitle={title}
  ogDescription={seoDesc}
  ogImage="https://mirai-shigoto.com/api/og?page=me"
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />

  <link rel="preload" href="/data.search.json" as="fetch" slot="head" />
  <link rel="preload" href="/data.me-positions.json" as="fetch" slot="head" />

  <style slot="head" set:html={`
    .me-wrapper { max-width: 980px; margin: 0 auto; padding: 32px 20px 80px; }
    .me-crumb { font-size: .85rem; color: var(--fg2); margin-bottom: 24px; }
    .me-crumb a { color: var(--fg2); }
    .me-crumb span[aria-hidden] { margin: 0 8px; color: var(--fg3); }
    .me-head { margin-bottom: 28px; border-bottom: 1px solid var(--border); padding-bottom: 22px; }
    .me-head h1 {
      font-family: var(--font-serif); font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 600; line-height: 1.25; color: var(--fg); margin-bottom: 10px;
    }
    .me-head h1 .accent { color: var(--accent-deep); }
    .me-head .sub { color: var(--fg2); font-size: .95rem; }
    .me-head .sub strong { color: var(--accent-deep); font-weight: 600; }
    .me-search {
      position: relative; margin: 12px 0 0;
    }
    .me-search-input {
      width: 100%; height: 48px; padding: 0 18px 0 44px;
      background: var(--bg2); color: var(--fg);
      border: 1px solid var(--border); border-radius: 999px;
      font-size: 1rem;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='%237A6F5E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><path d='m21 21-4.3-4.3'/></svg>");
      background-repeat: no-repeat; background-position: 16px center;
    }
    .me-search-input:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px;
      border-color: var(--accent);
    }
    .me-listbox {
      position: absolute; left: 0; right: 0; top: 100%;
      margin-top: 6px; z-index: 20;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 8px; box-shadow: 0 12px 28px rgba(36,30,24,.12);
      list-style: none; padding: 6px 0; max-height: 360px;
      overflow-y: auto; display: none;
    }
    .me-listbox[data-open="true"] { display: block; }
    .me-listbox li {
      display: grid; grid-template-columns: 1fr auto;
      gap: 10px; align-items: center;
      padding: 10px 16px; cursor: pointer;
      border: none; background: transparent; color: var(--fg);
    }
    .me-listbox li:hover, .me-listbox li.focused {
      background: var(--bg3);
    }
    .me-listbox li.focused { outline: 2px solid var(--accent); outline-offset: -2px; }
    .me-listbox li .me-li-name { font-weight: 500; }
    .me-listbox li .me-li-sector { font-size: .76rem; color: var(--fg2); margin-top: 2px; }
    .me-listbox li .me-li-pill {
      display: inline-block; padding: 2px 10px; border-radius: 12px;
      font-size: .72rem; font-weight: 600; font-variant-numeric: tabular-nums;
    }
    .me-listbox li .me-li-pill.low { background:var(--risk-pill-low-bg);color:var(--risk-pill-low-fg); }
    .me-listbox li .me-li-pill.mid { background:var(--risk-pill-mid-bg);color:var(--risk-pill-mid-fg); }
    .me-listbox li .me-li-pill.high { background:var(--risk-pill-high-bg);color:var(--risk-pill-high-fg); }
    .me-empty {
      padding: 56px 24px; text-align: center; color: var(--fg2);
      background: var(--bg2); border: 1px dashed var(--border);
      border-radius: 10px; margin: 32px 0;
    }
    .me-empty p { margin: 0; font-size: .95rem; }
    .me-results { display: none; }
    .me-results[data-visible="true"] { display: block; }
    .me-summary {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; padding: 22px 22px 18px; margin: 28px 0 18px;
    }
    .me-summary-head { margin-bottom: 14px; }
    .me-summary-head .me-name {
      font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600;
      color: var(--fg); margin-bottom: 4px;
    }
    .me-summary-head .me-sector { font-size: .85rem; color: var(--fg2); }
    .me-summary-stats {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
    }
    .me-summary-stats > div {
      background: var(--bg); border: 1px solid var(--border);
      padding: 10px 14px; border-radius: 6px;
    }
    .me-summary-stats dt {
      font-size: .72rem; color: var(--fg2);
      text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px;
    }
    .me-summary-stats dd {
      font-family: var(--font-serif); font-size: 1.1rem;
      font-weight: 600; color: var(--fg);
      font-variant-numeric: tabular-nums;
    }
    .me-section { margin: 36px 0; }
    .me-section h2 {
      font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600;
      color: var(--fg); margin-bottom: 14px;
      padding-bottom: 8px; border-bottom: 1px solid var(--border);
    }
    .me-rank-list { list-style: none; padding: 0; margin: 0; }
    .me-rank-list li {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px; align-items: center;
      padding: 12px 16px; margin-bottom: 6px;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 6px;
    }
    .me-rank-list li.in-top { border-left: 3px solid var(--accent-deep); }
    .me-rank-list a {
      color: var(--fg); text-decoration: none; font-weight: 500;
    }
    .me-rank-list a:hover { color: var(--accent); }
    .me-rank-desc { font-size: .76rem; color: var(--fg2); margin-top: 2px; }
    .me-rank-pos { text-align: right; font-variant-numeric: tabular-nums; }
    .me-rank-pos .rank-top {
      display: inline-block; padding: 3px 10px; border-radius: 12px;
      font-size: .8rem; font-weight: 600;
      background:var(--risk-pill-low-bg);color:var(--risk-pill-low-fg);
    }
    .me-rank-pos .rank-out {
      display: inline-block;
      font-size: .78rem; color: var(--fg2);
    }
    .me-rank-pos .rank-detail {
      font-size: .72rem; color: var(--fg3); margin-top: 2px;
    }
    .me-rank-toggle {
      display: block; width: 100%;
      padding: 10px 16px; margin-top: 8px;
      background: var(--bg2); border: 1px dashed var(--border);
      border-radius: 6px; color: var(--accent-deep);
      font-size: .9rem; font-weight: 500; text-align: center;
      cursor: pointer;
    }
    .me-rank-toggle:hover { border-color: var(--accent); color: var(--accent); }
    .me-similar { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
    .me-similar a {
      display: flex; flex-direction: column;
      padding: 14px 16px; background: var(--bg2);
      border: 1px solid var(--border); border-radius: 6px;
      text-decoration: none; color: var(--fg); font-weight: 500;
    }
    .me-similar a:hover { border-color: var(--accent); color: var(--accent-deep); }
    .me-similar .me-similar-meta {
      font-size: .76rem; color: var(--fg2); margin-top: 4px;
      display: flex; gap: 8px; align-items: center;
    }
    .me-status {
      position: absolute; left: -10000px; width: 1px; height: 1px;
      overflow: hidden;
    }
    .me-quiz-cta {
      margin: 8px 0 28px; padding: 20px 22px;
      background: var(--bg2); border: 1px solid var(--border); border-radius: 10px;
    }
    .me-quiz-cta[hidden], .me-quiz[hidden], .me-gap[hidden] { display: none; }
    .me-quiz-cta p { margin: 0 0 14px; color: var(--fg); line-height: 1.8; }
    .me-quiz-open {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 44px; padding: 10px 18px; border-radius: 999px;
      border: 1px solid transparent; background: var(--accent); color: #fff;
      font-weight: 700; font-size: .92rem; cursor: pointer;
    }
    .me-quiz-open:hover { filter: brightness(1.04); }
    .me-quiz { margin: 8px 0 28px; padding: 22px;
      background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; }
    .me-quiz h2 { font-family: var(--font-serif); font-size: 1.2rem; margin: 0 0 8px; }
    .me-quiz .sub { margin: 0 0 18px; color: var(--fg2); font-size: .9rem; line-height: 1.8; }
    .me-quiz-question { border: 1px solid var(--border); border-radius: 8px; padding: 14px; margin: 0 0 12px; background: var(--bg); }
    .me-quiz-question legend { padding: 0; margin: 0 0 10px; font-weight: 600; }
    .me-quiz-meta { margin-right: 8px; color: var(--accent-deep); font-size: .78rem; font-weight: 700; }
    .me-quiz-choice-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .me-quiz-choice input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }
    .me-quiz-choice-text {
      display: flex; align-items: center; justify-content: center; min-height: 58px;
      padding: 10px 12px; border: 1px solid var(--border); border-radius: 7px;
      background: var(--bg2); color: var(--fg); font-size: .88rem; line-height: 1.5;
      text-align: center; cursor: pointer;
    }
    .me-quiz-choice input:checked + .me-quiz-choice-text {
      background: rgba(217,107,61,.14); border-color: var(--accent); font-weight: 600;
    }
    .me-quiz-choice input:focus-visible + .me-quiz-choice-text { outline: 2px solid var(--accent); outline-offset: 2px; }
    .me-quiz-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
    .me-quiz-submit {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 44px; padding: 10px 18px; border-radius: 999px; border: 0;
      background: var(--accent); color: #fff; font-weight: 700; cursor: pointer;
    }
    .me-quiz-submit:disabled { opacity: .45; cursor: not-allowed; }
    .me-gap { margin: 8px 0 28px; padding: 22px;
      background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; }
    .me-gap h2 { font-family: var(--font-serif); font-size: 1.2rem; margin: 0 0 10px; line-height: 1.45; }
    .me-gap-reading, .me-gap-action { margin: 0 0 10px; color: var(--fg); line-height: 1.8; }
    .me-gap-action { color: var(--fg2); }
    .me-gap-meter { margin: 0; color: var(--fg3); font-size: .82rem; }
    @media (max-width: 600px) {
      .me-wrapper { padding: 20px 16px 60px; }
      .me-rank-list li { grid-template-columns: 1fr auto; }
      .me-summary-head .me-name { font-size: 1.25rem; }
    }
  `} />

  <article class="me-wrapper">
    <nav class="me-crumb" aria-label="パンくずリスト">
      <a href="/" rel="up">未来の仕事</a>
      <span aria-hidden="true">›</span>
      <span>自分の現在地</span>
    </nav>

    <header class="me-head" id="content">
      <h1><span class="accent">自分の現在地</span></h1>
      <p class="sub">職業を入力して、<strong>全 39 ランキング</strong> での位置を確認</p>

      <form class="me-search" id="meForm" role="search" autocomplete="off">
        <label for="meInput" class="me-status">職業を検索</label>
        <input
          type="search"
          class="me-search-input"
          id="meInput"
          placeholder="気になる職業を入力 (例: 看護師、エンジニア)"
          aria-label="職業を検索"
          aria-autocomplete="list"
          aria-controls="meListbox"
          aria-expanded="false"
          role="combobox"
        />
        <ul
          class="me-listbox"
          id="meListbox"
          role="listbox"
          aria-label="検索候補"
        ></ul>
      </form>
      <p class="me-status" id="meAnnounce" aria-live="polite" aria-atomic="true"></p>
    </header>

    <div class="me-empty" id="meEmpty">
      <p>上の検索欄から職業を選択すると、全 39 ランキングでの位置と類似 5 職業を表示します。</p>
    </div>

    <div class="me-results" id="meResults" aria-live="polite">
      <section class="me-summary" aria-labelledby="meSummaryName">
        <div class="me-summary-head">
          <div class="me-name" id="meSummaryName"></div>
          <div class="me-sector" id="meSummarySector"></div>
        </div>
        <dl class="me-summary-stats">
          <div><dt>AI 影響度</dt><dd id="meStatRisk">—</dd></div>
          <div><dt>就業者数</dt><dd id="meStatWorkers">—</dd></div>
          <div><dt>年収</dt><dd id="meStatSalary">—</dd></div>
          <div><dt>業種</dt><dd id="meStatSector">—</dd></div>
        </dl>
      </section>

      <section class="me-section" aria-labelledby="meRanksHead">
        <h2 id="meRanksHead">全 39 ランキングでの位置</h2>
        <ul class="me-rank-list" id="meRankList"></ul>
        <button type="button" class="me-rank-toggle" id="meRankToggle" aria-expanded="false">
          残り <span id="meRankRest">31</span> 件を見る
        </button>
      </section>

      <script id="meQuizCopy" type="application/json" set:html={meQuizCopyJson}></script>

      <section class="me-quiz-cta" id="meQuizCta" hidden>
        <p>この仕事のAI影響度は分かりました。<br />では、あなた自身はどうでしょう。</p>
        <button type="button" class="me-quiz-open" id="meQuizOpen">9問で確かめる</button>
      </section>

      <section class="me-quiz" id="meQuiz" hidden aria-labelledby="meQuizHeading">
        <h2 id="meQuizHeading">あなたとこの仕事の距離</h2>
        <p class="sub">同じ仕事でも、向き合い方は人によって違います。9問で、あなたとこの仕事の距離を見てみましょう。</p>
        <form id="meQuizForm" autocomplete="off">
          {QUESTIONS.map((q, i) => (
            <fieldset class="me-quiz-question">
              <legend>
                <span class="me-quiz-meta">Q{i + 1}</span>
                {q.left} / {q.right}
              </legend>
              <div class="me-quiz-choice-row">
                <label class="me-quiz-choice">
                  <input type="radio" name={`me-q${i}`} value="left" />
                  <span class="me-quiz-choice-text">{q.left}</span>
                </label>
                <label class="me-quiz-choice">
                  <input type="radio" name={`me-q${i}`} value="right" />
                  <span class="me-quiz-choice-text">{q.right}</span>
                </label>
              </div>
            </fieldset>
          ))}
          <div class="me-quiz-actions">
            <button class="me-quiz-submit" type="submit" id="meQuizSubmit" disabled>答えを見る</button>
          </div>
        </form>
      </section>

      <section class="me-gap" id="meGap" hidden aria-labelledby="meGapHeading">
        <h2 id="meGapHeading"></h2>
        <p class="me-gap-reading" id="meGapReading"></p>
        <p class="me-gap-action" id="meGapAction"></p>
        <p class="me-gap-meter" id="meGapMeter"></p>
      </section>

      <section class="me-section" aria-labelledby="meSimilarHead">
        <h2 id="meSimilarHead">似た職業 (同業種・AI 影響度 ±1)</h2>
        <div class="me-similar" id="meSimilar"></div>
      </section>
    </div>

    <Footer />
  </article>

    <script slot="bodyEnd" is:inline set:html={ME_INLINE_JS} />
</BaseLayout>
