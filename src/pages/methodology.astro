---
/**
 * methodology.astro — データの整理と評価プロセス（「どう作ったか」の単一の正典）。
 *
 * 旧 /about/methodology（スコア帯の代表例）＋ /about/data-sources（出典詳細）を
 * 本ページに統合し、重複を解消。基準そのものの定義は /standard。
 * 共通文書 CSS は canonical/doc.ts。インライン JS なし。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { CANONICAL_DOC_CSS, heatBg } from '@/lib/canonical/doc';
import { loadGeoFacts } from '@/page-data/geo-facts-loader';
import { buildMethodologyBatchView } from '@/site/methodology-facts';

const facts = loadGeoFacts();
const batchView = buildMethodologyBatchView(facts);

// Last content-change date — bump when this page's content actually changes.
// Static (NOT the build clock): a build-time date drifted the SEO baseline on
// every new UTC day. See ai-adoption.ts for the data-derived equivalent.
const pageLastUpdated = '2026-07-17';

const VECTORS: [string, string][] = [
  ['skills（スキル）', '39 指標 0–5。読解・批判的思考・プログラミング・判断など。'],
  ['knowledge（知識）', '33 指標。医学・法律・コンピュータ・デザイン等の領域知識。'],
  ['abilities（能力）', '34 指標。手先の細かさ・指の器用さ・発想力など、体と頭の力。'],
  ['work_characteristics（仕事の特性）', '39 指標。反復性・機械ペース・対面・裁量・結果責任・感染リスク等。'],
  ['interests（興味 RIASEC）', '6 指標。現実的・研究的・芸術的・社会的・企業的・慣習的。'],
  ['work_activities（仕事の活動）', '41 指標。情報処理・コンピュータ作業・記録・対人援助など。'],
  ['work_values（仕事の価値観）', '11 指標。達成・自律・専門性・ワークライフバランス等。'],
];

// スコア帯の代表例（旧 /about/methodology より）。
const BANDS: { sc: string; n: number; ex: string; why: string }[] = [
  { sc: '1 前後', n: 1, ex: '潜水士・花火師', why: '体を使う現場の仕事。AI もロボットも届きにくい' },
  { sc: '2 前後', n: 2, ex: '美容師・家政婦・学童保育指導員', why: '手仕事と対面の関係が中核' },
  { sc: '3 前後', n: 3, ex: '看護師・バーテンダー・訪問介護', why: '身体ケア・対面が中心。AI 補助はできるが置きかえ不可' },
  { sc: '4 前後', n: 4, ex: 'スーパー店長・建築設計技術者', why: 'AI が下書きや分析を助けるが、現場の判断は人' },
  { sc: '5 前後', n: 5, ex: '薬剤師・臨床検査技師', why: '定型部分の自動化が進むが、資格と手技が残る' },
  { sc: '6 前後', n: 6, ex: '公認会計士・人事事務', why: 'AI が作業の多くを担うが、責任と確認は人' },
  { sc: '7 前後', n: 7, ex: 'プログラマー・コールセンター', why: 'PC で完結する中核業務を AI が直接担える' },
  { sc: '8 前後', n: 8, ex: '一般事務・医療事務', why: '規程・点数表どおりの定型処理は AI でほぼ完結' },
  { sc: '9 前後', n: 9, ex: 'データ入力', why: 'ほぼすべてが AI で片づく（最高は 9.5）' },
];

const ACADEMIC_CITATIONS = [
  {
    '@type': 'ScholarlyArticle',
    name: 'The Future of Employment: How Susceptible Are Jobs to Computerisation?',
    author: [
      { '@type': 'Person', name: 'Carl Benedikt Frey' },
      { '@type': 'Person', name: 'Michael A. Osborne' },
    ],
    datePublished: '2013',
    url: 'https://www.oxfordmartin.ox.ac.uk/publications/the-future-of-employment',
  },
  {
    '@type': 'ScholarlyArticle',
    name: 'GPTs are GPTs: An Early Look at the Labor Market Impact Potential of Large Language Models',
    author: [
      { '@type': 'Person', name: 'Tyna Eloundou' },
      { '@type': 'Person', name: 'Sam Manning' },
      { '@type': 'Person', name: 'Pamela Mishkin' },
      { '@type': 'Person', name: 'Daniel Rock' },
    ],
    datePublished: '2023-03-17',
    url: 'https://arxiv.org/abs/2303.10130',
  },
  {
    '@type': 'ScholarlyArticle',
    name: 'Automation and New Tasks: How Technology Displaces and Reinstates Labor',
    author: [
      { '@type': 'Person', name: 'Daron Acemoglu' },
      { '@type': 'Person', name: 'Pascual Restrepo' },
    ],
    datePublished: '2019',
    url: 'https://www.aeaweb.org/articles?id=10.1257/jep.33.2.3',
  },
];

const jsonLd = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mirai-shigoto.com/methodology#webpage",
      "name": "データの整理と評価プロセス — mirai-shigoto.com",
      "url": "https://mirai-shigoto.com/methodology",
      "description": "${batchView.occupationCount} 職業の O*NET 型ベクトルと日本の労働統計をどう整理し、AIOIS-10 標準でどう採点したか。データソース、ベクトルエンジン、LLM 判定、スコア帯の代表例、校正、限界。",
      "inLanguage": ["ja"],
      "isPartOf": { "@id": "https://mirai-shigoto.com/#website" },
      "datePublished": "2026-05-30",
      "dateModified": "${pageLastUpdated}",
      "breadcrumb": { "@id": "https://mirai-shigoto.com/methodology#breadcrumb" },
      "mainEntity": { "@id": "https://mirai-shigoto.com/methodology#techarticle" },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".lead"] }
    },
    {
      "@type": "TechArticle",
      "@id": "https://mirai-shigoto.com/methodology#techarticle",
      "headline": "データの整理と評価プロセス — AIOIS-10 採点方法",
      "description": "${batchView.occupationCount} 職業のデータをどう整理し、AIOIS-10 標準で ${batchView.currentModelDisplay} がどう採点したか。データソース、LLM 全次元判定、指数の式、スコア帯の代表例、校正、限界。",
      "abstract": "This methodology page explains how mirai-shigoto.com converts public Japanese occupation data into AIOIS-10 scores. It positions the method against occupation-level automation susceptibility, GPT task exposure, and task-based displacement/reinstatement research. A representative 40-occupation cross-model validation found Transformation correlations of r=0.92-0.97 and 38/40 occupations within 2.0 points, as an external-consistency check rather than full consensus scoring.",
      "keywords": ["AIOIS-10", "methodology", "AI occupational impact", "LLM exposure", "automation", "Japan occupation data"],
      "url": "https://mirai-shigoto.com/methodology",
      "inLanguage": "ja",
      "datePublished": "2026-05-30",
      "dateModified": "${pageLastUpdated}",
      "author": { "@id": "https://mirai-shigoto.com/#organization" },
      "publisher": { "@id": "https://mirai-shigoto.com/#organization" },
      "mainEntityOfPage": { "@id": "https://mirai-shigoto.com/methodology#webpage" },
      "about": { "@type": "DefinedTermSet", "name": "AIOIS-10" },
      "citation": ${JSON.stringify(ACADEMIC_CITATIONS)},
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".lead"] }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mirai-shigoto.com/methodology#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "日本の職業 AI 影響マップ", "item": "https://mirai-shigoto.com/" },
        { "@type": "ListItem", "position": 2, "name": "評価プロセス", "item": "https://mirai-shigoto.com/methodology" }
      ]
    }
  ]
}`;
---
<BaseLayout
  title="データの整理と評価プロセス — mirai-shigoto.com"
  description={`${batchView.occupationCount} 職業のデータをどう整理し、AIOIS-10 標準でどう採点したか。データソース、${batchView.currentModelDisplay} 全次元判定、指数の式、スコア帯の代表例、校正、限界。`}
  canonical="https://mirai-shigoto.com/methodology"
  keywords={`評価方法, データ整理, データソース, AIOIS-10, O*NET, 職業情報データベース, jobtag, JILPT, 有効求人倍率, ${batchView.currentModelDisplay}, 校正, スコア帯, 限界`}
  ogTitle="データの整理と評価プロセス — mirai-shigoto.com"
  ogDescription={`${batchView.occupationCount} 職業データをどう整理し、AIOIS-10 標準でどう採点したか。データソース＋ベクトルエンジン＋LLM 判定＋校正。`}
>
  <script type="application/ld+json" slot="jsonLd" set:html={jsonLd} />
  <style slot="head" set:html={CANONICAL_DOC_CSS} />

  <div id="wrapper">
    <nav class="crumb"><a href="/" rel="up">未来の仕事</a><span aria-hidden="true">›</span><span>評価プロセス</span></nav>

    <h1>データの整理と<span class="accent">評価プロセス</span></h1>
    <p class="subtitle">{batchView.occupationCount} 職業をどう整え、AIOIS-10 標準でどう採点したか</p>
    <p class="meta-line">最終更新 {pageLastUpdated} ・ 採点 {batchView.currentModelDisplay}（{batchView.currentRunDate}）</p>

    <p class="lead">
      本サイトの基礎データは、すべて<strong>公開されている公的情報</strong>です。AI 影響スコアのみが独自分析で、<a href="/standard">AIOIS-10 標準</a>に基づいて算出しています。基準そのものの定義は <a href="/standard">AIOIS-10 標準</a>、ここでは<strong>①データの整理</strong>と<strong>②評価の手順</strong>を説明します。
    </p>

    <h2><span class="num">1.</span>データソース</h2>
    <div class="src-card">
      <div class="src-row"><span class="src-label">職業マスタ</span><span><a href="https://shigoto.mhlw.go.jp/User/" target="_blank" rel="noopener noreferrer">厚生労働省「職業情報提供サイト（job tag）」</a></span></div>
      <div class="src-row"><span class="src-label">著作権者</span><span>独立行政法人 労働政策研究・研修機構（<strong>JILPT</strong>）「職業情報データベース（IPD）」</span></div>
      <div class="src-row"><span class="src-label">バージョン</span><span><strong>v7.00</strong>（2026-03-17 公開・2026-05-03 公式 XLSX 取得）</span></div>
      <div class="src-row"><span class="src-label">職業数</span><span><strong>{batchView.occupationCount} 職業</strong>（就業者数・年収データつき、うち 4 職業は推定値）</span></div>
      <div class="src-row"><span class="src-label">労働統計</span><span>年収・就業者数・労働時間・平均年齢・<strong>有効求人倍率</strong>（賃金構造基本統計調査／労働力調査／ハローワーク求人統計。jobtag 簡易版より集計）</span></div>
      <div class="src-row"><span class="src-label">AI 影響スコア</span><span>本サイト独自分析（{batchView.currentModelDisplay} 採点、{batchView.currentRunDate}、AIOIS-10 v1.0）</span></div>
      <div class="src-row"><span class="src-label">利用条件</span><span>job tag 利用規約 第 9 条により、職業解説・数値情報の編集・加工・再集計等の二次利用が可能。本サイトは合法的な二次利用です。</span></div>
    </div>

    <h2><span class="num">2.</span>データの整理</h2>
    <p>各職業は、職務記述（概要・仕事内容・就労条件）に加え、<strong>O*NET 型の数値ベクトル</strong>を持ちます。これらは「この仕事は何を要するか」を 0–5 の強度で表したものです。</p>
    {VECTORS.map(([k, v]) => (
      <p style="margin-bottom:8px"><code>{k}</code> — {v}</p>
    ))}
    <p>さらに各職業を <strong>16 の産業セクター</strong>に分類し、年収・有効求人倍率などの労働統計を id で突合しました。スコアの履歴は<strong>追記のみ（上書き・削除なし）</strong>のバッチファイルで保持し、最新の採点日のものを現在値として採用します。</p>

    <h2><span class="num">3.</span>評価プロセス（AIOIS-10 の適用）</h2>
    <p>ただの統計でも、ただの勘でもありません。<strong>AIOIS-10 の 10 次元すべてを AI（言語モデル）が職務記述から判定し、2 つの指数は決まった式で算出</strong>します。Eloundou ら（2023）が GPT-4 に「O*NET の作業を AI がどこまでできるか」を判定させた手法の系譜で、判定対象を 10 次元に広げたものです。</p>
    <p>研究上の近い参照点は、Frey &amp; Osborne (2013) の職業単位の computerisation susceptibility、Eloundou et al. (2023) の GPT/LLM task exposure、Acemoglu &amp; Restrepo (2019) の displacement / reinstatement のタスク枠組みです。AIOIS-10 は exposure だけで終わらせず、D3〜D7 の human moat、D8 の導入費用対効果、D9 の日本固有の需給・制度摩擦を通して、変化の大きさと仕事が減るリスクを別々に出します。</p>
    <div class="steps">
      <div class="step-item"><div class="t">AI が判定：D1〜D10</div><div class="d">{batchView.currentModelDisplay} が各職業の職務記述（概要・仕事内容・労働条件）を読み、AI 到達度・定型反復・身体現場・判断責任・対人・創造・資格の壁・費用対効果・需給制度・雇用の将来性の 10 次元を 0〜10 で判定。<a href="/standard">AIOIS-10 標準</a>を正典とする凍結プロンプトを全職業に同一適用する。</div></div>
      <div class="step-item"><div class="t">式で出す：2 つの指数</div><div class="d">変化の大きさ ＝ D1 と D2 の平均。仕事が減るリスク ＝ AI 到達度 ×（1 − 人間の強み/10）× 広がりやすさ。式は <a href="/standard">AIOIS-10 標準</a> のまま固定で、採点モデルは式を変更できない。トップ指標「AI 影響」は変化の大きさ。</div></div>
      <div class="step-item"><div class="t">機械検証ではじく</div><div class="d">全採点行を自動検証する：10 次元＋2 指数の完全性、0〜10・小数第 1 位、指数が式と一致するか、ID の重複・欠落。違反した職業は採点をやり直す（手で数値を直すことはしない）。</div></div>
      <div class="step-item"><div class="t">D9 は日本版</div><div class="d">D9 需給・制度は国ごとに付け直す唯一の次元。<strong>深刻な人手不足</strong>の現場では AI は置きかえではなく助けになるため低く出る（職務記述と日本の労働市場の状況に基づいて判定）。</div></div>
    </div>

    <h2><span class="num">4.</span>スコア帯の代表例</h2>
    <p>トップ指標「AI 影響（変化の大きさ）」0〜10 の各帯のイメージとして、代表的な職業を挙げます（2026 年・AIOIS-10 版）。</p>
    <div class="wrap-x">
      <table class="bands">
        <thead><tr><th>スコア</th><th>代表例</th><th>理由</th></tr></thead>
        <tbody>
          {BANDS.map((b) => (
            <tr>
              <td class="sc" style={`background:${heatBg(b.n, 'up')}`}>{b.sc}</td>
              <td>{b.ex}</td>
              <td>{b.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2><span class="num">5.</span>校正と検証</h2>
    <p>全量を再採点したときは、前回 batch との drift（平均のずれ・帯の移動・順位変動）を共通職業で監査します。{batchView.comparisonJa} スコア履歴は追記のみで、過去の batch はすべて保存されています。</p>
    <div class="callout">
      <strong>現行 batch の分布</strong>：{batchView.occupationCount} 職業の変化の大きさは平均 {batchView.meanAiImpact}、仕事が減るリスクは平均 {batchView.meanDisplacementRisk}。身体・現場の仕事が低く、頭脳・事務の仕事が中〜高、定型デジタル作業（データ入力・文字起こし・各種事務）が最上位です。
    </div>

    <h2>履歴上のクロスモデル検証（外部整合性）</h2>
    <p><strong>これは現行 {batchView.currentModelDisplay} batch の検証ではありません。</strong> 2026-06-23 に、当時の正典だった Claude Fable 5 batch（2026-06-13）から代表 40 職業を取り、Claude Opus 4.8 と Claude Sonnet 4.6 に同一の AIOIS-10 ルーブリックで独立採点させた履歴上の検証です。3 モデルの「変化の大きさ」指数はモデル間相関 r=0.92〜0.97、平均の開きは約 1.0/10、95%（38/40 職業）が 2 点以内で一致しました。Fable 5 との平均絶対差は Opus 4.8 で 0.6、Sonnet 4.6 で 0.6 点でした。全量 batch 同士の集計差分は <a href="/models">モデル比較</a> にまとめています。</p>
    <p>限界：この 40 職業検証は Fable 5 predecessor batch の外部整合性を確認したもので、現行 {batchView.currentModelDisplay} の全 {batchView.occupationCount} 職業を直接検証したものではありません。現行公開値も多モデル consensus ではなく、単一の active batch のスコアです。</p>

    <h2><span class="num">6.</span>本手法の限界</h2>
    <ul>
      <li><strong>AI の判断を含みます</strong>。10 次元の判定は {batchView.currentModelDisplay} 一台によるもの。別の AI・別の時点なら ±1〜2 ずれることがあります（モデル更新時は前回 batch との drift を監査します）。</li>
      <li><strong>統計検証はしていません</strong>。人間専門家との一致率は未測定。「実証研究」ではなく「校正済みの見立て」です。</li>
      <li><strong>単一時点のスナップショット</strong>（{batchView.currentRunDate}、現行 AI フロンティア）。能力進化で賞味期限は約 1 年。</li>
      <li><strong>{batchView.occupationCount} 職業のみ</strong>。jobtag 未収録の新興職種（プロンプトエンジニア等）は対象外。</li>
      <li><strong>日本版です</strong>。D9 は日本の労働市場（有効求人倍率）前提。海外の同名職には当てはめないでください。</li>
      <li><strong>個別の業務差を反映できない</strong>。同じ「医師」でも科目で実態は大きく異なります。</li>
    </ul>

    <h2><span class="num">7.</span>使用上の注意</h2>
    <p>本スコアは<strong>キャリア選択の参考情報の一つ</strong>です。次のような利用は推奨しません。</p>
    <ul>
      <li>本スコアだけで採用・昇進を判断する</li>
      <li>個別の事業所の AI 化進捗を予測する</li>
      <li>政策決定の根拠とする</li>
      <li>個人のスキル評価に転用する</li>
    </ul>
    <p><strong>本サイトは非公式</strong>です。厚労省・JILPT 等と提携・承認関係にありません。スコア・分類・可視化は独自の分析であり、公式見解ではありません。基準の定義は <a href="/standard">AIOIS-10 標準</a>、出典・FAQ・用語は <a href="/about">データについて</a> を参照してください。</p>

    <Footer />
  </div>
</BaseLayout>
