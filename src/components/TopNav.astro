---
/**
 * TopNav.astro — sticky slim top navigation, included in BaseLayout so it
 * appears on every BaseLayout-driven page automatically (~50 page templates,
 * 821 built pages). The home page (`/`) is a separate inline copy in
 * src/index-source.html since it doesn't go through BaseLayout.
 *
 * Behavior:
 *   - Sticky to viewport top (z-index 50)
 *   - Warm-cream backdrop with blur (falls back to solid bg on older browsers)
 *   - Active section highlighted via aria-current="page" (auto-detected from
 *     Astro.url.pathname)
 *
 * Styling lives in src/lib/canonical-css.ts under the "Top navigation" block,
 * so home + every BaseLayout page render it identically.
 */

const path = Astro.url.pathname;

/**
 * Mark a link as the current section if the path starts with the prefix.
 * The brand link `/` is special-cased — only "exactly /" counts as home,
 * otherwise every page would highlight it.
 */
function isCurrent(prefix: string): boolean {
  if (prefix === '/') return path === '/' || path === '/index.html';
  return path === prefix || path.startsWith(prefix + '/') || path.startsWith(prefix + '.');
}

interface NavItem {
  href: string;
  label: string;
  prefix: string;
}

const items: ReadonlyArray<NavItem> = [
  { href: '/shindan',     label: '診断',        prefix: '/shindan' },
  { href: '/gyakuten',    label: '図鑑',        prefix: '/gyakuten' },
  { href: '/map',           label: '職業マップ',  prefix: '/map' },
  { href: '/sectors',    label: '業種',        prefix: '/sectors' },
  { href: '/rankings',   label: 'ランキング',  prefix: '/rankings' },
  { href: '/compare',    label: '比較',        prefix: '/compare' },
  { href: '/q',          label: 'Q&A',         prefix: '/q' },
  { href: '/explore',    label: '探す方法',    prefix: '/explore' },
  { href: '/aiadoption', label: 'AI 利用率',   prefix: '/aiadoption' },
];

const brandIsCurrent = isCurrent('/');
---
<nav class="top-nav" aria-label="主要ナビゲーション">
  <a
    href="/"
    class="top-nav-brand"
    {...(brandIsCurrent ? { 'aria-current': 'page' } : {})}
  ><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="top-nav-brand-mark"><path d="M3 18 L9 10 L13 14 L21 6"/><circle cx="9" cy="10" r="1.5" fill="currentColor"/><circle cx="13" cy="14" r="1.5" fill="currentColor"/><circle cx="21" cy="6" r="1.5" fill="currentColor"/></svg><span class="top-nav-brand-text">未来の仕事</span></a><span class="sep" aria-hidden="true">·</span>{items.map((it, i) => (
    <>
      <a
        href={it.href}
        {...(isCurrent(it.prefix) ? { 'aria-current': 'page' } : {})}
      >{it.label}</a>{i < items.length - 1 && <span class="sep" aria-hidden="true">·</span>}
    </>
  ))}
</nav>
