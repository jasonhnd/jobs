<script is:inline>
  // Phase 8 — share buttons available on every page (Footer-level).
  // The home page used to have its own share JS; this is now the canonical
  // single-source. Each share carries the CURRENT page URL (window.location.href)
  // so a deep page like /sectors/iryo shares THAT page, not the homepage.
  (function wireShareButtons() {
    var footer = document.querySelector('footer.site-footer');
    if (!footer) return;
    if (footer.dataset.shareWired === '1') return;
    footer.dataset.shareWired = '1';

    var COPY_TOAST = 'コピーしました';
    // FALLBACK_TEXT must mirror SHARE_FALLBACK_TEXT in this file's frontmatter
    // (kept in sync via OCCUPATION_COUNT.SCORED; see src/site/config.ts).
    var FALLBACK_TEXT = '日本 556 職業への AI 影響を 0〜10 で可視化したマップ。あなたの仕事は？';

    function shareText() {
      // Prefer page-specific og:description (set per-page in BaseLayout).
      var og = document.querySelector('meta[property="og:description"]');
      if (og && og.content && og.content.length < 240) return og.content;
      return FALLBACK_TEXT;
    }
    function shareUrl(source, medium) {
      // Share the CURRENT page, not the homepage. Append UTM for analytics.
      var u = new URL(window.location.href);
      u.searchParams.set('utm_source', source);
      u.searchParams.set('utm_medium', medium);
      u.searchParams.set('utm_campaign', 'page_share');
      return u.toString();
    }
    function track(platform) {
      if (window.gtag) {
        window.gtag('event', 'share_click', {
          platform: platform,
          page_path: window.location.pathname
        });
      }
    }
    function popOpen(url) {
      window.open(url, '_blank', 'noopener,noreferrer');
    }

    // X (Twitter)
    var x = footer.querySelector('.share-btn[data-platform="x"]');
    if (x) x.addEventListener('click', function (e) {
      e.preventDefault();
      popOpen('https://x.com/intent/post?url=' + encodeURIComponent(shareUrl('x', 'social')) + '&text=' + encodeURIComponent(shareText()));
      track('x');
    });

    // LINE
    var line = footer.querySelector('.share-btn[data-platform="line"]');
    if (line) line.addEventListener('click', function (e) {
      e.preventDefault();
      popOpen('https://social-plugins.line.me/lineit/share?url=' + encodeURIComponent(shareUrl('line', 'im')));
      track('line');
    });

    // Hatena bookmark
    var hatena = footer.querySelector('.share-btn[data-platform="hatena"]');
    if (hatena) hatena.addEventListener('click', function (e) {
      e.preventDefault();
      popOpen('https://b.hatena.ne.jp/entry/' + shareUrl('hatena', 'social').replace(/^https?:\/\//, ''));
      track('hatena');
    });

    // LinkedIn
    var linkedin = footer.querySelector('.share-btn[data-platform="linkedin"]');
    if (linkedin) linkedin.addEventListener('click', function (e) {
      e.preventDefault();
      popOpen('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(shareUrl('linkedin', 'social')));
      track('linkedin');
    });

    // Facebook
    var facebook = footer.querySelector('.share-btn[data-platform="facebook"]');
    if (facebook) facebook.addEventListener('click', function (e) {
      e.preventDefault();
      popOpen('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareUrl('facebook', 'social')));
      track('facebook');
    });

    // Copy URL — uses Clipboard API with showing fallback. Toast lives next
    // to the buttons so visual feedback is local.
    var copy = footer.querySelector('.share-btn[data-platform="copy"]');
    var toast = footer.querySelector('.share-toast');
    if (copy && toast) copy.addEventListener('click', async function (e) {
      e.preventDefault();
      var url = shareUrl('direct', 'copylink');
      try {
        await navigator.clipboard.writeText(url);
        toast.textContent = COPY_TOAST;
      } catch (err) {
        toast.textContent = url;
      }
      toast.classList.add('visible');
      track('copy');
      setTimeout(function () { toast.classList.remove('visible'); }, 2200);
    });

    // Native Web Share API — shown only on supporting browsers (mobile mostly).
    var native = footer.querySelector('.share-btn[data-platform="native"]');
    if (native) {
      if (typeof navigator.share === 'function') {
        native.hidden = false;
        native.addEventListener('click', async function (e) {
          e.preventDefault();
          try {
            await navigator.share({
              title: document.title,
              text: shareText(),
              url: shareUrl('native', 'share_api')
            });
            track('native');
          } catch (err) { /* user cancelled — no-op */ }
        });
      }
    }
  })();

  // ── CODE-012 CSP hardening (2026-05-17) ─────────────────────────────────
  // Delegated click handler for `<a data-track-event="…">` anchors. Replaces
  // the inline `onclick=` attribute previously used by _JobtagAnchor.astro,
  // which would have required CSP `'unsafe-inline'` for script-src OR a
  // per-occupation hash (556+ unique hashes — infeasible).
  //
  // Listener is attached at the document level so it covers anchors added
  // anywhere on the page. Reads the GA4 event name + payload from data-*
  // attributes on the anchor. Currently used by _JobtagAnchor.astro for
  // `jobtag_outbound_click`; future page-level tracking links can plug into
  // the same pattern by adding `data-track-event="…"` and the data fields
  // they want logged.
  (function wireDelegatedTrackClicks() {
    if (document.body.dataset.trackWired === '1') return;
    document.body.dataset.trackWired = '1';

    document.addEventListener('click', function (e) {
      var t = e.target;
      // Walk up to the nearest <a data-track-event="…"> if any.
      while (t && t !== document.body) {
        if (t.tagName === 'A' && t.dataset && t.dataset.trackEvent) {
          var name = t.dataset.trackEvent;
          if (name === 'jobtag_outbound_click') {
            var occId = Number(t.getAttribute('data-jobtag-id')) || 0;
            var aiRisk = Number(t.getAttribute('data-ai-risk')) || 0;
            try {
              if (typeof window.gtag === 'function') {
                window.gtag('event', name, {
                  occupation_id: occId,
                  ai_risk_score: aiRisk,
                  language: 'ja'
                });
              }
            } catch (err) { /* never block navigation */ }
          }
          return;
        }
        t = t.parentNode;
      }
    }, { passive: true });
  })();
</script>

<style is:global set:html={CANONICAL_CSS}></style>
