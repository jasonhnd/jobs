---
/**
 * Footer.astro — site footer.
 *
 * The build-time timestamp is computed here. Site-wide typography + footer
 * styling is delegated to the canonical CSS in src/lib/canonical-css.ts and
 * emitted as a global <style> block at the end of this component (so EVERY
 * page that renders <Footer /> picks up the same typography baseline —
 * beats per-page page-local CSS by specificity).
 */
import { CANONICAL_CSS } from '../lib/canonical-css.ts';
const buildTime = new Date();

// Format: "2026/05/08_09:30_JST"
function formatJst(d: Date): { iso: string; display: string } {
  // Convert to JST (UTC+9).
  const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
  const yyyy = jst.getUTCFullYear();
  const mm = String(jst.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(jst.getUTCDate()).padStart(2, '0');
  const hh = String(jst.getUTCHours()).padStart(2, '0');
  const mi = String(jst.getUTCMinutes()).padStart(2, '0');
  const ss = String(jst.getUTCSeconds()).padStart(2, '0');
  return {
    iso: `${yyyy}-${mm}-${dd}T${hh}:${mi}:${ss}+09:00`,
    display: `${yyyy}/${mm}/${dd}_${hh}:${mi}_JST`,
  };
}

const { iso, display } = formatJst(buildTime);
---
<footer class="site-footer">
  <div class="footer-links">
    <a href="/">トップ</a>
    <a href="/map">職業マップ</a>
    <a href="/ja/explore">探す方法</a>
    <a href="/ja/sectors">セクター</a>
    <a href="/ja/rankings">ランキング</a>
    <a href="/ja/q">Q&amp;A</a>
    <a href="/ja/careers">キャリア段階</a>
    <a href="/ja/licenses">資格</a>
    <a href="/ja/compare">比較</a>
    <a href="/ja/about">方法論</a>
  </div>
  <div class="footer-links">
    <a href="/about">データについて</a>
    <a href="/compliance">コンプライアンス</a>
    <a href="/privacy">プライバシー</a>
  </div>
  <div class="footer-meta">
    最終更新：<time datetime={iso}>{display}</time><br />
    出典：厚生労働省・<span class="nowrap">独立行政法人 労働政策研究・研修機構（JILPT）</span><br />
    <em>※ 本サイトは独自分析サイトであり、<br />厚生労働省・job tag・JILPT の<span class="nowrap">公式見解ではありません</span>。<br />詳細は <a href="/compliance">コンプライアンス</a> ページをご確認ください。</em>
  </div>
</footer>

<style is:global set:html={CANONICAL_CSS}></style>
