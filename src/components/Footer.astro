---
/**
 * Footer.astro — site footer.
 *
 * Migrated from partials/footer.html (which was injected by build_partials.py).
 * The {{LAST_UPDATED_ISO}} / {{LAST_UPDATED}} placeholders are replaced here
 * by computing the build-time timestamp directly in Astro frontmatter.
 *
 * NOTE: Style of the footer is page-local (each page provides its own
 * `footer { ... }` block in inline CSS, matching the original HTML). This
 * component only handles structure + dynamic timestamp.
 */
const buildTime = new Date();

// Format: "2026/05/08_09:30_JST"
function formatJst(d: Date): { iso: string; display: string } {
  // Convert to JST (UTC+9).
  const jst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
  const yyyy = jst.getUTCFullYear();
  const mm = String(jst.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(jst.getUTCDate()).padStart(2, '0');
  const hh = String(jst.getUTCHours()).padStart(2, '0');
  const mi = String(jst.getUTCMinutes()).padStart(2, '0');
  const ss = String(jst.getUTCSeconds()).padStart(2, '0');
  return {
    iso: `${yyyy}-${mm}-${dd}T${hh}:${mi}:${ss}+09:00`,
    display: `${yyyy}/${mm}/${dd}_${hh}:${mi}_JST`,
  };
}

const { iso, display } = formatJst(buildTime);
---
<footer class="site-footer">
  <div class="footer-links">
    <a href="/">トップ</a>
    <a href="/map">職業マップ</a>
    <a href="/ja/sectors">セクター</a>
    <a href="/ja/rankings">ランキング</a>
  </div>
  <div class="footer-links">
    <a href="/about">データについて</a>
    <a href="/compliance">コンプライアンス</a>
    <a href="/privacy">プライバシー</a>
  </div>
  <div class="footer-meta">
    最終更新：<time datetime={iso}>{display}</time><br />
    出典：厚生労働省・<span class="nowrap">独立行政法人 労働政策研究・研修機構（JILPT）</span><br />
    <em>※ 本サイトは独自分析サイトであり、<br />厚生労働省・job tag・JILPT の<span class="nowrap">公式見解ではありません</span>。<br />詳細は <a href="/compliance">コンプライアンス</a> ページをご確認ください。</em>
  </div>
</footer>

<style is:global>
  /*
   * Canonical footer style — shared across every page that uses <Footer />.
   *
   * Selector specificity is footer.site-footer (0,0,1,1) — higher than the
   * legacy page-local `footer { ... }` rules (0,0,0,1) so we win the cascade
   * regardless of where Astro hoists this <style> tag in the document. (A
   * previous attempt relied on document order, which broke for pages whose
   * <style slot="head" is:global> got extracted to an external CSS file
   * loaded AFTER this inline block.)
   *
   * Don't add per-page `footer.site-footer { ... }` rules in page styles.
   * The site-wide default lives here.
   */
  footer.site-footer {
    max-width: none;
    margin: 48px auto 0;
    padding: 22px 16px 24px;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--fg2);
    text-align: center;
    font-family: var(--font-sans);
  }
  footer.site-footer a {
    color: var(--accent);
    text-decoration: none;
  }
  footer.site-footer a:hover {
    text-decoration: underline;
  }
  footer.site-footer .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    align-items: center;
    margin-bottom: 14px;
  }
  footer.site-footer .footer-links a {
    color: var(--fg2);
    text-decoration: none;
    padding: 5px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.78rem;
    line-height: 1.2;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  footer.site-footer .footer-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(217, 107, 61, 0.06);
    text-decoration: none;
  }
  footer.site-footer .footer-meta {
    color: var(--fg2);
    font-size: 0.7rem;
    opacity: 0.92;
    text-wrap: pretty;
    line-height: 1.65;
  }
  footer.site-footer .footer-meta a {
    color: var(--accent);
  }
  footer.site-footer .footer-meta .nowrap {
    white-space: nowrap;
  }
  footer.site-footer .footer-meta em {
    font-style: italic;
  }
  footer.site-footer time {
    font-variant-numeric: tabular-nums;
  }
</style>
