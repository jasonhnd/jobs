<script is:inline>
  // wireMobileNav — runs once per page load. Idempotent: re-attaching from
  // bfcache pageshow is safe because we use stored references on the burger
  // element (not closures).
  (function () {
    var burger = document.getElementById('mobBurger');
    var drawer = document.getElementById('mobDrawer');
    if (!burger || !drawer) return;
    if (burger.dataset.wired === '1') return;
    burger.dataset.wired = '1';

    var lastFocus = null;

    function setOpen(open) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (open) {
        // #234: 91% of sessions are mobile, and every drawer entry costs two
        // taps. Without this event a flat /me number cannot separate "the
        // drawer is never opened" from "it is opened and the row is ignored" —
        // the two have opposite fixes. Pairs with me_entry_click
        // (source=nav_drawer) on the 自分の現在地 row: opens are the
        // denominator, clicks the numerator. No params beyond `language`, so
        // no GA4 custom dimension is consumed; the page the drawer was opened
        // from arrives free in page_location.
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'nav_drawer_open', { language: 'ja' });
          }
        } catch (err) { /* never block the drawer */ }
        lastFocus = document.activeElement;
        drawer.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          var first = drawer.querySelector('a');
          if (first) first.focus();
        });
      } else {
        drawer.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          try { lastFocus.focus(); } catch (e) {}
        }
      }
    }

    burger.addEventListener('click', function () {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    drawer.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== drawer) {
        if (t.tagName === 'A') { setOpen(false); return; }
        t = t.parentNode;
      }
    });

    window.addEventListener('pageshow', function () {
      document.body.style.overflow = '';
    });
  })();
</script>

<script is:inline>
  // wireMobileSearch — static body, one CSP hash. Idempotent via dataset.wired.
  (function () {
    var btn = document.getElementById('mobSearchBtn');
    var overlay = document.getElementById('mobSearchOverlay');
    var input = document.getElementById('mobSearchInput');
    var closeBtn = document.getElementById('mobSearchClose');
    if (!btn || !overlay || !input || !closeBtn) return;
    if (btn.dataset.wired === '1') return;
    btn.dataset.wired = '1';

    var SEARCH_URL = '/data.search.json';
    var SECTORS_URL = '/data.sectors.json';
    var RECENT_KEY = 'ms.search.recent';
    var FETCH_MS = 10000;
    var lastFocus = null;
    var docs = null;
    var sectorJa = {};
    var loadPromise = null;

    var resultsEl = overlay.querySelector('.mob-search-results');
    var recentWrap = overlay.querySelector('.mob-search-recent');
    var recentList = overlay.querySelector('.mob-search-recent-list');
    var emptyHead = overlay.querySelector('.mob-search-empty-head');

    function occupationPath(id) {
      return Number(id) === 404 ? '/occupations/404' : '/' + id;
    }
    function nfkc(s) {
      return String(s || '').normalize('NFKC').toLowerCase();
    }
    function consentOk() {
      try { return localStorage.getItem('cookieConsent') === 'accepted'; } catch (e) { return false; }
    }
    function gaOpen() {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'search_overlay_open', { language: 'ja' });
        }
      } catch (e) {}
    }
    function gaNav() {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'search_overlay_navigate', { language: 'ja' });
        }
      } catch (e) {}
    }
    function fetchJson(url) {
      return new Promise(function (resolve, reject) {
        var done = false;
        var t = setTimeout(function () { if (!done) { done = true; reject(new Error('timeout')); } }, FETCH_MS);
        fetch(url).then(function (r) {
          if (!done) { done = true; clearTimeout(t); }
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        }).then(resolve).catch(function (err) {
          if (!done) { done = true; clearTimeout(t); }
          reject(err);
        });
      });
    }
    function ensureData() {
      if (docs) return Promise.resolve();
      if (loadPromise) return loadPromise;
      loadPromise = Promise.all([fetchJson(SEARCH_URL), fetchJson(SECTORS_URL)]).then(function (parts) {
        docs = (parts[0] && parts[0].documents) || [];
        var sectors = (parts[1] && parts[1].sectors) || [];
        sectorJa = {};
        for (var i = 0; i < sectors.length; i++) {
          sectorJa[sectors[i].id] = sectors[i].ja || sectors[i].id;
        }
      }).catch(function (err) {
        loadPromise = null;
        throw err;
      });
      return loadPromise;
    }
    function rankMatches(q) {
      q = nfkc(q).trim();
      if (!q || !docs) return [];
      var exact = [];
      var starts = [];
      var contains = [];
      for (var i = 0; i < docs.length; i++) {
        var d = docs[i];
        var fields = [d.title_ja].concat(d.aliases_ja || []);
        var hit = false;
        var isExact = false;
        var isStart = false;
        for (var k = 0; k < fields.length; k++) {
          var f = nfkc(fields[k]);
          if (f === q) { isExact = true; hit = true; break; }
          if (f.indexOf(q) === 0) { isStart = true; hit = true; }
          else if (f.indexOf(q) >= 0) hit = true;
        }
        if (!hit) continue;
        if (isExact) exact.push(d);
        else if (isStart) starts.push(d);
        else contains.push(d);
      }
      return exact.concat(starts, contains).slice(0, 8);
    }
    function readRecent() {
      if (!consentOk()) return [];
      try {
        var raw = localStorage.getItem(RECENT_KEY);
        var list = raw ? JSON.parse(raw) : [];
        return Array.isArray(list) ? list.slice(0, 5) : [];
      } catch (e) { return []; }
    }
    function writeRecent(doc) {
      if (!consentOk() || !doc || doc.id == null) return;
      try {
        var next = readRecent().filter(function (r) { return r && String(r.id) !== String(doc.id); });
        next.unshift({
          id: doc.id,
          title_ja: doc.title_ja,
          sector_id: doc.sector_id,
          risk_band: doc.risk_band,
          ai_risk: doc.ai_risk
        });
        localStorage.setItem(RECENT_KEY, JSON.stringify(next.slice(0, 5)));
      } catch (e) {}
    }
    function makeRow(doc) {
      var a = document.createElement('a');
      a.className = 'mob-search-row';
      a.setAttribute('role', 'listitem');
      a.href = occupationPath(doc.id);
      var name = document.createElement('span');
      name.className = 'mob-search-name';
      name.textContent = doc.title_ja || '';
      var sub = document.createElement('span');
      sub.className = 'mob-search-sub';
      sub.textContent = sectorJa[doc.sector_id] || '';
      var pill = document.createElement('span');
      var band = doc.risk_band === 'low' || doc.risk_band === 'high' ? doc.risk_band : 'mid';
      pill.className = 'mob-search-pill ' + band;
      pill.textContent = (doc.ai_risk != null ? Number(doc.ai_risk).toFixed(1) : '—') + '/10';
      a.appendChild(name);
      a.appendChild(sub);
      a.appendChild(pill);
      a.addEventListener('click', function () {
        writeRecent(doc);
        gaNav();
      });
      return a;
    }
    function render() {
      var q = input.value;
      var hasQuery = nfkc(q).trim().length > 0;
      resultsEl.replaceChildren();
      recentList.replaceChildren();
      if (!hasQuery) {
        var recent = readRecent();
        recentWrap.hidden = recent.length === 0;
        emptyHead.hidden = true;
        for (var i = 0; i < recent.length; i++) recentList.appendChild(makeRow(recent[i]));
        return;
      }
      recentWrap.hidden = true;
      var hits = rankMatches(q);
      emptyHead.hidden = hits.length !== 0;
      for (var j = 0; j < hits.length; j++) resultsEl.appendChild(makeRow(hits[j]));
    }
    function visibleFocusables() {
      var nodes = overlay.querySelectorAll('a[href], button:not([disabled]), input');
      var out = [];
      for (var i = 0; i < nodes.length; i++) {
        if (nodes[i].closest('[hidden]')) continue;
        out.push(nodes[i]);
      }
      return out;
    }
    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      if (open) {
        var burger = document.getElementById('mobBurger');
        if (burger && burger.getAttribute('aria-expanded') === 'true') burger.click();
        lastFocus = document.activeElement;
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        gaOpen();
        ensureData().then(function () { render(); }).catch(function () { render(); });
        requestAnimationFrame(function () { input.focus(); });
      } else {
        overlay.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          try { lastFocus.focus(); } catch (e) {}
        }
      }
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    closeBtn.addEventListener('click', function () { setOpen(false); });
    input.addEventListener('input', function () { if (docs) render(); });

    overlay.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var list = visibleFocusables();
      if (!list.length) return;
      var first = list[0];
      var last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        e.preventDefault();
        setOpen(false);
      }
    });

    window.addEventListener('pageshow', function () {
      overlay.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  })();
</script>
