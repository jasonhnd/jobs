---
/**
 * MobileNav.astro — mobile-only top bar (48px sticky) + full-screen drawer
 * with all 24 hub categories, organized into 3 cleanly-separated panels.
 *
 * Architecture (Phase 7.1, mobile-first with stronger visual hierarchy):
 *   - Layer 1: `.mob-topbar` — 48px sticky, brand SVG + text on left,
 *              animated three-line to close icon on right (44×44px tap target)
 *   - Layer 2: `.mob-drawer` — full-screen slide-down drawer with 3 panels:
 *
 *      Each panel (`<section.mob-drawer-sec>`) is a bg2 container with:
 *        - `<header>` block: serif-bold title + accent dot + lede description
 *        - `<div.mob-drawer-list>`: list of card-style item rows, each with:
 *            * label, optional count/meta, right-arrow chevron
 *            * white bg, border, rounded corners, active scale-down
 *
 * Rendered on every page including `/` — index.astro has used BaseLayout since
 * 2026-05-18, and `src/index-source.html` carries no nav markup of its own
 * (checked: zero `mob-topbar` / `mob-drawer` / burger occurrences). An earlier
 * version of this comment claimed the homepage inlined a duplicate copy that
 * had to be kept in sync; it does not.
 *
 * Behavior:
 *   - Tap burger → drawer slides down (220ms), bg scroll-locked
 *   - Tap any link / Esc → drawer closes
 *   - Focus management: first link focused on open, prev focus restored on close
 *
 * Hidden on desktop via canonical-css.ts media query.
 */
import { OCCUPATION_COUNT } from '@/site/config';
---
