---
/**
 * MobileNav.astro — mobile-only top bar (48px sticky) + full-screen drawer
 * with all 24 hub categories, organized into 3 cleanly-separated panels.
 *
 * Architecture (Phase 7.1, mobile-first with stronger visual hierarchy):
 *   - Layer 1: `.mob-topbar` — 48px sticky, brand SVG + text on left,
 *              animated three-line to close icon on right (44×44px tap target)
 *   - Layer 2: `.mob-drawer` — full-screen slide-down drawer with 3 panels:
 *
 *      Each panel (`<section.mob-drawer-sec>`) is a bg2 container with:
 *        - `<header>` block: serif-bold title + accent dot + lede description
 *        - `<div.mob-drawer-list>`: list of card-style item rows, each with:
 *            * label, optional count/meta, right-arrow chevron
 *            * white bg, border, rounded corners, active scale-down
 *
 * The home page (`/`) inlines an equivalent copy in src/index-source.html
 * (no BaseLayout). Keep markup in sync.
 *
 * Behavior:
 *   - Tap burger → drawer slides down (220ms), bg scroll-locked
 *   - Tap any link / Esc → drawer closes
 *   - Focus management: first link focused on open, prev focus restored on close
 *
 * Hidden on desktop via canonical-css.ts media query.
 */
import { OCCUPATION_COUNT } from '@/site/config';
---
<header class="mob-topbar" aria-label="モバイルサイトヘッダー">
  <a href="/" class="mob-topbar-brand" aria-label="未来の仕事 — トップへ">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 18 L9 10 L13 14 L21 6"/>
      <circle cx="9" cy="10" r="1.5" fill="currentColor"/>
      <circle cx="13" cy="14" r="1.5" fill="currentColor"/>
      <circle cx="21" cy="6" r="1.5" fill="currentColor"/>
    </svg>
    <span class="mob-topbar-brand-text">未来の仕事</span>
  </a>
  <button
    type="button"
    class="mob-topbar-burger"
    id="mobBurger"
    aria-label="メニューを開く"
    aria-expanded="false"
    aria-controls="mobDrawer"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<div class="mob-drawer" id="mobDrawer" hidden role="dialog" aria-modal="true" aria-label="メインメニュー">
  <div class="mob-drawer-inner">

    <section class="mob-drawer-sec">
      <header class="mob-drawer-sec-head">
        <p class="mob-drawer-title" role="heading" aria-level="2">
          <span class="mob-drawer-title-dot" aria-hidden="true"></span>
          探す入口
        </p>
        <p class="mob-drawer-lede">業種・ランキング・Q&A など主要な入口</p>
      </header>
      <div class="mob-drawer-list">
        <a href="/me" class="mob-drawer-item mob-drawer-item-feature">
          <span class="mob-drawer-label">自分の現在地</span>
          <span class="mob-drawer-meta">職業を入力 → 全 39 ランキングでの位置</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/map" class="mob-drawer-item">
          <span class="mob-drawer-label">職業マップ</span>
          <span class="mob-drawer-meta">{OCCUPATION_COUNT.SCORED} 職業の俯瞰</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/sectors" class="mob-drawer-item">
          <span class="mob-drawer-label">業種から探す</span>
          <span class="mob-drawer-count">16</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/rankings" class="mob-drawer-item">
          <span class="mob-drawer-label">ランキング</span>
          <span class="mob-drawer-count">39</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/compare" class="mob-drawer-item">
          <span class="mob-drawer-label">比較</span>
          <span class="mob-drawer-count">20</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/q" class="mob-drawer-item">
          <span class="mob-drawer-label">Q&amp;A</span>
          <span class="mob-drawer-count">49</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/explore" class="mob-drawer-item">
          <span class="mob-drawer-label">探す方法</span>
          <span class="mob-drawer-meta">7 つの入口</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/careers" class="mob-drawer-item">
          <span class="mob-drawer-label">キャリア段階</span>
          <span class="mob-drawer-count">10</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/licenses" class="mob-drawer-item">
          <span class="mob-drawer-label">資格</span>
          <span class="mob-drawer-count">15</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/yearly" class="mob-drawer-item">
          <span class="mob-drawer-label">年次レポート</span>
          <span class="mob-drawer-count">3</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/aiadoption" class="mob-drawer-item">
          <span class="mob-drawer-label">AI 利用率</span>
          <span class="mob-drawer-meta">世界の AI 利用者を 5 層で推定</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <section class="mob-drawer-sec">
      <header class="mob-drawer-sec-head">
        <p class="mob-drawer-title" role="heading" aria-level="2">
          <span class="mob-drawer-title-dot" aria-hidden="true"></span>
          適性・条件で絞る
        </p>
        <p class="mob-drawer-lede">スキル・能力・学歴など、自分の特性で絞り込む</p>
      </header>
      <div class="mob-drawer-list">
        <a href="/interests" class="mob-drawer-item">
          <span class="mob-drawer-label">興味 (RIASEC)</span>
          <span class="mob-drawer-count">6</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/skills" class="mob-drawer-item">
          <span class="mob-drawer-label">スキル</span>
          <span class="mob-drawer-count">10</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/abilities" class="mob-drawer-item">
          <span class="mob-drawer-label">能力</span>
          <span class="mob-drawer-count">10</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/knowledge" class="mob-drawer-item">
          <span class="mob-drawer-label">知識</span>
          <span class="mob-drawer-count">10</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/values" class="mob-drawer-item">
          <span class="mob-drawer-label">価値観</span>
          <span class="mob-drawer-count">8</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/education" class="mob-drawer-item">
          <span class="mob-drawer-label">学歴</span>
          <span class="mob-drawer-count">6</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/training" class="mob-drawer-item">
          <span class="mob-drawer-label">習熟期間</span>
          <span class="mob-drawer-count">5</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/work-styles" class="mob-drawer-item">
          <span class="mob-drawer-label">働き方</span>
          <span class="mob-drawer-count">7</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/employment-types" class="mob-drawer-item">
          <span class="mob-drawer-label">雇用形態</span>
          <span class="mob-drawer-count">4</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/life-balance" class="mob-drawer-item">
          <span class="mob-drawer-label">ライフバランス</span>
          <span class="mob-drawer-count">6</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/entry-paths" class="mob-drawer-item">
          <span class="mob-drawer-label">入職経路</span>
          <span class="mob-drawer-count">5</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/methodology" class="mob-drawer-item">
          <span class="mob-drawer-label">評価プロセス</span>
          <span class="mob-drawer-meta">算出方法・データ出典</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <section class="mob-drawer-sec">
      <header class="mob-drawer-sec-head">
        <p class="mob-drawer-title" role="heading" aria-level="2">
          <span class="mob-drawer-title-dot" aria-hidden="true"></span>
          サイト
        </p>
        <p class="mob-drawer-lede">データ出典・法的情報</p>
      </header>
      {/* RA-126 (2026-05-18): meta strings added so section 3 rows have
          the same right-edge anchor as sections 1+2; eliminates the
          "thin / unbalanced" feel from the count/meta column being empty. */}
      <div class="mob-drawer-list">
        <a href="/about" class="mob-drawer-item">
          <span class="mob-drawer-label">このサイトについて</span>
          <span class="mob-drawer-meta">概要・運営</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/compliance" class="mob-drawer-item">
          <span class="mob-drawer-label">コンプライアンス</span>
          <span class="mob-drawer-meta">免責・引用</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
        <a href="/privacy" class="mob-drawer-item">
          <span class="mob-drawer-label">プライバシー</span>
          <span class="mob-drawer-meta">Cookie・解析</span>
          <span class="mob-drawer-arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </section>

  </div>
</div>

<script is:inline>
  // wireMobileNav — runs once per page load. Idempotent: re-attaching from
  // bfcache pageshow is safe because we use stored references on the burger
  // element (not closures).
  (function () {
    var burger = document.getElementById('mobBurger');
    var drawer = document.getElementById('mobDrawer');
    if (!burger || !drawer) return;
    if (burger.dataset.wired === '1') return;
    burger.dataset.wired = '1';

    var lastFocus = null;

    function setOpen(open) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (open) {
        lastFocus = document.activeElement;
        drawer.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          var first = drawer.querySelector('a');
          if (first) first.focus();
        });
      } else {
        drawer.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          try { lastFocus.focus(); } catch (e) {}
        }
      }
    }

    burger.addEventListener('click', function () {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    drawer.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== drawer) {
        if (t.tagName === 'A') { setOpen(false); return; }
        t = t.parentNode;
      }
    });

    window.addEventListener('pageshow', function () {
      document.body.style.overflow = '';
    });
  })();
</script>
