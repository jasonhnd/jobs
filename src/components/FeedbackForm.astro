---
import { FEEDBACK_OPTIONS } from '@/lib/feedback-ui';

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<section class="feedback-panel" data-feedback-root data-feedback-state="idle" aria-labelledby="feedback-summary">
  <details>
    <summary id="feedback-summary">
      <span>このサイトへのご意見を送る</span>
      <small>1分ほど・匿名でも送信できます</small>
    </summary>

    <form class="feedback-form" data-feedback-form aria-describedby="feedback-instructions feedback-status">
      <p id="feedback-instructions" class="feedback-instructions">
        当てはまる項目を選ぶか、ご意見をご入力ください。どちらか一方だけでも送信できます。
      </p>
      <noscript>
        <p class="feedback-unavailable">送信にはJavaScriptが必要です。ブラウザの設定を有効にしてから再読み込みしてください。</p>
      </noscript>

      <fieldset>
        <legend>このサイトを何に使っていますか？（複数選択可）</legend>
        <div class="feedback-options">
          {FEEDBACK_OPTIONS.map(({ key, label }) => (
            <label>
              <input type="checkbox" name="options" value={key} data-feedback-control disabled />
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="feedback-field" for="feedback-freetext">
        <span>ご意見・改善してほしい点（任意）</span>
        <textarea id="feedback-freetext" name="freetext" maxlength="2000" rows="4" placeholder="例：この職業の評価根拠をもっと詳しく知りたい" data-feedback-control disabled></textarea>
      </label>

      <label class="feedback-field" for="feedback-email">
        <span>返信先メールアドレス（任意）</span>
        <input id="feedback-email" name="email" type="email" maxlength="254" inputmode="email" autocomplete="email" placeholder="name@example.com" data-feedback-control disabled />
      </label>

      <label class="feedback-honeypot" aria-hidden="true">
        ウェブサイト
        <input name="htmlfield" type="text" tabindex="-1" autocomplete="off" data-feedback-control disabled />
      </label>

      {TURNSTILE_SITE_KEY && (
        <div class="feedback-turnstile">
          <div id="feedback-turnstile" class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="ja" data-theme="auto"></div>
        </div>
      )}

      <p class="feedback-privacy">
        送信内容はサービス改善と必要な返信にのみ利用します。詳しくは<a href="/privacy">プライバシーポリシー</a>をご確認ください。
      </p>

      <div class="feedback-actions">
        <button type="submit" data-feedback-submit data-feedback-control disabled>ご意見を送信</button>
        <p id="feedback-status" class="feedback-status" data-feedback-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1">送信機能を準備しています…</p>
      </div>
    </form>
  </details>
</section>

<script>
  import {
    buildFeedbackAnalytics,
    buildFeedbackPayload,
    feedbackOutcomeForResponse,
    feedbackStatusMessage,
  } from '@/lib/feedback-ui';

  type GtagWindow = Window & {
    gtag?: (command: 'event', eventName: string, params: Record<string, string | number>) => void;
    turnstile?: { reset: (widgetSelector: string) => void };
  };

  document.querySelectorAll<HTMLElement>('[data-feedback-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-feedback-form]');
    const submit = root.querySelector<HTMLButtonElement>('[data-feedback-submit]');
    const status = root.querySelector<HTMLElement>('[data-feedback-status]');
    if (!form || !submit || !status || root.dataset.feedbackWired === '1') return;
    root.dataset.feedbackWired = '1';

    let pending = false;

    const resetTurnstile = (): void => {
      if (!root.querySelector('#feedback-turnstile')) return;
      const turnstileApi = (window as GtagWindow).turnstile;
      if (typeof turnstileApi?.reset !== 'function') return;
      try {
        // Turnstile tokens are single-use. A server response consumes the
        // token even when downstream email delivery fails, so every retry
        // must start with a newly generated challenge token.
        turnstileApi.reset('#feedback-turnstile');
      } catch { /* the next submit will surface turnstile_failed */ }
    };

    const setState = (
      state: 'idle' | 'pending' | 'success' | 'validation-error' | 'error',
      errorCode = '',
    ): void => {
      root.dataset.feedbackState = state;
      form.setAttribute('aria-busy', state === 'pending' ? 'true' : 'false');
      submit.disabled = state === 'pending';
      submit.textContent = state === 'pending' ? '送信中…' : state === 'error' ? 'もう一度送信' : 'ご意見を送信';
      status.textContent = feedbackStatusMessage(state, errorCode);
      status.setAttribute('role', state === 'error' || state === 'validation-error' ? 'alert' : 'status');
      if (state === 'error' || state === 'validation-error' || state === 'success') status.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (pending) return;

      const selectedOptions = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="options"]:checked'),
        (input) => input.value,
      );
      const freetext = form.elements.namedItem('freetext') as HTMLTextAreaElement | null;
      const email = form.elements.namedItem('email') as HTMLInputElement | null;
      const honeypot = form.elements.namedItem('htmlfield') as HTMLInputElement | null;
      const turnstile = form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null;

      if (selectedOptions.length === 0 && !(freetext?.value ?? '').trim()) {
        setState('validation-error', 'empty_feedback');
        return;
      }

      const payload = buildFeedbackPayload({
        selectedOptions,
        freetext: freetext?.value ?? '',
        email: email?.value ?? '',
        htmlfield: honeypot?.value ?? '',
        turnstileToken: turnstile?.value ?? '',
        pathname: window.location.pathname,
      });

      pending = true;
      setState('pending');

      try {
        const response = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body: unknown = await response.json().catch(() => null);
        const outcome = feedbackOutcomeForResponse(response.status, body);
        const analytics = buildFeedbackAnalytics(payload, outcome);
        const gtag = (window as GtagWindow).gtag;
        if (typeof gtag === 'function') gtag('event', 'feedback_submit', analytics);
        setState(outcome.success ? 'success' : 'error', outcome.errorCode);
      } catch {
        const outcome = { success: false, errorCode: 'network_error' } as const;
        const analytics = buildFeedbackAnalytics(payload, outcome);
        const gtag = (window as GtagWindow).gtag;
        if (typeof gtag === 'function') gtag('event', 'feedback_submit', analytics);
        setState('error', outcome.errorCode);
      } finally {
        resetTurnstile();
        pending = false;
        submit.disabled = false;
        form.setAttribute('aria-busy', 'false');
      }
    });

    // The API accepts JSON only and production Turnstile verification needs
    // JavaScript. Keep native controls disabled until this handler is wired so
    // a missing bundle cannot navigate away, leak fields into a URL, or send a
    // request the endpoint cannot process.
    form.action = '/api/feedback';
    form.method = 'post';
    root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('[data-feedback-control]')
      .forEach((control) => { control.disabled = false; });
    setState('idle');
  });
</script>

<style>
  .feedback-panel {
    max-width: 720px;
    margin: 0 auto 28px;
    color: var(--fg, #28231f);
    text-align: left;
  }
  .feedback-panel details {
    border: 1px solid var(--border, #d7cec4);
    border-radius: 14px;
    background: var(--bg2, #fffaf4);
    overflow: hidden;
  }
  .feedback-panel summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 16px 18px;
    cursor: pointer;
    font-size: 0.94rem;
    font-weight: 700;
  }
  .feedback-panel summary:focus-visible {
    outline: 2px solid var(--accent, #b54f27);
    outline-offset: -3px;
  }
  .feedback-panel summary small {
    color: var(--fg2, #655e58);
    font-size: 0.72rem;
    font-weight: 500;
  }
  .feedback-form {
    padding: 0 18px 18px;
    border-top: 1px solid var(--border, #d7cec4);
  }
  .feedback-instructions,
  .feedback-unavailable,
  .feedback-privacy {
    margin: 14px 0;
    color: var(--fg2, #655e58);
    font-size: 0.78rem;
    line-height: 1.7;
  }
  .feedback-unavailable {
    color: #9f2d20;
    font-weight: 650;
  }
  .feedback-form fieldset {
    margin: 0 0 16px;
    padding: 0;
    border: 0;
  }
  .feedback-form legend,
  .feedback-field > span {
    display: block;
    margin-bottom: 8px;
    color: var(--fg, #28231f);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .feedback-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }
  .feedback-options label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 7px 9px;
    border: 1px solid var(--border, #d7cec4);
    border-radius: 8px;
    background: var(--bg, #fff);
    color: var(--fg, #28231f);
    font-size: 0.76rem;
    cursor: pointer;
  }
  .feedback-options input {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    accent-color: var(--accent, #b54f27);
  }
  .feedback-field {
    display: block;
    margin: 0 0 14px;
  }
  .feedback-field textarea,
  .feedback-field input {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid var(--border, #d7cec4);
    border-radius: 8px;
    background: var(--bg, #fff);
    color: var(--fg, #28231f);
    padding: 10px 11px;
    font: inherit;
    font-size: 0.84rem;
  }
  .feedback-field textarea {
    min-height: 96px;
    resize: vertical;
  }
  .feedback-field textarea:focus,
  .feedback-field input:focus,
  .feedback-options input:focus-visible {
    outline: 2px solid var(--accent, #b54f27);
    outline-offset: 2px;
  }
  .feedback-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .feedback-turnstile {
    margin: 0 0 12px;
  }
  .feedback-privacy a {
    text-decoration: underline;
  }
  .feedback-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .feedback-actions button {
    min-height: 44px;
    flex: 0 0 auto;
    padding: 9px 18px;
    border: 1px solid var(--accent, #b54f27);
    border-radius: 999px;
    background: var(--accent, #b54f27);
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }
  .feedback-actions button:focus-visible {
    outline: 2px solid var(--fg, #28231f);
    outline-offset: 2px;
  }
  .feedback-actions button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .feedback-status {
    min-height: 1.5em;
    margin: 0;
    color: var(--fg2, #655e58);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  [data-feedback-state='error'] .feedback-status,
  [data-feedback-state='validation-error'] .feedback-status {
    color: #9f2d20;
    font-weight: 650;
  }
  [data-feedback-state='success'] .feedback-status {
    color: #176b45;
    font-weight: 650;
  }
  @media (max-width: 560px) {
    .feedback-panel summary,
    .feedback-form { padding-left: 14px; padding-right: 14px; }
    .feedback-options { grid-template-columns: 1fr; }
    .feedback-actions { align-items: flex-start; flex-direction: column; }
    .feedback-actions button { width: 100%; }
  }
</style>
