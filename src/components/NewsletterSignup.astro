---
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<section
  class="newsletter-panel"
  data-newsletter-root
  data-newsletter-state="idle"
  aria-labelledby="newsletter-heading"
>
  <div class="newsletter-copy">
    <p class="newsletter-eyebrow">月次レポート</p>
    <h2 id="newsletter-heading">AIと仕事の変化を、月1回だけ</h2>
    <p id="newsletter-help">
      新しい職業評価やデータ更新を、要点だけメールでお届けします。
    </p>
  </div>

  <form
    class="newsletter-form"
    data-newsletter-form
    aria-describedby="newsletter-help newsletter-consent newsletter-status"
    novalidate
  >
    <noscript>
      <p class="newsletter-unavailable">登録にはJavaScriptが必要です。ブラウザの設定を有効にしてから再読み込みしてください。</p>
    </noscript>
    <label class="newsletter-label" for="newsletter-email">メールアドレス</label>
    <div class="newsletter-row">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        maxlength="254"
        inputmode="email"
        autocomplete="email"
        placeholder="name@example.com"
        aria-describedby="newsletter-status"
        data-newsletter-control
        disabled
        required
      />
      <button type="submit" data-newsletter-submit data-newsletter-control disabled>無料で登録</button>
    </div>

    <label class="newsletter-honeypot" aria-hidden="true">
      ウェブサイト
      <input name="htmlfield" type="text" tabindex="-1" autocomplete="off" data-newsletter-control disabled />
    </label>

    {TURNSTILE_SITE_KEY && (
      <div class="newsletter-turnstile">
        <div
          id="newsletter-turnstile"
          class="cf-turnstile"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-language="ja"
          data-theme="auto"
        ></div>
      </div>
    )}

    <p id="newsletter-consent" class="newsletter-consent">
      登録すると、月次レポートと本サイトの更新通知の受信に同意したものとします。
      配信停止は各メールからいつでも可能です。詳しくは<a href="/privacy">プライバシーポリシー</a>をご確認ください。
    </p>
    <p
      id="newsletter-status"
      class="newsletter-status"
      data-newsletter-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
      tabindex="-1"
    >登録機能を準備しています…</p>
  </form>
</section>

<script>
  import {
    buildNewsletterAnalytics,
    buildNewsletterPayload,
    isValidNewsletterEmail,
    newsletterOutcomeForResponse,
    newsletterStatusMessage,
    type NewsletterState,
  } from '@/lib/newsletter-ui';

  type NewsletterWindow = Window & {
    gtag?: (command: 'event', eventName: string, params: Record<string, string | number>) => void;
    turnstile?: { reset: (widgetSelector: string) => void };
  };

  document.querySelectorAll<HTMLElement>('[data-newsletter-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-newsletter-form]');
    const email = root.querySelector<HTMLInputElement>('#newsletter-email');
    const submit = root.querySelector<HTMLButtonElement>('[data-newsletter-submit]');
    const status = root.querySelector<HTMLElement>('[data-newsletter-status]');
    if (!form || !email || !submit || !status || root.dataset.newsletterWired === '1') return;
    root.dataset.newsletterWired = '1';

    let pending = false;

    const resetTurnstile = (): void => {
      if (!root.querySelector('#newsletter-turnstile')) return;
      const turnstileApi = (window as NewsletterWindow).turnstile;
      if (typeof turnstileApi?.reset !== 'function') return;
      try {
        // Tokens are single-use. Every failed delivery must obtain a new
        // challenge before the visitor can retry the same subscription.
        turnstileApi.reset('#newsletter-turnstile');
      } catch { /* the next submit will surface turnstile_failed */ }
    };

    const setState = (state: NewsletterState, errorCode = ''): void => {
      root.dataset.newsletterState = state;
      form.setAttribute('aria-busy', state === 'pending' ? 'true' : 'false');
      email.setAttribute('aria-invalid', state === 'validation-error' ? 'true' : 'false');
      email.disabled = state === 'success';
      submit.disabled = state === 'pending' || state === 'success';
      submit.textContent = state === 'pending'
        ? '登録中…'
        : state === 'success'
          ? '登録済み'
          : state === 'error'
            ? 'もう一度登録'
            : '無料で登録';
      status.textContent = newsletterStatusMessage(state, errorCode);
      status.setAttribute('role', state === 'error' || state === 'validation-error' ? 'alert' : 'status');
      if (state === 'error' || state === 'success') status.focus();
    };

    email.addEventListener('input', () => {
      if (root.dataset.newsletterState === 'validation-error') setState('idle');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (pending || root.dataset.newsletterState === 'success') return;

      if (!isValidNewsletterEmail(email.value)) {
        setState('validation-error', 'invalid_email');
        email.focus();
        return;
      }

      const honeypot = form.elements.namedItem('htmlfield') as HTMLInputElement | null;
      const turnstile = form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null;
      const payload = buildNewsletterPayload({
        email: email.value,
        htmlfield: honeypot?.value ?? '',
        turnstileToken: turnstile?.value ?? '',
        pathname: window.location.pathname,
      });

      pending = true;
      setState('pending');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body: unknown = await response.json().catch(() => null);
        const outcome = newsletterOutcomeForResponse(response.status, body);
        const gtag = (window as NewsletterWindow).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'email_submit_header', buildNewsletterAnalytics(outcome));
        }
        if (outcome.success) email.value = '';
        setState(outcome.success ? 'success' : 'error', outcome.errorCode);
      } catch {
        const outcome = { success: false, errorCode: 'network_error' } as const;
        const gtag = (window as NewsletterWindow).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'email_submit_header', buildNewsletterAnalytics(outcome));
        }
        setState('error', outcome.errorCode);
      } finally {
        resetTurnstile();
        pending = false;
        form.setAttribute('aria-busy', 'false');
        if (root.dataset.newsletterState !== 'success') submit.disabled = false;
      }
    });

    // `/api/subscribe` accepts JSON and production Turnstile verification
    // requires JavaScript. Keep the static fallback non-submitting until this
    // handler is ready, matching the shared feedback form's safety boundary.
    form.action = '/api/subscribe';
    form.method = 'post';
    root.querySelectorAll<HTMLInputElement | HTMLButtonElement>('[data-newsletter-control]')
      .forEach((control) => { control.disabled = false; });
    setState('idle');
  });
</script>

<style>
  .newsletter-panel {
    box-sizing: border-box;
    max-width: 720px;
    margin: 0 auto 20px;
    padding: 22px;
    border: 1px solid var(--border, #d7cec4);
    border-radius: 16px;
    background: var(--bg2, #fffaf4);
    color: var(--fg, #28231f);
    text-align: left;
  }
  .newsletter-copy {
    margin-bottom: 16px;
  }
  .newsletter-eyebrow {
    margin: 0 0 4px;
    color: var(--orange-hot, #c0411e);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .newsletter-copy h2 {
    margin: 0;
    color: var(--fg, #28231f);
    font-size: clamp(1.05rem, 2.8vw, 1.35rem);
    line-height: 1.45;
  }
  .newsletter-copy #newsletter-help {
    margin: 7px 0 0;
    color: var(--fg2, #655e58);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .newsletter-label {
    display: block;
    margin-bottom: 7px;
    color: var(--fg, #28231f);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .newsletter-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 9px;
  }
  .newsletter-row input,
  .newsletter-row button {
    box-sizing: border-box;
    min-height: 46px;
    border-radius: 10px;
    font: inherit;
  }
  .newsletter-row input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border, #d7cec4);
    background: var(--bg, #fff);
    color: var(--fg, #28231f);
    font-size: 0.86rem;
  }
  .newsletter-row input[aria-invalid='true'] {
    border-color: #9f2d20;
  }
  .newsletter-row button {
    padding: 10px 19px;
    border: 1px solid var(--orange-hot, #c0411e);
    background: var(--orange-hot, #c0411e);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }
  .newsletter-row input:focus,
  .newsletter-row button:focus-visible {
    outline: 2px solid var(--orange-hot, #c0411e);
    outline-offset: 2px;
  }
  .newsletter-row button:disabled {
    cursor: wait;
    opacity: 0.68;
  }
  [data-newsletter-state='success'] .newsletter-row button:disabled {
    cursor: default;
  }
  .newsletter-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .newsletter-turnstile {
    margin: 12px 0 0;
  }
  .newsletter-unavailable,
  .newsletter-consent {
    margin: 10px 0 0;
    color: var(--fg2, #655e58);
    font-size: 0.7rem;
    line-height: 1.65;
  }
  .newsletter-unavailable {
    color: #9f2d20;
    font-weight: 650;
  }
  .newsletter-consent a {
    color: var(--orange-hot, #c0411e);
    text-decoration: underline;
  }
  .newsletter-status {
    min-height: 1.5em;
    margin: 8px 0 0;
    color: var(--fg2, #655e58);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  [data-newsletter-state='error'] .newsletter-status,
  [data-newsletter-state='validation-error'] .newsletter-status {
    color: #9f2d20;
    font-weight: 650;
  }
  [data-newsletter-state='success'] .newsletter-status {
    color: #176b45;
    font-weight: 650;
  }
  @media (max-width: 560px) {
    .newsletter-panel {
      padding: 18px 14px;
    }
    .newsletter-row {
      grid-template-columns: 1fr;
    }
    .newsletter-row button {
      width: 100%;
    }
  }
</style>
